{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "16425568284138802102"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "westus2",
      "metadata": {
        "description": "Azure region (matches the PoLocalCompare resource group)"
      }
    },
    "appServiceName": {
      "type": "string",
      "defaultValue": "app-polocalcompare-win",
      "metadata": {
        "description": "Name of the new App Service to create on the existing plan"
      }
    },
    "sharedResourceGroupName": {
      "type": "string",
      "defaultValue": "PoShared",
      "metadata": {
        "description": "Shared resource group holding Key Vault, App Insights, and the workload identity"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appServiceName')]",
      "location": "[parameters('location')]",
      "kind": "app",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.ManagedIdentity/userAssignedIdentities', 'mi-poshared-containerapps'))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', 'asp-PoLocalCompare-f1')]",
        "httpsOnly": true,
        "siteConfig": {
          "alwaysOn": false,
          "netFrameworkVersion": "v10.0",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "http20Enabled": true,
          "metadata": [
            {
              "name": "CURRENT_STACK",
              "value": "dotnet"
            }
          ],
          "appSettings": [
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "false"
            },
            {
              "name": "KeyVault__Uri",
              "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.KeyVault/vaults', 'kv-poshared'), '2023-07-01').vaultUri]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.Insights/components', 'poappideinsights8f9c9a4e'), '2020-02-02').ConnectionString]"
            },
            {
              "name": "AZURE_CLIENT_ID",
              "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.ManagedIdentity/userAssignedIdentities', 'mi-poshared-containerapps'), '2023-01-31').clientId]"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "appServiceName": {
      "type": "string",
      "value": "[parameters('appServiceName')]"
    },
    "appServiceUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('appServiceName')), '2023-12-01').defaultHostName)]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "polocalcomparedevsa"
    }
  }
}