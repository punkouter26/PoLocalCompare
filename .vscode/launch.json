{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch PoLocalCompare (Edge)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PoLocalCompare.Api/bin/Debug/net10.0/PoLocalCompare.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/PoLocalCompare.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "https://localhost:5001",
        "browserProgram": "msedge"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Watch & Launch PoLocalCompare (Edge)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "watch",
      "program": "${workspaceFolder}/src/PoLocalCompare.Api/bin/Debug/net10.0/PoLocalCompare.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/PoLocalCompare.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "https://localhost:5001",
        "browserProgram": "msedge"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
