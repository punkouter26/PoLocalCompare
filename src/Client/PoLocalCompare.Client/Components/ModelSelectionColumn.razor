@using PoLocalCompare.Shared.DTOs

<div class="war-room__column">
    <h2 class="war-room__col-title">@Title</h2>
    @if (!Models.Any())
    {
        <p class="war-room__empty">No models available - register a model first.</p>
    }
    else if (!FilteredModels.Any())
    {
        <p class="war-room__empty">No models match this filter.</p>
    }
    else
    {
        @foreach (var model in FilteredModels)
        {
            <ModelCard
                Model="model"
                LabelOverride="@(ModelLabels.GetValueOrDefault(model.ModelId))"
                IsSelected="SelectedModelId == model.ModelId"
                IsDisabled="OtherSelectedModelId == model.ModelId"
                OnSelected="OnSelected"
                ProjectedEloGain="ProjectedEloGain" />
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IEnumerable<ModelDto> Models { get; set; } = Enumerable.Empty<ModelDto>();
    [Parameter, EditorRequired] public IEnumerable<ModelDto> FilteredModels { get; set; } = Enumerable.Empty<ModelDto>();
    [Parameter, EditorRequired] public Dictionary<string, string> ModelLabels { get; set; } = new();
    [Parameter] public string? SelectedModelId { get; set; }
    [Parameter] public string? OtherSelectedModelId { get; set; }
    [Parameter] public double? ProjectedEloGain { get; set; }
    [Parameter, EditorRequired] public EventCallback<ModelDto> OnSelected { get; set; }
}
