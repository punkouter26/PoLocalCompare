@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums

<div class="@_cardClass" @onclick="OnCardClick" style="@_cardStyle">
    <div class="model-card__header">
        <span class="model-card__name">@(LabelOverride ?? Model.DisplayName)</span>
        <div style="display:flex;align-items:center;gap:0.4rem;">
            @if (Slot == "Left")
            {
                <span class="model-card__slot-badge model-card__slot-badge--left" title="Left player">L</span>
            }
            else if (Slot == "Right")
            {
                <span class="model-card__slot-badge model-card__slot-badge--right" title="Right player">R</span>
            }
            <span class="model-card__badge model-card__badge--@(Model.ModelType.ToString().ToLower())">
                @(Model.ModelType == ModelType.LocalService ? "SVC" : Model.ModelType.ToString().ToUpper())
            </span>
        </div>
    </div>
    <div class="model-card__elo">
        ELO: <strong>@Model.CurrentElo.ToString("F0")</strong>
        @if (ProjectedEloGain.HasValue)
        {
            <span class="model-card__elo-gain @(ProjectedEloGain >= 0 ? "positive" : "negative")">
                @(ProjectedEloGain >= 0 ? "+" : "")@ProjectedEloGain.Value.ToString("F1")
            </span>
        }
    </div>
    <div class="model-card__stats">
        Duels: @Model.DuelCount &nbsp;|&nbsp; W/L: @Model.WinCount/@(Model.DuelCount - Model.WinCount)
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ModelDto Model { get; set; } = null!;
    [Parameter] public string? LabelOverride { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public string? Slot { get; set; }  // "Left", "Right", or null
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public EventCallback<ModelDto> OnSelected { get; set; }
    [Parameter] public double? ProjectedEloGain { get; set; }

    private string _cardClass => IsSelected ? "model-card model-card--selected" : "model-card";

    private string _cardStyle
    {
        get
        {
            var cursor = IsDisabled ? "cursor:not-allowed;opacity:0.45;" : "cursor:pointer;";
            if (IsSelected)
                return cursor + "border:2px solid #22c55e !important;box-shadow:0 0 0 2px rgba(34,197,94,0.4),0 0 24px rgba(34,197,94,0.2) !important;background:linear-gradient(135deg,rgba(34,197,94,0.08) 0%,#0a0a0a 100%) !important;";
            return cursor;
        }
    }

    private async Task OnCardClick()
    {
        if (!IsDisabled)
            await OnSelected.InvokeAsync(Model);
    }
}

<style>
    .model-card {
        background: var(--oled-surface);
        border: 1px solid var(--oled-border);
        transition: all var(--transition-medium);
        margin-bottom: 0.5rem;
        border-radius: var(--radius-md);
        position: relative;
        overflow: hidden;
        padding: 1rem;
    }

    .model-card::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(180deg, var(--oled-green), var(--oled-cyan));
        transform: scaleY(0);
        transition: transform var(--transition-medium);
    }

    .model-card:hover:not(.model-card--selected) {
        border-color: var(--oled-border-light);
        transform: translateY(-2px) scale(1.01);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        background: var(--oled-surface-elevated);
    }

    .model-card:hover:not(.model-card--selected)::before {
        transform: scaleY(0.3);
    }

    .model-card--selected {
        border-color: var(--oled-green);
        border-left: none;
        box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.4), 0 0 24px rgba(34, 197, 94, 0.2);
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.08) 0%, var(--oled-surface) 100%);
        animation: borderGlow 3s ease-in-out infinite;
    }

    .model-card--selected::before {
        transform: scaleY(1);
    }

    .model-card__slot-badge {
        font-size: 0.7rem;
        font-weight: 700;
        width: 1.25rem;
        height: 1.25rem;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        animation: scaleIn 0.3s var(--spring-bounce);
    }

    .model-card__slot-badge--left {
        background: var(--oled-cyan);
        color: #000;
    }

    .model-card__slot-badge--right {
        background: #f59e0b;
        color: #000;
    }

    .model-card__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.35rem;
    }

    .model-card__name {
        color: var(--oled-text);
        font-weight: 600;
        font-size: 1rem;
    }

    .model-card__badge {
        font-size: 0.65rem;
        padding: 0.2rem 0.45rem;
        border-radius: var(--radius-sm);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
    }

    .model-card__badge::before {
        content: '●';
        font-size: 0.6em;
    }

    .model-card__badge--local {
        background: linear-gradient(135deg, #4c1d95, #7c3aed);
        color: #fff;
        box-shadow: 0 2px 8px rgba(124, 58, 237, 0.3);
    }
    .model-card__badge--local::before { color: #c4b5fd; }

    .model-card__badge--remote {
        background: linear-gradient(135deg, #1d4ed8, #3b82f6);
        color: #fff;
        box-shadow: 0 2px 8px rgba(29, 78, 216, 0.3);
    }
    .model-card__badge--remote::before { color: #93c5fd; }

    .model-card__badge--localservice {
        background: linear-gradient(135deg, #0d9469, #06b6d4);
        color: #fff;
        box-shadow: 0 2px 8px rgba(13, 148, 105, 0.3);
    }
    .model-card__badge--localservice::before { color: #6ee7b7; }

    .model-card__elo {
        color: var(--oled-text);
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .model-card__elo-gain {
        font-weight: 700;
        transition: all var(--transition-fast);
    }

    .model-card__elo-gain.positive { 
        color: var(--oled-green);
        text-shadow: 0 0 10px rgba(34, 197, 94, 0.5);
    }
    
    .model-card__elo-gain.negative { 
        color: var(--oled-red);
        text-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
    }

    .model-card__stats {
        color: var(--oled-text-muted);
        font-size: 0.8rem;
    }
    
    /* Ripple effect on click */
    .model-card::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: radial-gradient(circle, rgba(34, 197, 94, 0.3) 0%, transparent 70%);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition: width 0.5s, height 0.5s;
    }
    
    .model-card:active::after {
        width: 300px;
        height: 300px;
    }
</style>
