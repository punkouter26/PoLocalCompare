@namespace PoLocalCompare.Client.Components

<div class="skeleton-wrapper">
    @if (Type == SkeletonType.Card)
    {
        <div class="skeleton-card">
            <div class="skeleton skeleton-title"></div>
            <div class="skeleton skeleton-text" style="width: 80%"></div>
            <div class="skeleton skeleton-text" style="width: 60%"></div>
            <div class="skeleton skeleton-text" style="width: 70%"></div>
        </div>
    }
    else if (Type == SkeletonType.List)
    {
        @for (int i = 0; i < Items; i++)
        {
            <div class="skeleton-list-item" style="animation-delay: @(i * 100)ms">
                <div class="skeleton skeleton-avatar"></div>
                <div class="skeleton-list-item__content">
                    <div class="skeleton skeleton-text" style="width: 60%"></div>
                    <div class="skeleton skeleton-text" style="width: 40%"></div>
                </div>
            </div>
        }
    }
    else if (Type == SkeletonType.Table)
    {
        <div class="skeleton-table">
            <div class="skeleton-table__header">
                @for (int i = 0; i < Columns; i++)
                {
                    <div class="skeleton skeleton-text" style="width: @((100 / Columns).ToString("F0"))%"></div>
                }
            </div>
            @for (int i = 0; i < Rows; i++)
            {
                <div class="skeleton-table__row" style="animation-delay: @(i * 50)ms">
                    @for (int j = 0; j < Columns; j++)
                    {
                        <div class="skeleton skeleton-text" style="width: @((100 / Columns).ToString("F0"))%"></div>
                    }
                </div>
            }
        </div>
    }
    else if (Type == SkeletonType.Hero)
    {
        <div class="skeleton-hero">
            <div class="skeleton skeleton-title" style="width: 50%; margin: 0 auto 1rem;"></div>
            <div class="skeleton skeleton-text" style="width: 80%; margin: 0 auto 0.5rem;"></div>
            <div class="skeleton skeleton-text" style="width: 60%; margin: 0 auto;"></div>
        </div>
    }
    else
    {
        <div class="skeleton skeleton-text" style="width: @Width"></div>
    }
</div>

<style>
    .skeleton-wrapper {
        width: 100%;
    }

    .skeleton-card {
        padding: 1.5rem;
        background: var(--oled-surface);
        border: 1px solid var(--oled-border);
        border-radius: var(--radius-lg);
    }

    .skeleton-list-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem;
        border-bottom: 1px solid var(--oled-border);
        animation: fadeIn 0.4s ease-out both;
    }

    .skeleton-list-item:last-child {
        border-bottom: none;
    }

    .skeleton-list-item__content {
        flex: 1;
    }

    .skeleton-table {
        background: var(--oled-surface);
        border: 1px solid var(--oled-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .skeleton-table__header {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        background: var(--oled-surface-elevated);
        border-bottom: 1px solid var(--oled-border);
    }

    .skeleton-table__row {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        border-bottom: 1px solid var(--oled-border);
        animation: fadeIn 0.4s ease-out both;
    }

    .skeleton-table__row:last-child {
        border-bottom: none;
    }

    .skeleton-hero {
        text-align: center;
        padding: 3rem 1rem;
    }
</style>

@code {
    public enum SkeletonType
    {
        Text,
        Card,
        List,
        Table,
        Hero
    }

    [Parameter] public SkeletonType Type { get; set; } = SkeletonType.Text;
    [Parameter] public int Items { get; set; } = 5;
    [Parameter] public int Columns { get; set; } = 4;
    [Parameter] public int Rows { get; set; } = 5;
    [Parameter] public string Width { get; set; } = "100%";
}
