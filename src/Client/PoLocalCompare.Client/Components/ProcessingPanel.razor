@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums

<div class="processing-panel processing-panel--@Status.ToString().ToLower()">
    <div class="processing-panel__header">
        <span class="processing-panel__name">@ModelName</span>
        <span class="processing-panel__side">@Side</span>
    </div>
    <div class="processing-panel__status">
        <span class="processing-panel__status-label">@Status</span>
        @if (Status == DuelStatus.Generating || Status == DuelStatus.Done)
        {
            <span class="processing-panel__tokens">@TokenCount tokens</span>
        }
    </div>
    <div class="processing-panel__timer">
        Elapsed: <strong>@FormatElapsed(ElapsedMs)</strong>
        @if (EstimatedRemainingMs.HasValue && Status == DuelStatus.Generating)
        {
            <span class="processing-panel__eta"> · ETA: @FormatElapsed(EstimatedRemainingMs.Value)</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string ModelName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Side { get; set; } = string.Empty;
    [Parameter] public DuelStatus Status { get; set; } = DuelStatus.Initializing;
    [Parameter] public long ElapsedMs { get; set; }
    [Parameter] public int TokenCount { get; set; }
    [Parameter] public long? EstimatedRemainingMs { get; set; }

    private static string FormatElapsed(long ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return ts.TotalMinutes >= 1
            ? $"{(int)ts.TotalMinutes}m {ts.Seconds:D2}s"
            : $"{ts.TotalSeconds:F1}s";
    }
}

<style>
    .processing-panel {
        background: #0a0a0a;
        border: 1px solid #333;
        border-radius: 0.5rem;
        padding: 1rem;
        min-height: 120px;
    }

    .processing-panel--generating { border-color: #eab308; }
    .processing-panel--done { border-color: #22c55e; }
    .processing-panel--failed { border-color: #ef4444; }

    .processing-panel__header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }

    .processing-panel__name { color: #fff; font-weight: 700; font-size: 1rem; }

    .processing-panel__side {
        color: #9ca3af;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .processing-panel__status { display: flex; gap: 1rem; align-items: center; margin-bottom: 0.5rem; }

    .processing-panel__status-label {
        font-weight: 600;
        color: #e5e7eb;
        font-size: 1.1rem;
    }

    .processing-panel--generating .processing-panel__status-label { color: #eab308; }
    .processing-panel--done .processing-panel__status-label { color: #22c55e; }
    .processing-panel--failed .processing-panel__status-label { color: #ef4444; }

    .processing-panel__tokens { color: #9ca3af; font-size: 0.9rem; }
    .processing-panel__timer { color: #6b7280; font-size: 0.85rem; }
    .processing-panel__eta { color: #9ca3af; }
</style>
