@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums

<div class="processing-panel processing-panel--@Status.ToString().ToLower()">
    <div class="processing-panel__header">
        <div class="processing-panel__name-block">
            <span class="processing-panel__display-name">@(string.IsNullOrEmpty(DisplayName) ? ModelName : DisplayName)</span>
            @if (!string.IsNullOrEmpty(DisplayName))
            {
                <span class="processing-panel__model-id">@ModelName</span>
            }
        </div>
        <div class="processing-panel__badges">
            <span class="badge badge--@(IsLocal ? "local" : "remote")">@(IsLocal ? "🖥 Local" : "☁ Remote")</span>
            @if (CacheHit == true)
            {
                <span class="badge badge--cache">⚡ cached</span>
            }
            @if (IsStalled && Status == DuelStatus.Generating)
            {
                <span class="badge badge--stall">⚠ stalled</span>
            }
            <span class="processing-panel__side">@Side</span>
        </div>
    </div>

    <div class="processing-panel__status">
        <span class="processing-panel__status-label">
            @if (Status == DuelStatus.Generating)
            {
                <span class="processing-panel__pulse"></span>
            }
            @Status
        </span>
        @if (Status == DuelStatus.Generating || Status == DuelStatus.Done)
        {
            <span class="processing-panel__tokens">@TokenCount.ToString("N0") tokens</span>
        }
    </div>

    @* Sub-phase detail (e.g. WebLLM "Loading weights 42%") *@
    @if (!string.IsNullOrEmpty(Detail))
    {
        <div class="processing-panel__detail">@Detail</div>
    }

    @* Repetition warning *@
    @if (RepetitionScore.HasValue && RepetitionScore.Value > 0.3 && Status == DuelStatus.Generating)
    {
        <div class="processing-panel__rep-warning">
            ⟳ Possible loop detected (@(RepetitionScore.Value.ToString("P0")) repeated n-grams)
        </div>
    }

    @* Time progress bar against 5-minute limit *@
    <div class="processing-panel__progress-track">
        <div class="processing-panel__progress-fill processing-panel__progress-fill--@Status.ToString().ToLower()"
             style="width: @Math.Min(100, ElapsedMs / 3000.0).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%">
        </div>
    </div>

    <div class="processing-panel__metrics">

        @* --- Timing (stats 1, 2, 3) --- *@
        <div class="processing-panel__metric">
            <span class="processing-panel__metric-label">Elapsed</span>
            <span class="processing-panel__metric-value">@FormatElapsed(ElapsedMs)</span>
        </div>

        @if (TdpWatts.HasValue)
        {
            <div class="processing-panel__metric">
                <span class="processing-panel__metric-label">TDP</span>
                <span class="processing-panel__metric-value">@TdpWatts.Value W</span>
            </div>
        }

        @if (WarmUpMs.HasValue)
        {
            <div class="processing-panel__metric">
                <span class="processing-panel__metric-label">Warm-up</span>
                <span class="processing-panel__metric-value">@FormatElapsed(WarmUpMs.Value)</span>
            </div>
        }

        @if (Status == DuelStatus.Generating && TokenVelocity.HasValue && TokenVelocity.Value > 0)
        {
            var remainingTokens = 8000 - TokenCount;
            var etaMs = (long)(remainingTokens / TokenVelocity.Value * 1000);
            var finishAt = DateTime.Now.AddMilliseconds(etaMs);
            <div class="processing-panel__metric">
                <span class="processing-panel__metric-label">~Done at</span>
                <span class="processing-panel__metric-value">@finishAt.ToString("h:mm tt")</span>
            </div>
        }

        @* --- Speed (stats 1, 2) --- *@
        @if (TokenVelocity.HasValue && TokenVelocity.Value > 0)
        {
            <div class="processing-panel__metric processing-panel__metric--highlight">
                <span class="processing-panel__metric-label">Gen speed</span>
                <span class="processing-panel__metric-value">@TokenVelocity.Value.ToString("F1") tok/s</span>
            </div>
        }

        @if (PeakTokenVelocity.HasValue && PeakTokenVelocity.Value > 0)
        {
            <div class="processing-panel__metric">
                <span class="processing-panel__metric-label">Peak speed</span>
                <span class="processing-panel__metric-value">@PeakTokenVelocity.Value.ToString("F1") tok/s</span>
            </div>
        }

        @if (PrefillSpeedTps.HasValue && PrefillSpeedTps.Value > 0)
        {
            <div class="processing-panel__metric">
                <span class="processing-panel__metric-label">Prefill</span>
                <span class="processing-panel__metric-value">@PrefillSpeedTps.Value.ToString("F0") tok/s</span>
            </div>
        }

        @* --- Output size + rate --- *@
        @if (TokenCount > 0)
        {
            var outputBytes = (long)(TokenCount * 4.5);
            var genElapsedMs = WarmUpMs.HasValue ? Math.Max(1, ElapsedMs - WarmUpMs.Value) : Math.Max(1, ElapsedMs);

            <div class="processing-panel__metric">
                <span class="processing-panel__metric-label">~Output</span>
                <span class="processing-panel__metric-value">@FormatBytes(outputBytes)</span>
            </div>

            @if (Status == DuelStatus.Generating && genElapsedMs > 0)
            {
                var kbPerSec = outputBytes / 1024.0 / (genElapsedMs / 1000.0);
                <div class="processing-panel__metric">
                    <span class="processing-panel__metric-label">Rate</span>
                    <span class="processing-panel__metric-value">@kbPerSec.ToString("F2") KB/s</span>
                </div>
            }

            <div class="processing-panel__metric">
                <span class="processing-panel__metric-label">~Progress</span>
                <span class="processing-panel__metric-value">@((TokenCount * 100 / 8000).ToString())%</span>
            </div>
        }

        @* --- HTML structure (stats 5, 6, 7) --- *@
        @if (HtmlTagCount.HasValue && HtmlTagCount.Value > 0)
        {
            <div class="processing-panel__metric">
                <span class="processing-panel__metric-label">HTML tags</span>
                <span class="processing-panel__metric-value">@HtmlTagCount.Value.ToString("N0")</span>
            </div>
        }

        @if (OpenTagDepth.HasValue)
        {
            <div class="processing-panel__metric">
                <span class="processing-panel__metric-label">Tag depth</span>
                <span class="processing-panel__metric-value">@OpenTagDepth.Value</span>
            </div>
        }

        @if (StyleRuleCount.HasValue && StyleRuleCount.Value > 0)
        {
            <div class="processing-panel__metric">
                <span class="processing-panel__metric-label">CSS rules</span>
                <span class="processing-panel__metric-value">@StyleRuleCount.Value.ToString("N0")</span>
            </div>
        }

        @* --- Repetition score (stat 8) — only show when non-trivial --- *@
        @if (RepetitionScore.HasValue && RepetitionScore.Value > 0.05)
        {
            <div class="processing-panel__metric @(RepetitionScore.Value > 0.3 ? "processing-panel__metric--danger" : "")">
                <span class="processing-panel__metric-label">Loop risk</span>
                <span class="processing-panel__metric-value">@RepetitionScore.Value.ToString("P0")</span>
            </div>
        }

    </div>
</div>

@code {
    [Parameter, EditorRequired] public string ModelName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Side { get; set; } = string.Empty;
    [Parameter] public string? DisplayName { get; set; }
    [Parameter] public bool IsLocal { get; set; }
    [Parameter] public double? TdpWatts { get; set; }
    [Parameter] public DuelStatus Status { get; set; } = DuelStatus.Initializing;
    [Parameter] public long ElapsedMs { get; set; }
    [Parameter] public int TokenCount { get; set; }
    [Parameter] public double? TokenVelocity { get; set; }
    [Parameter] public double? PeakTokenVelocity { get; set; }
    [Parameter] public long? WarmUpMs { get; set; }
    [Parameter] public bool IsStalled { get; set; }
    [Parameter] public int? HtmlTagCount { get; set; }
    [Parameter] public int? OpenTagDepth { get; set; }
    [Parameter] public int? StyleRuleCount { get; set; }
    [Parameter] public double? RepetitionScore { get; set; }
    [Parameter] public double? PrefillSpeedTps { get; set; }
    [Parameter] public bool? CacheHit { get; set; }
    [Parameter] public string? Detail { get; set; }

    private static string FormatElapsed(long ms)
    {
        if (ms <= 0) return "0s";
        var ts = TimeSpan.FromMilliseconds(ms);
        return ts.TotalMinutes >= 1
            ? $"{(int)ts.TotalMinutes}m {ts.Seconds:D2}s"
            : $"{ts.TotalSeconds:F1}s";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes} B";
    }
}
