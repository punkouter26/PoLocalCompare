@page "/archive"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Radzen
@using Radzen.Blazor
@inject DuelApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Archive — LLM Duel Arena</PageTitle>

<div class="archive">
    <h1 class="archive__title">&#x1F52C; Lab Archive</h1>

    @if (_loading)
    {
        <p class="archive__status">Loading archive...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="archive__error">@_error</p>
    }
    else if (_duels.Count == 0)
    {
        <div class="archive__empty-card">
            <h2>No duels recorded yet</h2>
            <p>Archive snapshots, verdicts, and lab reports will appear here once a duel completes.</p>
            <div class="archive__empty-actions">
                <a class="archive__empty-cta" href="/war-room">⚔ Start a New Duel</a>
                <a class="archive__empty-link" href="/local-model-lab">🧪 Run Local Lab Diagnostics</a>
            </div>
        </div>
    }
    else
    {
        <div class="archive__filters">
            @foreach (var label in new[] { "All", "Won", "No Verdict" })
            {
                <button class="archive__filter-chip @(_verdictFilter == label ? "archive__filter-chip--active" : "")"
                        @onclick="() => _verdictFilter = label">
                    @label
                </button>
            }
            <button class="archive__filter-chip @(_qualityFilter == "Quality80" ? "archive__filter-chip--active" : "")"
                    @onclick="ToggleQualityFilter">
                Quality 80+
            </button>
            <button class="archive__filter-chip @(_sortMode == "Quality" ? "archive__filter-chip--active" : "")"
                    @onclick="ToggleSortMode">
                Sort: @(_sortMode == "Quality" ? "Quality" : "Newest")
            </button>
        </div>
        @if (FilteredDuels().Count == 0)
        {
            <div class="archive__filtered-empty">
                <p>No duels match the <strong>@_verdictFilter</strong> filter.</p>
                <button class="archive__filter-reset" @onclick="ResetFilters">Show all duels</button>
            </div>
        }
        <RadzenDataGrid Data="@FilteredDuels()" TItem="DuelSummaryDto" RowSelect="OnRowSelect"
            RowClass="@_rowClassFn"
            Class="archive__grid">
            <Columns>
                <RadzenDataGridColumn TItem="DuelSummaryDto" Property="StartedAt" Title="Date" Width="170px">
                    <Template Context="d">@d.StartedAt.ToString("yyyy-MM-dd HH:mm")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DuelSummaryDto" Property="PromptSummary" Title="Prompt" Width="200px" />
                <RadzenDataGridColumn TItem="DuelSummaryDto" Title="Left Model" Width="180px">
                    <Template Context="d">
                        <span class="archive__model @(IsUnresolvedModelName(d.LeftModelName, d.LeftModelId) ? "archive__model--unresolved" : "")"
                              title="@d.LeftModelId">
                            @FormatModelName(d.LeftModelName, d.LeftModelId)
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DuelSummaryDto" Title="Right Model" Width="180px">
                    <Template Context="d">
                        <span class="archive__model @(IsUnresolvedModelName(d.RightModelName, d.RightModelId) ? "archive__model--unresolved" : "")"
                              title="@d.RightModelId">
                            @FormatModelName(d.RightModelName, d.RightModelId)
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DuelSummaryDto" Title="" Width="30px">
                    <Template Context="d">
                        @{ var chevron = d.DuelId == _selectedDuel?.DuelId ? "▾" : "›"; }
                        <span class="archive__expand-icon">@chevron</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DuelSummaryDto" Title="Verdict" Width="120px">
                    <Template Context="d">
                        @switch (d.Verdict)
                        {
                            case DuelVerdict.Left:
                                <span class="archive__verdict archive__verdict--win">⬅ Left</span>
                                break;
                            case DuelVerdict.Right:
                                <span class="archive__verdict archive__verdict--win">Right ➡</span>
                                break;
                            default:
                                <span class="archive__verdict archive__verdict--pending">No Verdict</span>
                                break;
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @if (_selectedDuel is not null)
        {
            <div class="archive__detail">
                <h2 class="archive__detail-title">Duel Details</h2>

                <div class="archive__detail-meta">
                    <p><strong>Prompt:</strong> @_selectedDuel.PromptSummary</p>
                    <p><strong>Left:</strong> @FormatModelName(_selectedDuel.LeftModelName, _selectedDuel.LeftModelId) &nbsp;&nbsp; <strong>Right:</strong> @FormatModelName(_selectedDuel.RightModelName, _selectedDuel.RightModelId)</p>
                    <p><strong>Started:</strong> @_selectedDuel.StartedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
                    @if (_selectedDuel.CompletedAt.HasValue)
                    {
                        <p><strong>Completed:</strong> @_selectedDuel.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
                    }
                    <p><strong>Winner:</strong> @(GetWinnerName(_selectedDuel))</p>
                </div>

                <div class="archive__detail-actions">
                    <RadzenButton
                        Text="🔁 Re-render"
                        ButtonStyle="ButtonStyle.Secondary"
                        Click="OnReRender"
                        class="archive__btn" />
                    <RadzenButton
                        Text="⚧ Re-Challenge"
                        ButtonStyle="ButtonStyle.Light"
                        Click="@GoToReChallenge"
                        class="archive__btn" />
                    <RadzenButton
                        Text="⬇ Export Lab Report"
                        ButtonStyle="ButtonStyle.Success"
                        Click="OnExportReport"
                        Disabled="@_exportBusy"
                        class="archive__btn" />
                    @if (_exportBusy)
                    {
                        <span class="archive__spinner" aria-label="Exporting…" title="Exporting…" />
                    }
                    @if (_selectedDuel.Verdict == DuelVerdict.Pending)
                    {
                        <RadzenButton
                            Text="⚔ Judge This Duel"
                            ButtonStyle="ButtonStyle.Primary"
                            Click="@GoToArena"
                            class="archive__btn" />
                    }
                </div>

                @if (_reRenderDuel is not null)
                {
                    <div class="archive__viewports">
                        <div class="archive__viewport-panel">
                            <SandboxedViewport
                                HtmlContent="@(_reRenderDuel.Results?.FirstOrDefault(r => r.ModelId == _selectedDuel.LeftModelId)?.HtmlOutputRaw ?? string.Empty)"
                                ModelName="@FormatModelName(_selectedDuel.LeftModelName, _selectedDuel.LeftModelId)"
                                IsLoser="@(_selectedDuel.Verdict == DuelVerdict.Right)" />
                        </div>
                        <div class="archive__viewport-panel">
                            <SandboxedViewport
                                HtmlContent="@(_reRenderDuel.Results?.FirstOrDefault(r => r.ModelId == _selectedDuel.RightModelId)?.HtmlOutputRaw ?? string.Empty)"
                                ModelName="@FormatModelName(_selectedDuel.RightModelName, _selectedDuel.RightModelId)"
                                IsLoser="@(_selectedDuel.Verdict == DuelVerdict.Left)" />
                        </div>
                    </div>
                }
            </div>
        }

        <div class="archive__pagination">
            <span class="archive__count">Showing @FilteredDuels().Count of @_duels.Count duel@(_duels.Count == 1 ? "" : "s")@(_hasMore ? " — more available" : " (all loaded)")</span>
            @if (_hasMore)
            {
                <RadzenButton Text="Load More" ButtonStyle="ButtonStyle.Light" Click="LoadMoreAsync" />
            }
        </div>
    }
</div>

@code {
    private List<DuelSummaryDto> _duels = [];
    private DuelSummaryDto? _selectedDuel;
    private DuelDto? _reRenderDuel;
    private bool _loading = true;
    private bool _exportBusy;
    private string? _error;
    private bool _hasMore;
    private const int PageSize = 20;

    private string _verdictFilter = "No Verdict";
    private string _qualityFilter = "All";
    private string _sortMode = "Newest";

    private List<DuelSummaryDto> FilteredDuels()
    {
        IEnumerable<DuelSummaryDto> query = _verdictFilter switch
        {
            "Won" => _duels.Where(d => d.Verdict is DuelVerdict.Left or DuelVerdict.Right),
            "No Verdict" => _duels.Where(d => d.Verdict == DuelVerdict.Pending),
            _ => _duels
        };

        if (_qualityFilter == "Quality80")
        {
            query = query.Where(d => d.AvgOutputQualityScore.HasValue && d.AvgOutputQualityScore.Value >= 80);
        }

        query = _sortMode == "Quality"
            ? query.OrderByDescending(d => d.AvgOutputQualityScore ?? -1).ThenByDescending(d => d.StartedAt)
            : query.OrderByDescending(d => d.StartedAt);

        return query.ToList();
    }

    private Func<DuelSummaryDto, string> _rowClassFn => GetRowClass;

    private void ResetFilters()
    {
        _verdictFilter = "All";
        _qualityFilter = "All";
        _sortMode = "Newest";
    }

    private void ToggleQualityFilter() =>
        _qualityFilter = _qualityFilter == "Quality80" ? "All" : "Quality80";

    private void ToggleSortMode() => _sortMode = _sortMode == "Quality" ? "Newest" : "Quality";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var results = await ApiClient.ListDuelsAsync(PageSize + 1);
            if (results is not null)
            {
                _hasMore = results.Count > PageSize;
                _duels = results.Take(PageSize).ToList();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load archive: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_duels.Count == 0) return;
        var oldest = _duels.Last();
        var before = oldest.StartedAt.ToString("yyyyMM");
        try
        {
            var more = await ApiClient.ListDuelsAsync(PageSize + 1, before);
            if (more is not null)
            {
                _hasMore = more.Count > PageSize;
                _duels.AddRange(more.Take(PageSize));
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load more: {ex.Message}";
        }
    }

    private async Task OnRowSelect(DuelSummaryDto duel)
    {
        _selectedDuel = duel;
        _reRenderDuel = null;
        StateHasChanged();
        await JS.InvokeVoidAsync("eval", "void 0"); // no-op (auto-scroll removed P4)
    }

    private async Task OnReRender()
    {
        if (_selectedDuel is null) return;
        try
        {
            _reRenderDuel = await ApiClient.GetDuelAsync(_selectedDuel.DuelId);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load duel: {ex.Message}";
        }
    }

    private async Task OnExportReport()
    {
        if (_selectedDuel is null) return;
        _exportBusy = true;
        try
        {
            var bytes = await ApiClient.DownloadReportAsync(_selectedDuel.DuelId);
            if (bytes is not null)
            {
                var base64 = Convert.ToBase64String(bytes);
                var fileName = $"lab-report-{_selectedDuel.DuelId}.html";
                await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "text/html", base64);
            }
        }
        catch (Exception ex)
        {
            _error = $"Export failed: {ex.Message}";
        }
        finally
        {
            _exportBusy = false;
        }
    }

    private static string GetWinnerName(DuelSummaryDto d)
    {
        if (d.WinnerModelId is null) return "—";
        if (d.WinnerModelId == d.LeftModelId) return FormatModelName(d.LeftModelName, d.LeftModelId);
        if (d.WinnerModelId == d.RightModelId) return FormatModelName(d.RightModelName, d.RightModelId);
        return ShortModelId(d.WinnerModelId);
    }

    private static bool IsUnresolvedModelName(string? modelName, string modelId)
    {
        if (string.IsNullOrWhiteSpace(modelName)) return true;
        var trimmed = modelName.Trim();
        return string.Equals(trimmed, modelId, StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatModelName(string? modelName, string modelId)
    {
        if (IsUnresolvedModelName(modelName, modelId))
            return "[Deleted Model]";

        return modelName!.Trim();
    }

    private static string ShortModelId(string? modelId)
    {
        if (string.IsNullOrWhiteSpace(modelId)) return "id: n/a";
        return modelId.Length <= 10 ? $"id: {modelId}" : $"id: {modelId[..4]}…{modelId[^4..]}";
    }

    private string GetRowClass(DuelSummaryDto d) =>
        d.DuelId == _selectedDuel?.DuelId ? "archive__row--selected" : string.Empty;

    private void GoToArena() => Nav.NavigateTo($"/arena/{_selectedDuel!.DuelId}");

    private void GoToReChallenge()
    {
        if (_selectedDuel is null) return;
        var prompt = Uri.EscapeDataString(_selectedDuel.PromptSummary);
        var leftId = Uri.EscapeDataString(_selectedDuel.LeftModelId);
        var rightId = Uri.EscapeDataString(_selectedDuel.RightModelId);
        Nav.NavigateTo($"/war-room?prompt={prompt}&leftModelId={leftId}&rightModelId={rightId}");
    }
}
