@page "/authentication/{action}"
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject NavigationManager Nav
@implements IDisposable

<RemoteAuthenticatorView Action="@Action">
    <LoggingIn>
        <div class="auth-spinner">
            <p>Redirecting to Microsoft login&hellip;</p>
        </div>
    </LoggingIn>
    <CompletingLoggingIn>
        <div class="auth-spinner">
            <p>Completing sign-in&hellip;</p>
        </div>
    </CompletingLoggingIn>
    <LogOut>
        <div class="auth-spinner">
            <p>Signing out&hellip;</p>
        </div>
    </LogOut>
    <CompletingLogOut>
        <div class="auth-spinner">
            <p>Completing sign-out&hellip;</p>
        </div>
    </CompletingLogOut>
</RemoteAuthenticatorView>

@code {
    [Parameter] public string Action { get; set; } = default!;

    private CancellationTokenSource? _callbackTimeoutCts;

    protected override void OnParametersSet()
    {
        _callbackTimeoutCts?.Cancel();
        _callbackTimeoutCts?.Dispose();
        _callbackTimeoutCts = null;

        if (string.Equals(Action, "login-callback", StringComparison.OrdinalIgnoreCase))
        {
            // MSAL 10+ uses PKCE authorization-code flow: code & state arrive as
            // query parameters (?code=...&state=...), not as a fragment. Older implicit
            // flow used the fragment. Accept either; only bail when there is truly no
            // auth payload at all (e.g. a stray direct navigation to this URL).
            var callbackUri = new Uri(Nav.Uri);
            var hasAuthPayload = !string.IsNullOrWhiteSpace(callbackUri.Fragment)
                              || callbackUri.Query.Contains("code=", StringComparison.OrdinalIgnoreCase)
                              || callbackUri.Query.Contains("error=", StringComparison.OrdinalIgnoreCase);
            if (!hasAuthPayload)
            {
                Nav.NavigateTo("/", forceLoad: true);
                return;
            }

            _callbackTimeoutCts = new CancellationTokenSource();
            _ = RecoverIfCallbackStallsAsync(_callbackTimeoutCts.Token);
        }
    }

    private async Task RecoverIfCallbackStallsAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(12), cancellationToken);

            if (!cancellationToken.IsCancellationRequested
                && new Uri(Nav.Uri).LocalPath.StartsWith("/authentication/login-callback", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/", forceLoad: true);
            }
        }
        catch (TaskCanceledException)
        {
            // Normal during successful callback navigation.
        }
    }

    public void Dispose()
    {
        _callbackTimeoutCts?.Cancel();
        _callbackTimeoutCts?.Dispose();
    }
}
