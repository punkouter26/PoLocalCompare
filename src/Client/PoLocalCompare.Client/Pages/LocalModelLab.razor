@page "/local-model-lab"
@using Microsoft.AspNetCore.Components.Rendering
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Microsoft.Extensions.Configuration
@using Microsoft.JSInterop
@using System.Text.Json
@implements IAsyncDisposable
@inject DuelApiClient ApiClient
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IConfiguration Configuration

<PageTitle>Local Model Lab — PoLocalCompare</PageTitle>

<div class="lab">
    <h1 class="lab__title">Local Model Lab</h1>
    <p class="lab__subtitle">
        Environment health · download detection · live inference diagnostics · speed benchmark
    </p>
    <div class="lab__view-toggle" role="tablist" aria-label="Lab detail level">
        <button class="lab__view-btn @(!_advancedMode ? "lab__view-btn--active" : "")"
                role="tab"
                aria-selected="@(!_advancedMode)"
                @onclick="() => _advancedMode = false">
            Quick Health
        </button>
        <button class="lab__view-btn @(_advancedMode ? "lab__view-btn--active" : "")"
                role="tab"
                aria-selected="@_advancedMode"
                @onclick="() => _advancedMode = true">
            Advanced Diagnostics
        </button>
    </div>
    @if (!_loading)
    {
        <p class="lab__mode-note">
            @if (IsCloudMode)
            {
                <span>☁ Cloud mode: Ollama service models are intentionally hidden; browser models run on demand from CDN/local sources.</span>
            }
            else
            {
                <span>🖥 Local mode: Ollama service models and local browser model assets are available.</span>
            }
        </p>
    }

    @* ── Environment strip ── *@
    <div class="lab__env @(_webGpu?.Supported == true ? "lab__env--ok" : "lab__env--warn")">
        <div class="lab__env-cluster lab__env-cluster--runtime">
            @if (_webGpu is null)
            {
                <span class="lab__env-item">⏳ Checking WebGPU…</span>
            }
            else if (_webGpu.Supported)
            {
                <span class="lab__env-item lab__env-item--ok">✅ WebGPU supported</span>
                <span class="lab__env-sep">·</span>
                <span class="lab__env-item">🖥 @(string.IsNullOrEmpty(_webGpu.Vendor) ? "WebGPU Device" : _webGpu.Vendor)@(string.IsNullOrEmpty(_webGpu.Architecture) ? "" : " · " + _webGpu.Architecture)</span>
            }
            else
            {
                <span class="lab__env-item lab__env-item--err">❌ WebGPU unavailable</span>
                <span class="lab__env-sep">·</span>
                <span class="lab__env-item lab__env-item--muted">@_webGpu.Reason</span>
            }

            <span class="lab__env-sep">·</span>

            @if (_webNn is null)
            {
                <span class="lab__env-item">⏳ Checking NPU…</span>
            }
            else if (_webNn.Supported)
            {
                <span class="lab__env-item lab__env-item--ok">🧠 NPU (@_webNn.DeviceType.ToUpperInvariant())</span>
            }
            else
            {
                <span class="lab__env-item lab__env-item--muted" title="@_webNn.Reason">🧠 NPU: not detected</span>
            }
        </div>

        <div class="lab__env-cluster lab__env-cluster--inventory">
            <span class="lab__env-item"><span class="lab__env-number">@_models.Count</span> registered</span>
            <span class="lab__env-item"><span class="lab__env-number">@_models.Count(m => m.IsDownloaded == true)</span> ready</span>
            <span class="lab__env-item"><span class="lab__env-number">@_models.Count(m => m.IsDownloaded == false)</span> missing assets</span>
            <span class="lab__env-item lab__env-stat--tested"><span class="lab__env-number">@_models.Count(m => m.Status == DiagStatus.Complete)</span> tested</span>
        </div>
    </div>
    @if (_statusRefreshing)
    {
        <p class="lab__status-note">⏳ Refreshing model availability and Ollama status…</p>
    }
    else if (_statusLastUpdatedUtc is not null)
    {
        <p class="lab__status-note">Last status check: @_statusLastUpdatedUtc.Value.ToLocalTime().ToString("HH:mm:ss")</p>
    }
    @if (_showLocalSetupHint)
    {
        <div class="lab__setup-hint">
            <p class="lab__setup-hint-title">First-time setup for a new PC</p>
            <p class="lab__setup-hint-copy">
                Local browser assets are not fully present yet (@_browserModelsUsingLocalAssets/@_browserModels.Count() local).
                Run <code>python SCRIPTS/download-models.py</code>, then click <strong>Refresh</strong>.
            </p>
        </div>
    }

    @* ── Prompt config ── *@
    <div class="lab__prompt-section">
        <label class="lab__prompt-label">Test Prompt</label>
        <textarea class="lab__prompt-input"
                  rows="4"
                  @bind="_testPrompt"
                  @bind:event="oninput"
                  placeholder="Enter the test prompt to run against each model…"></textarea>
        <div class="lab__btn-row">
            <button class="lab__btn lab__btn--primary"
                    @onclick="RunAllDownloaded"
                    disabled="@(_anyRunning || !_models.Any(m => m.IsDownloaded == true))">
                Run All Downloaded
            </button>
            <button class="lab__btn lab__btn--smol"
                    @onclick="RunSmolFamily"
                    title="@(!_models.Any(m => m.IsSmolLM2 && m.IsDownloaded == true) ? "Download SmolLM2-135M or SmolLM2-360M to enable" : "Race all downloaded SmolLM2 models")"
                    disabled="@(_anyRunning || !_models.Any(m => m.IsSmolLM2 && m.IsDownloaded == true))">
                SmolLM2 Race
            </button>
            <button class="lab__btn lab__btn--danger"
                    @onclick="CancelAll"
                    disabled="@(!_anyRunning)">
                Cancel All
            </button>
            <button class="lab__btn lab__btn--secondary"
                    @onclick="RefreshDownloadStatusAsync"
                    disabled="@_anyRunning">
                Refresh
            </button>
            <button class="lab__btn lab__btn--verify"
                    @onclick="VerifyAndGoAsync"
                    disabled="@(_anyRunning || !_models.Any(m => m.IsDownloaded == true))"
                    title="Run diagnostics on all downloaded models, then go to War Room">
                Verify and Go to War Room
            </button>
        </div>
        @if (_models.Any(m => m.IsSmolLM2)
             && !_models.Any(m => m.IsSmolLM2 && m.IsDownloaded is null)
             && !_models.Any(m => m.IsSmolLM2 && m.IsDownloaded == true))
        {
            <details class="lab__smol-hint-details">
                <summary class="lab__smol-hint-summary">💡 Enable race mode</summary>
                <p class="lab__smol-hint">Download SmolLM2-135M or SmolLM2-360M to enable race mode — run <code>python download-models.py</code></p>
            </details>
        }
        @if (!_loading && !_models.Any(m => m.IsDownloaded == true))
        {
            <p class="lab__no-models-hint">
                ⬇ No models downloaded yet.
                Run <code>python SCRIPTS/download-models.py</code> to get started,
                then click <strong>Refresh</strong>.
            </p>
        }
        @if (_cancelFeedback is not null)
        {
            <p class="lab__cancel-feedback">✓ @_cancelFeedback</p>
        }
    </div>

    @if (!_advancedMode)
    {
        <div class="lab__quick-panel">
            <h2 class="lab__quick-title">Quick Health Snapshot</h2>
            <p class="lab__quick-copy">Use this view for rapid readiness checks. Switch to Advanced Diagnostics for per-model traces, benchmark tables, and output matrices.</p>
            <div class="lab__quick-metrics">
                <div class="lab__quick-metric">
                    <span class="lab__quick-label">Registered</span>
                    <span class="lab__quick-value">@_models.Count</span>
                </div>
                <div class="lab__quick-metric">
                    <span class="lab__quick-label">Ready</span>
                    <span class="lab__quick-value">@_models.Count(m => m.IsDownloaded == true)</span>
                </div>
                <div class="lab__quick-metric">
                    <span class="lab__quick-label">Tested</span>
                    <span class="lab__quick-value">@_models.Count(m => m.Status == DiagStatus.Complete)</span>
                </div>
            </div>
            <button class="lab__btn lab__btn--secondary" @onclick="() => _advancedMode = true">Open Advanced Diagnostics</button>
        </div>
    }

    @* ── Model grid ── *@
    @if (_advancedMode)
    {
        if (_loading)
        {
            <p class="lab__loading">Loading model list…</p>
        }
        else if (_models.Count == 0)
        {
            <p class="lab__empty">No local models registered. Register one from the War Room first.</p>
        }
        else
        {
        var _familyGroups = _models
            .GroupBy(m => GetModelFamily(m))
            .OrderBy(g => FamilyOrder(g.Key));
        foreach (var _family in _familyGroups)
        {
            <div class="lab__family-group">
                <div class="lab__family-header">
                    <span class="lab__family-name">@_family.Key</span>
                    <span class="lab__family-count">@_family.Count() model@(_family.Count() == 1 ? "" : "s")</span>
                </div>
                <div class="lab__grid">
                @foreach (var state in _family)
                {
                    <LabModelCard State="state"
                                  WebGpuSupported="@(_webGpu?.Supported)"
                                  OnRun="RunSingleAsync"
                                  OnCancel="CancelSingleAsync"
                                  OnDownload="DownloadModelAsync"
                                  OnToggleOutput="@(_ => StateHasChanged())" />
                }
                </div>
            </div>
        }

            @* ── Summary: shown when ≥ 1 model is tested ── *@
            @if (_testedModels.Count() >= 1)
            {
            var ranked = _testedModels.OrderByDescending(m => ValueScore(m)).ToList();

            <div class="lab__summary">
                <h2 class="lab__summary-title">📊 Benchmark Results</h2>

                @* Rankings table *@
                <div class="lab__table-wrap">
                    <table class="lab__table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Model</th>
                                <th>VRAM</th>
                                <th>Load time</th>
                                <th>1st token</th>
                                <th class="lab__th--speed">Tok/s ↑</th>
                                <th class="lab__th--value" title="Tok/s × completeness — rewards models that are fast AND finish the task">Value ↑</th>
                                <th>Tokens out</th>
                                <th>Completeness</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < ranked.Count; i++)
                            {
                                var m = ranked[i];
                                var medal = i switch { 0 => "🥇", 1 => "🥈", 2 => "🥉", _ => (i + 1).ToString() };
                                var quality = CompletenessScore(m);

                                <tr class="@(i == 0 ? "lab__tr--winner" : "")">
                                    <td>@medal</td>
                                    <td>@m.Model.DisplayName</td>
                                    <td>@(m.VramMb > 0 ? m.VramLabel : "—")</td>
                                    <td>@FormatMs(m.LoadMs)</td>
                                    <td>@FormatMs(m.FirstTokenMs)</td>
                                    <td class="lab__td--speed">@m.TokensPerSec</td>
                                    <td class="lab__td--value @(i == 0 ? "lab__td--value--best" : "")">@ValueScore(m)</td>
                                    <td>@m.TotalTokens</td>
                                    <td>
                                        <div class="lab__quality-wrap">
                                            <div class="lab__quality-bar lab__quality-bar--@(quality >= 70 ? "good" : quality >= 30 ? "fair" : "poor")" style="width: @quality%"></div>
                                            <span class="lab__quality-pct">@quality%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="lab__quality-note">
                    ✱ Completeness = tokens generated ÷ 256 max-token cap. Value = tok/s × completeness — the best single number for "fast enough and finishes the task".
                </p>

                @* Speed scatter (SVG) — shown when ≥ 2 models have results *@
                @if (ranked.Count >= 2)
                {
                    var maxTps = ranked.Max(m => m.TokensPerSec);
                    var bestVs = ranked.Max(m => ValueScore(m));
                    <div class="lab__scatter-wrap">
                        <h3 class="lab__scatter-title">Speed vs. Output Completeness</h3>
                        @BuildScatterSvg(ranked, maxTps, bestVs)
                    </div>
                }

                @* Capability matrix ── fixed prompts, shown only if all were tested with default prompt *@
                <div class="lab__matrix">
                    <h3 class="lab__matrix-title">💬 Output Preview — Side by Side</h3>
                    <div class="lab__matrix-grid" style="grid-template-columns: repeat(@ranked.Count, 1fr)">
                        @foreach (var m in ranked)
                        {
                            <div class="lab__matrix-col">
                                <div class="lab__matrix-model">@m.Model.DisplayName</div>
                                <div class="lab__matrix-score">
                                    <span class="lab__matrix-tps">@m.TokensPerSec tok/s</span>
                                </div>
                                <pre class="lab__matrix-output">@TruncateOutput(m.Output, 400)</pre>
                            </div>
                        }
                    </div>
                </div>
            </div>
            }
        }
    }
</div>

@code {
    // ── WebGPU info ──────────────────────────────────────────────────────────
    private sealed class WebGpuInfo
    {
        public bool Supported { get; set; }
        public string Vendor { get; set; } = "";
        public string Architecture { get; set; } = "";
        public string Device { get; set; } = "";
        public string Reason { get; set; } = "";
    }

    // ── WebNN / NPU info ─────────────────────────────────────────────────────
    private sealed class WebNnInfo
    {
        public bool Supported { get; set; }
        public string DeviceType { get; set; } = "";
        public string Reason { get; set; } = "";
    }

    private sealed class BrowserModelAvailability
    {
        public bool Available { get; set; }
        public string Source { get; set; } = "";
    }

    // ── Fields ───────────────────────────────────────────────────────────────
    private bool _loading = true;
    private bool _statusRefreshing;
    private DateTime? _statusLastUpdatedUtc;
    private List<ModelDiagState> _models = [];
    private WebGpuInfo? _webGpu;
    private WebNnInfo? _webNn;
    private string[] _browserModelCdnBaseUrlTemplates = [];
    private string _testPrompt =
        "Hello! Please complete all three tasks:\n" +
        "1) What is 17 × 8?\n" +
        "2) Write a Python one-liner to reverse a string.\n" +
        "3) In one sentence: what is recursion in programming?";
    private DotNetObjectReference<LocalModelLab>? _selfRef;

    private bool _runAllCancelled;
    private string? _cancelFeedback;
    private bool _advancedMode;

    private bool _anyRunning =>
        _models.Any(m => m.Status is DiagStatus.Loading or DiagStatus.Generating or DiagStatus.Checking);

    private IEnumerable<ModelDiagState> _testedModels =>
        _models.Where(m => m.Status == DiagStatus.Complete);

    private IEnumerable<ModelDiagState> _browserModels =>
        _models.Where(m => !m.IsOllamaModel);

    private int _browserModelsUsingLocalAssets =>
        _browserModels.Count(m => m.IsDownloaded == true && !m.UsesCdnAssets);

    private bool _showLocalSetupHint =>
        !_loading && _browserModels.Any() && _browserModelsUsingLocalAssets < _browserModels.Count();

    private bool IsCloudMode => _models.Count > 0 && !_models.Any(m => m.IsOllamaModel);

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _selfRef = DotNetObjectReference.Create(this);
        var primary = Configuration["BrowserModels:PrimaryCdnBaseUrlTemplate"]
            ?? Configuration["BrowserModels:CdnBaseUrlTemplate"];
        var backup = Configuration["BrowserModels:BackupCdnBaseUrlTemplate"];
        _browserModelCdnBaseUrlTemplates = [
            ..new[] { primary, backup }
                .Where(v => !string.IsNullOrWhiteSpace(v))
                .Select(v => v!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
        ];
        var apiModels = await ApiClient.GetModelsAsync();
        _models = (apiModels ?? [])
            .Where(m =>
                (m.ModelType == ModelType.Local      && !string.IsNullOrWhiteSpace(m.WebLlmModelId)) ||
                (m.ModelType == ModelType.LocalService && !string.IsNullOrWhiteSpace(m.ApiEndpointRef)))
            .Select(m => new ModelDiagState { Model = m })
            .OrderBy(s => s.IsOllamaModel ? 0 : s.VramMb == 0 ? int.MaxValue : s.VramMb)
            .ToList();
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _webGpu = await JS.InvokeAsync<WebGpuInfo>("checkWebGpu");
        _webNn  = await JS.InvokeAsync<WebNnInfo>("checkWebNn");
        StateHasChanged();

        await RefreshDownloadStatusAsync();
        await RestoreLabResultsAsync();
    }

    // ── JS Callbacks ─────────────────────────────────────────────────────────
    [JSInvokable]
    public Task OnDiagStep(string diagId, string step, string detail, int progress)
    {
        return InvokeAsync(() =>
        {
            var state = FindById(diagId);
            if (state is null) return;
            state.Status = step == "Loading" ? DiagStatus.Loading : DiagStatus.Generating;
            state.StepDetail = detail;
            state.LoadProgress = progress;
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task OnDiagResult(string diagId, int loadMs, int firstTokenMs,
                             int tokensPerSec, int totalTokens, string output, string? error,
                             bool warmCache = false)
    {
        return InvokeAsync(() =>
        {
            var state = FindById(diagId);
            if (state is null) return;

            if (error is not null)
            {
                state.Status = DiagStatus.Error;
                state.ErrorMessage = error;
                state._completion.TrySetResult(false);
            }
            else
            {
                state.Status       = DiagStatus.Complete;
                state.LoadMs       = loadMs;
                state.FirstTokenMs = firstTokenMs;
                state.TokensPerSec = tokensPerSec;
                state.TotalTokens  = totalTokens;
                state.Output       = output;
                state.WarmCache    = warmCache;
                state.ShowOutput   = true;
                state._completion.TrySetResult(true);
                _ = JS.InvokeVoidAsync("saveLabResult", state.Model.ModelId,
                    new { loadMs, firstTokenMs, tokensPerSec, totalTokens, output });
                _ = JS.InvokeVoidAsync("pulseTestedCount");
            }
            StateHasChanged();
        });
    }

    // ── Actions ───────────────────────────────────────────────────────────────
    private async Task RefreshDownloadStatusAsync()
    {
        _statusRefreshing = true;
        foreach (var s in _models) s.IsDownloaded = null;
        StateHasChanged();

        try
        {
            // Fetch Ollama availability once upfront
            IReadOnlyList<string> ollamaAvailable = [];
            if (_models.Any(m => m.IsOllamaModel))
                ollamaAvailable = await ApiClient.GetOllamaAvailableModelsAsync();

            var results = await Task.WhenAll(_models.Select(async state =>
            {
                if (state.IsOllamaModel)
                {
                    var modelRef = state.Model.ApiEndpointRef ?? "";
                    bool available = ollamaAvailable.Any(m =>
                        m.Equals(modelRef, StringComparison.OrdinalIgnoreCase) ||
                        m.StartsWith(modelRef + ":", StringComparison.OrdinalIgnoreCase));
                    state.AssetSource = available ? "local" : "";
                    return (state, available);
                }

                BrowserModelAvailability? availability = null;
                for (int attempt = 0; attempt < 3 && availability is null; attempt++)
                {
                    try
                    {
                        availability = await JS.InvokeAsync<BrowserModelAvailability>(
                            "checkModelFile",
                            state.Model.WebLlmModelId ?? string.Empty,
                            _browserModelCdnBaseUrlTemplates);
                    }
                    catch
                    {
                        if (attempt < 2) await Task.Delay(500);
                    }
                }

                state.AssetSource = availability?.Source ?? "";
                return (state, availability?.Available ?? false);
            }));

            foreach (var (state, downloaded) in results)
                state.IsDownloaded = downloaded;
        }
        finally
        {
            _statusRefreshing = false;
            _statusLastUpdatedUtc = DateTime.UtcNow;
            StateHasChanged();
        }
    }

    private async Task DownloadModelAsync(string webLlmModelId)
    {
        var state = _models.FirstOrDefault(m => m.Model.WebLlmModelId == webLlmModelId);
        if (state is null) return;
        state.Downloading = true;
        StateHasChanged();

        var started = await ApiClient.RequestModelDownloadAsync(webLlmModelId);
        if (!started)
        {
            state.Downloading = false;
            StateHasChanged();
        }
        // Leave Downloading = true; user clicks Refresh when they want to re-check status
    }

    private async Task RunSingleAsync(ModelDiagState state)
    {
        if (state.IsDownloaded != true) return;

        if (state.IsOllamaModel)
        {
            await RunOllamaAsync(state);
            return;
        }

        state.Status       = DiagStatus.Loading;
        state.LoadProgress = 0;
        state.StepDetail   = "Starting worker…";
        state.ErrorMessage = null;
        state.Output       = "";
        state.WarmCache    = false;
        state.ResetCompletion();
        StateHasChanged();

        await JS.InvokeVoidAsync(
            "runModelDiag",
            _selfRef,
            state.Model.ModelId,
            state.Model.WebLlmModelId,
            _testPrompt,
            _browserModelCdnBaseUrlTemplates);
    }

    private async Task RunOllamaAsync(ModelDiagState state)
    {
        state.Status       = DiagStatus.Loading;
        state.LoadProgress = 0;
        state.StepDetail   = "Running Ollama inference…";
        state.ErrorMessage = null;
        state.Output       = "";
        state.ResetCompletion();
        StateHasChanged();

        var result = await ApiClient.BenchmarkOllamaModelAsync(state.Model.ApiEndpointRef!, _testPrompt);

        await InvokeAsync(() =>
        {
            if (state.Status == DiagStatus.Cancelled) return;

            if (result is null || result.IsFailure)
            {
                state.Status       = DiagStatus.Error;
                state.ErrorMessage = result?.FailureReason ?? "Ollama unreachable";
                state._completion.TrySetResult(false);
            }
            else
            {
                state.Status       = DiagStatus.Complete;
                state.LoadMs       = result.LoadMs;
                state.FirstTokenMs = result.FirstTokenMs;
                state.TokensPerSec = result.TokensPerSec;
                state.TotalTokens  = result.TotalTokens;
                state.Output       = result.Output;
                state.ShowOutput   = true;
                state._completion.TrySetResult(true);
            }
            StateHasChanged();
        });
    }

    private async Task RunAllDownloaded()
    {
        _runAllCancelled = false;
        var targets = _models
            .Where(m => m.IsDownloaded == true && m.Status is DiagStatus.Idle or DiagStatus.Complete or DiagStatus.Error or DiagStatus.Cancelled)
            .ToList();
        foreach (var s in targets)
        {
            if (_runAllCancelled) break;
            await RunSingleAsync(s);
            await s._completion.Task;
        }
    }

    // UX#10: Verify & Go — run all downloaded models then navigate to War Room
    private async Task VerifyAndGoAsync()
    {
        await RunAllDownloaded();
        Nav.NavigateTo("/war-room");
    }

    private async Task RunSmolFamily()
    {
        _runAllCancelled = false;
        var smol = _models
            .Where(m => m.IsSmolLM2 && m.IsDownloaded == true && m.Status is DiagStatus.Idle or DiagStatus.Complete or DiagStatus.Error or DiagStatus.Cancelled)
            .ToList();
        foreach (var s in smol)
        {
            if (_runAllCancelled) break;
            await RunSingleAsync(s);
            await s._completion.Task;
        }
    }

    private async Task CancelAll()
    {
        _runAllCancelled = true;
        await JS.InvokeVoidAsync("cancelAllModelDiags");
        foreach (var s in _models.Where(m => m.Status is DiagStatus.Loading or DiagStatus.Generating))
        {
            s.Status = DiagStatus.Cancelled;
            s._completion.TrySetResult(false);
        }
        _cancelFeedback = "All workers stopped";
        StateHasChanged();
        await Task.Delay(2500);
        _cancelFeedback = null;
        StateHasChanged();
    }

    private async Task CancelSingleAsync(ModelDiagState state)
    {
        await JS.InvokeVoidAsync("cancelModelDiag", state.Model.ModelId);
        state.Status = DiagStatus.Cancelled;
        StateHasChanged();
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private ModelDiagState? FindById(string modelId) =>
        _models.FirstOrDefault(m => m.Model.ModelId == modelId);

    private static string GetModelFamily(ModelDiagState s)
    {
        if (s.IsOllamaModel) return "🦙 Ollama";
        var id = s.Model.WebLlmModelId;
        return id switch
        {
            _ when id?.StartsWith("SmolLM2",  StringComparison.OrdinalIgnoreCase) == true => "SmolLM2",
            _ when id?.StartsWith("Llama",    StringComparison.OrdinalIgnoreCase) == true => "Llama",
            _ when id?.StartsWith("Qwen",     StringComparison.OrdinalIgnoreCase) == true => "Qwen",
            _ when id?.StartsWith("Phi",      StringComparison.OrdinalIgnoreCase) == true => "Phi",
            _ when id?.StartsWith("gemma",    StringComparison.OrdinalIgnoreCase) == true => "Gemma",
            _ when id?.StartsWith("Mistral",  StringComparison.OrdinalIgnoreCase) == true => "Mistral",
            _ when id?.StartsWith("DeepSeek", StringComparison.OrdinalIgnoreCase) == true => "DeepSeek",
            _                                                                               => "Other",
        };
    }

    private static int FamilyOrder(string family) => family switch
    {
        "SmolLM2"   => 0,
        "Llama"     => 1,
        "Qwen"      => 2,
        "Phi"       => 3,
        "Gemma"     => 4,
        "Mistral"   => 5,
        "DeepSeek"  => 6,
        "🦙 Ollama" => 90,
        _           => 99,
    };

    private async Task RestoreLabResultsAsync()
    {
        try
        {
            var saved = await JS.InvokeAsync<Dictionary<string, JsonElement>>("loadLabResults");
            if (saved is null || saved.Count == 0) return;
            await InvokeAsync(() =>
            {
                foreach (var (modelId, data) in saved)
                {
                    var state = _models.FirstOrDefault(m => m.Model.ModelId == modelId);
                    if (state is null) continue;
                    state.Status       = DiagStatus.Complete;
                    state.LoadMs       = data.TryGetProperty("loadMs",       out var lm)  ? lm.GetInt32()  : 0;
                    state.FirstTokenMs = data.TryGetProperty("firstTokenMs", out var ft)  ? ft.GetInt32()  : 0;
                    state.TokensPerSec = data.TryGetProperty("tokensPerSec", out var tps) ? tps.GetInt32() : 0;
                    state.TotalTokens  = data.TryGetProperty("totalTokens",  out var tt)  ? tt.GetInt32()  : 0;
                    state.Output       = data.TryGetProperty("output",       out var o)   ? o.GetString() ?? "" : "";
                    state.ShowOutput   = false;
                }
                StateHasChanged();
            });
        }
        catch { /* sessionStorage not available or corrupted — ignore */ }
    }

    private static string FormatMs(int ms) => ms < 0 ? "—" : ms < 1000 ? $"{ms} ms" : $"{ms / 1000.0:F1} s";

    private static int CompletenessScore(ModelDiagState m) =>
        m.TotalTokens <= 0 ? 0 : Math.Min(100, (int)((m.TotalTokens / 256.0) * 100));

    private static int ValueScore(ModelDiagState m) =>
        (int)Math.Round(m.TokensPerSec * (CompletenessScore(m) / 100.0));

    private static string TruncateOutput(string text, int maxLen) =>
        text.Length <= maxLen ? text : text[..maxLen] + "\n…";

    private static MarkupString BuildScatterSvg(List<ModelDiagState> ranked, int maxTps, int bestVs)
    {
        const int W = 600, H = 290, PadL = 62, PadB = 46, PadR = 32, PadT = 28;
        int plotW = W - PadL - PadR;
        int plotH = H - PadT - PadB;
        var sb = new System.Text.StringBuilder();

        sb.Append($"""<svg class="lab__scatter" viewBox="0 0 {W} {H}" xmlns="http://www.w3.org/2000/svg">""");

        // Sweet-spot zone (fast AND complete — top-right quadrant)
        double szX = PadL + plotW * 0.55;
        double szH = plotH * 0.42;
        sb.Append($"""<rect x="{szX:F0}" y="{PadT}" width="{(W - PadR - szX):F0}" height="{szH:F0}" fill="#0f2e1a" stroke="#1e5c30" stroke-width="1" opacity="0.9" rx="4"/>""");
        sb.Append($"""<text x="{W - PadR - 7:F0}" y="{PadT + 14:F0}" class="lab__scatter-zone-label" text-anchor="end">sweet spot ✦</text>""");

        // Grid lines + Y-axis tick labels
        for (int g = 1; g <= 4; g++)
        {
            double gy = PadT + plotH - g / 5.0 * plotH;
            sb.Append($"""<line x1="{PadL}" y1="{gy:F1}" x2="{W - PadR}" y2="{gy:F1}" stroke="#26264a" stroke-width="1"/>""");
            sb.Append($"""<text x="{PadL - 4}" y="{gy + 3.5:F1}" class="lab__scatter-tick" text-anchor="end">{g * 20}%</text>""");
        }

        // X-axis tick labels
        if (maxTps > 0)
        {
            for (int t = 1; t <= 4; t++)
            {
                double tx = PadL + t / 4.0 * plotW;
                int tv = (int)Math.Round(maxTps * t / 4.0);
                sb.Append($"""<text x="{tx:F1}" y="{PadT + plotH + 14:F1}" class="lab__scatter-tick" text-anchor="middle">{tv}</text>""");
            }
        }

        // Axes
        sb.Append($"""<line x1="{PadL}" y1="{PadT}" x2="{PadL}" y2="{PadT + plotH}" stroke="#5a5a80" stroke-width="1.5"/>""");
        sb.Append($"""<line x1="{PadL}" y1="{PadT + plotH}" x2="{W - PadR}" y2="{PadT + plotH}" stroke="#5a5a80" stroke-width="1.5"/>""");
        sb.Append($"""<text x="{W / 2}" y="{H - 4}" class="lab__scatter-axis-label" text-anchor="middle">Tokens / sec →</text>""");
        sb.Append($"""<text x="12" y="{PadT + plotH / 2}" class="lab__scatter-axis-label" text-anchor="middle" transform="rotate(-90, 12, {PadT + plotH / 2})">Completeness</text>""");

        // Compute all point data, sorted by x so label nudging works left-to-right
        var pts = ranked
            .Select(m =>
            {
                int quality = CompletenessScore(m);
                int vs      = ValueScore(m);
                double cx   = maxTps > 0 ? PadL + (m.TokensPerSec / (double)maxTps) * plotW : PadL;
                double cy   = PadT + plotH - quality / 100.0 * plotH;
                bool isRec  = vs == bestVs;
                string dot  = quality >= 70 ? "lab__scatter-dot--good"
                            : quality >= 30 ? "lab__scatter-dot--fair"
                            :                 "lab__scatter-dot--poor";
                string name = System.Net.WebUtility.HtmlEncode(
                    m.Model.DisplayName.Length > 16 ? m.Model.DisplayName[..13] + "…" : m.Model.DisplayName);
                return (m, quality, cx, cy, vs, isRec, dot, name);
            })
            .OrderBy(p => p.cx)
            .ToList();

        // Label placement — nudge overlapping labels downward
        var placed = new List<(double lx, double ly)>();
        foreach (var (_, _, cx, cy, _, _, _, _) in pts)
        {
            double ly = cy - 14;
            if (ly < PadT + 8) ly = cy + 20;
            for (int iter = 0; iter < 10; iter++)
            {
                bool hit = false;
                foreach (var (plx, ply) in placed)
                {
                    if (Math.Abs(cx - plx) < 54 && Math.Abs(ly - ply) < 13)
                    {
                        ly += 14;
                        if (ly > PadT + plotH + 14) ly = cy - 14 - iter * 12;
                        hit = true;
                        break;
                    }
                }
                if (!hit) break;
            }
            placed.Add((cx, ly));
        }

        // Render
        for (int i = 0; i < pts.Count; i++)
        {
            var (_, quality, cx, cy, vs, isRec, dot, name) = pts[i];
            var (lx, ly) = placed[i];

            if (isRec)
            {
                sb.Append($"""<circle cx="{cx:F1}" cy="{cy:F1}" r="13" fill="none" stroke="#22c55e" stroke-width="1.5" opacity="0.4"/>""");
                sb.Append($"""<circle cx="{cx:F1}" cy="{cy:F1}" r="8" class="{dot} lab__scatter-dot--recommended"/>""");
                sb.Append($"""<text x="{lx:F1}" y="{ly - 11:F1}" class="lab__scatter-rec-label" text-anchor="middle">⭐ Recommended</text>""");
            }
            else
            {
                sb.Append($"""<circle cx="{cx:F1}" cy="{cy:F1}" r="6" class="{dot}"/>""");
            }

            // Leader line when label is far from dot
            if (Math.Abs(ly - cy) > 20)
            {
                double lineY0 = cy + (ly > cy ? 7 : -7);
                sb.Append($"""<line x1="{cx:F1}" y1="{lineY0:F1}" x2="{lx:F1}" y2="{ly + 2:F1}" stroke="#4a4a78" stroke-width="1"/>""");
            }

            sb.Append($"""<text x="{lx:F1}" y="{ly:F1}" class="lab__scatter-model-label" text-anchor="middle">{name}</text>""");
        }

        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }

    // ── Dispose ───────────────────────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("cancelAllModelDiags"); } catch { /* ignore if JS context gone */ }
        _selfRef?.Dispose();
    }
