@page "/leaderboard"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using Radzen

<PageTitle>Leaderboard — LLM Duel Arena</PageTitle>

@using Radzen.Blazor
@inject DuelApiClient ApiClient

<MockDataBanner />

<div class="leaderboard">
    <h1 class="leaderboard__title">Leaderboard</h1>

    <div class="leaderboard__controls">
        <span class="leaderboard__sort-label">Sort by:</span>
        <RadzenButton
            Text="ELO"
            Click="@(() => SetSortAsync("Elo"))"
            ButtonStyle="@(IsGreenSort ? ButtonStyle.Light : ButtonStyle.Primary)"
            Size="ButtonSize.Small"
            class="leaderboard__sort-btn" />
        <RadzenButton
            Text="Green Score"
            Click="@(() => SetSortAsync("GreenScore"))"
            ButtonStyle="@(IsGreenSort ? ButtonStyle.Primary : ButtonStyle.Light)"
            Size="ButtonSize.Small"
            class="leaderboard__sort-btn" />
    </div>

    @if (_loading)
    {
        <p class="leaderboard__status">Loading leaderboard...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="leaderboard__error">@_error</p>
    }
    else
    {
        @if (_entries.Count > 0 && _entries.All(e => e.DuelCount == 0))
        {
            <div class="leaderboard__empty-state">
                <p>&#x1F3C6; No duels have been fought yet.</p>
                <a href="/war-room" class="leaderboard__cta">&#x2694;&#xFE0F; Head to the War Room to start one!</a>
            </div>
        }
        <RadzenDataGrid Data="@_entries" TItem="LeaderboardEntryDto" RowSelect="OnRowSelect" Class="leaderboard__grid leaderboard__grid--scrollable">
            <Columns>
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="Rank" Title="Rank" Width="80px" />
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="DisplayName" Title="Model Name" Width="200px" />
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="CurrentElo" Title="ELO" Width="120px">
                    <Template Context="entry">
                        @((int)Math.Round(entry.CurrentElo))
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="DuelCount" Title="Duels" Width="90px" />
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Title="W/L (Win %)" Width="140px">
                    <Template Context="entry">
                        @{
                            var losses = Math.Max(entry.DuelCount - entry.WinCount, 0);
                            var winPct = entry.DuelCount > 0 ? (entry.WinCount * 100.0 / entry.DuelCount) : 0;
                            var pctStr = entry.DuelCount > 0 ? $" ({winPct:F0}%)" : "";
                        }
                        @($"{entry.WinCount}/{losses}{pctStr}")
                    </Template>
                </RadzenDataGridColumn>
                @if (_entries.Any(e => e.GreenScoreAvg.HasValue))
                {
                    <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="GreenScoreAvg" Title="Green Score" Width="140px">
                        <Template Context="entry">
                            @if (entry.GreenScoreAvg.HasValue)
                            {
                                @entry.GreenScoreAvg.Value.ToString("F1")
                            }
                            else
                            {
                                <span style="color: var(--rz-text-secondary-color);">—</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                }
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Title="ELO Trend (last 20)" Width="170px">
                    <Template Context="entry">
                        @if (entry.EloSparkline.Count > 1)
                        {
                            <EloSparkline Values="entry.EloSparkline" />
                        }
                        else
                        {
                            <span title="No duel history yet" style="color: var(--rz-text-secondary-color); font-style: italic;">No duels yet</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @if (_selected is not null)
        {
            <div class="leaderboard__killlist-panel">
                <div class="leaderboard__killlist-header">
                    <span class="leaderboard__killlist-title">@KillListPanelText</span>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                        Click="CloseKillList" class="leaderboard__killlist-close" />
                </div>
                @if (_killListLoading)
                {
                    <p class="leaderboard__status">Loading kill list...</p>
                }
                else if (_killListError is not null)
                {
                    <p class="leaderboard__error">@_killListError</p>
                }
                else if (_killList.Count == 0)
                {
                    <p class="leaderboard__status">No head-to-head history yet.</p>
                }
                else
                {
                    <RadzenDataGrid Data="@_killList" TItem="HeadToHeadDto">
                        <Columns>
                            <RadzenDataGridColumn TItem="HeadToHeadDto" Property="OpponentName" Title="Opponent" />
                            <RadzenDataGridColumn TItem="HeadToHeadDto" Title="W/L" Width="100px">
                                <Template Context="row">@row.Wins/@row.Losses</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="HeadToHeadDto" Title="Win %" Width="90px">
                                <Template Context="row">
                                    @{
                                        var total = row.Wins + row.Losses;
                                        var pct = total > 0 ? (row.Wins * 100.0 / total) : 0;
                                    }
                                    @(total > 0 ? $"{pct:F0}%" : "-")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="HeadToHeadDto" Title="Last Duel" Width="170px">
                                <Template Context="row">@row.LastDuelAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>
        }
    }
</div>

@code {
    private List<LeaderboardEntryDto> _entries = [];
    private bool _loading = true;
    private string? _error;

    private LeaderboardEntryDto? _selected;
    private readonly List<HeadToHeadDto> _killList = [];
    private bool _killListLoading;
    private string? _killListError;

    private string _sortBy = "Elo";
    private bool IsGreenSort => string.Equals(_sortBy, "GreenScore", StringComparison.OrdinalIgnoreCase);
    private string KillListPanelText => _selected is null ? "Kill List" : $"Kill List: {_selected.DisplayName}";

    protected override async Task OnInitializedAsync()
    {
        await LoadLeaderboardAsync();
    }

    private async Task SetSortAsync(string sortBy)
    {
        if (string.Equals(_sortBy, sortBy, StringComparison.OrdinalIgnoreCase))
            return;
        _sortBy = sortBy;
        await LoadLeaderboardAsync();
    }

    private void CloseKillList()
    {
        _selected = null;
        _killList.Clear();
        _killListError = null;
    }

    private async Task LoadLeaderboardAsync()
    {
        _loading = true;
        _error = null;
        _selected = null;
        _killList.Clear();
        _killListError = null;

        try
        {
            var rows = await ApiClient.GetLeaderboardAsync(_sortBy);
            _entries = rows?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _error = $"Failed to load leaderboard: {ex.Message}";
            _entries = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRowSelect(LeaderboardEntryDto row)
    {
        _selected = row;
        _killListLoading = true;
        _killListError = null;
        _killList.Clear();

        try
        {
            var rows = await ApiClient.GetKillListAsync(row.ModelId);
            if (rows is not null)
            {
                _killList.AddRange(rows);
            }
        }
        catch (Exception ex)
        {
            _killListError = $"Failed to load kill list: {ex.Message}";
        }
        finally
        {
            _killListLoading = false;
        }
    }
}

<style>
    .leaderboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem;
        color: #e5e7eb;
    }

    .leaderboard__title {
        font-size: 1.8rem;
        font-weight: 800;
        margin-bottom: 1rem;
        color: #f9fafb;
    }

    .leaderboard__controls {
        margin-bottom: 1rem;
        display: flex;
        justify-content: flex-end;
    }

    .leaderboard__grid {
        margin-bottom: 1rem;
    }

    .leaderboard__grid--scrollable {
        overflow-x: auto;
    }

    .leaderboard__empty-state {
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 8px;
        padding: 20px 24px;
        margin-bottom: 1.5rem;
        text-align: center;
        color: #9ca3af;
    }

    .leaderboard__cta {
        display: inline-block;
        margin-top: 8px;
        color: #22c55e;
        font-weight: 600;
        text-decoration: none;
    }

    .leaderboard__cta:hover {
        text-decoration: underline;
    }

    .leaderboard__killlist-panel {
        background: #0b0b0b;
        border: 1px solid #2a2a2a;
    }

    .leaderboard__status {
        color: #9ca3af;
    }

    .leaderboard__error {
        color: #ef4444;
        font-weight: 600;
    }
</style>
