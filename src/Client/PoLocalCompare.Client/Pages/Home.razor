@page "/"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Radzen
@using Radzen.Blazor
@inject DuelApiClient ApiClient

<PageTitle>LLM Duel Arena</PageTitle>

<div class="home">
    @* ── Compact Header (C1) ── *@
    <div class="home__header">
        <h1 class="home__title">⚔ LLM Duel Arena</h1>
        <a href="/war-room" class="rz-button rz-button-md rz-primary">⚔ New Duel</a>
    </div>

    @* ── Stat Strip (C1) ── *@
    <div class="home__stats">
        <div class="home__stat">
            <span class="home__stat-value">@_totalDuels</span>
            <span class="home__stat-label">Duels Fought</span>
        </div>
        <div class="home__stat">
            <span class="home__stat-value">@_activeModels</span>
            <span class="home__stat-label">Active Models</span>
        </div>
        <div class="home__stat">
            <span class="home__stat-value">@(_topModel ?? "—")</span>
            <span class="home__stat-label">Top Ranked</span>
        </div>
        <div class="home__stat @(_unratedCount > 0 ? "home__stat--alert" : "")">
            <span class="home__stat-value">@_unratedCount</span>
            <span class="home__stat-label">Need Verdict</span>
        </div>
    </div>

    @* ── Recent Duels (O1 — pending links to arena) ── *@
    @if (_recentDuels.Count > 0)
    {
        <div class="home__recent">
            <h2 class="home__recent-title">Recent Duels</h2>
            <div class="home__recent-list">
                @foreach (var d in _recentDuels)
                {
                    var isPending = d.Verdict == DuelVerdict.Pending;
                    var href = isPending ? $"/arena/{d.DuelId}" : "/archive";
                    <a href="@href" class="home__recent-item @(isPending ? "home__recent-item--unrated" : "")">
                        <span class="home__recent-prompt">@d.PromptSummary</span>
                        <span class="home__recent-vs">@d.LeftModelName <em>vs</em> @d.RightModelName</span>
                        @if (d.Verdict == DuelVerdict.Left)
                        {
                            <span class="home__recent-winner">🏆 @d.LeftModelName</span>
                        }
                        else if (d.Verdict == DuelVerdict.Right)
                        {
                            <span class="home__recent-winner">🏆 @d.RightModelName</span>
                        }
                        else
                        {
                            <span class="home__recent-unrated">⚖ Rate it</span>
                        }
                        <span class="home__recent-date">@d.StartedAt.ToString("MMM d")</span>
                    </a>
                }
            </div>
        </div>
    }

    @* ── Danger Zone (O2 — moved to bottom) ── *@
    <div class="home__danger-zone">
        @if (_resetConfirm)
        {
            <span class="home__danger-msg">⚠ This will delete all duels, results and ELO history and reset model ratings. Are you sure?</span>
            <RadzenButton Text="Yes, clear everything" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                Disabled="@_resetBusy" Click="@DoResetAsync" class="home__danger-btn" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="@(() => _resetConfirm = false)" class="home__danger-btn" />
        }
        else if (_resetDone)
        {
            <span class="home__danger-ok">✓ All data cleared.</span>
            <RadzenButton Text="Clear again" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="@(() => { _resetDone = false; _resetConfirm = true; })" class="home__danger-btn" />
        }
        else
        {
            <RadzenButton Text="🗑 Clear All Duel Data" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="@(() => _resetConfirm = true)" class="home__danger-btn" />
        }
    </div>
</div>

<style>
    .home { max-width: 860px; margin: 2rem auto; padding: 0 1rem; }

    /* ── Compact header (C1) ────────────────────────────────────────────── */
    .home__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .home__title {
        font-size: 1.6rem;
        font-weight: 800;
        margin: 0;
        color: var(--oled-text);
        letter-spacing: -0.01em;
    }

    /* ── Stat strip (C1) ────────────────────────────────────────────────── */
    .home__stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.75rem;
        margin-bottom: 2rem;
    }

    .home__stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.2rem;
        padding: 0.9rem 0.5rem;
        background: var(--oled-surface);
        border: 1px solid var(--oled-border);
        border-radius: var(--radius-md);
        text-align: center;
    }

    .home__stat--alert {
        border-color: rgba(251, 191, 36, 0.5);
        background: rgba(251, 191, 36, 0.05);
    }

    .home__stat-value {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--oled-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    .home__stat--alert .home__stat-value { color: #fbbf24; }

    .home__stat-label {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--oled-text-muted);
    }

    @@media (max-width: 500px) {
        .home__stats { grid-template-columns: repeat(2, 1fr); }
    }

    /* ── Recent Duels ─────────────────────────────────────────────────────── */
    .home__recent { animation: fadeIn 0.6s ease-out 0.6s both; }

    .home__recent-title {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--oled-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
    }

    .home__recent-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .home__recent-item {
        display: grid;
        grid-template-columns: 1fr 1fr auto auto;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--oled-border);
        border-radius: var(--radius-md);
        text-decoration: none;
        color: inherit;
        transition: all var(--transition-fast);
        background: var(--oled-surface);
    }

    .home__recent-item:hover {
        border-color: var(--oled-green);
        transform: translateX(4px);
        box-shadow: 0 4px 20px rgba(34, 197, 94, 0.1);
    }

    /* O1: Unrated items get amber left border to signal action needed */
    .home__recent-item--unrated {
        border-left: 3px solid rgba(251, 191, 36, 0.7);
    }

    .home__recent-item--unrated:hover {
        border-color: #fbbf24;
        box-shadow: 0 4px 20px rgba(251, 191, 36, 0.1);
    }

    .home__recent-prompt {
        font-size: 0.85rem;
        color: var(--oled-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .home__recent-vs {
        font-size: 0.75rem;
        color: var(--oled-text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .home__recent-winner {
        font-size: 0.8rem;
        color: var(--oled-green);
        font-weight: 600;
        white-space: nowrap;
    }

    .home__recent-unrated {
        font-size: 0.75rem;
        color: #fbbf24;
        font-weight: 600;
        white-space: nowrap;
    }

    .home__recent-date {
        font-size: 0.7rem;
        color: var(--oled-text-muted);
        white-space: nowrap;
    }

    /* ── Danger Zone ─────────────────────────────────────────────────────── */
    .home__danger-zone {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 2.5rem;
        padding: 1rem 1.25rem;
        border: 1px solid var(--oled-border);
        border-radius: var(--radius-md);
        background: var(--oled-surface);
    }

    .home__danger-msg {
        font-size: 0.85rem;
        color: var(--oled-red);
        flex: 1;
        min-width: 200px;
    }

    .home__danger-ok { font-size: 0.85rem; color: var(--oled-green); }
    .home__danger-btn { flex-shrink: 0; }

    @@media (max-width: 640px) {
        .home__recent-item {
            grid-template-columns: 1fr auto;
            gap: 0.5rem;
        }
        .home__recent-vs, .home__recent-date { display: none; }
    }
</style>

@code {
    private IReadOnlyList<DuelSummaryDto> _recentDuels = [];

    // Stat strip fields (C1)
    private int _totalDuels;
    private int _activeModels;
    private string? _topModel;
    private int _unratedCount;

    private bool _resetConfirm;
    private bool _resetBusy;
    private bool _resetDone;

    protected override async Task OnInitializedAsync()
    {
        // Load recent duels (8) and leaderboard in parallel
        var duelsTask = ApiClient.ListDuelsAsync(8);
        var lbTask = ApiClient.GetLeaderboardAsync("Elo");

        await Task.WhenAll(duelsTask, lbTask);

        var duels = duelsTask.Result ?? [];
        _recentDuels = duels;
        _totalDuels = duels.Count;
        _unratedCount = duels.Count(d => d.Verdict == DuelVerdict.Pending);

        var lb = lbTask.Result;
        if (lb is not null)
        {
            _activeModels = lb.Count(e => e.DuelCount > 0);
            _topModel = lb.FirstOrDefault(e => e.Rank == 1)?.DisplayName;
        }
    }

    private async Task DoResetAsync()
    {
        _resetBusy = true;
        try
        {
            await ApiClient.DevResetAsync();
            _recentDuels = [];
            _totalDuels = 0;
            _activeModels = 0;
            _topModel = null;
            _unratedCount = 0;
            _resetDone = true;
            _resetConfirm = false;
        }
        catch { /* swallow — server may not be in dev mode */ }
        finally { _resetBusy = false; }
    }
}
