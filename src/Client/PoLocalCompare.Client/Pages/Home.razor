@page "/"
@using PoLocalCompare.Client.Components
@using Radzen.Blazor

<PageTitle>LLM Duel Arena</PageTitle>

<MockDataBanner />

<div class="home">
    <div class="home__hero">
        <h1 class="home__title">LLM Duel Arena</h1>
        <p class="home__subtitle">
            Pit AI models head-to-head. Track ELO ratings, win rates, and energy efficiency
            across thousands of prompt battles — all running locally.
        </p>
        <div class="home__cta">
            <a class="rz-button rz-button-md rz-primary" href="war-room">Enter War Room</a>
            <a class="rz-button rz-button-md rz-light" href="leaderboard">View Leaderboard</a>
        </div>
    </div>

    <div class="home__cards">
        <div class="home__card">
            <span class="home__card-icon">⚔️</span>
            <h3>Head-to-Head Duels</h3>
            <p>Send the same prompt to two models simultaneously and judge which response wins.</p>
        </div>
        <div class="home__card">
            <span class="home__card-icon">📈</span>
            <h3>ELO Rankings</h3>
            <p>Every verdict shifts ELO scores using the same algorithm chess grandmasters use. The leaderboard updates live.</p>
        </div>
        <div class="home__card">
            <span class="home__card-icon">🌱</span>
            <h3>Green Score</h3>
            <p>Measures energy cost per duel (watts × time). Compare accuracy <em>and</em> environmental impact.</p>
        </div>
    </div>
</div>

<style>
    .home { max-width: 860px; margin: 2rem auto; padding: 0 1rem; }
    .home__hero { text-align: center; padding: 2.5rem 1rem; }
    .home__title { font-size: 2.25rem; font-weight: 700; margin-bottom: 0.75rem; }
    .home__subtitle { font-size: 1.1rem; color: var(--rz-text-secondary-color, #6b7280); max-width: 560px; margin: 0 auto 1.75rem; }
    .home__cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .home__cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-top: 2rem; }
    .home__card { border: 1px solid var(--rz-border-color, #e5e7eb); border-radius: 0.75rem; padding: 1.5rem; background: var(--rz-base-background-color, #fff); }
    .home__card-icon { font-size: 2rem; display: block; margin-bottom: 0.5rem; }
    .home__card h3 { margin: 0 0 0.5rem; font-size: 1rem; font-weight: 600; }
    .home__card p { margin: 0; font-size: 0.875rem; color: var(--rz-text-secondary-color, #6b7280); line-height: 1.5; }
</style>
