@page "/"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Radzen
@using Radzen.Blazor
@inject DuelApiClient ApiClient

<PageTitle>LLM Duel Arena</PageTitle>

<div class="home">
    @* ── Compact Header (C1) ── *@
    <div class="home__header">
        <h1 class="home__title">⚔ LLM Duel Arena</h1>
        <a href="/war-room" class="rz-button rz-button-md rz-primary">⚔ New Duel</a>
    </div>

    @* ── Stat Strip (C1) ── *@
    <div class="home__stats">
        <div class="home__stat" style="--stagger-index: 0;">
            <span class="home__stat-value">@_totalDuels</span>
            <span class="home__stat-label">Duels Fought</span>
        </div>
        <div class="home__stat" style="--stagger-index: 1;">
            <span class="home__stat-value">@_activeModels</span>
            <span class="home__stat-label">Active Models</span>
        </div>
        <div class="home__stat" style="--stagger-index: 2;">
            <span class="home__stat-value">@(_topModel ?? "—")</span>
            <span class="home__stat-label">Top Ranked</span>
        </div>
        <div class="home__stat @(_unratedCount > 0 ? "home__stat--alert" : "")" style="--stagger-index: 3;">
            <span class="home__stat-value">@_unratedCount</span>
            <span class="home__stat-label">Need Verdict</span>
        </div>
    </div>

    <div class="home__system @(_systemRefreshing ? "home__system--refreshing" : "")">
        <div class="home__system-head">
            <h2 class="home__system-title">System Status</h2>
            <div class="home__system-actions">
                <button class="home__system-refresh" @onclick="RefreshSystemAsync">Run Smoke Test</button>
                <button class="home__system-diagnostics" @onclick="ToggleDiagnostics">Diagnostics</button>
            </div>
        </div>
        @if (_systemLoading)
        {
            <p class="home__system-note">Running diagnostics…</p>
        }
        else
        {
            <div class="home__system-grid">
                <div class="home__system-card">
                    <span class="home__system-label">API Health</span>
                    <span class="home__system-value @(_apiHealthy ? "home__system-value--ok" : "home__system-value--bad")">@(_apiHealthy ? "Healthy" : "Degraded")</span>
                </div>
                <div class="home__system-card">
                    <span class="home__system-label">Runtime Mode</span>
                    <span class="home__system-value">@_runtimeMode</span>
                </div>
                <div class="home__system-card">
                    <span class="home__system-label">Models</span>
                    <span class="home__system-value">@_systemModelCount total</span>
                </div>
                <div class="home__system-card">
                    <span class="home__system-label">Service Models</span>
                    <span class="home__system-value">@_systemServiceModelCount</span>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_systemNote))
            {
                <p class="home__system-note">@_systemNote</p>
            }

            @if (_showDiagnostics)
            {
                <div class="home__diagnostics" role="region" aria-label="Diagnostics Drawer">
                    <div class="home__diagnostics-head">
                        <h3>Runtime Diagnostics</h3>
                        <button class="home__diagnostics-close" @onclick="ToggleDiagnostics">Close</button>
                    </div>

                    <div class="home__diagnostics-metrics">
                        <div class="home__diagnostics-pill @(_apiHealthy ? "home__diagnostics-pill--ok" : "home__diagnostics-pill--bad")">
                            API @(_apiHealthy ? "Healthy" : "Degraded")
                        </div>
                        <div class="home__diagnostics-pill @(_modelsReady ? "home__diagnostics-pill--ok" : "home__diagnostics-pill--bad")">
                            Model Readiness: @(_modelsReady ? "Ready" : "Needs Attention")
                        </div>
                        <div class="home__diagnostics-pill">
                            Ready Basis: @_systemServiceModelCount service / @_systemModelCount total
                        </div>
                    </div>

                    @if (_diagnosticWarnings.Count == 0)
                    {
                        <p class="home__diagnostics-empty">No warnings or errors in the latest snapshot.</p>
                    }
                    else
                    {
                        <ul class="home__diagnostics-list">
                            @foreach (var warning in _diagnosticWarnings)
                            {
                                <li class="home__diagnostics-item home__diagnostics-item--@warning.Level.ToLowerInvariant()">
                                    <span class="home__diagnostics-level">@warning.Level</span>
                                    <span class="home__diagnostics-message">@warning.Message</span>
                                    <span class="home__diagnostics-meta">@warning.Timestamp · @warning.Source</span>
                                </li>
                            }
                        </ul>
                    }

                    <p class="home__diagnostics-stamp">Updated @(_diagnosticUpdatedAt is null ? "just now" : _diagnosticUpdatedAt.Value.LocalDateTime.ToString("HH:mm:ss"))</p>
                </div>
            }
        }
    </div>

    @* ── Recent Duels (O1 — pending links to arena) ── *@
    @if (_recentDuels.Count > 0)
    {
        <div class="home__recent">
            <h2 class="home__recent-title">Recent Duels</h2>
            <div class="home__recent-list">
                @for (var i = 0; i < _recentDuels.Count; i++)
                {
                    var d = _recentDuels[i];
                    var isPending = d.Verdict == DuelVerdict.Pending;
                    var href = isPending ? $"/arena/{d.DuelId}" : "/archive";
                    <a href="@href" class="home__recent-item @(isPending ? "home__recent-item--unrated" : "")" style="--stagger-index: @i;">
                        <span class="home__recent-prompt">@d.PromptSummary</span>
                        <span class="home__recent-vs">@d.LeftModelName <em>vs</em> @d.RightModelName</span>
                        @if (d.Verdict == DuelVerdict.Left)
                        {
                            <span class="home__recent-winner">🏆 @d.LeftModelName</span>
                        }
                        else if (d.Verdict == DuelVerdict.Right)
                        {
                            <span class="home__recent-winner">🏆 @d.RightModelName</span>
                        }
                        else
                        {
                            <span class="home__recent-unrated">⚖ Rate it</span>
                        }
                        <span class="home__recent-date">@d.StartedAt.ToString("MMM d")</span>
                    </a>
                }
            </div>
        </div>
    }

    @* ── Danger Zone (O2 — moved to bottom) ── *@
    <div class="home__danger-zone">
        @if (_resetConfirm)
        {
            <span class="home__danger-msg">⚠ This will delete all duels, results and ELO history and reset model ratings. Are you sure?</span>
            <RadzenButton Text="Yes, clear everything" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                Disabled="@_resetBusy" Click="@DoResetAsync" class="home__danger-btn" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="@(() => _resetConfirm = false)" class="home__danger-btn" />
        }
        else if (_resetDone)
        {
            <span class="home__danger-ok">✓ All data cleared.</span>
            <RadzenButton Text="Clear again" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="@(() => { _resetDone = false; _resetConfirm = true; })" class="home__danger-btn" />
        }
        else
        {
            <RadzenButton Text="🗑 Clear All Duel Data" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="@(() => _resetConfirm = true)" class="home__danger-btn" />
        }
    </div>
</div>

@code {
    private IReadOnlyList<DuelSummaryDto> _recentDuels = [];

    // Stat strip fields (C1)
    private int _totalDuels;
    private int _activeModels;
    private string? _topModel;
    private int _unratedCount;

    private bool _resetConfirm;
    private bool _resetBusy;
    private bool _resetDone;

    private bool _systemLoading;
    private bool _apiHealthy;
    private string _runtimeMode = "Unknown";
    private int _systemModelCount;
    private int _systemServiceModelCount;
    private string? _systemNote;
    private bool _showDiagnostics;
    private bool _systemRefreshing;
    private bool _modelsReady;
    private DateTimeOffset? _diagnosticUpdatedAt;
    private IReadOnlyList<DuelApiClient.DiagnosticsWarningEntryDto> _diagnosticWarnings = [];

    protected override async Task OnInitializedAsync()
    {
        // Load recent duels (8) and leaderboard in parallel
        var duelsTask = ApiClient.ListDuelsAsync(8);
        var lbTask = ApiClient.GetLeaderboardAsync("Elo");

        await Task.WhenAll(duelsTask, lbTask);

        var duels = duelsTask.Result ?? [];
        _recentDuels = duels;
        _totalDuels = duels.Count;
        _unratedCount = duels.Count(d => d.Verdict == DuelVerdict.Pending);

        var lb = lbTask.Result;
        if (lb is not null)
        {
            _activeModels = lb.Count(e => e.DuelCount > 0);
            _topModel = lb.FirstOrDefault(e => e.Rank == 1)?.DisplayName;
        }

        await RefreshSystemAsync();
    }

    private async Task RefreshSystemAsync()
    {
        _systemLoading = true;
        _systemRefreshing = true;
        _systemNote = null;
        try
        {
            var healthTask = ApiClient.GetHealthSnapshotAsync();
            var smokeTask = ApiClient.GetSmokeSnapshotAsync();
            var warningsTask = ApiClient.GetDiagnosticsWarningsAsync(6);
            await Task.WhenAll(healthTask, smokeTask, warningsTask);

            var health = healthTask.Result;
            var smoke = smokeTask.Result;
            var warnings = warningsTask.Result;
            _apiHealthy = string.Equals(health?.Status, "Healthy", StringComparison.OrdinalIgnoreCase)
                || string.Equals(smoke?.Status, "Healthy", StringComparison.OrdinalIgnoreCase);

            if (smoke is not null)
            {
                _systemModelCount = smoke.Models.Total;
                _systemServiceModelCount = smoke.Models.LocalService;
                _runtimeMode = smoke.Models.CloudMode ? "Cloud (Ollama hidden)" : "Local/Dev";
            }
            else
            {
                _runtimeMode = "Unknown";
            }

            _modelsReady = _systemModelCount > 0 && (_systemServiceModelCount > 0 || _runtimeMode.StartsWith("Cloud", StringComparison.OrdinalIgnoreCase));
            _diagnosticWarnings = warnings?.Entries ?? [];
            _diagnosticUpdatedAt = warnings?.GeneratedAtUtc ?? DateTimeOffset.UtcNow;

            _systemNote = $"Updated {DateTime.Now:HH:mm:ss}";
        }
        catch
        {
            _apiHealthy = false;
            _runtimeMode = "Unknown";
            _modelsReady = false;
            _diagnosticWarnings = [];
            _diagnosticUpdatedAt = DateTimeOffset.UtcNow;
            _systemNote = "Smoke test failed. Check API logs.";
        }
        finally
        {
            _systemLoading = false;
            _ = Task.Delay(750).ContinueWith(_ =>
            {
                _systemRefreshing = false;
                InvokeAsync(StateHasChanged);
            });
        }
    }

    private void ToggleDiagnostics() => _showDiagnostics = !_showDiagnostics;

    private async Task DoResetAsync()
    {
        _resetBusy = true;
        try
        {
            await ApiClient.DevResetAsync();
            _recentDuels = [];
            _totalDuels = 0;
            _activeModels = 0;
            _topModel = null;
            _unratedCount = 0;
            _resetDone = true;
            _resetConfirm = false;
        }
        catch { /* swallow — server may not be in dev mode */ }
        finally { _resetBusy = false; }
    }
}
