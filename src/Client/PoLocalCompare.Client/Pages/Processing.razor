@page "/processing/{DuelId}"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@inject NavigationManager Nav
@inject SignalRDuelClient HubClient
@inject WebLlmService WebLlm
@inject DuelApiClient ApiClient
@implements IAsyncDisposable

<MockDataBanner />

<div class="processing-page">
    <h1 class="processing-page__title">Processing Duel…</h1>
    <p class="processing-page__duel-id">Duel ID: @DuelId</p>

    <div class="processing-page__panels">
        <ProcessingPanel
            ModelName="@_leftModelId"
            Side="Left"
            Status="@_leftStatus"
            ElapsedMs="@_leftElapsedMs"
            TokenCount="@_leftTokenCount"
            TokenVelocity="@_leftTokenVelocity"
            PeakTokenVelocity="@_leftPeakVelocity"
            WarmUpMs="@_leftWarmUpMs"
            IsStalled="@_leftIsStalled"
            HtmlTagCount="@_leftHtmlTagCount"
            OpenTagDepth="@_leftOpenTagDepth"
            StyleRuleCount="@_leftStyleRuleCount"
            RepetitionScore="@_leftRepetitionScore"
            PrefillSpeedTps="@_leftPrefillSpeedTps"
            CacheHit="@_leftCacheHit"
            Detail="@_leftDetail"
        />
        <ProcessingPanel
            ModelName="@_rightModelId"
            Side="Right"
            Status="@_rightStatus"
            ElapsedMs="@_rightElapsedMs"
            TokenCount="@_rightTokenCount"
            TokenVelocity="@_rightTokenVelocity"
            PeakTokenVelocity="@_rightPeakVelocity"
            WarmUpMs="@_rightWarmUpMs"
            IsStalled="@_rightIsStalled"
            HtmlTagCount="@_rightHtmlTagCount"
            OpenTagDepth="@_rightOpenTagDepth"
            StyleRuleCount="@_rightStyleRuleCount"
            RepetitionScore="@_rightRepetitionScore"
            PrefillSpeedTps="@_rightPrefillSpeedTps"
            CacheHit="@_rightCacheHit"
            Detail="@_rightDetail"
        />
    </div>

    @if (_leftHtmlPreview is not null || _rightHtmlPreview is not null)
    {
        <div class="processing-page__preview-heading">
            <span class="processing-page__preview-label">&#x1F4FA; Live Preview — rendering in real time</span>
        </div>
        <div class="processing-page__previews">
            <div class="processing-page__preview-panel">
                @if (_leftHtmlPreview is not null)
                {
                    <SandboxedViewport HtmlContent="@_leftHtmlPreview" ModelName="@_leftModelId" IsLoser="false" />
                }
                else
                {
                    <div class="processing-page__preview-waiting">@_leftModelId — waiting for first output…</div>
                }
            </div>
            <div class="processing-page__preview-panel">
                @if (_rightHtmlPreview is not null)
                {
                    <SandboxedViewport HtmlContent="@_rightHtmlPreview" ModelName="@_rightModelId" IsLoser="false" />
                }
                else
                {
                    <div class="processing-page__preview-waiting">@_rightModelId — waiting for first output…</div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string DuelId { get; set; } = string.Empty;

    private string _leftModelId = "Left Model";
    private string _rightModelId = "Right Model";

    private DuelStatus _leftStatus = DuelStatus.Initializing;
    private DuelStatus _rightStatus = DuelStatus.Initializing;
    private long _leftElapsedMs;
    private long _rightElapsedMs;
    private int _leftTokenCount;
    private int _rightTokenCount;
    private double? _leftTokenVelocity;
    private double? _rightTokenVelocity;
    private double? _leftPeakVelocity;
    private double? _rightPeakVelocity;
    private long? _leftWarmUpMs;
    private long? _rightWarmUpMs;
    private bool _leftIsStalled;
    private bool _rightIsStalled;
    private DateTimeOffset _leftLastTokenAt = DateTimeOffset.UtcNow;
    private DateTimeOffset _rightLastTokenAt = DateTimeOffset.UtcNow;
    // HTML content stats
    private int? _leftHtmlTagCount;
    private int? _rightHtmlTagCount;
    private int? _leftOpenTagDepth;
    private int? _rightOpenTagDepth;
    private int? _leftStyleRuleCount;
    private int? _rightStyleRuleCount;
    private double? _leftRepetitionScore;
    private double? _rightRepetitionScore;
    // Local-model-only stats
    private double? _leftPrefillSpeedTps;
    private double? _rightPrefillSpeedTps;
    private bool? _leftCacheHit;
    private bool? _rightCacheHit;
    private string? _leftDetail;
    private string? _rightDetail;
    // Live HTML preview (partial HTML accumulated during generation)
    private string? _leftHtmlPreview;
    private string? _rightHtmlPreview;
    private DuelStatus _leftPrevStatus = DuelStatus.Initializing;
    private DuelStatus _rightPrevStatus = DuelStatus.Initializing;

    // Track in-flight local inference tasks to avoid double-starting
    private readonly HashSet<string> _runningLocalModels = [];

    protected override async Task OnInitializedAsync()
    {
        HubClient.OnModelStatusUpdate += HandleStatusUpdate;
        HubClient.OnDuelComplete += HandleDuelComplete;
        HubClient.OnStartLocalInference += HandleStartLocalInference;
        WebLlm.OnStatusUpdate += HandleLocalStatusUpdate;

        var baseUri = Nav.BaseUri.TrimEnd('/');
        await HubClient.ConnectAsync(baseUri, DuelId);
    }

    private void HandleStatusUpdate(ModelStatusUpdateDto update)
    {
        if (update.DuelId != DuelId) return;

        if (update.Side == "Left")
        {
            _leftModelId = update.ModelId;
            _leftStatus = update.Status;
            _leftElapsedMs = update.ElapsedMs;
            _leftTokenCount = update.TokenCount;
            if (update.TokenVelocity.HasValue) _leftTokenVelocity = update.TokenVelocity;
            if (update.WarmUpMs.HasValue) _leftWarmUpMs = update.WarmUpMs;
            if (update.PeakTokenVelocity.HasValue) _leftPeakVelocity = update.PeakTokenVelocity;
            _leftIsStalled = update.IsStalled;
            if (update.HtmlTagCount.HasValue) _leftHtmlTagCount = update.HtmlTagCount;
            if (update.OpenTagDepth.HasValue) _leftOpenTagDepth = update.OpenTagDepth;
            if (update.StyleRuleCount.HasValue) _leftStyleRuleCount = update.StyleRuleCount;
            if (update.RepetitionScore.HasValue) _leftRepetitionScore = update.RepetitionScore;
            if (update.PrefillSpeedTps.HasValue) _leftPrefillSpeedTps = update.PrefillSpeedTps;
            if (update.CacheHit.HasValue) _leftCacheHit = update.CacheHit;
            if (update.Detail is not null) _leftDetail = update.Detail;
            if (update.HtmlPreview is not null) _leftHtmlPreview = update.HtmlPreview;
            _leftLastTokenAt = DateTimeOffset.UtcNow;
        }
        else
        {
            _rightModelId = update.ModelId;
            _rightStatus = update.Status;
            _rightElapsedMs = update.ElapsedMs;
            _rightTokenCount = update.TokenCount;
            if (update.TokenVelocity.HasValue) _rightTokenVelocity = update.TokenVelocity;
            if (update.WarmUpMs.HasValue) _rightWarmUpMs = update.WarmUpMs;
            if (update.PeakTokenVelocity.HasValue) _rightPeakVelocity = update.PeakTokenVelocity;
            _rightIsStalled = update.IsStalled;
            if (update.HtmlTagCount.HasValue) _rightHtmlTagCount = update.HtmlTagCount;
            if (update.OpenTagDepth.HasValue) _rightOpenTagDepth = update.OpenTagDepth;
            if (update.StyleRuleCount.HasValue) _rightStyleRuleCount = update.StyleRuleCount;
            if (update.RepetitionScore.HasValue) _rightRepetitionScore = update.RepetitionScore;
            if (update.PrefillSpeedTps.HasValue) _rightPrefillSpeedTps = update.PrefillSpeedTps;
            if (update.CacheHit.HasValue) _rightCacheHit = update.CacheHit;
            if (update.Detail is not null) _rightDetail = update.Detail;
            if (update.HtmlPreview is not null) _rightHtmlPreview = update.HtmlPreview;
            _rightLastTokenAt = DateTimeOffset.UtcNow;
        }

        InvokeAsync(StateHasChanged);
    }

    // Local model status updates come directly from the JS worker (bypassing server SignalR)
    private void HandleLocalStatusUpdate(string modelId, WebLlmStatusUpdate update)
    {
        var isLeft = _leftModelId == modelId || (_leftStatus == DuelStatus.Initializing && _rightModelId != modelId);

        if (isLeft)
        {
            // Capture warm-up: elapsed at the moment Initializing → Generating transitions
            if (_leftPrevStatus == DuelStatus.Initializing && update.Status == "Generating")
                _leftWarmUpMs = update.ElapsedMs;
            _leftPrevStatus = update.Status switch {
                "Generating" => DuelStatus.Generating,
                "Done"       => DuelStatus.Done,
                "Failed"     => DuelStatus.Failed,
                _            => DuelStatus.Initializing,
            };

            _leftTokenCount = update.TokenCount;
            _leftElapsedMs = update.ElapsedMs;
            // Generation-only velocity (exclude warm-up)
            var genMs = _leftWarmUpMs.HasValue ? update.ElapsedMs - _leftWarmUpMs.Value : update.ElapsedMs;
            var vel = genMs > 0 && update.TokenCount > 0
                ? Math.Round(update.TokenCount / (genMs / 1000.0), 1) : (double?)null;
            _leftTokenVelocity = vel;
            if (vel.HasValue && vel.Value > (_leftPeakVelocity ?? 0)) _leftPeakVelocity = vel;
            _leftIsStalled = update.Status == "Generating" &&
                (DateTimeOffset.UtcNow - _leftLastTokenAt).TotalSeconds > 2;
            if (update.TokenCount > 0) _leftLastTokenAt = DateTimeOffset.UtcNow;
            if (update.HtmlTagCount > 0) _leftHtmlTagCount = update.HtmlTagCount;
            if (update.OpenTagDepth > 0) _leftOpenTagDepth = update.OpenTagDepth;
            if (update.StyleRuleCount > 0) _leftStyleRuleCount = update.StyleRuleCount;
            if (update.RepetitionScore > 0) _leftRepetitionScore = update.RepetitionScore;
            if (update.PrefillSpeedTps.HasValue) _leftPrefillSpeedTps = update.PrefillSpeedTps;
            _leftCacheHit = update.CacheHit;
            if (update.Detail is not null) _leftDetail = update.Detail;
            else if (update.Status == "Generating") _leftDetail = null;
            if (update.HtmlPreview is not null) _leftHtmlPreview = update.HtmlPreview;
        }
        else
        {
            if (_rightPrevStatus == DuelStatus.Initializing && update.Status == "Generating")
                _rightWarmUpMs = update.ElapsedMs;
            _rightPrevStatus = update.Status switch {
                "Generating" => DuelStatus.Generating,
                "Done"       => DuelStatus.Done,
                "Failed"     => DuelStatus.Failed,
                _            => DuelStatus.Initializing,
            };

            _rightTokenCount = update.TokenCount;
            _rightElapsedMs = update.ElapsedMs;
            var genMs = _rightWarmUpMs.HasValue ? update.ElapsedMs - _rightWarmUpMs.Value : update.ElapsedMs;
            var vel = genMs > 0 && update.TokenCount > 0
                ? Math.Round(update.TokenCount / (genMs / 1000.0), 1) : (double?)null;
            _rightTokenVelocity = vel;
            if (vel.HasValue && vel.Value > (_rightPeakVelocity ?? 0)) _rightPeakVelocity = vel;
            _rightIsStalled = update.Status == "Generating" &&
                (DateTimeOffset.UtcNow - _rightLastTokenAt).TotalSeconds > 2;
            if (update.TokenCount > 0) _rightLastTokenAt = DateTimeOffset.UtcNow;
            if (update.HtmlTagCount > 0) _rightHtmlTagCount = update.HtmlTagCount;
            if (update.OpenTagDepth > 0) _rightOpenTagDepth = update.OpenTagDepth;
            if (update.StyleRuleCount > 0) _rightStyleRuleCount = update.StyleRuleCount;
            if (update.RepetitionScore > 0) _rightRepetitionScore = update.RepetitionScore;
            if (update.PrefillSpeedTps.HasValue) _rightPrefillSpeedTps = update.PrefillSpeedTps;
            _rightCacheHit = update.CacheHit;
            if (update.Detail is not null) _rightDetail = update.Detail;
            else if (update.Status == "Generating") _rightDetail = null;
            if (update.HtmlPreview is not null) _rightHtmlPreview = update.HtmlPreview;
        }
        InvokeAsync(StateHasChanged);
    }

    private void HandleDuelComplete(DuelDto dto)
    {
        if (dto.DuelId != DuelId) return;
        Nav.NavigateTo($"/arena/{DuelId}");
    }

    private void HandleStartLocalInference(StartLocalInferencePayload payload)
    {
        if (payload.DuelId != DuelId) return;
        if (_runningLocalModels.Contains(payload.ModelId)) return;

        _runningLocalModels.Add(payload.ModelId);

        // Fire-and-forget; errors are caught inside
        _ = Task.Run(() => RunLocalInferenceAsync(payload));
    }

    private async Task RunLocalInferenceAsync(StartLocalInferencePayload payload)
    {
        string htmlOutput = string.Empty;
        int tokenCount = 0;
        long totalMs = 0;
        long warmUpMs = 0;
        bool isFailure = false;
        string? failureReason = null;

        try
        {
            // WebLlmService needs a prompt — retrieve the duel to get it
            var duel = await ApiClient.GetDuelAsync(payload.DuelId);
            var prompt = duel?.PromptFull ?? string.Empty;

            // Stream status updates (signals the JS worker to start)
            await foreach (var update in WebLlm.StartInferenceAsync(payload.ModelId, prompt, payload.DuelId))
            {
                if (update.Status == "Done" || update.Status == "Failed")
                {
                    isFailure = update.Status == "Failed";
                    failureReason = update.ErrorReason;
                    break;
                }
            }

            if (!isFailure)
            {
                // Collect full result payload (HTML, timing) from the completion source
                var result = await WebLlm.GetResultAsync(payload.ModelId);
                if (result is not null)
                {
                    htmlOutput = result.HtmlOutput;
                    tokenCount = result.TokenCount;
                    totalMs = result.TotalMs;
                    warmUpMs = result.WarmUpMs;
                }
            }
        }
        catch (Exception ex)
        {
            isFailure = true;
            failureReason = ex.Message;
        }
        finally
        {
            _runningLocalModels.Remove(payload.ModelId);
        }

        await ApiClient.PostLocalResultAsync(
            payload.DuelId,
            payload.ModelId,
            htmlOutput,
            tokenCount,
            totalMs,
            warmUpMs,
            isFailure,
            failureReason);
    }

    public async ValueTask DisposeAsync()
    {
        HubClient.OnModelStatusUpdate -= HandleStatusUpdate;
        HubClient.OnDuelComplete -= HandleDuelComplete;
        HubClient.OnStartLocalInference -= HandleStartLocalInference;
        WebLlm.OnStatusUpdate -= HandleLocalStatusUpdate;
        await HubClient.DisposeAsync();
    }
}

<style>
    .processing-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem;
        color: #e5e7eb;
    }

    .processing-page__title {
        font-size: 1.8rem;
        font-weight: 800;
        color: #eab308;
        margin-bottom: 0.25rem;
    }

    .processing-page__duel-id {
        color: #6b7280;
        font-size: 0.8rem;
        margin-bottom: 1.5rem;
    }

    .processing-page__panels {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    @@media (max-width: 1023px) {
        .processing-page__panels {
            grid-template-columns: 1fr;
            scroll-snap-type: y mandatory;
            overflow-y: scroll;
            max-height: calc(100vh - 150px);
        }

        .processing-page__panels > * {
            scroll-snap-align: start;
        }
    }

    .processing-page__preview-heading {
        margin-top: 2.5rem;
        margin-bottom: 0.5rem;
        text-align: center;
    }

    .processing-page__preview-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .processing-page__previews {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-top: 0.5rem;
    }

    .processing-page__preview-panel {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .processing-page__preview-model {
        font-size: 0.75rem;
        font-weight: 600;
        color: #9ca3af;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .processing-page__preview-waiting {
        height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px dashed #374151;
        border-radius: 6px;
        color: #4b5563;
        font-size: 0.85rem;
        font-style: italic;
    }

    /* Shrink the iframe height in preview context (default 500px is too tall during generation) */
    .processing-page__preview-panel ::deep .sandboxed-viewport__frame {
        min-height: 350px;
        max-height: 450px;
    }

    @@media (max-width: 1023px) {
        .processing-page__previews {
            grid-template-columns: 1fr;
        }
    }
</style>
