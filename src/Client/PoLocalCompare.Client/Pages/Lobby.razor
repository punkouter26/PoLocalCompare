@page "/lobby"
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@inject DuelApiClient ApiClient
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject SignalRLobbyClient LobbyClient
@implements IAsyncDisposable

<PageTitle>Lobby - PoLocalCompare</PageTitle>

<div class="lobby">
    <h1 class="lobby__title">Lobby</h1>
    <p class="lobby__subtitle">Join with any account, get ready, then the Host starts the duel.</p>

    @if (_identity is null)
    {
        <div class="lobby__auth-gate">
            <p>You must be logged in to join the lobby.</p>
            <a href="auth/login/microsoft?returnUrl=/lobby" class="btn-ms-login">Sign in with Microsoft</a>
        </div>
    }
    else if (_connectionError is not null)
    {
        <div class="lobby__error">
            <p>Connection error: @_connectionError</p>
            <button class="lobby__retry-btn" @onclick="ConnectAsync">Retry</button>
        </div>
    }
    else if (!_connected)
    {
        <div class="lobby__connecting">
            <p>Connecting to lobby…</p>
        </div>
    }
    else
    {
        @* ── Players list ── *@
        <section class="lobby__players">
            <h2 class="lobby__section-title">Players (@_state.Players.Count)</h2>
            @if (!_state.Players.Any())
            {
                <p class="lobby__empty">No players yet — you are the first!</p>
            }
            else
            {
                <ul class="lobby__player-list">
                    @foreach (var player in _state.Players)
                    {
                        <li class="lobby__player @(player.UserId == _identity ? "lobby__player--self" : "")">
                            <span class="lobby__player-name">
                                @player.UserId
                                @if (player.IsHost) { <span class="lobby__badge lobby__badge--host">HOST</span> }
                                @if (player.UserId == _identity) { <span class="lobby__badge lobby__badge--you">YOU</span> }
                            </span>
                            <span class="lobby__player-ready @(player.IsReady ? "lobby__player-ready--yes" : "lobby__player-ready--no")">
                                @(player.IsReady ? "Ready" : "Not Ready")
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>

        @* ── Ready toggle ── *@
        <div class="lobby__actions">
            <button class="lobby__ready-btn @(_myReady ? "lobby__ready-btn--active" : "")"
                    @onclick="ToggleReadyAsync">
                @(_myReady ? "✓ Ready — click to unready" : "Mark as Ready")
            </button>
        </div>

        @* ── Model selection (Host only) ── *@
        @if (_isHost)
        {
            <section class="lobby__models">
                <h2 class="lobby__section-title">Select Models for the Duel</h2>
                <p class="lobby__hint">As Host, pick the two models that will compete.</p>

                <div class="lobby__model-grid">
                    <div class="lobby__model-slot">
                        <label class="lobby__model-label" for="lobby-left-model">Left Model</label>
                        <select id="lobby-left-model" class="lobby__model-select" @bind="_leftModelId">
                            <option value="">— Select —</option>
                            @foreach (var group in _modelGroups)
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var m in group.Value)
                                    {
                                        <option value="@m.ModelId">@m.DisplayName (ELO @Math.Round(m.CurrentElo))</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>

                    <div class="lobby__model-slot">
                        <label class="lobby__model-label" for="lobby-right-model">Right Model</label>
                        <select id="lobby-right-model" class="lobby__model-select" @bind="_rightModelId">
                            <option value="">— Select —</option>
                            @foreach (var group in _modelGroups)
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var m in group.Value)
                                    {
                                        <option value="@m.ModelId">@m.DisplayName (ELO @Math.Round(m.CurrentElo))</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                </div>

                <div class="lobby__prompt-wrap">
                    <label class="lobby__model-label" for="lobby-prompt">Prompt</label>
                    <textarea id="lobby-prompt" class="lobby__prompt-input" rows="4"
                              @bind="_prompt" placeholder="Describe the HTML challenge for both models…"></textarea>
                </div>

                <button class="lobby__start-btn"
                        disabled="@(!CanStart)"
                        @onclick="StartDuelAsync">
                    Start Duel
                </button>

                @if (!_state.CanStart)
                {
                    <p class="lobby__start-hint">
                        @if (_state.Players.Count < 2)
                        {
                            @("Waiting for at least one more player…")
                        }
                        else
                        {
                            @("All players must be ready before starting.")
                        }
                    </p>
                }
            </section>
        }
    }
</div>

@code {
    private string? _identity;
    private bool _connected;
    private string? _connectionError;

    private LobbyStateDto _state = new();
    private bool _isHost;
    private bool _myReady;

    private string _leftModelId = string.Empty;
    private string _rightModelId = string.Empty;
    private string _prompt = string.Empty;

    private IReadOnlyDictionary<string, IReadOnlyList<ModelDto>> _modelGroups
        = new Dictionary<string, IReadOnlyList<ModelDto>>();

    private bool CanStart =>
        _state.CanStart &&
        !string.IsNullOrWhiteSpace(_leftModelId) &&
        !string.IsNullOrWhiteSpace(_rightModelId) &&
        _leftModelId != _rightModelId &&
        !string.IsNullOrWhiteSpace(_prompt);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _identity = state.User.Identity?.IsAuthenticated == true
            ? (state.User.FindFirst("preferred_username")?.Value ?? state.User.Identity.Name)
            : null;
        if (_identity is null) return;

        LobbyClient.OnLobbyStateChanged += OnLobbyStateChanged;
        LobbyClient.OnDuelStarting += OnDuelStarting;

        await LoadModelsAsync();
        await ConnectAsync();
    }

    private async Task ConnectAsync()
    {
        _connectionError = null;
        _connected = false;
        try
        {
            var baseUrl = Nav.BaseUri.TrimEnd('/');
            await LobbyClient.ConnectAsync(baseUrl, _identity!);
            _connected = true;
        }
        catch (Exception ex)
        {
            _connectionError = ex.Message;
        }

        StateHasChanged();
    }

    private async Task LoadModelsAsync()
    {
        var models = await ApiClient.GetModelsAsync();
        if (models is null) return;

        _modelGroups = models
            .GroupBy(m => m.ModelType switch
            {
                ModelType.Remote => "Remote (Azure OpenAI)",
                ModelType.Local => "Browser (WebLLM)",
                ModelType.LocalService => "Ollama (Local Service)",
                _ => "Other"
            })
            .ToDictionary(g => g.Key, g => (IReadOnlyList<ModelDto>)g.ToList());
    }

    private async Task ToggleReadyAsync()
    {
        if (_identity is null) return;
        await LobbyClient.ToggleReadyAsync(_identity);
    }

    private async Task StartDuelAsync()
    {
        if (!CanStart) return;
        await LobbyClient.StartDuelAsync(_leftModelId, _rightModelId, _prompt);
    }

    private void OnLobbyStateChanged(LobbyStateDto state)
    {
        _state = state;
        _isHost = string.Equals(state.HostUserId, _identity, StringComparison.OrdinalIgnoreCase);
        _myReady = state.Players
            .FirstOrDefault(p => string.Equals(p.UserId, _identity, StringComparison.OrdinalIgnoreCase))
            ?.IsReady ?? false;
        InvokeAsync(StateHasChanged);
    }

    private void OnDuelStarting(string leftModelId, string rightModelId, string prompt)
    {
        var url = $"/war-room?leftModelId={Uri.EscapeDataString(leftModelId)}" +
                  $"&rightModelId={Uri.EscapeDataString(rightModelId)}" +
                  $"&prompt={Uri.EscapeDataString(prompt)}";
        InvokeAsync(() => Nav.NavigateTo(url));
    }

    public async ValueTask DisposeAsync()
    {
        LobbyClient.OnLobbyStateChanged -= OnLobbyStateChanged;
        LobbyClient.OnDuelStarting -= OnDuelStarting;
        await LobbyClient.DisposeAsync();
    }
}
