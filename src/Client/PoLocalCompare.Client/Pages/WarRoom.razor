@page "/war-room"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Radzen
@using Radzen.Blazor
@inject DuelApiClient ApiClient
@inject AudioService AudioService
@inject PromptTemplatesService PromptTemplates
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>War Room — LLM Duel Arena</PageTitle>

<div class="war-room" @onkeydown="OnKeyDown" tabindex="-1" id="war-room-root">
    <h1 class="war-room__title">⚔ War Room</h1>
    @if (!_loading)
    {
        <p class="war-room__mode-badge">
            @if (IsCloudMode)
            {
                <span>☁ Cloud mode active: Ollama service models are hidden in this environment.</span>
            }
            else
            {
                <span>🖥 Local mode active: service-backed Ollama models are available.</span>
            }
        </p>
    }

    @if (_loading)
    {
        <p class="war-room__loading">Loading models…</p>
    }
    else
    {
        @* ── 1. PROMPT FIRST (C4) — Quick Prompts + Textarea above everything ── *@
        <div class="war-room__templates-section">
            <div class="war-room__templates-header">
                <h3 class="war-room__templates-title">
                    <span>📋</span> Quick Prompts
                </h3>
                @if (!string.IsNullOrEmpty(_promptText))
                {
                    <button class="war-room__clear-prompt" @onclick="ClearPrompt">
                        ✕ Clear
                    </button>
                }
            </div>
            <div class="war-room__templates-grid">
                @foreach (var template in PromptTemplates.GetAll())
                {
                    <button class="war-room__template-card @(IsTemplateSelected(template) ? "war-room__template-card--selected" : "")"
                            @onclick="() => SelectTemplate(template)">
                        <span class="war-room__template-icon">@template.Icon</span>
                        <span class="war-room__template-name">@template.Name</span>
                        <span class="war-room__template-category">@template.Category</span>
                    </button>
                }
            </div>
        </div>

        <div class="war-room__prompt-section">
            <label class="war-room__label" for="promptInput">Prompt (5-minute duel, HTML output)</label>
            <p class="war-room__hint">💡 Local models may take 5–10 min to load on first use. Remote models respond immediately.</p>
            <RadzenTextArea
                id="promptInput"
                @bind-Value="_promptText"
                @oninput="@((ChangeEventArgs e) => { _promptText = e.Value?.ToString() ?? string.Empty; })"
                Rows="6"
                class="war-room__textarea"
                spellcheck="true"
                Placeholder="Describe the HTML app you want both models to build…"
            />
        </div>

        @* ── 2. TYPE FILTER + UNIFIED MODEL POOL ── *@
        <div class="war-room__selection-bar">
            <div class="war-room__selection-slot @(_leftModel is not null ? "war-room__selection-slot--set" : "")">
                <span class="war-room__selection-label">Left</span>
                <span class="war-room__selection-name">@(_leftModel?.DisplayName ?? "Not selected")</span>
            </div>
            <span class="war-room__selection-vs">VS</span>
            <div class="war-room__selection-slot @(_rightModel is not null ? "war-room__selection-slot--set" : "")">
                <span class="war-room__selection-label">Right</span>
                <span class="war-room__selection-name">@(_rightModel?.DisplayName ?? "Not selected")</span>
            </div>
        </div>

        <div class="war-room__type-filter">
            @foreach (var label in new[] { "All", "Local", "Remote", "Service" })
            {
                <button class="war-room__filter-chip @(_typeFilter == label ? "war-room__filter-chip--active" : "")"
                        @onclick="() => _typeFilter = label">
                    @label
                </button>
            }
        </div>
        <p class="war-room__hint">Tip: click a selected model again to unselect it, then choose a replacement.</p>

        <div class="war-room__pool">
            @if (!_filteredModels.Any())
            {
                <p class="war-room__empty">No models match this filter.</p>
            }
            else
            {
                @foreach (var model in _filteredModels)
                {
                    <div class="war-room__pool-item">
                        <ModelCard
                            Model="model"
                            LabelOverride="@(_modelLabels.GetValueOrDefault(model.ModelId))"
                            IsSelected="@(model.ModelId == _leftModel?.ModelId || model.ModelId == _rightModel?.ModelId)"
                            Slot="@(model.ModelId == _leftModel?.ModelId ? "Left" : model.ModelId == _rightModel?.ModelId ? "Right" : null)"
                            IsDisabled="false"
                            OnSelected="AssignModel"
                            ProjectedEloGain="@ComputeProjectedGain(model)" />
                        @if (model.ModelType == ModelType.Remote || model.ModelType == ModelType.LocalService)
                        {
                            <button class="war-room__edit-btn" title="Edit deployment name"
                                    @onclick="() => ToggleEdit(model.ModelId)"
                                    @onclick:stopPropagation="true">
                                ✏️
                            </button>
                        }
                    </div>
                    @if (_editingModelId == model.ModelId)
                    {
                        <div class="war-room__edit-row">
                            <label class="war-room__edit-label">Display Name</label>
                            <input class="war-room__edit-input" @bind="_editDisplayName" placeholder="Display name" />
                            <label class="war-room__edit-label">Deployment / Model Name (ApiEndpointRef)</label>
                            <input class="war-room__edit-input" @bind="_editApiEndpointRef" placeholder="e.g. gpt-4o-mini" />
                            @if (_editError is not null)
                            {
                                <p class="war-room__edit-error">@_editError</p>
                            }
                            <div class="war-room__edit-actions">
                                <button class="war-room__edit-save" @onclick="() => SaveEditAsync(model.ModelId)" disabled="@_editSaving">
                                    @(_editSaving ? "Saving…" : "Save")
                                </button>
                                <button class="war-room__edit-cancel" @onclick="CancelEdit">Cancel</button>
                            </div>
                        </div>
                    }
                }
            }
        </div>

        @* ── 4. ACTIONS ── *@
        <div class="war-room__actions">
            <RadzenButton
                Text="Commence Duel"
                ButtonStyle="ButtonStyle.Danger"
                Size="ButtonSize.Large"
                Disabled="@(!CanCommence)"
                Click="@CommenceDuelAsync"
                class="war-room__commence-btn"
            />
            @if (!CanCommence)
            {
                <p class="war-room__validation-hint">
                    @if (_leftModel is null && _rightModel is null)
                    {
                        @("Pick two models below to continue.")
                    }
                    else if (_leftModel is null || _rightModel is null)
                    {
                        @("Pick a second model to continue.")
                    }
                    else if (string.IsNullOrWhiteSpace(_promptText))
                    {
                        @("Enter a prompt above to continue.")
                    }
                    else
                    {
                        @("Left and Right models must be different.")
                    }
                </p>
            }
        </div>

        @if (_error is not null)
        {
            <p class="war-room__error">@_error</p>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? PromptParam { get; set; }
    [SupplyParameterFromQuery(Name = "leftModelId")] public string? LeftModelIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "rightModelId")] public string? RightModelIdParam { get; set; }

    private bool _loading = true;
    private List<ModelDto> _allModels = [];
    private Dictionary<string, string> _modelLabels = [];
    private ModelDto? _leftModel;
    private ModelDto? _rightModel;
    private string _promptText = string.Empty;
    private string? _error;

    private string _typeFilter = "All";
    private IEnumerable<ModelDto> _filteredModels => FilteredModels(_typeFilter);

    // ── Inline edit state ─────────────────────────────────────────────────
    private string? _editingModelId;
    private string _editDisplayName = string.Empty;
    private string _editApiEndpointRef = string.Empty;
    private string? _editError;
    private bool _editSaving;

    private void ToggleEdit(string modelId)
    {
        if (_editingModelId == modelId) { CancelEdit(); return; }
        var model = _allModels.FirstOrDefault(m => m.ModelId == modelId);
        if (model is null) return;
        _editingModelId = modelId;
        _editDisplayName = model.DisplayName;
        _editApiEndpointRef = model.ApiEndpointRef ?? string.Empty;
        _editError = null;
    }

    private void CancelEdit()
    {
        _editingModelId = null;
        _editError = null;
    }

    private async Task SaveEditAsync(string modelId)
    {
        _editSaving = true;
        _editError = null;
        try
        {
            var updated = await ApiClient.PatchModelAsync(
                modelId,
                string.IsNullOrWhiteSpace(_editDisplayName) ? null : _editDisplayName,
                string.IsNullOrWhiteSpace(_editApiEndpointRef) ? null : _editApiEndpointRef);

            if (updated is not null)
            {
                var idx = _allModels.FindIndex(m => m.ModelId == modelId);
                if (idx >= 0) _allModels[idx] = updated;
                // Rebuild disambiguated labels
                _modelLabels = _allModels
                    .GroupBy(m => m.DisplayName)
                    .SelectMany(g =>
                    {
                        bool dup = g.Count() > 1;
                        return g.Select(m => KeyValuePair.Create(
                            m.ModelId,
                            dup ? $"{m.DisplayName} (…{(m.ModelId.Length > 6 ? m.ModelId[^6..] : m.ModelId)})" : m.DisplayName));
                    })
                    .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
                CancelEdit();
            }
        }
        catch (Exception ex)
        {
            _editError = $"Save failed: {ex.Message}";
        }
        finally
        {
            _editSaving = false;
        }
    }


    private IEnumerable<ModelDto> FilteredModels(string filter) => filter switch
    {
        "Local"   => _allModels.Where(m => m.ModelType == ModelType.Local),
        "Remote"  => _allModels.Where(m => m.ModelType == ModelType.Remote),
        "Service" => _allModels.Where(m => m.ModelType == ModelType.LocalService),
        _         => _allModels
    };

    private bool CanCommence =>
        _leftModel is not null && _rightModel is not null &&
        _leftModel.ModelId != _rightModel.ModelId &&
        !string.IsNullOrWhiteSpace(_promptText);

    private bool IsCloudMode => _allModels.Count > 0 && !_allModels.Any(m => m.ModelType == ModelType.LocalService);


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var models = await ApiClient.GetModelsAsync();
            if (models is not null)
            {
                _allModels = models.ToList();

                // Build disambiguated labels for models sharing the same display name
                _modelLabels = _allModels
                    .GroupBy(m => m.DisplayName)
                    .SelectMany(g =>
                    {
                        bool dup = g.Count() > 1;
                        return g.Select(m => KeyValuePair.Create(
                            m.ModelId,
                            dup ? $"{m.DisplayName} (…{(m.ModelId.Length > 6 ? m.ModelId[^6..] : m.ModelId)})" : m.DisplayName));
                    })
                    .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

                // Pre-fill from query parameters (Re-Challenge flow)
                if (!string.IsNullOrEmpty(PromptParam))
                    _promptText = Uri.UnescapeDataString(PromptParam);

                if (!string.IsNullOrEmpty(LeftModelIdParam))
                    _leftModel = _allModels.FirstOrDefault(m => m.ModelId == LeftModelIdParam);

                if (!string.IsNullOrEmpty(RightModelIdParam))
                    _rightModel = _allModels.FirstOrDefault(m => m.ModelId == RightModelIdParam);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectLeft(ModelDto model) => _leftModel = model;
    private void SelectRight(ModelDto model) => _rightModel = model;

    // ── Sequential model selection: 1st click = left, 2nd click = right ──
    private void AssignModel(ModelDto model)
    {
        // Toggle off if already selected
        if (_leftModel?.ModelId == model.ModelId) { _leftModel = null; return; }
        if (_rightModel?.ModelId == model.ModelId) { _rightModel = null; return; }

        // Fill left first, then right
        if (_leftModel is null) { _leftModel = model; return; }
        if (_rightModel is null) { _rightModel = model; return; }

        // Both filled — replace right
        _rightModel = model;
    }

    private double? ComputeProjectedGain(ModelDto model)
    {
        // Show gain for selected models against their opponent
        if (model.ModelId == _leftModel?.ModelId) return ComputeGain(model, _rightModel);
        if (model.ModelId == _rightModel?.ModelId) return ComputeGain(model, _leftModel);
        // Unselected: show gain vs whichever opponent is already picked
        return ComputeGain(model, _leftModel ?? _rightModel);
    }

    private static double? ComputeGain(ModelDto? challenger, ModelDto? opponent)
    {
        if (challenger is null || opponent is null) return null;
        var expected = 1.0 / (1.0 + Math.Pow(10.0, (opponent.CurrentElo - challenger.CurrentElo) / 400.0));
        const double k = 32;
        return Math.Round(k * (1.0 - expected), 1);
    }

    private async Task CommenceDuelAsync()
    {
        if (!CanCommence) return;

        _error = null;

        try
        {
            await AudioService.PlaySnareRollAsync();

            var dto = await ApiClient.CommenceDuelAsync(
                _leftModel!.ModelId,
                _rightModel!.ModelId,
                _promptText);

            if (dto is not null)
                Nav.NavigateTo($"/processing/{dto.DuelId}");
        }
        catch (Exception ex)
        {
            _error = $"Failed to start duel: {ex.Message}";
        }
    }

    // UX#6: Keyboard shortcut N → focus prompt textarea (when no input/button is active target)
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "n" || e.Key == "N")
        {
            await JS.InvokeVoidAsync("eval", "var el = document.getElementById('promptInput'); if (el && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA' && document.activeElement?.tagName !== 'BUTTON') { el.focus(); el.select(); }");
        }
    }

    // ── Prompt Templates ──────────────────────────────────────────────────
    private PromptTemplate? _selectedTemplate;

    private void SelectTemplate(PromptTemplate template)
    {
        _selectedTemplate = template;
        _promptText = template.Prompt;
    }

    private void ClearPrompt()
    {
        _selectedTemplate = null;
        _promptText = string.Empty;
    }

    private bool IsTemplateSelected(PromptTemplate template) =>
        _selectedTemplate?.Id == template.Id;
}

<style>
    .war-room { max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem; }

    .war-room__title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        color: var(--oled-text);
    }

    /* Filter chips */
    .war-room__type-filter {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .war-room__filter-chip {
        padding: 0.5rem 1rem;
        border: 1px solid var(--oled-border);
        border-radius: var(--radius-full);
        background: var(--oled-surface);
        color: var(--oled-text-muted);
        cursor: pointer;
        transition: all var(--transition-fast);
        font-size: 0.875rem;
    }

    .war-room__filter-chip:hover {
        border-color: var(--oled-green);
        color: var(--oled-text);
    }

    .war-room__filter-chip--active {
        background: var(--oled-green);
        color: #000;
        border-color: var(--oled-green);
    }

    /* Slot assignment header (C2) */
    .war-room__assign-slots {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1.25rem;
    }

    .war-room__slot {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.85rem 1rem;
        background: var(--oled-surface);
        border: 2px dashed var(--oled-border);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all var(--transition-fast);
        position: relative;
        min-height: 64px;
        justify-content: center;
    }

    .war-room__slot:hover { border-color: var(--oled-text-muted); }
    .war-room__slot--active { border-color: var(--oled-cyan); border-style: solid; box-shadow: 0 0 0 2px rgba(6,182,212,0.25); }
    .war-room__slot--set { border-style: solid; border-color: var(--oled-green); }

    .war-room__slot-side {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--oled-text-muted);
    }

    .war-room__slot-name {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--oled-text);
    }

    .war-room__slot--set .war-room__slot-name { color: var(--oled-green); }

    .war-room__slot-clear {
        position: absolute;
        top: 0.4rem;
        right: 0.5rem;
        background: none;
        border: none;
        color: var(--oled-text-muted);
        cursor: pointer;
        font-size: 0.85rem;
        line-height: 1;
        padding: 0.15rem 0.35rem;
        border-radius: 50%;
        transition: color var(--transition-fast);
    }
    .war-room__slot-clear:hover { color: var(--oled-red); }

    .war-room__slot-vs {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--oled-text-muted);
        text-align: center;
    }

    @@media (max-width: 640px) {
        .war-room__assign-slots { grid-template-columns: 1fr; }
        .war-room__slot-vs { display: none; }
    }

    /* Unified model pool (C2) */
    .war-room__pool {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.75rem;
        margin-bottom: 2rem;
    }

    .war-room__pool-hint {
        grid-column: 1 / -1;
        font-size: 0.82rem;
        color: var(--oled-text-muted);
        margin: 0 0 0.25rem;
    }

    .war-room__pool-hint strong { color: var(--oled-cyan); }

    .war-room__empty {
        grid-column: 1 / -1;
        color: var(--oled-text-muted);
        font-size: 0.9rem;
    }

    /* Prompt Templates */
    .war-room__templates-section {
        background: var(--oled-surface);
        border: 1px solid var(--oled-border);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .war-room__templates-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .war-room__templates-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--oled-text);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }

    .war-room__clear-prompt {
        background: none;
        border: 1px solid var(--oled-border);
        color: var(--oled-text-muted);
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-sm);
        cursor: pointer;
        font-size: 0.8rem;
        transition: all var(--transition-fast);
    }

    .war-room__clear-prompt:hover {
        border-color: var(--oled-red);
        color: var(--oled-red);
    }

    .war-room__templates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 0.75rem;
    }

    .war-room__template-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        padding: 1rem 0.75rem;
        background: var(--oled-surface-elevated);
        border: 1px solid var(--oled-border);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all var(--transition-fast);
        text-align: center;
    }

    .war-room__template-card:hover {
        border-color: var(--oled-cyan);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(6, 182, 212, 0.2);
    }

    .war-room__template-card--selected {
        border-color: var(--oled-green);
        background: rgba(34, 197, 94, 0.1);
        box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.3);
    }

    .war-room__template-icon {
        font-size: 1.5rem;
    }

    .war-room__template-name {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--oled-text);
    }

    .war-room__template-category {
        font-size: 0.7rem;
        color: var(--oled-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Prompt section */
    .war-room__prompt-section { margin-bottom: 1.5rem; }

    .war-room__label {
        display: block;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--oled-text);
        margin-bottom: 0.5rem;
    }

    .war-room__hint {
        font-size: 0.8rem;
        color: var(--oled-text-muted);
        margin-bottom: 0.75rem;
    }

    .war-room__textarea {
        width: 100%;
        background: var(--oled-surface) !important;
        border: 1px solid var(--oled-border) !important;
        color: var(--oled-text) !important;
        border-radius: var(--radius-md) !important;
        padding: 1rem !important;
    }

    .war-room__textarea:focus {
        border-color: var(--oled-blue) !important;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2) !important;
    }

    /* Actions */
    .war-room__actions {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .war-room__commence-btn {
        min-width: 200px;
    }

    .war-room__validation-hint {
        font-size: 0.85rem;
        color: var(--oled-text-muted);
        margin: 0;
    }

    .war-room__error {
        color: var(--oled-red);
        font-size: 0.9rem;
        margin-top: 1rem;
    }

    .war-room__loading,
    .war-room__clash-warning {
        color: var(--oled-yellow);
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    /* Inline model edit */
    .war-room__pool-item {
        position: relative;
    }

    .war-room__edit-btn {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
        opacity: 0.4;
        padding: 0.2rem 0.35rem;
        border-radius: var(--radius-sm);
        transition: opacity var(--transition-fast), background var(--transition-fast);
        z-index: 1;
    }

    .war-room__edit-btn:hover {
        opacity: 1;
        background: rgba(255,255,255,0.07);
    }

    .war-room__edit-row {
        grid-column: 1 / -1;
        background: var(--oled-surface);
        border: 1px solid var(--oled-cyan);
        border-radius: var(--radius-md);
        padding: 0.85rem 1rem;
        margin-bottom: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .war-room__edit-label {
        font-size: 0.75rem;
        color: var(--oled-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .war-room__edit-input {
        background: #111;
        border: 1px solid var(--oled-border);
        color: var(--oled-text);
        border-radius: var(--radius-sm);
        padding: 0.4rem 0.6rem;
        font-size: 0.9rem;
        width: 100%;
        box-sizing: border-box;
    }

    .war-room__edit-input:focus {
        outline: none;
        border-color: var(--oled-cyan);
        box-shadow: 0 0 0 2px rgba(6,182,212,0.2);
    }

    .war-room__edit-error {
        color: var(--oled-red);
        font-size: 0.8rem;
        margin: 0;
    }

    .war-room__edit-actions {
        display: flex;
