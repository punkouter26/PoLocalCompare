@page "/war-room"
@using Microsoft.AspNetCore.Components.Web
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Radzen
@using Radzen.Blazor
@inject DuelApiClient ApiClient
@inject AudioService AudioService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>War Room - PoLocalCompare</PageTitle>

<div class="war-room" @onkeydown="OnKeyDown" tabindex="-1" id="war-room-root">
    <h1 class="war-room__title">War Room</h1>

    <ol class="war-room__steps" aria-label="Duel setup steps">
        <li class="war-room__step @(ActiveStep > 1 ? "war-room__step--done" : ActiveStep == 1 ? "war-room__step--active" : "")">
            <span class="war-room__step-number">1</span>
            <span class="war-room__step-label">Write prompt</span>
        </li>
        <li class="war-room__step @(ActiveStep > 2 ? "war-room__step--done" : ActiveStep == 2 ? "war-room__step--active" : "")">
            <span class="war-room__step-number">2</span>
            <span class="war-room__step-label">Pick two models</span>
        </li>
        <li class="war-room__step @(ActiveStep == 3 ? "war-room__step--active" : "")">
            <span class="war-room__step-number">3</span>
            <span class="war-room__step-label">Launch duel</span>
        </li>
    </ol>

    @if (!_loading)
    {
        <p class="war-room__mode-badge">
            @if (IsCloudMode)
            {
                <span>Cloud mode active. Service-backed Ollama models are hidden in this environment.</span>
            }
            else
            {
                <span>Local mode active. Service-backed Ollama models are available.</span>
            }
        </p>
    }

    @if (_loading)
    {
        <div class="war-room__loading-panel">
            <p class="war-room__loading-title">Preparing model roster...</p>
            <div class="war-room__loading-skeletons" aria-hidden="true">
                <div class="skeleton skeleton-card"></div>
                <div class="skeleton skeleton-card"></div>
                <div class="skeleton skeleton-card"></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_loadWarning))
            {
                <p class="war-room__loading-warning">@_loadWarning</p>
                <button class="war-room__retry-btn" @onclick="RetryLoadAsync">Retry loading models</button>
            }
        </div>
    }
    else
    {
        <section class="war-room__section">
            <p class="section-eyebrow">Step 1</p>
            <div class="war-room__prompt-section">
                <label class="war-room__label" for="promptInput">Prompt for a five-minute HTML duel</label>
                <p class="war-room__hint">Tip: local models can take longer on first warmup; remote models usually respond immediately.</p>
                <RadzenTextArea
                    id="promptInput"
                    @bind-Value="_promptText"
                    @oninput="@((ChangeEventArgs e) => { _promptText = e.Value?.ToString() ?? string.Empty; })"
                    Rows="6"
                    class="war-room__textarea"
                    spellcheck="true"
                    Placeholder="Describe the HTML app you want both models to build..."
                />
            </div>
        </section>

        <section class="war-room__section">
            <p class="section-eyebrow">Step 2</p>

            <div class="war-room__selection-bar">
                <div class="war-room__selection-slot @(_leftModel is not null ? "war-room__selection-slot--set" : "")">
                    <span class="war-room__selection-label">Left</span>
                    <span class="war-room__selection-name">@(_leftModel?.DisplayName ?? "Not selected")</span>
                </div>
                <span class="war-room__selection-vs">VS</span>
                <div class="war-room__selection-slot @(_rightModel is not null ? "war-room__selection-slot--set" : "")">
                    <span class="war-room__selection-label">Right</span>
                    <span class="war-room__selection-name">@(_rightModel?.DisplayName ?? "Not selected")</span>
                </div>
            </div>

            @if (_leftModel is not null && _rightModel is not null)
            {
                <div class="war-room__compare">
                    <div class="war-room__compare-card">
                        <span class="war-room__compare-model">@_leftModel.DisplayName</span>
                        <span class="war-room__compare-meta">ELO @Math.Round(_leftModel.CurrentElo)</span>
                    </div>
                    <div class="war-room__compare-center">
                        Left win chance @ComputeWinPct(_leftModel, _rightModel).ToString("F0")%
                    </div>
                    <div class="war-room__compare-card">
                        <span class="war-room__compare-model">@_rightModel.DisplayName</span>
                        <span class="war-room__compare-meta">ELO @Math.Round(_rightModel.CurrentElo)</span>
                    </div>
                </div>
            }

            <div class="war-room__controls-row">
                <input class="war-room__search-input"
                       @bind="_modelSearch"
                       @bind:event="oninput"
                       placeholder="Search models by name or id" />
                <select class="war-room__sort-select" @bind="_sortBy">
                    <option value="Recommended">Recommended</option>
                    <option value="Elo">ELO High-Low</option>
                    <option value="Name">Name A-Z</option>
                </select>
            </div>

            <div class="war-room__type-filter">
                @foreach (var label in new[] { "All", "Local", "Remote", "Service" })
                {
                    <button class="war-room__filter-chip @(_typeFilter == label ? "war-room__filter-chip--active" : "")"
                            @onclick="() => _typeFilter = label">
                        @label
                    </button>
                }
            </div>
            <p class="war-room__hint">Click a selected model again to unselect it, then choose a replacement.</p>

            <div class="war-room__pool">
                @if (!_filteredModels.Any())
                {
                    <p class="war-room__empty">No models match the current filters.</p>
                }
                else
                {
                    @foreach (var model in _filteredModels)
                    {
                        <div class="war-room__pool-item">
                            <div class="war-room__pool-item-head">
                                <span class="war-room__pool-type">@GetTypeLabel(model)</span>
                                <span class="war-room__pool-elo">ELO @Math.Round(model.CurrentElo)</span>
                            </div>
                            <ModelCard
                                Model="model"
                                LabelOverride="@(_modelLabels.GetValueOrDefault(model.ModelId))"
                                IsSelected="@(model.ModelId == _leftModel?.ModelId || model.ModelId == _rightModel?.ModelId)"
                                Slot="@(model.ModelId == _leftModel?.ModelId ? "Left" : model.ModelId == _rightModel?.ModelId ? "Right" : null)"
                                IsDisabled="@(!IsModelSelectable(model))"
                                OnSelected="AssignModel"
                                ProjectedEloGain="@ComputeProjectedGain(model)" />
                            @if (!IsModelSelectable(model))
                            {
                                <p class="war-room__availability-note">Unavailable: @GetUnavailableReason(model)</p>
                            }
                        </div>
                    }
                }
            </div>
        </section>

        @if (ActiveStep == 3)
        {
            <div class="war-room__ready-banner">
                <span class="war-room__ready-icon">✓</span>
                <span class="war-room__ready-text">Both models selected — ready to launch</span>
                <button class="war-room__ready-scroll" @onclick="ScrollToLaunchAsync">↓ Go to Step 3</button>
            </div>
        }

        <section class="war-room__section" id="launch-section">
            <div class="war-room__actions">
                <RadzenButton
                    Text="Start Duel"
                    ButtonStyle="ButtonStyle.Danger"
                    Size="ButtonSize.Large"
                    Disabled="@(!CanCommence)"
                    Click="@CommenceDuelAsync"
                    class="war-room__commence-btn"
                />
                @if (!CanCommence)
                {
                    <p class="war-room__validation-hint">
                        @if (_leftModel is null && _rightModel is null)
                        {
                            @("Pick two models below to continue.")
                        }
                        else if (_leftModel is null || _rightModel is null)
                        {
                            @("Pick a second model to continue.")
                        }
                        else if (string.IsNullOrWhiteSpace(_promptText))
                        {
                            @("Enter a prompt above to continue.")
                        }
                        else if ((_leftModel is not null && !IsModelSelectable(_leftModel)) || (_rightModel is not null && !IsModelSelectable(_rightModel)))
                        {
                            @("One or both selected models are unavailable. Pick confirmed working models.")
                        }
                        else
                        {
                            @("Left and Right models must be different.")
                        }
                    </p>
                }
            </div>

            @if (_error is not null)
            {
                <p class="war-room__error">@_error</p>
            }
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? PromptParam { get; set; }
    [SupplyParameterFromQuery(Name = "leftModelId")] public string? LeftModelIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "rightModelId")] public string? RightModelIdParam { get; set; }

    private bool _loading = true;
    private List<ModelDto> _allModels = [];
    private Dictionary<string, string> _modelLabels = [];
    private ModelDto? _leftModel;
    private ModelDto? _rightModel;
    private string _promptText = string.Empty;
    private string _modelSearch = string.Empty;
    private string _sortBy = "Recommended";
    private string? _loadWarning;
    private string? _error;
    private Dictionary<string, ModelAvailabilityDto> _availabilityByModelId = new(StringComparer.Ordinal);

    private string _typeFilter = "All";
    private IEnumerable<ModelDto> _filteredModels => FilteredModels(_typeFilter, _modelSearch, _sortBy);

    private bool HasPrompt => !string.IsNullOrWhiteSpace(_promptText);
    private bool HasPair => _leftModel is not null && _rightModel is not null && _leftModel.ModelId != _rightModel.ModelId;
    private int ActiveStep => !HasPrompt ? 1 : !HasPair ? 2 : 3;

    private async Task ScrollToLaunchAsync()
        => await JS.InvokeVoidAsync("eval", "document.getElementById('launch-section')?.scrollIntoView({behavior:'smooth',block:'start'})");

    private IEnumerable<ModelDto> FilteredModels(string filter, string search, string sortBy)
    {
        IEnumerable<ModelDto> query = filter switch
        {
            "Local" => _allModels.Where(m => m.ModelType == ModelType.Local),
            "Remote" => _allModels.Where(m => m.ModelType == ModelType.Remote),
            "Service" => _allModels.Where(m => m.ModelType == ModelType.LocalService),
            _ => _allModels
        };

        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(m =>
                m.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                m.ModelId.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        query = sortBy switch
        {
            "Elo" => query.OrderByDescending(m => m.CurrentElo),
            "Name" => query.OrderBy(m => m.DisplayName),
            _ => query
                .OrderByDescending(IsModelSelectable)
                .ThenByDescending(m => m.CurrentElo)
        };

        return query;
    }

    private bool CanCommence =>
        _leftModel is not null && _rightModel is not null &&
        _leftModel.ModelId != _rightModel.ModelId &&
        IsModelSelectable(_leftModel) && IsModelSelectable(_rightModel) &&
        !string.IsNullOrWhiteSpace(_promptText);

    private bool IsCloudMode => _allModels.Count > 0 && !_allModels.Any(m => m.ModelType == ModelType.LocalService);

    protected override async Task OnInitializedAsync()
    {
        await LoadModelsAsync();
    }

    private async Task LoadModelsAsync()
    {
        _loading = true;
        _loadWarning = null;
        _error = null;

        try
        {
            var modelsTask = ApiClient.GetModelsAsync();
            var completedTask = await Task.WhenAny(modelsTask, Task.Delay(TimeSpan.FromSeconds(12)));

            if (completedTask != modelsTask)
            {
                _loadWarning = "Model loading is taking longer than expected. Retry to refresh availability.";
                return;
            }

            var models = await modelsTask;
            if (models is null)
            {
                _loadWarning = "No model metadata returned from the API.";
                return;
            }

            _allModels = models.ToList();

            _modelLabels = _allModels
                .GroupBy(m => m.DisplayName)
                .SelectMany(g =>
                {
                    var dup = g.Count() > 1;
                    return g.Select(m => KeyValuePair.Create(
                        m.ModelId,
                        dup ? $"{m.DisplayName} (...{(m.ModelId.Length > 6 ? m.ModelId[^6..] : m.ModelId)})" : m.DisplayName));
                })
                .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

            await RefreshAvailabilityAsync();

            if (!string.IsNullOrWhiteSpace(PromptParam))
                _promptText = Uri.UnescapeDataString(PromptParam);
            if (!string.IsNullOrWhiteSpace(LeftModelIdParam))
                _leftModel = _allModels.FirstOrDefault(m => m.ModelId == LeftModelIdParam);
            if (!string.IsNullOrWhiteSpace(RightModelIdParam))
                _rightModel = _allModels.FirstOrDefault(m => m.ModelId == RightModelIdParam);

            if (_leftModel is not null && !IsModelSelectable(_leftModel)) _leftModel = null;
            if (_rightModel is not null && !IsModelSelectable(_rightModel)) _rightModel = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RetryLoadAsync()
    {
        await LoadModelsAsync();
    }

    private void AssignModel(ModelDto model)
    {
        if (!IsModelSelectable(model)) return;

        if (_leftModel?.ModelId == model.ModelId) { _leftModel = null; return; }
        if (_rightModel?.ModelId == model.ModelId) { _rightModel = null; return; }

        if (_leftModel is null) { _leftModel = model; return; }
        if (_rightModel is null) { _rightModel = model; return; }

        _rightModel = model;
    }

    private bool IsModelSelectable(ModelDto model)
    {
        if (_availabilityByModelId.TryGetValue(model.ModelId, out var status))
            return status.IsAvailable;
        return model.ModelType == ModelType.Local;
    }

    private string GetUnavailableReason(ModelDto model)
    {
        if (_availabilityByModelId.TryGetValue(model.ModelId, out var status) && !string.IsNullOrWhiteSpace(status.Reason))
            return status.Reason;
        return "Not confirmed available right now.";
    }

    private string GetTypeLabel(ModelDto model) => model.ModelType switch
    {
        ModelType.Local => "LOCAL",
        ModelType.Remote => "REMOTE",
        ModelType.LocalService => "SERVICE",
        _ => "UNKNOWN"
    };

    private async Task RefreshAvailabilityAsync()
    {
        var availability = await ApiClient.GetModelAvailabilityAsync();
        if (availability is null)
        {
            _availabilityByModelId = new Dictionary<string, ModelAvailabilityDto>(StringComparer.Ordinal);
            return;
        }

        _availabilityByModelId = availability
            .Where(a => !string.IsNullOrWhiteSpace(a.ModelId))
            .ToDictionary(a => a.ModelId, a => a, StringComparer.Ordinal);
    }

    private double? ComputeProjectedGain(ModelDto model)
    {
        if (model.ModelId == _leftModel?.ModelId) return ComputeGain(model, _rightModel);
        if (model.ModelId == _rightModel?.ModelId) return ComputeGain(model, _leftModel);
        return ComputeGain(model, _leftModel ?? _rightModel);
    }

    private static double? ComputeGain(ModelDto? challenger, ModelDto? opponent)
    {
        if (challenger is null || opponent is null) return null;
        var expected = 1.0 / (1.0 + Math.Pow(10.0, (opponent.CurrentElo - challenger.CurrentElo) / 400.0));
        const double k = 32;
        return Math.Round(k * (1.0 - expected), 1);
    }

    private static double ComputeWinPct(ModelDto left, ModelDto right)
    {
        var expected = 1.0 / (1.0 + Math.Pow(10.0, (right.CurrentElo - left.CurrentElo) / 400.0));
        return expected * 100.0;
    }

    private async Task CommenceDuelAsync()
    {
        if (!CanCommence) return;

        _error = null;

        try
        {
            await AudioService.PlaySnareRollAsync();
            var dto = await ApiClient.CommenceDuelAsync(_leftModel!.ModelId, _rightModel!.ModelId, _promptText);
            if (dto is not null)
                Nav.NavigateTo($"/processing/{dto.DuelId}");
        }
        catch (Exception ex)
        {
            _error = $"Failed to start duel: {ex.Message}";
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "n" || e.Key == "N")
        {
            await JS.InvokeVoidAsync("eval", "var el = document.getElementById('promptInput'); if (el && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA' && document.activeElement?.tagName !== 'BUTTON') { el.focus(); el.select(); }");
        }
    }
}