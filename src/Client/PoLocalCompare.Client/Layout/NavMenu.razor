@implements IDisposable
<nav class="topnav navbar navbar-expand-md navbar-dark">
    @* ── USING MOCK DATA banner (standards §7) — shown when UseRealAi is off ── *@
    @if (_usingMockData)
    {
        <div class="mock-data-banner" role="alert" aria-live="polite">
            ⚠ USING MOCK DATA — Features:UseRealAi is disabled. AI responses are simulated.
        </div>
    }
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="brand-mark" aria-hidden="true">PL</span>
            <span class="brand-text">PoLocalCompare</span>
        </a>

        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu" aria-expanded="@(!collapseNavMenu)" aria-controls="navbarLinks">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass" id="navbarLinks">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="nav-text">Compare</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="leaderboard">
                        <span class="nav-text">Leaderboard</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="archive">
                        <span class="nav-text">Archive</span>
                    </NavLink>
                </li>
                <li class="nav-item nav-item--kebab" @onclick="ToggleToolsMenu" @onclick:stopPropagation="true">
                    <button class="nav-link nav-kebab" aria-label="More tools" aria-expanded="@_toolsMenuOpen">
                        <span aria-hidden="true">⋯</span>
                    </button>
                    @if (_toolsMenuOpen)
                    {
                        <ul class="nav-kebab-menu" role="menu">
                            <li role="menuitem">
                                <NavLink class="nav-kebab-link" href="local-model-lab" @onclick="CloseToolsMenu">
                                    🧪 Local Lab
                                </NavLink>
                            </li>
                            <li role="menuitem">
                                <NavLink class="nav-kebab-link" href="lobby" @onclick="CloseToolsMenu">
                                    🎮 Lobby
                                </NavLink>
                            </li>
                        </ul>
                    }
                </li>
            </ul>

            @* ── User identity / auth (standards §6) ── *@
            <div class="navbar-nav ms-auto align-items-center gap-2 nav-auth">
                @if (_identity is not null)
                {
                    <span class="nav-user-badge @(_isGuest ? "nav-user-badge--guest" : "nav-user-badge--oauth")"
                          title="@(_isGuest ? "Guest session — data is not persisted" : "Signed in via Microsoft")">
                        @_identity
                    </span>
                    <button class="btn btn-sm btn-outline-secondary nav-logout" @onclick="LogoutAsync">Logout</button>
                }
                else
                {
                    <button class="btn btn-sm btn-ms-nav" @onclick="LoginWithMicrosoft">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 21 21" width="14" height="14" style="margin-right:0.35rem;vertical-align:middle">
                            <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                            <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                            <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                            <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                        </svg>
                        Sign in
                    </button>
                    @if (_allowGuest)
                    {
                        <button class="btn btn-sm btn-outline-warning nav-guest-btn" @onclick="LoginAsGuestAsync">
                            Guest
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</nav>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment { get; set; } = default!;

    private bool collapseNavMenu = true;
    private string? _identity;
    private bool _isGuest;
    private bool _usingMockData;
    private bool _allowGuest;
    private bool _toolsMenuOpen;

    private string NavMenuCssClass => collapseNavMenu ? "navbar-collapse" : "navbar-collapse nav-open";

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
    private void ToggleToolsMenu() => _toolsMenuOpen = !_toolsMenuOpen;
    private void CloseToolsMenu() => _toolsMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;

        var allowGuestByConfig = string.Equals(Config["Auth:AllowGuest"], "true", StringComparison.OrdinalIgnoreCase);
        var isProduction = string.Equals(HostEnvironment.Environment, "Production", StringComparison.OrdinalIgnoreCase);
        _allowGuest = allowGuestByConfig && !isProduction;

        await RefreshIdentityAsync();

        var useRealAi = Config["Features:UseRealAi"];
        _usingMockData = !bool.TryParse(useRealAi, out var flag) || !flag;
    }

    /// <summary>Resolves the current identity from the BFF session (/auth/me via the state provider).</summary>
    private async Task RefreshIdentityAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated == true)
            {
                _identity = state.User.FindFirst("preferred_username")?.Value
                         ?? state.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                         ?? state.User.Identity.Name;
                _isGuest = _identity?.StartsWith("GUEST", StringComparison.OrdinalIgnoreCase) == true
                        || state.User.IsInRole("Guest");
            }
            else
            {
                _identity = null;
                _isGuest = false;
            }
        }
        catch
        {
            _identity = null;
            _isGuest = false;
        }
    }

    private void LoginWithMicrosoft()
        => Nav.NavigateTo($"auth/login/microsoft?returnUrl={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}", forceLoad: true);

    private void LoginAsGuestAsync()
        => Nav.NavigateTo($"auth/login/fake?returnUrl={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}", forceLoad: true);

    private async Task LogoutAsync()
    {
        try { await Http.PostAsync("auth/logout", null); }
        catch { /* clear UI regardless */ }
        // Full reload re-evaluates the (now cleared) session and renders the Login view.
        Nav.NavigateTo("/", forceLoad: true);
    }

    private void OnAuthStateChanged(Task<AuthenticationState> _)
        => InvokeAsync(async () =>
        {
            await RefreshIdentityAsync();
            StateHasChanged();
        });

    public void Dispose()
    {
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
