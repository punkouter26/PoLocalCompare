<nav class="topnav navbar navbar-expand-md navbar-dark">
    @* ── USING MOCK DATA banner (standards §7) — shown when UseRealAi is off ── *@
    @if (_usingMockData)
    {
        <div class="mock-data-banner" role="alert" aria-live="polite">
            ⚠ USING MOCK DATA — Features:UseRealAi is disabled. AI responses are simulated.
        </div>
    }
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="brand-mark" aria-hidden="true">PL</span>
            <span class="brand-text">PoLocalCompare</span>
        </a>

        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu" aria-expanded="@(!collapseNavMenu)" aria-controls="navbarLinks">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass" id="navbarLinks">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="nav-text">Dashboard</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="war-room">
                        <span class="nav-text">War Room</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="leaderboard">
                        <span class="nav-text">Leaderboard</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="archive">
                        <span class="nav-text">Archive</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="local-model-lab">
                        <span class="nav-text">Local Lab</span>
                    </NavLink>
                </li>
            </ul>

            @* ── User identity / auth (standards §6) ── *@
            <div class="navbar-nav ms-auto align-items-center gap-2 nav-auth">
                @if (_identity is not null)
                {
                    <span class="nav-user-badge @(_isGuest ? "nav-user-badge--guest" : "nav-user-badge--oauth")"
                          title="@(_isGuest ? "Guest session — data is not persisted" : "Signed in via Microsoft")">
                        @(_isGuest ? $"{_identity} LOGGED IN" : _identity)
                    </span>
                    <button class="btn btn-sm btn-outline-secondary nav-logout" @onclick="LogoutAsync">Logout</button>
                }
                else
                {
                    <button class="btn btn-sm btn-ms-nav" @onclick="LoginWithMicrosoft">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 21 21" width="14" height="14" style="margin-right:0.35rem;vertical-align:middle">
                            <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                            <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                            <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                            <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                        </svg>
                        Sign in
                    </button>
                    @if (_allowGuest)
                    {
                        <button class="btn btn-sm btn-outline-warning nav-guest-btn" @onclick="LoginAsGuestAsync">
                            Guest
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</nav>

@code {
    [Inject] private GuestAuthService GuestAuth { get; set; } = default!;
    [Inject] private IConfiguration Config { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;

    private bool collapseNavMenu = true;
    private string? _identity;
    private bool _isGuest;
    private bool _usingMockData;
    private bool _allowGuest;

    private string NavMenuCssClass => collapseNavMenu ? "navbar-collapse" : "navbar-collapse nav-open";

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    protected override async Task OnInitializedAsync()
    {
        GuestAuth.OnChange += OnAuthChanged;
        _allowGuest = string.Equals(Config["Auth:AllowGuest"], "true", StringComparison.OrdinalIgnoreCase);
        _identity = await GuestAuth.GetIdentityAsync();
        _isGuest = GuestAuth.IsGuest;

        var useRealAi = Config["Features:UseRealAi"];
        _usingMockData = !bool.TryParse(useRealAi, out var flag) || !flag;
    }

    private void LoginWithMicrosoft()
    {
        Nav.NavigateTo($"authentication/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}");
    }

    private async Task LoginAsGuestAsync()
    {
        await GuestAuth.LoginAsGuestAsync();
        _identity = await GuestAuth.GetIdentityAsync();
        _isGuest = GuestAuth.IsGuest;
    }

    private async Task LogoutAsync()
    {
        await GuestAuth.LogoutAsync();
        _identity = null;
        _isGuest = false;

        // If signed in via Microsoft, also sign out of MSAL
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Nav.NavigateTo("authentication/logout");
    }

    private void OnAuthChanged()
    {
        _isGuest = GuestAuth.IsGuest;
        InvokeAsync(async () =>
        {
            _identity = await GuestAuth.GetIdentityAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => GuestAuth.OnChange -= OnAuthChanged;
}
