@* Top horizontal navbar — portrait/phone-first layout (Rule 10) *@
<nav class="topnav navbar navbar-expand-md navbar-dark">
    <div class="container-fluid">
        @* App name left-aligned *@
        <a class="navbar-brand" href="">
            <span class="brand-icon">⚔️</span>
            <span class="brand-text">LLM Duel Arena</span>
        </a>

        @* Hamburger for mobile portrait *@
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu" aria-expanded="@(!collapseNavMenu)" aria-controls="navbarLinks">
            <span class="navbar-toggler-icon"></span>
        </button>

        @* Nav links — collapse into hamburger on narrow screens *@
        <div class="@NavMenuCssClass" id="navbarLinks">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="war-room">
                        <span class="nav-icon" aria-hidden="true">&#x2694;&#xFE0F;</span>
                        <span class="nav-text">War Room</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="leaderboard">
                        <span class="nav-icon" aria-hidden="true">&#x1F3C6;</span>
                        <span class="nav-text">Leaderboard</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="archive">
                        <span class="nav-icon" aria-hidden="true">&#x1F4C1;</span>
                        <span class="nav-text">Archive</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="local-model-lab">
                        <span class="nav-icon" aria-hidden="true">&#x1F9EA;</span>
                        <span class="nav-text">Local Lab</span>
                    </NavLink>
                </li>
            </ul>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;

    // Builder pattern: collapsible nav state collapses/expands on toggle
    private string NavMenuCssClass => collapseNavMenu ? "navbar-collapse" : "navbar-collapse nav-open";

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}
