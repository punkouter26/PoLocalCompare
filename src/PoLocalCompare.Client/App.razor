@using Microsoft.AspNetCore.Components.Authorization
@using PoLocalCompare.Client.Pages

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @* AuthorizeRouteView already wraps this content in DefaultLayout (MainLayout).
                       Do NOT add another LayoutView here — it double-nests the nav bar. *@
                    <Login />
                </NotAuthorized>
                <Authorizing>
                    <div class="auth-spinner"><p>Loading&hellip;</p></div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
