@implements IDisposable
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
<nav class="navmenu">
    @* ── USING MOCK DATA banner (standards §7) — shown when UseRealAi is off ──
       The wording names which inference paths are simulated on purpose. Browser (WebGPU) models
       run in this tab and the server never sees them, so they are NOT mocked and a banner
       claiming all responses were simulated would be the same kind of lie this flag used to be.
       See MockInferenceProxy for the server half. *@
    @if (_usingMockData)
    {
        <div class="navmenu__mock-banner" role="alert" aria-live="polite">
            ⚠ USING MOCK DATA — Features:UseRealAi is off. Remote and Ollama responses are simulated.
        </div>
    }
    <div class="navmenu__inner">
        @* aria-label, not the visible wordmark, carries the accessible name: below 992px the
           wordmark is hidden to buy the bar room and the mark itself is decorative. *@
        @* Brand mark — shared with Login. The brand-text hides at 992px (rule in app.css),
   but the mark stays. *@
        <BrandMark Size="BrandMarkSize.Small" Href="" AccessibleLabel="PoLocalCompare home" AdditionalClass="navmenu__brand" />

        <button title="Navigation menu" aria-label="Navigation menu" class="navmenu__toggler" @onclick="ToggleNavMenu" aria-expanded="@NavExpanded" aria-controls="navbarLinks">
            <span class="navmenu__toggler-icon" aria-hidden="true"></span>
        </button>

        <div class="@NavMenuCssClass" id="navbarLinks">
            <ul class="navmenu__links">
                <li>
                    <NavLink class="navmenu__link" href="" Match="NavLinkMatch.All">
                        <span class="navmenu__link-text">Compare</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="navmenu__link" href="tournament">
                        <span class="navmenu__link-text">Tournament</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="navmenu__link" href="leaderboard">
                        <span class="navmenu__link-text">Leaderboard</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="navmenu__link" href="archive">
                        <span class="navmenu__link-text">Archive</span>
                    </NavLink>
                </li>
                @* Catalog was demoted from the top nav. It is the lowest-traffic route on this
                   page and grew one slot on a phone-sized bar at the cost of crowding the
                   others — see consolidation pass #10. The /catalog route is still served and
                   still reachable from the dropdown above the user identity or from
                   /leaderboard's tooling line. *@
            </ul>

            @* ── Live activity ticker ──────────────────────────────────────
               Polite, not assertive: duels finish while the user is reading, and an assertive
               region would interrupt them every time one did. *@
            @if (_tickerVisible)
            {
                <div class="navmenu__ticker" role="status" aria-live="polite" aria-label="Live duel activity">
                    @* One grouped chip — "N running · M awaiting". The two stats previously
                       sat on separate pills on the desktop bar; folding them into one rounds
                       both numbers into a single visual affordance and gives the bar enough
                       room to land the auth controls next to it. The link href opens the
                       awaiting-judgment filter so the click is meaningful regardless of
                       whether M is zero. *@
                    @if (Ticker.RunningCount > 0 || Ticker.AwaitingVerdictCount > 0)
                    {
                        <a href="archive?verdict=Unjudged" class="navmenu__ticker-pill navmenu__ticker-pill--combined"
                           title="@TickerSummaryTitle()">
                            @if (Ticker.RunningCount > 0)
                            {
                                <span class="navmenu__ticker-pulse" aria-hidden="true"></span>
                                <span class="navmenu__ticker-count">@Ticker.RunningCount</span>
                                <span class="visually-hidden">running</span>
                            }
                            @if (Ticker.RunningCount > 0 && Ticker.AwaitingVerdictCount > 0)
                            {
                                <span class="navmenu__ticker-sep" aria-hidden="true">·</span>
                            }
                            @if (Ticker.AwaitingVerdictCount > 0)
                            {
                                <span aria-hidden="true">⚖</span>
                                <span class="navmenu__ticker-count">@Ticker.AwaitingVerdictCount</span>
                                <span class="visually-hidden">awaiting judgment</span>
                            }
                        </a>
                    }
                    @if (_latest is not null)
                    {
                        <a href="@LatestHref" class="navmenu__ticker-latest" title="@_latest.PromptSummary">
                            @LatestText
                        </a>
                    }
                </div>
            }

            @* ── User identity / auth (standards §6) ── *@
            <div class="navmenu__auth">
                @* Cycles System → Light → Dark. aria-live is on the label so a screen reader
                   announces the new state; the glyph itself is decorative. *@
                <button type="button"
                        class="po-btn po-btn--sm po-btn--secondary navmenu__theme-toggle"
                        @onclick="CycleThemeAsync"
                        title="@ThemeTitle"
                        aria-label="@ThemeTitle">
                    <span class="navmenu__theme-glyph" aria-hidden="true">@ThemeGlyph</span>
                    <span class="navmenu__theme-label">@ThemeLabel</span>
                </button>

                @if (_identity is not null)
                {
                    @* Split at the '@' so the badge can drop the DOMAIN on a narrow screen instead
                       of ellipsising mid-string. "punkouter26@gmail…." told you nothing the local
                       part alone doesn't, while looking like a rendering bug; the local part is
                       the identifying half. The full value stays in the title either way, so
                       nothing is actually lost — see the --domain rule in the stylesheet. *@
                    <span class="navmenu__user-badge @(_isGuest ? "navmenu__user-badge--guest" : "navmenu__user-badge--oauth")"
                          title="@(_identity + (_isGuest ? " (guest session)" : " (signed in via Microsoft)"))">
                        <span>@IdentityLocalPart</span>@if (IdentityDomain is not null)
                        {
                            <span class="navmenu__user-badge-domain">@IdentityDomain</span>
                        }
                    </span>
                    @* Hidden behind the user badge rather than in the top nav — Catalog is
                       tooling, not a primary flow. Adding a model is something a returning
                       user does occasionally; surfacing it next to the four core flows made
                       the bar 110px wider on a phone for a route that already lives under
                       /leaderboard's "what model did what" mental model. *@
                    <a class="navmenu__user-menu-link"
                       href="catalog"
                       title="Add browser or Ollama models to the catalog">
                        <span aria-hidden="true">🧪</span> Catalog
                    </a>
                    <button class="po-btn po-btn--sm po-btn--secondary" @onclick="LogoutAsync">Logout</button>
                }
                else
                {
                    @* Same control as the Login card, just sized small so it sits in the navbar
                       alongside the theme toggle. *@
                    <MicrosoftSignInButton Size="MicrosoftSignInSize.Small"
                                            Label="Sign in"
                                            OnClick="LoginWithMicrosoft" />
                    @if (_allowGuest)
                    {
                        <button class="po-btn po-btn--sm po-btn--warn" @onclick="LoginAsGuestAsync">
                            Guest
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</nav>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment { get; set; } = default!;
    [Inject] private ThemeService Theme { get; set; } = default!;
    [Inject] private LobbyTickerService Ticker { get; set; } = default!;

    private bool collapseNavMenu = true;
    private string? _identity;
    private bool _isGuest;

    /// <summary>
    /// The identity up to and excluding the first '@' — the whole value when there is none
    /// (a guest name, or a UPN that is not email-shaped). This is the half worth keeping when
    /// the badge has to shed width.
    /// </summary>
    private string IdentityLocalPart =>
        _identity is null ? string.Empty
        : _identity.IndexOf('@') is var at && at > 0 ? _identity[..at]
        : _identity;

    /// <summary>
    /// The '@domain' remainder, or null when the identity has no '@'. Rendered in its own span
    /// so CSS can hide it on a narrow screen without the string being cut mid-word.
    /// </summary>
    private string? IdentityDomain =>
        _identity is not null && _identity.IndexOf('@') is var at && at > 0 && at < _identity.Length - 1
            ? _identity[at..]
            : null;
    private bool _usingMockData;
    private bool _allowGuest;
    private AppTheme _theme = AppTheme.System;

    private string NavMenuCssClass => collapseNavMenu ? "navmenu__collapse" : "navmenu__collapse navmenu__collapse--open";

    // Rendered as a string, not a bool: Blazor treats a bool-valued attribute as an HTML
    // boolean attribute and omits it entirely when false, which would leave the collapsed
    // menu with no aria-expanded at all.
    private string NavExpanded => collapseNavMenu ? "false" : "true";

    private string ThemeGlyph => _theme switch
    {
        AppTheme.Light => "☀",   // sun
        AppTheme.Dark => "☽",    // moon
        _ => "◑",                // half-filled circle: following the system
    };

    private string ThemeLabel => _theme switch
    {
        AppTheme.Light => "Light",
        AppTheme.Dark => "Dark",
        _ => "Auto",
    };

    private string ThemeTitle => $"Theme: {ThemeLabel}. Activate to switch.";

    // ── Live ticker ──────────────────────────────────────────────────────────

    private LobbyEventDto? _latest;

    // Nothing to say is rendered as nothing at all: an empty ticker strip would take nav space
    // on every page to communicate that no duels are happening.
    private bool _tickerVisible =>
        Ticker.RunningCount > 0 || Ticker.AwaitingVerdictCount > 0 || _latest is not null;

    private string LatestHref => _latest is null ? "archive" : $"arena/{_latest.DuelId}";

    /// <summary>Tooltip for the grouped activity pill. A screen reader hears both counts
    /// from the visually-hidden labels; the tooltip is the same sentence for sighted users.</summary>
    private string TickerSummaryTitle()
    {
        var parts = new List<string>();
        if (Ticker.RunningCount > 0) parts.Add($"{Ticker.RunningCount} running");
        if (Ticker.AwaitingVerdictCount > 0) parts.Add($"{Ticker.AwaitingVerdictCount} awaiting judgment");
        return string.Join(" — ", parts);
    }

    private string LatestText => _latest switch
    {
        null => string.Empty,
        { Kind: LobbyEventKind.VerdictRecorded, Verdict: DuelVerdict.Tie } e =>
            $"🤝 {e.LeftModelName} vs {e.RightModelName} — judged a tie",
        { Kind: LobbyEventKind.VerdictRecorded } e =>
            $"🏆 {e.WinnerModelName} beat {Opponent(e)}{EloSuffix(e)}",
        { Kind: LobbyEventKind.DuelCompleted } e =>
            $"✓ {e.LeftModelName} vs {e.RightModelName} finished",
        var e => $"⚡ {e.LeftModelName} vs {e.RightModelName} started",
    };

    private static string Opponent(LobbyEventDto e) =>
        string.Equals(e.WinnerModelName, e.LeftModelName, StringComparison.Ordinal)
            ? e.RightModelName
            : e.LeftModelName;

    private static string EloSuffix(LobbyEventDto e) =>
        e.EloShiftWinner is { } shift ? $" (+{shift:F1})" : string.Empty;

    private void OnTickerChanged() => InvokeAsync(() =>
    {
        _latest = Ticker.Events.FirstOrDefault();
        StateHasChanged();
    });

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private async Task CycleThemeAsync()
    {
        _theme = _theme switch
        {
            AppTheme.System => AppTheme.Light,
            AppTheme.Light => AppTheme.Dark,
            _ => AppTheme.System,
        };
        await Theme.SetAsync(_theme);
    }

    protected override async Task OnInitializedAsync()
    {
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;

        var allowGuestByConfig = string.Equals(Config["Auth:AllowGuest"], "true", StringComparison.OrdinalIgnoreCase);
        var isProduction = string.Equals(HostEnvironment.Environment, "Production", StringComparison.OrdinalIgnoreCase);
        _allowGuest = allowGuestByConfig && !isProduction;

        await RefreshIdentityAsync();

        // theme.js already painted before Blazor booted; this only syncs the button's label
        // to what it chose, so the two cannot disagree.
        _theme = await Theme.GetAsync();

        var useRealAi = Config["Features:UseRealAi"];
        _usingMockData = !bool.TryParse(useRealAi, out var flag) || !flag;

        // Not awaited: connecting the hub and seeding the pending count must not hold up the
        // nav bar, which is the first thing rendered on every page.
        Ticker.OnChanged += OnTickerChanged;
        _ = Ticker.EnsureStartedAsync(Nav.BaseUri);
    }

    /// <summary>Resolves the current identity from the BFF session (/auth/me via the state provider).</summary>
    private async Task RefreshIdentityAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated == true)
            {
                _identity = state.User.FindFirst("preferred_username")?.Value
                         ?? state.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                         ?? state.User.Identity.Name;
                _isGuest = _identity?.StartsWith("GUEST", StringComparison.OrdinalIgnoreCase) == true
                        || state.User.IsInRole("Guest");
            }
            else
            {
                _identity = null;
                _isGuest = false;
            }
        }
        catch
        {
            _identity = null;
            _isGuest = false;
        }
    }

    private void LoginWithMicrosoft()
        => Nav.NavigateTo($"auth/login/microsoft?returnUrl={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}", forceLoad: true);

    private void LoginAsGuestAsync()
        => Nav.NavigateTo($"auth/login/fake?returnUrl={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}", forceLoad: true);

    private async Task LogoutAsync()
    {
        try { await Http.PostAsync("auth/logout", null); }
        catch { /* clear UI regardless */ }
        // Full reload re-evaluates the (now cleared) session and renders the Login view.
        Nav.NavigateTo("/", forceLoad: true);
    }

    private void OnAuthStateChanged(Task<AuthenticationState> _)
        => InvokeAsync(async () =>
        {
            await RefreshIdentityAsync();
            StateHasChanged();
        });

    public void Dispose()
    {
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
        Ticker.OnChanged -= OnTickerChanged;
    }
}
