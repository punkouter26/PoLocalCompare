@using PoLocalCompare.Client.Pages

<div class="lab-card__card @GetCardClass(State) @GetCardDownloadClass(State)">

    @* Header row *@
    <div class="lab-card__card-header">
        <div class="lab-card__card-title">
            <div class="lab-card__card-title-main">
                <span class="lab-card__model-name">@FormatDisplayName(State.Model.DisplayName)</span>
                @if (!State.IsOllamaModel && State.VramTier == "warn")
                {
                    <span class="lab-card__vram-warn" aria-hidden="true" title="High VRAM — may fail on integrated or low-VRAM GPUs">⚠</span>
                }
            </div>
            <div class="lab-card__card-title-meta">
                @if (State.IsRemoteModel)
                {
                    <span class="lab-card__vram-badge lab-card__vram-badge--remote" title="Runs on Azure AI Foundry">☁ Remote</span>
                }
                else if (State.IsOllamaModel)
                {
                    <span class="lab-card__vram-badge lab-card__vram-badge--ollama" title="Runs via local Ollama daemon">🦙 Ollama</span>
                }
                else if (State.VramMb > 0)
                {
                    <span class="lab-card__vram-badge lab-card__vram-badge--@State.VramTier"
                          title="Estimated GPU VRAM required: @State.VramLabel">@State.VramLabel</span>
                }
            </div>
            @if (!State.IsOllamaModel && State.VramTier == "warn")
            {
                <span class="lab-card__vram-hint">High VRAM requirement</span>
            }
        </div>
        <div class="lab-card__card-actions">
            @* Remote models are verified by reachability (no in-browser run). *@
            @if (!State.IsRemoteModel)
            {
                @if (State.Status is DiagStatus.Idle or DiagStatus.Complete or DiagStatus.Error or DiagStatus.Cancelled)
                {
                    <button class="po-btn po-btn--sm po-btn--primary lab-card__icon-btn"
                            title="Run diagnostic"
                            aria-label="Run diagnostic for @FormatDisplayName(State.Model.DisplayName)"
                            @onclick="HandleRun"
                            disabled="@(State.IsDownloaded != true || (!State.IsOllamaModel && WebGpuSupported != true))">
                        <span aria-hidden="true">▶</span>
                    </button>
                }
                else
                {
                    <button class="po-btn po-btn--sm po-btn--danger lab-card__icon-btn"
                            title="Cancel"
                            aria-label="Cancel diagnostic for @FormatDisplayName(State.Model.DisplayName)"
                            @onclick="HandleCancel">
                        <span aria-hidden="true">■</span>
                    </button>
                }
            }
        </div>
    </div>

    @* Model ID chip — show ApiEndpointRef for Ollama, WebLlmModelId for browser *@
    <div class="lab-card__model-id">@(State.IsOllamaModel ? State.Model.ApiEndpointRef : State.Model.WebLlmModelId)</div>

    @* Download status — Ollama & Remote models show availability instead *@
    <div class="lab-card__download-row">
        @if (State.IsRemoteModel)
        {
            @if (State.IsDownloaded is null)
            {
                <span class="lab-card__badge lab-card__badge--checking">⏳ Checking deployment…</span>
            }
            else if (State.IsDownloaded == true)
            {
                <span class="lab-card__badge lab-card__badge--ok">✅ Deployment reachable</span>
            }
            else
            {
                <span class="lab-card__badge lab-card__badge--missing">⚠ Azure deployment unreachable</span>
            }
        }
        else if (State.IsOllamaModel)
        {
            @if (State.IsDownloaded is null)
            {
                <span class="lab-card__badge lab-card__badge--checking">⏳ Checking Ollama…</span>
            }
            else if (State.IsDownloaded == true)
            {
                <span class="lab-card__badge lab-card__badge--ok">✅ Available in Ollama</span>
            }
            else
            {
                <span class="lab-card__badge lab-card__badge--missing">⚠ Not found in Ollama — run <code>ollama pull @State.Model.ApiEndpointRef</code></span>
            }
        }
        else
        {
            @if (State.IsDownloaded is null)
            {
                <span class="lab-card__badge lab-card__badge--checking">⏳ Checking…</span>
            }
            else if (State.IsDownloaded == true)
            {
                <span class="lab-card__badge lab-card__badge--ok">@(State.UsesCdnAssets ? "☁ Ready via CDN" : "✅ Downloaded locally")</span>
            }
            else
            {
                <span class="lab-card__badge lab-card__badge--missing">⚠ Model assets unavailable</span>
            }
        }
    </div>
    @if (!State.IsOllamaModel && !State.IsRemoteModel && State.IsDownloaded == false)
    {
        <div class="lab-card__download-hint">
            @if (State.Downloading)
            {
                <span class="lab-card__badge lab-card__badge--checking">⏬ Downloading… (check back in a few minutes)</span>
            }
            else
            {
                <button class="po-btn po-btn--sm po-btn--warn lab-card__icon-btn"
                        title="Download from HuggingFace via server"
                        @onclick="HandleDownload">
                    ⬇ Download
                </button>
            }
            <span class="lab-card__download-note">Asset: /models/@State.Model.WebLlmModelId/mlc-chat-config.json</span>
        </div>
    }

    @* Running: progress bar + step detail *@
    @if (State.Status is DiagStatus.Loading or DiagStatus.Generating)
    {
        <div class="lab-card__progress-track">
            <div class="lab-card__progress-fill" style="--fill: @(State.LoadProgress)%"></div>
        </div>
        <div class="lab-card__step-detail">@State.StepDetail</div>
    }

    @* Error *@
    @if (State.Status == DiagStatus.Error)
    {
        <div class="lab-card__error">❌ @State.ErrorMessage</div>
    }

    @* Cancelled *@
    @if (State.Status == DiagStatus.Cancelled)
    {
        <div class="lab-card__cancelled">⊘ Cancelled</div>
    }

    @* Results *@
    @if (State.Status == DiagStatus.Complete)
    {
        <div class="lab-card__metrics">
            <div class="lab-card__metric">
                <span class="lab-card__metric-label">Load</span>
                <span class="lab-card__metric-value">
                    @FormatMs(State.LoadMs)
                    @if (State.WarmCache) { <span class="lab-card__warm-badge" title="GPU shaders cached — subsequent loads are faster">⚡</span> }
                </span>
            </div>
            <div class="lab-card__metric">
                <span class="lab-card__metric-label">1st Token</span>
                <span class="lab-card__metric-value">@FormatMs(State.FirstTokenMs)</span>
            </div>
            <div class="lab-card__metric lab-card__metric--highlight">
                <span class="lab-card__metric-label">Tok/s</span>
                <span class="lab-card__metric-value">@State.TokensPerSec</span>
            </div>
            <div class="lab-card__metric">
                <span class="lab-card__metric-label">Tokens</span>
                <span class="lab-card__metric-value">@State.TotalTokens</span>
            </div>
            <div class="lab-card__metric">
                <span class="lab-card__metric-label">Quality</span>
                <span class="lab-card__metric-value">@CompletenessScore(State)%</span>
            </div>
        </div>
        <button class="lab-card__output-toggle" @onclick="HandleToggleOutput">
            @(State.ShowOutput ? "▲ Hide output" : "▼ Show output")
        </button>
        @if (State.ShowOutput)
        {
            <pre class="lab-card__output">@State.Output</pre>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public ModelDiagState State { get; set; } = null!;
    [Parameter] public bool? WebGpuSupported { get; set; }
    [Parameter] public EventCallback<ModelDiagState> OnRun { get; set; }
    [Parameter] public EventCallback<ModelDiagState> OnCancel { get; set; }
    [Parameter] public EventCallback<ModelDiagState> OnToggleOutput { get; set; }
    [Parameter] public EventCallback<string> OnDownload { get; set; }

    private Task HandleRun()    => OnRun.InvokeAsync(State);
    private Task HandleCancel() => OnCancel.InvokeAsync(State);
    private Task HandleDownload() => OnDownload.InvokeAsync(State.Model.WebLlmModelId ?? string.Empty);

    private async Task HandleToggleOutput()
    {
        State.ShowOutput = !State.ShowOutput;
        await OnToggleOutput.InvokeAsync(State);
    }

    private static string GetCardClass(ModelDiagState s) => s.Status switch
    {
        DiagStatus.Loading or DiagStatus.Generating => "lab-card__card--running",
        DiagStatus.Complete                         => "lab-card__card--complete",
        DiagStatus.Error                            => "lab-card__card--error",
        DiagStatus.Cancelled                        => "lab-card__card--cancelled",
        _                                           => ""
    };

    private static string GetCardDownloadClass(ModelDiagState s)
    {
        if (s.Status is DiagStatus.Error) return "lab-card__card--border-error";
        if (s.IsDownloaded == true)  return "lab-card__card--border-ready";
        if (s.IsDownloaded == false) return "lab-card__card--border-missing";
        return ""; // null = still checking
    }

    private static string FormatMs(int ms) =>
        ms < 0 ? "—" : ms < 1000 ? $"{ms} ms" : $"{ms / 1000.0:F1} s";

    private static int CompletenessScore(ModelDiagState m) =>
        m.TotalTokens <= 0 ? 0 : Math.Min(100, (int)((m.TotalTokens / 256.0) * 100));

    private static string FormatDisplayName(string? displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return string.Empty;
        }

        return System.Text.RegularExpressions.Regex.Replace(displayName, @"(?<=\d)(?=(MB|GB)\b)", " ");
    }
}
