@using PoLocalCompare.Shared.Analysis
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Side-by-side source inspection for the Arena. Two shapes:
   - Code: independent panes, scroll-linked through JS so both stay at the same relative place.
   - Diff: one table, so alignment is structural and needs no syncing at all. *@

<div class="source-compare">
    <div class="source-compare__toolbar">
        <div class="source-compare__stats" role="status">
            @if (Mode == SourceViewMode.Diff)
            {
                <span class="source-compare__stat source-compare__stat--changed">@_stats.Changed changed</span>
                <span class="source-compare__stat source-compare__stat--removed">@_stats.Removed only left</span>
                <span class="source-compare__stat source-compare__stat--added">@_stats.Added only right</span>
                <span class="source-compare__stat">@_stats.Equal identical</span>
            }
            else
            {
                <span class="source-compare__stat">@_leftLines.Length lines vs @_rightLines.Length lines</span>
            }
        </div>

        <div class="source-compare__actions">
            @if (Mode == SourceViewMode.Diff && _hasCollapsedSegments)
            {
                <button type="button" class="source-compare__btn" @onclick="ToggleExpandAll">
                    @(_expandAll ? "Collapse identical" : "Expand identical")
                </button>
            }
            <button type="button" class="source-compare__btn" @onclick="() => CopyAsync(LeftHtml, true)">
                @(_copiedLeft ? "Copied ✓" : $"Copy {LeftName}")
            </button>
            <button type="button" class="source-compare__btn" @onclick="() => CopyAsync(RightHtml, false)">
                @(_copiedRight ? "Copied ✓" : $"Copy {RightName}")
            </button>
        </div>
    </div>

    @if (Mode == SourceViewMode.Code)
    {
        <div class="source-compare__panes">
            <div class="source-compare__pane">
                <div class="source-compare__pane-head">@LeftName</div>
                <div class="source-compare__code" id="@_leftPaneId" tabindex="0" role="region" aria-label="@($"{LeftName} source")">
                    @foreach (var (line, index) in _leftLines.Select((l, i) => (l, i)))
                    {
                        <div class="source-compare__line">
                            <span class="source-compare__ln" aria-hidden="true">@(index + 1)</span>
                            <code class="source-compare__text">@line</code>
                        </div>
                    }
                </div>
            </div>
            <div class="source-compare__pane">
                <div class="source-compare__pane-head">@RightName</div>
                <div class="source-compare__code" id="@_rightPaneId" tabindex="0" role="region" aria-label="@($"{RightName} source")">
                    @foreach (var (line, index) in _rightLines.Select((l, i) => (l, i)))
                    {
                        <div class="source-compare__line">
                            <span class="source-compare__ln" aria-hidden="true">@(index + 1)</span>
                            <code class="source-compare__text">@line</code>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="source-compare__diff" tabindex="0" role="region" aria-label="Source differences">
            <div class="source-compare__diff-head">
                <span>@LeftName</span>
                <span>@RightName</span>
            </div>

            @if (_segments.Count == 0)
            {
                <p class="source-compare__empty">Nothing to compare — both outputs are empty.</p>
            }
            else if (_stats.TotalDifferences == 0)
            {
                <p class="source-compare__empty">The two outputs are byte-for-byte identical.</p>
            }

            @foreach (var (segment, segmentIndex) in _segments.Select((s, i) => (s, i)))
            {
                if (segment.IsCollapsed && !_expandAll && !_expandedSegments.Contains(segmentIndex))
                {
                    <button type="button"
                            class="source-compare__fold"
                            @onclick="() => ExpandSegment(segmentIndex)">
                        ⋯ @segment.RowCount identical lines — show
                    </button>
                }
                else
                {
                    @foreach (var row in segment.Rows)
                    {
                        <div class="source-compare__row source-compare__row--@RowClass(row.Kind)">
                            <span class="source-compare__ln" aria-hidden="true">@(row.LeftLineNumber?.ToString() ?? "")</span>
                            <code class="source-compare__text">@row.LeftText</code>
                            <span class="source-compare__ln" aria-hidden="true">@(row.RightLineNumber?.ToString() ?? "")</span>
                            <code class="source-compare__text">@row.RightText</code>
                        </div>
                    }
                }
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string? LeftHtml { get; set; }
    [Parameter, EditorRequired] public string? RightHtml { get; set; }
    [Parameter, EditorRequired] public string LeftName { get; set; } = "Left";
    [Parameter, EditorRequired] public string RightName { get; set; } = "Right";
    [Parameter] public SourceViewMode Mode { get; set; } = SourceViewMode.Code;

    // Stable per-instance ids: the JS scroll link resolves elements by id, and two Arena
    // instances on one page would otherwise both bind the first pair.
    private readonly string _leftPaneId = $"srccmp-l-{Guid.NewGuid():N}";
    private readonly string _rightPaneId = $"srccmp-r-{Guid.NewGuid():N}";

    private string[] _leftLines = [];
    private string[] _rightLines = [];
    private IReadOnlyList<DiffSegment> _segments = [];
    private DiffStats _stats = new(0, 0, 0, 0);
    private bool _hasCollapsedSegments;

    private readonly HashSet<int> _expandedSegments = [];
    private bool _expandAll;
    private bool _copiedLeft;
    private bool _copiedRight;

    private string? _computedLeft;
    private string? _computedRight;
    private SourceViewMode _syncedForMode = SourceViewMode.Diff;
    private bool _scrollLinked;

    protected override void OnParametersSet()
    {
        // Diffing is O(n·m); the Arena re-renders far more often than the outputs change.
        if (string.Equals(_computedLeft, LeftHtml, StringComparison.Ordinal)
            && string.Equals(_computedRight, RightHtml, StringComparison.Ordinal))
        {
            return;
        }

        _computedLeft = LeftHtml;
        _computedRight = RightHtml;

        var left = HtmlPreview.Normalize(LeftHtml);
        var right = HtmlPreview.Normalize(RightHtml);

        _leftLines = SplitLines(left);
        _rightLines = SplitLines(right);

        var rows = LineDiff.Compute(left, right);
        _stats = LineDiff.Summarize(rows);
        _segments = LineDiff.Fold(rows);
        _hasCollapsedSegments = _segments.Any(s => s.IsCollapsed);
        _expandedSegments.Clear();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only the Code view has two independent scroll containers to link.
        if (Mode == SourceViewMode.Code && (!_scrollLinked || _syncedForMode != Mode))
        {
            await InvokeJsAsync("syncScrollPanes", _leftPaneId, _rightPaneId);
            _scrollLinked = true;
        }
        else if (Mode != SourceViewMode.Code && _scrollLinked)
        {
            await InvokeJsAsync("unsyncScrollPanes", _leftPaneId);
            _scrollLinked = false;
        }

        _syncedForMode = Mode;
    }

    private static string[] SplitLines(string text) =>
        string.IsNullOrEmpty(text)
            ? []
            : text.Replace("\r\n", "\n", StringComparison.Ordinal).Replace('\r', '\n').Split('\n');

    private static string RowClass(DiffKind kind) => kind switch
    {
        DiffKind.Added => "added",
        DiffKind.Removed => "removed",
        DiffKind.Changed => "changed",
        _ => "equal",
    };

    private void ExpandSegment(int index) => _expandedSegments.Add(index);

    private void ToggleExpandAll()
    {
        _expandAll = !_expandAll;
        if (!_expandAll) _expandedSegments.Clear();
    }

    private async Task CopyAsync(string? html, bool isLeft)
    {
        var text = HtmlPreview.Normalize(html);
        if (string.IsNullOrEmpty(text)) return;

        bool copied;
        try
        {
            copied = await JS.InvokeAsync<bool>("copyTextToClipboard", text);
        }
        catch (JSException)
        {
            copied = false;
        }

        if (!copied) return;

        if (isLeft) _copiedLeft = true; else _copiedRight = true;
        StateHasChanged();

        await Task.Delay(1600);
        if (isLeft) _copiedLeft = false; else _copiedRight = false;
        StateHasChanged();
    }

    private async Task InvokeJsAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (JSException)
        {
            // compare.js unavailable — the panes still scroll, just independently.
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_scrollLinked)
            await InvokeJsAsync("unsyncScrollPanes", _leftPaneId);
    }
}
