@* The failure card shown in place of a side's viewport when its inference failed.
   Identical shape for left and right; the side comes in as the `DisplayName`. The
   `<details>` block is gated on `IsMasked` because a runtime failure message routinely
   names the deployment or the WebLLM model id, which is the secret Blind mode is hiding. *@

<div class="arena__failure-card">
    <div class="arena__failure-title">❌ @DisplayName failed</div>
    <div class="arena__failure-body">@(FailureReasonText.FirstLine(FailureReason) ?? "No reason provided by the model runtime.")</div>
    @if (!IsMasked)
    {
        <details class="arena__failure-details">
            <summary>Show technical details</summary>
            <pre class="arena__failure-raw">@FailureReason</pre>
        </details>
    }
    <div class="arena__failure-hint">Retry the duel, or start a new one with a different pairing.</div>
</div>

@code {
    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;

    /// <summary>The full failure-reason text. The card body only shows the first line.</summary>
    [Parameter, EditorRequired] public string? FailureReason { get; set; }

    /// <summary>When true, suppresses the technical-details disclosure (Blind mode).</summary>
    [Parameter] public bool IsMasked { get; set; }
}
