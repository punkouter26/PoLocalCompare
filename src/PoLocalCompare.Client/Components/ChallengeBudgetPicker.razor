@using PoLocalCompare.Shared.Challenges
@using PoLocalCompare.Shared.Enums

@* The challenge-budget picker on Home: kind buttons (None / Time / Cost / Tokens) plus a
   row of preset thresholds for the chosen kind. Was previously inline on Home.razor with
   its own state, hint string and event handlers — lifted because it has zero coupling to
   anything else on Home and any future "start a duel from elsewhere" surface would want
   the same control. *@

<div class="home__budget">
    <div class="home__budget-kinds" role="group" aria-label="Challenge budget">
        <span class="home__budget-label"><span aria-hidden="true">⏱</span> Challenge</span>
        @foreach (var kind in _kinds)
        {
            <button type="button"
                    class="po-btn po-btn--sm @(Kind == kind ? "po-btn--success" : "po-btn--secondary")"
                    aria-pressed="@(Kind == kind ? "true" : "false")"
                    @onclick="() => SetKindAsync(kind)">
                @ChallengeRules.KindLabel(kind)
            </button>
        }
    </div>

    @if (Kind != ChallengeKind.None)
    {
        <div class="home__budget-values" role="group" aria-label="Budget ceiling">
            @foreach (var preset in ChallengeRules.PresetsFor(Kind))
            {
                <button type="button"
                        class="po-btn po-btn--sm @(Math.Abs(Threshold - preset) < 1e-9 ? "po-btn--primary" : "po-btn--ghost")"
                        aria-pressed="@(Math.Abs(Threshold - preset) < 1e-9 ? "true" : "false")"
                        @onclick="() => Threshold = preset">
                    @ChallengeRules.Format(Kind, preset)
                </button>
            }
        </div>
    }
    <p class="home__budget-hint">@Hint</p>
</div>

@code {
    /// <summary>Kind buttons offered in the group. "None" is a real option rather than an off
    /// switch, so the control reads as one four-way choice instead of a toggle plus a dependent
    /// selector.</summary>
    private static readonly ChallengeKind[] _kinds =
    [
        ChallengeKind.None,
        ChallengeKind.MaxSeconds,
        ChallengeKind.MaxCostUsd,
        ChallengeKind.MaxTokens,
    ];

    /// <summary>The currently selected kind. Two-way bound to the page's challenge-kind state.</summary>
    [Parameter, EditorRequired] public ChallengeKind Kind { get; set; }

    /// <summary>Event callback raised when the user picks a different kind.</summary>
    [Parameter] public EventCallback<ChallengeKind> KindChanged { get; set; }

    /// <summary>The currently selected threshold, in the units of the chosen kind.</summary>
    [Parameter, EditorRequired] public double Threshold { get; set; }

    /// <summary>Event callback raised when the user picks a different threshold.</summary>
    [Parameter] public EventCallback<double> ThresholdChanged { get; set; }

    /// <summary>Hint string explaining what the chosen budget means. Pre-computed by the page
    /// because it lives next to the Compare button and needs to be co-located with the other
    /// page-level hint text.</summary>
    [Parameter, EditorRequired] public string Hint { get; set; } = string.Empty;

    private async Task SetKindAsync(ChallengeKind kind)
    {
        if (Kind == kind) return;
        Kind = kind;
        await KindChanged.InvokeAsync(kind);

        // Land on a sensible ceiling immediately: a selected kind with a zero threshold is
        // dropped server-side, so the control would silently do nothing.
        var firstPreset = ChallengeRules.PresetsFor(kind).FirstOrDefault();
        if (Threshold != firstPreset)
        {
            Threshold = firstPreset;
            await ThresholdChanged.InvokeAsync(firstPreset);
        }
    }
}
