@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using System.Text.RegularExpressions

@* SC 2.1.1 Keyboard / 4.1.2 Name-Role-Value: the card is a toggle button, so it is
   focusable, Enter/Space operable, and exposes its selected + disabled state. *@
<div class="@_cardClass"
     role="button"
     tabindex="@(IsDisabled ? -1 : 0)"
     aria-pressed="@AriaPressed"
     aria-disabled="@AriaDisabled"
     aria-label="@AriaLabel"
     @onclick="OnCardClick"
     @onkeydown="OnCardKeyDown">
    <div class="model-card__header">
        <span class="model-card__name">@Model.DisplayName</span>
        <div class="model-card__badges">
            @if (Slot == "Left")
            {
                <span class="model-card__slot-badge model-card__slot-badge--left" title="Left player">L</span>
            }
            else if (Slot == "Right")
            {
                <span class="model-card__slot-badge model-card__slot-badge--right" title="Right player">R</span>
            }
            <span class="model-card__badge model-card__badge--@ModelTypeGroup.CssModifier(Model.ModelType)">
                @ModelTypeGroup.ShortLabel(Model.ModelType)
            </span>
        </div>
    </div>
    <div class="model-card__elo">
        ELO: <strong>@Model.CurrentElo.ToString("F0")</strong>
    </div>
    <div class="model-card__stats">
        Duels: @Model.DuelCount &nbsp;|&nbsp; W/L: @Model.WinCount/@(Model.DuelCount - Model.WinCount)
    </div>
    <div class="model-card__params">
        Params: <span class="model-card__params-value">@GetParameterLabel()</span>
    </div>
    @if (Model.InputTokenPricePerMillion.HasValue || Model.OutputTokenPricePerMillion.HasValue)
    {
        <div class="model-card__pricing">
            in: $@FormatPrice(Model.InputTokenPricePerMillion ?? 0) &nbsp;·&nbsp; out: $@FormatPrice(Model.OutputTokenPricePerMillion ?? 0) <span class="model-card__pricing-unit">/ 1M tkns</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ModelDto Model { get; set; } = null!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public string? Slot { get; set; }  // "Left", "Right", or null
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public EventCallback<ModelDto> OnSelected { get; set; }

    // Rendered as strings, not bools. Blazor treats a bool-valued attribute as an HTML boolean
    // attribute and OMITS it when false — so an unselected card exposed no pressed state at
    // all, failing SC 4.1.2.
    private string AriaPressed => IsSelected ? "true" : "false";

    private string AriaDisabled => IsDisabled ? "true" : "false";

    // Selected and disabled are expressed as classes so the whole appearance lives in
    // ModelCard.razor.css; they used to be an inline style string, which is why the
    // selected state needed !important to beat the stylesheet.
    private string _cardClass
    {
        get
        {
            var css = "model-card";
            if (IsSelected) css += " model-card--selected";
            if (IsDisabled) css += " model-card--disabled";
            return css;
        }
    }

    private string AriaLabel
    {
        get
        {
            var slot = Slot is null ? string.Empty : $", assigned to {Slot}";
            var unavailable = IsDisabled ? ", unavailable" : string.Empty;
            return $"{Model.DisplayName}, {Model.ModelType} model, ELO {Model.CurrentElo:F0}{slot}{unavailable}";
        }
    }

    private async Task OnCardClick()
    {
        if (!IsDisabled)
            await OnSelected.InvokeAsync(Model);
    }

    private async Task OnCardKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " or "Spacebar")
            await OnCardClick();
    }

    private static string FormatPrice(decimal price) =>
        price == 0 ? "0" : price < 1 ? price.ToString("G4") : price.ToString("0.##");

    private string GetParameterLabel()
    {
        // Prefer explicit known values for select open models.
        var known = (Model.ApiEndpointRef ?? string.Empty).ToLowerInvariant() switch
        {
            "meta-llama-3.3-70b-instruct" => "70B",
            "phi-4" => "14B",
            "phi-4-mini-instruct" => "3.8B",
            _ => null
        };

        if (!string.IsNullOrWhiteSpace(known))
            return known;

        // Try parsing from display/model names like "1.7B", "360M", "70B".
        var searchText = $"{Model.DisplayName} {Model.WebLlmModelId} {Model.ApiEndpointRef}";
        var match = Regex.Match(searchText, @"\b(\d+(?:\.\d+)?)\s*([BM])\b", RegexOptions.IgnoreCase);
        if (match.Success)
            return $"{match.Groups[1].Value}{match.Groups[2].Value.ToUpperInvariant()}";

        return "Undisclosed";
    }
}
