@using PoLocalCompare.Shared.Analysis
@inject IJSRuntime JS

@* SandboxedViewport — renders model-generated HTML in an XSS-safe sandboxed iframe.
   sandbox="allow-scripts" permits JS execution required by generated HTML apps.
   allow-same-origin is deliberately omitted so scripts cannot access parent frame, cookies, or localStorage. *@

<div class="sandboxed-viewport @(IsLoser ? "sandboxed-viewport--loser" : "")">
    <div class="sandboxed-viewport__header">
        <span class="sandboxed-viewport__model-name">@ModelName</span>
        @* A score for an empty document is a fabricated number: empty HTML scored 20/100
           through the renderability deductions, so a side that had not produced a single
           token displayed "Quality 20/100 — Model produced no renderable output" while the
           race was still warming up. Score only what exists; while a result is merely
           pending, the header carries the name and nothing else. *@
        @if (!string.IsNullOrWhiteSpace(_normalizedHtml))
        {
            <span class="sandboxed-viewport__score" title="Heuristic quality score based on renderability checks">
                Quality @_qualityScore/100
            </span>
        }
        @if (IsLoser)
        {
            <span class="sandboxed-viewport__badge sandboxed-viewport__badge--loser">LOSER</span>
        }
        else if (ShowWinner)
        {
            <span class="sandboxed-viewport__badge sandboxed-viewport__badge--winner">WINNER</span>
        }
    </div>
    @if (_diagnosticItems.Count > 0)
    {
        <div class="sandboxed-viewport__diagnostics">
            @foreach (var item in _diagnosticItems)
            {
                <span class="sandboxed-viewport__diagnostic-item">@item</span>
            }
        </div>
    }
    @if (string.IsNullOrWhiteSpace(_normalizedHtml))
    {
        @* Two very different reasons for an empty frame. While the run is still in flight the
           honest placeholder is neutral — 🚫 + "no renderable output" reads as a VERDICT, and
           mid-race it told the user both models had already lost. The failure phrasing stays
           only for the run that genuinely finished without usable output. *@
        @if (IsAwaitingResult)
        {
            <div class="sandboxed-viewport__empty" role="status">
                <span class="sandboxed-viewport__empty-icon" aria-hidden="true">⏳</span>
                <span>Generating — preview appears with the first tokens…</span>
            </div>
        }
        else
        {
            <div class="sandboxed-viewport__empty">
                <span class="sandboxed-viewport__empty-icon" aria-hidden="true">🚫</span>
                <span>Model produced no renderable output</span>
            </div>
        }
    }
    else
    {
        <iframe
            srcdoc="@_frameHtml"
            sandbox="allow-scripts"
            allow="accelerometer; gyroscope"
            title="@ModelName output"
            class="sandboxed-viewport__frame"
            loading="lazy">
        </iframe>
    }
</div>

@code {
    [Parameter, EditorRequired] public string HtmlContent { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ModelName { get; set; } = string.Empty;
    [Parameter] public bool IsLoser { get; set; }
    [Parameter] public bool ShowWinner { get; set; }

    /// <summary>
    /// True while the run is still in flight (no streaming preview and no result row yet).
    /// Drives the neutral placeholder — the failure placeholder is reserved for a run that
    /// finished empty.
    /// </summary>
    [Parameter] public bool IsAwaitingResult { get; set; }

    private readonly List<string> _diagnosticItems = [];
    private string _normalizedHtml = string.Empty;
    private string _frameHtml = string.Empty;
    private int _qualityScore = 100;

    // Everything this component renders is derived from its parameters, so an unchanged
    // parameter set can only produce an identical frame. The sentinel makes the first pass
    // always process (a genuinely empty HtmlContent must still be analysed once).
    private string? _lastRaw;
    private (string Name, bool Loser, bool Winner, bool Awaiting) _lastChrome;
    private bool _renderDirty = true;

    /// <summary>
    /// Suppresses re-renders the parent triggers for reasons that do not concern this frame.
    /// The Arena re-renders on a timer while streaming; without this, every one of those
    /// re-emitted <c>srcdoc</c> on both iframes, which makes the browser tear down and reload
    /// the document mid-generation.
    /// </summary>
    protected override bool ShouldRender() => _renderDirty;

    protected override void OnParametersSet()
    {
        var raw = HtmlContent ?? string.Empty;
        var chrome = (ModelName, IsLoser, ShowWinner, IsAwaitingResult);

        // Cheap ordinal gate before the four regex passes below: while a duel streams, most
        // parent renders carry a document identical to the one already on screen.
        if (_lastRaw is not null && string.Equals(raw, _lastRaw, StringComparison.Ordinal) && chrome == _lastChrome)
        {
            _renderDirty = false;
            return;
        }

        _lastRaw = raw;
        _lastChrome = chrome;
        _renderDirty = true;

        _diagnosticItems.Clear();

        var containsFence = HtmlPreview.ContainsFence(raw);
        var normalized = HtmlPreview.Normalize(raw);

        _normalizedHtml = normalized;

        var hasDoctype = ContainsTag(_normalizedHtml, "!doctype");
        var hasHtml = ContainsTag(_normalizedHtml, "html");
        var hasBody = ContainsTag(_normalizedHtml, "body");
        var hasScript = ContainsTag(_normalizedHtml, "script");
        var looksLikeHtml = LooksLikeHtml(_normalizedHtml);

        if (containsFence)
        {
            _diagnosticItems.Add("Markdown code fences detected and removed");
        }

        if (!looksLikeHtml && !string.IsNullOrWhiteSpace(_normalizedHtml))
        {
            _diagnosticItems.Add("Output may not be valid HTML");
        }

        if (!hasDoctype && !string.IsNullOrWhiteSpace(_normalizedHtml))
        {
            _diagnosticItems.Add("Missing <!DOCTYPE html>");
        }

        if (!hasScript && !string.IsNullOrWhiteSpace(_normalizedHtml))
        {
            _diagnosticItems.Add("No <script> tag found");
        }

        _qualityScore = 100;
        if (containsFence) _qualityScore -= 10;
        if (!looksLikeHtml) _qualityScore -= 40;
        if (!hasDoctype) _qualityScore -= 10;
        if (!hasHtml) _qualityScore -= 10;
        if (!hasBody) _qualityScore -= 10;
        if (!hasScript) _qualityScore -= 10;
        if (_normalizedHtml.Length < 200 && !string.IsNullOrWhiteSpace(_normalizedHtml)) _qualityScore -= 10;
        _qualityScore = Math.Clamp(_qualityScore, 0, 100);

        // The frame renders the model's own document untouched. A runtime probe used to be
        // prepended here — a script that reported load time, thrown errors and failed resources
        // back to the Objective scorecard — and it went with that scorecard on 2026-08-23. The
        // preview is now byte-for-byte what "View Source" shows.
        _frameHtml = _normalizedHtml;
    }

    private static bool ContainsTag(string html, string tagName) =>
        System.Text.RegularExpressions.Regex.IsMatch(
            html,
            $@"<\s*{System.Text.RegularExpressions.Regex.Escape(tagName)}\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private static bool LooksLikeHtml(string html) =>
        System.Text.RegularExpressions.Regex.IsMatch(
            html,
            @"<(?:!doctype|html|head|body|canvas|div|script|style)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
}
