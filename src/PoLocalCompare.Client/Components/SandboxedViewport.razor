@using PoLocalCompare.Shared.Analysis
@implements IAsyncDisposable
@inject IJSRuntime JS

@* SandboxedViewport — renders model-generated HTML in an XSS-safe sandboxed iframe.
   sandbox="allow-scripts" permits JS execution required by generated HTML apps.
   allow-same-origin is deliberately omitted so scripts cannot access parent frame, cookies, or localStorage. *@

<div class="sandboxed-viewport @(IsLoser ? "sandboxed-viewport--loser" : "")">
    <div class="sandboxed-viewport__header">
        <span class="sandboxed-viewport__model-name">@ModelName</span>
        <span class="sandboxed-viewport__score" title="Heuristic quality score based on renderability checks">
            Quality @_qualityScore/100
        </span>
        @if (IsLoser)
        {
            <span class="sandboxed-viewport__badge sandboxed-viewport__badge--loser">LOSER</span>
        }
        else if (ShowWinner)
        {
            <span class="sandboxed-viewport__badge sandboxed-viewport__badge--winner">WINNER</span>
        }
    </div>
    @if (_diagnosticItems.Count > 0)
    {
        <div class="sandboxed-viewport__diagnostics">
            @foreach (var item in _diagnosticItems)
            {
                <span class="sandboxed-viewport__diagnostic-item">@item</span>
            }
        </div>
    }
    @if (string.IsNullOrWhiteSpace(_normalizedHtml))
    {
        <div class="sandboxed-viewport__empty">
            <span class="sandboxed-viewport__empty-icon" aria-hidden="true">🚫</span>
            <span>Model produced no renderable output</span>
        </div>
    }
    else
    {
        <iframe
            srcdoc="@_frameHtml"
            sandbox="allow-scripts"
            allow="accelerometer; gyroscope"
            title="@ModelName output"
            class="sandboxed-viewport__frame"
            loading="lazy">
        </iframe>
    }
</div>

@code {
    [Parameter, EditorRequired] public string HtmlContent { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ModelName { get; set; } = string.Empty;
    [Parameter] public bool IsLoser { get; set; }
    [Parameter] public bool ShowWinner { get; set; }

    /// <summary>
    /// Opt in to measuring what the output does at run time — load time, thrown errors, failed
    /// external resources. Off by default and never enabled for streaming previews, where the
    /// document is incomplete by definition and every measurement would be noise.
    /// </summary>
    [Parameter] public bool ProbeRuntime { get; set; }

    /// <summary>Raised as probe observations arrive; the same instance is mutated and re-raised.</summary>
    [Parameter] public EventCallback<RuntimeProbeReport> OnProbeUpdated { get; set; }

    private readonly List<string> _diagnosticItems = [];
    private string _normalizedHtml = string.Empty;
    private string _frameHtml = string.Empty;
    private int _qualityScore = 100;

    // ── Runtime probe ─────────────────────────────────────────────────────────
    private DotNetObjectReference<SandboxedViewport>? _selfRef;
    private string? _probeId;
    private string? _registeredProbeId;
    private RuntimeProbeReport _report = new();

    protected override void OnParametersSet()
    {
        _diagnosticItems.Clear();

        var raw = HtmlContent ?? string.Empty;
        var containsFence = HtmlPreview.ContainsFence(raw);
        var normalized = HtmlPreview.Normalize(raw);

        // Re-instrumenting an unchanged document would reset the counts the Arena is showing,
        // so the probe id — and therefore the srcdoc — only changes when the output does.
        var contentChanged = !string.Equals(normalized, _normalizedHtml, StringComparison.Ordinal);
        _normalizedHtml = normalized;

        var hasDoctype = ContainsTag(_normalizedHtml, "!doctype");
        var hasHtml = ContainsTag(_normalizedHtml, "html");
        var hasBody = ContainsTag(_normalizedHtml, "body");
        var hasScript = ContainsTag(_normalizedHtml, "script");
        var looksLikeHtml = LooksLikeHtml(_normalizedHtml);

        if (containsFence)
        {
            _diagnosticItems.Add("Markdown code fences detected and removed");
        }

        if (!looksLikeHtml && !string.IsNullOrWhiteSpace(_normalizedHtml))
        {
            _diagnosticItems.Add("Output may not be valid HTML");
        }

        if (!hasDoctype && !string.IsNullOrWhiteSpace(_normalizedHtml))
        {
            _diagnosticItems.Add("Missing <!DOCTYPE html>");
        }

        if (!hasScript && !string.IsNullOrWhiteSpace(_normalizedHtml))
        {
            _diagnosticItems.Add("No <script> tag found");
        }

        _qualityScore = 100;
        if (containsFence) _qualityScore -= 10;
        if (!looksLikeHtml) _qualityScore -= 40;
        if (!hasDoctype) _qualityScore -= 10;
        if (!hasHtml) _qualityScore -= 10;
        if (!hasBody) _qualityScore -= 10;
        if (!hasScript) _qualityScore -= 10;
        if (_normalizedHtml.Length < 200 && !string.IsNullOrWhiteSpace(_normalizedHtml)) _qualityScore -= 10;
        _qualityScore = Math.Clamp(_qualityScore, 0, 100);

        if (ProbeRuntime && !string.IsNullOrWhiteSpace(_normalizedHtml))
        {
            if (contentChanged || _probeId is null)
            {
                _probeId = Guid.NewGuid().ToString("N");
                _report = new RuntimeProbeReport();
            }
            _frameHtml = ProbeScript(_probeId) + _normalizedHtml;
        }
        else
        {
            _probeId = null;
            _frameHtml = _normalizedHtml;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_probeId == _registeredProbeId) return;

        await UnregisterProbeAsync();

        if (_probeId is null) return;

        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("sandboxProbe.register", _probeId, _selfRef);
            _registeredProbeId = _probeId;
        }
        catch (JSException)
        {
            // compare.js not loaded (or blocked) — the static scorecard still works without it.
        }
    }

    [JSInvokable]
    public async Task OnProbeMessage(string type, string message)
    {
        switch (type)
        {
            case "loaded":
                if (long.TryParse(message, out var ms)) _report.LoadMs = ms;
                _report.Loaded = true;
                break;
            case "error":
                _report.AddError(message);
                break;
            case "resource":
                _report.AddResourceFailure(message);
                break;
            case "console":
                _report.AddConsoleError(message);
                break;
        }

        if (OnProbeUpdated.HasDelegate)
            await OnProbeUpdated.InvokeAsync(_report);
    }

    /// <summary>
    /// Prepended to the document so it observes everything the model's own scripts do. It is
    /// injected into the <em>preview</em> only: the persisted output, the structural analysis
    /// and "View Source" all read the untouched raw string, so nothing a person judges or
    /// exports contains this.
    /// </summary>
    /// <remarks>
    /// The id is embedded as a bare quoted literal rather than JSON-encoded because it is always
    /// <c>Guid.ToString("N")</c> — 32 hex characters, nothing a string literal could escape.
    /// </remarks>
    private static string ProbeScript(string probeId) =>
        "<script>(function(){var i='" + probeId + "';" +
        "function s(t,m){try{parent.postMessage({__plprobe:i,type:t,message:String(m).slice(0,300)},'*')}catch(e){}}" +
        "window.addEventListener('error',function(e){" +
        "if(e.target&&e.target!==window&&e.target.tagName){s('resource',e.target.tagName.toLowerCase()+': '+(e.target.src||e.target.href||'unknown'))}" +
        "else{s('error',e.message||'Script error')}},true);" +
        "window.addEventListener('unhandledrejection',function(e){s('error','Unhandled rejection: '+((e.reason&&e.reason.message)||e.reason))});" +
        "var c=console.error;console.error=function(){try{c.apply(console,arguments)}catch(x){}" +
        "s('console',Array.prototype.slice.call(arguments).join(' '))};" +
        "window.addEventListener('load',function(){s('loaded',String(Math.round(performance.now())))});" +
        "})();</script>\n";

    private async Task UnregisterProbeAsync()
    {
        if (_registeredProbeId is null) return;

        try
        {
            await JS.InvokeVoidAsync("sandboxProbe.unregister", _registeredProbeId);
        }
        catch (JSException)
        {
            // Nothing to release.
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }

        _registeredProbeId = null;
    }

    public async ValueTask DisposeAsync()
    {
        await UnregisterProbeAsync();
        _selfRef?.Dispose();
        _selfRef = null;
    }

    private static bool ContainsTag(string html, string tagName) =>
        System.Text.RegularExpressions.Regex.IsMatch(
            html,
            $@"<\s*{System.Text.RegularExpressions.Regex.Escape(tagName)}\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private static bool LooksLikeHtml(string html) =>
        System.Text.RegularExpressions.Regex.IsMatch(
            html,
            @"<(?:!doctype|html|head|body|canvas|div|script|style)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
}
