<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WasmSdkPackageVersion>10.0.7</WasmSdkPackageVersion>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Standards §6.6: the assembly is trim-annotated (IsTrimmable + analyzer), but the app
         publishes untrimmed: the Router's NotFoundPage (and MSAL/Radzen) instantiate components
         via reflection, which the IL trimmer strips in Release publish (CtorNotLocated at
         runtime → the Blazor view tree fails to mount). -->
    <IsTrimmable>true</IsTrimmable>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <!-- Surface trim diagnostics as warnings without failing the build: Blazor-generated Razor code,
         Radzen, MSAL, and System.Net.Http.Json emit IL2xxx/IL3xxx trim-analyzer warnings that cannot
         be fixed in this app (it ships untrimmed-by-default anyway). Scoped to trim codes only —
         every other warning is still an error per TreatWarningsAsErrors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2046;IL2057;IL2072;IL2075;IL2087;IL2091;IL2104;IL2110;IL2111;IL3050;IL3051;IL3052;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Radzen.Blazor" />
    <!-- Force safe version of transitive dependency from Radzen.Blazor -->
    <PackageReference Include="System.Linq.Dynamic.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoLocalCompare.Shared\PoLocalCompare.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\models\**\*" CopyToPublishDirectory="Never" />
    <!-- Development-only config: enables guest auth in non-Production; never deployed -->
    <Content Update="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
