@page "/archive"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Microsoft.AspNetCore.Components.Web
@inject DuelApiClient ApiClient
@inject NavigationManager Nav

<PageTitle>Archive — PoLocalCompare</PageTitle>

<div class="archive po-page po-page--wide">
    <PageHeader Title="Archive" TitleHook="archive__title" />

    @if (_loading)
    {
        <p class="po-status">Loading archive...</p>
    }
    else if (_duels.Count == 0 && !string.IsNullOrEmpty(_error))
    {
        <p class="po-error">@_error</p>
    }
    else if (_duels.Count == 0 && _verdictFilter == "All")
    {
        @* Only for "All": the verdict chips filter on the server now, so an empty filtered page
           means "none of THAT kind" and keeps the chips on screen to switch back. *@
        @* EmptyState — Archive's "no duels yet" card. The new card shares its layout
           with Leaderboard and Model Profile so a viewer sees the same shape anywhere
           in the app a list is empty. *@
        <EmptyState Icon="📁"
                    Title="No duels recorded yet"
                    Hint="Archive snapshots, verdicts, and lab reports will appear here once a duel completes."
                    Actions="@(new[] {
                        new EmptyStateAction("⚔ Start a duel", "/", EmptyStateActionVariant.Ghost)
                    })" />
    }
    else
    {
        @* .po-btn--chip, shared with Home and PromptPicker. These were .archive__filter-chip,
           a fourth private implementation of the same control, and — like Home's — they carried
           no aria-pressed, so which filter was active reached assistive tech not at all and
           reached a colour-blind viewer only as a slightly different grey (SC 1.4.1, 4.1.2). *@
        <div class="archive__filters" role="group" aria-label="Filter duels by verdict">
            @foreach (var label in Filters)
            {
                <button type="button"
                        class="po-btn po-btn--sm po-btn--chip"
                        aria-pressed="@(_verdictFilter == label ? "true" : "false")"
                        @onclick="() => SelectFilter(label)">
                    @label
                </button>
            }
        </div>
        @* One search box over the loaded rows, matching the prompt or either model's name.
           It replaced the Radzen grid's per-column filters when Radzen was removed on
           2026-09-26; the verdict chips above still filter on the server. *@
        <input type="search" class="archive__search" placeholder="Search prompt or model…"
               aria-label="Search loaded duels by prompt or model name"
               @bind="_search" @bind:event="oninput" />

        @* A plain .po-table: it becomes labelled cards below 640px via data-label, and the
           prompt cell's link opens the duel in the Arena. *@
        <div class="po-table-wrap">
            <table class="po-table po-table--cards">
                <caption class="visually-hidden">Duels, newest first — open a prompt to see both outputs</caption>
                <thead>
                    <tr>
                        <th scope="col">Date (UTC)</th>
                        <th scope="col">Prompt</th>
                        <th scope="col">Matchup</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in VisibleRows)
                    {
                        var d = r.Duel;
                        <tr @key="d.DuelId">
                            <td data-label="Date" class="archive__date">@d.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td data-label="Prompt"><a href="@($"/arena/{d.DuelId}")">@d.PromptSummary</a></td>
                            <td data-label="Matchup">
                                <span class="archive__matchup">
                                    @Side(d.LeftModelName, d.LeftModelId, d.Verdict == DuelVerdict.Left)
                                    <span class="archive__vs">vs</span>
                                    @Side(d.RightModelName, d.RightModelId, d.Verdict == DuelVerdict.Right)
                                    @if (d.Verdict == DuelVerdict.Tie)
                                    {
                                        <span class="archive__verdict archive__verdict--tie"
                                              title="The judge compared both outputs and found them equivalent. No rating moved.">
                                            <span aria-hidden="true">🤝</span> Tie
                                        </span>
                                    }
                                    else if (d.Verdict == DuelVerdict.Pending)
                                    {
                                        <a class="po-btn po-btn--sm po-btn--primary archive__judge-btn"
                                           href="@($"/arena/{d.DuelId}")"
                                           title="Open both outputs and pick a winner">
                                            <span aria-hidden="true">⚖</span> Judge
                                        </a>
                                    }
                                </span>
                            </td>
                            <td class="po-cell--bare">
                                <div class="archive__row-actions">
                                    @* Re-run: same prompt, same two models, fresh duel. *@
                                    <button type="button"
                                            class="po-btn po-btn--sm archive__row-btn"
                                            aria-label="@($"Re-run {d.LeftModelName} vs {d.RightModelName} with the same prompt")"
                                            title="Re-run with the same prompt"
                                            disabled="@_rerunning"
                                            @onclick="@(() => RerunAsync(d))"><span aria-hidden="true">⚔</span></button>
                                    @* Same-origin GET carries the BFF cookie, so the browser
                                       does the whole download with no interop. *@
                                    <a class="po-btn po-btn--sm archive__row-btn"
                                       href="@($"/api/duels/{d.DuelId}/report")"
                                       aria-label="Download lab report (HTML)"
                                       title="Download lab report (HTML)"
                                       download="@($"lab-report-{d.DuelId}.html")"><span aria-hidden="true">⬇</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!VisibleRows.Any())
        {
            <p class="po-hint">No duels match — choose All, or clear the search.</p>
        }

        <div class="archive__pagination">
            @* The old copy read "Showing 20 of 20 duels — more available", because the first
               number counted the filter and the second counted what had been loaded, while
               "more available" spoke about the server. Three different populations, one
               sentence. Now it counts one thing, and Load More says the rest. *@
            <span class="archive__count">@CountSummary</span>
            @if (_hasMore)
            {
                @* Disabled while any list request is in flight: a double-click used to fire two
                   requests from the same cursor and append the same page twice. *@
                <button type="button" class="po-btn" disabled="@_fetching" @onclick="LoadMoreAsync">
                    @(_fetching ? "Loading…" : "Load More")
                </button>
            }
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="po-error">@_error</p>
        }
    }
</div>

@code {
    /// <summary>
    /// The one list of filter labels: the chips render from it and <see cref="VerdictQuery"/> is
    /// validated against it, so a deep link can never select a filter the chips don't offer.
    /// </summary>
    private static readonly string[] Filters = ["All", "Won", "Tie", "Unjudged"];

    /// <summary>
    /// Deep-links a filter chip. The header's "N awaiting judgment" pill uses it to land on the
    /// unjudged duels directly — it previously dropped you on "All", where the duels it was
    /// counting were scattered through twenty rows of decided ones.
    /// </summary>
    [SupplyParameterFromQuery(Name = "verdict")] public string? VerdictQuery { get; set; }

    /// <summary>Everything loaded for the current filter, newest first by id — the server's paging key.</summary>
    private List<DuelSummaryDto> _duels = [];

    /// <summary>First load only; it replaces the page. Later loads keep the grid on screen.</summary>
    private bool _loading = true;

    /// <summary>Any list request in flight. Guards Load More against a double-click.</summary>
    private bool _fetching;

    /// <summary>
    /// Bumped per list request. A response whose version is stale — a chip switched while the
    /// previous filter's page was still in flight — is dropped instead of overwriting the rows.
    /// </summary>
    private int _loadVersion;

    private bool _rerunning;
    private string? _error;
    private bool _hasMore;
    private const int PageSize = 20;

    /// <summary>Null until the first OnParametersSetAsync applies the query.</summary>
    private string? _verdictFilter;

    // Materialised once per change instead of per read: re-projecting on every incidental
    // re-render — a row selection, say — was pure waste.
    private List<ArchiveRow> _rows = [];

    /// <summary>
    /// A row: the duel plus its "A vs B" text, which the search box matches, so a model name
    /// finds the duel whichever side it played on.
    /// </summary>
    private sealed record ArchiveRow(DuelSummaryDto Duel, string Matchup);

    private string _search = string.Empty;

    private IEnumerable<ArchiveRow> VisibleRows => string.IsNullOrWhiteSpace(_search)
        ? _rows
        : _rows.Where(r => r.Matchup.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
                        || r.Duel.PromptSummary.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// What each chip asks the server for. The filter runs server-side, before the page limit:
    /// filtering the twenty loaded rows meant "Unjudged" — the nav pill's deep link — could show
    /// nothing while unjudged duels sat one Load More away.
    /// </summary>
    private static DuelVerdict[]? VerdictsFor(string? filter) => filter switch
    {
        "Won" => new[] { DuelVerdict.Left, DuelVerdict.Right },
        "Tie" => new[] { DuelVerdict.Tie },
        "Unjudged" => new[] { DuelVerdict.Pending },
        _ => null,
    };

    /// <summary>How many rows are on screen. Load More says whether there are more.</summary>
    private string CountSummary => $"{_rows.Count} {(_rows.Count == 1 ? "duel" : "duels")}";

    /// <summary>
    /// A chip writes the query string rather than the field, so the URL is the one source of
    /// truth: OnParametersSetAsync does the loading, and clicking the nav's "awaiting judgment"
    /// pill after picking another chip still changes the URL and still takes effect.
    /// </summary>
    private void SelectFilter(string label) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("verdict", label == "All" ? null : label), replace: true);

    /// <summary>
    /// Runs on every navigation to /archive, including a query-only one — the nav pill clicked
    /// while already here. The query used to be read in OnInitializedAsync, which runs once per
    /// component instance, so that deep link did nothing unless you arrived from another page.
    /// Skips when the filter is unchanged, so an unrelated re-render never refetches.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var requested = Filters.FirstOrDefault(f => string.Equals(f, VerdictQuery, StringComparison.OrdinalIgnoreCase)) ?? "All";
        if (requested == _verdictFilter) return;

        _verdictFilter = requested;
        await LoadPageAsync(append: false);
    }

    private Task LoadMoreAsync() => LoadPageAsync(append: true);

    /// <summary>
    /// Loads the first page for the current filter, or (append) the page strictly older than
    /// the oldest row held. The cursor is that row's id: ids are ULIDs, so id order is time
    /// order, and it is the key the server sorts and pages on. The old cursor was the row's
    /// yyyyMM, which the server matched with `le` — the whole current month again, every time.
    /// </summary>
    private async Task LoadPageAsync(bool append)
    {
        if (append && (_fetching || _duels.Count == 0)) return;

        var version = ++_loadVersion;
        _fetching = true;
        _error = null;
        if (!append)
        {
            // A new filter must not keep the old filter's rows: if its request fails they sat
            // under the newly pressed chip, and Load More then paged from the wrong cursor.
            _duels = [];
            _rows = [];
            _hasMore = false;
        }
        try
        {
            DuelId? cursor = append ? _duels[^1].DuelId : null;
            var page = await ApiClient.ListDuelsAsync(PageSize + 1, cursor, VerdictsFor(_verdictFilter));
            if (version != _loadVersion || page is null) return;

            _hasMore = page.Count > PageSize;
            var batch = page.Take(PageSize);

            // DistinctBy is defensive — the cursor already makes pages disjoint — and the sort
            // keeps _duels[^1] the oldest row, which is what the next cursor reads.
            _duels = (append ? _duels.Concat(batch) : batch)
                .DistinctBy(d => d.DuelId)
                .OrderByDescending(d => d.DuelId)
                .ToList();
            _rows = _duels
                .Select(d => new ArchiveRow(d,
                    $"{FormatModelName(d.LeftModelName, d.LeftModelId)} vs {FormatModelName(d.RightModelName, d.RightModelId)}"))
                .ToList();
        }
        catch (Exception ex)
        {
            if (version == _loadVersion)
                _error = append ? $"Failed to load more: {ex.Message}" : $"Failed to load archive: {ex.Message}";
        }
        finally
        {
            // A superseded request leaves the flags to the one that replaced it.
            if (version == _loadVersion)
            {
                _fetching = false;
                _loading = false;
            }
        }
    }

    /// <summary>
    /// One side of the matchup. The winner is bold with a trophy; the trophy is decoration, so
    /// the win is also stated in text for assistive tech rather than carried by glyph and weight.
    /// </summary>
    private static RenderFragment Side(string? modelName, ModelId modelId, bool won) =>
        @<span class="archive__model @(IsUnresolvedModelName(modelName, modelId) ? "archive__model--unresolved" : "") @(won ? "archive__model--winner" : "")">
            @FormatModelName(modelName, modelId)@if (won)
            {
                <span aria-hidden="true"> 🏆</span><span class="visually-hidden"> (winner)</span>
            }
        </span>;

    // Both delegate to the one shared resolver rather than restating its rules here; see
    // ModelDisplayName for why an unresolved id shows as "Retired model".
    private static bool IsUnresolvedModelName(string? modelName, ModelId modelId) =>
        ModelDisplayName.IsUnresolved(modelName, modelId);

    private static string FormatModelName(string? modelName, ModelId modelId) =>
        ModelDisplayName.ResolveForDisplay(modelName, null, modelId);

    /// <summary>
    /// Starts a fresh duel with the same pairing and the FULL prompt, then opens it — what the
    /// Arena's Retry does. This used to pre-fill Home from <c>PromptSummary</c>, which the list
    /// truncates to 80 characters, so every re-run of a longer prompt ran a different one; and
    /// a prompt of up to 10,000 characters does not belong on a query string anyway.
    /// PromptText, not PromptFull: the server appends its CDN instruction itself.
    /// </summary>
    private async Task RerunAsync(DuelSummaryDto d)
    {
        if (_rerunning) return;

        _rerunning = true;
        _error = null;
        try
        {
            var prompt = string.IsNullOrWhiteSpace(d.PromptText) ? d.PromptSummary : d.PromptText;
            var rerun = await ApiClient.CommenceDuelAsync(d.LeftModelId, d.RightModelId, prompt);
            if (rerun is not null)
            {
                Nav.NavigateTo($"/arena/{rerun.DuelId}");
                return;
            }

            _error = "Could not start the re-run. Please try again.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to start the re-run: {ex.Message}";
        }

        _rerunning = false;
    }
}
