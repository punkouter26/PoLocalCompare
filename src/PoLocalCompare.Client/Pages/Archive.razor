@page "/archive"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Microsoft.AspNetCore.Components.Web
@inject DuelApiClient ApiClient
@inject NavigationManager Nav

<PageTitle>Archive — PoLocalCompare</PageTitle>

<div class="archive">
    <h1 class="archive__title">Lab Archive</h1>

    @if (_loading)
    {
        <p class="archive__status">Loading archive...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="archive__error">@_error</p>
    }
    else if (_duels.Count == 0)
    {
        <div class="archive__empty-card">
            <h2>No duels recorded yet</h2>
            <p>Archive snapshots, verdicts, and lab reports will appear here once a duel completes.</p>
            <div class="archive__empty-actions">
                <a class="po-btn po-btn--ghost" href="/">⚔ Start a New Duel</a>
            </div>
        </div>
    }
    else
    {
        <div class="archive__filters">
            @foreach (var label in new[] { "All", "Won", "Tie", "Unjudged" })
            {
                <button class="archive__filter-chip @(_verdictFilter == label ? "archive__filter-chip--active" : "")"
                        @onclick="() => SetVerdictFilter(label)">
                    @label
                </button>
            }
        </div>
        @if (_filteredDuels.Count == 0)
        {
            <div class="archive__filtered-empty">
                <p>No duels match the <strong>@_verdictFilter</strong> filter.</p>
                <button class="archive__filter-reset" @onclick="ResetFilters">Show all duels</button>
            </div>
        }
        @* The detail panel sits above the table, not below it. Below a 20-row grid it opened
           roughly 1,100px off-screen, so selecting the top row scrolled you to the bottom of
           the page and away from the list you were reading. Here it opens in place, the list
           stays visible underneath, and no scroll is needed at all. *@
        @if (_selectedDuel is not null)
        {
            <div class="archive__detail" id="archive-detail">
                <div class="archive__detail-head">
                    <h2 class="archive__detail-title">Duel Details</h2>
                    <button type="button" class="po-btn po-btn--sm po-btn--ghost"
                            aria-label="Close duel details"
                            @onclick="@(() => _selectedDuel = null)">✕</button>
                </div>

                <div class="archive__detail-meta">
                    <p><strong>Prompt:</strong> @_selectedDuel.PromptSummary</p>
                    <p><strong>Left:</strong> @FormatModelName(_selectedDuel.LeftModelName, _selectedDuel.LeftModelId) &nbsp;&nbsp; <strong>Right:</strong> @FormatModelName(_selectedDuel.RightModelName, _selectedDuel.RightModelId)</p>
                    <p><strong>Started:</strong> @_selectedDuel.StartedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
                    @if (_selectedDuel.CompletedAt.HasValue)
                    {
                        <p><strong>Completed:</strong> @_selectedDuel.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
                    }
                    <p><strong>Outcome:</strong> @OutcomeText(_selectedDuel)</p>
                </div>

                <div class="archive__detail-actions">
                    <button type="button" class="po-btn archive__btn"
                            @onclick="@(() => Nav.NavigateTo($"/arena/{_selectedDuel.DuelId}"))">
                        👁 View Output
                    </button>
                    <button type="button" class="po-btn archive__btn" @onclick="GoToReChallenge">
                        ⚧ Re-Challenge
                    </button>
                    @* Same endpoint the Arena links to; the BFF cookie rides along on a
                       same-origin GET, so no interop is needed to download it. *@
                    <a class="po-btn archive__btn"
                       href="@($"/api/duels/{_selectedDuel.DuelId}/report")"
                       download="@($"lab-report-{_selectedDuel.DuelId}.html")">
                        ⬇ Lab report
                    </a>
                    @if (_selectedDuel.Verdict == DuelVerdict.Pending)
                    {
                        <button type="button" class="po-btn po-btn--primary archive__btn" @onclick="GoToArena">
                            ⚔ Judge This Duel
                        </button>
                    }
                </div>
            </div>
        }

        @* Rows are keyboard-operable (WCAG 2.2 SC 2.1.1): tabbable, and Enter/Space
           selects, because clicking a row is the only way to open the detail panel. *@
        <div class="po-table-wrap">
            <table class="po-table po-table--selectable">
                <caption class="archive__grid-caption">Recorded duels — select a row for details</caption>
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Prompt</th>
                        <th scope="col">Left Model</th>
                        <th scope="col">Right Model</th>
                        @* No chevron column: the caption already says a row opens its details,
                           and the selected row is marked by aria-selected and its own styling. *@
                        <th scope="col">Verdict</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _filteredDuels)
                    {
                        <tr class="@GetRowClass(d)"
                            tabindex="0"
                            aria-selected="@((d.DuelId == _selectedDuel?.DuelId).ToString().ToLowerInvariant())"
                            @onclick="() => OnRowSelect(d)"
                            @onkeydown="e => OnRowKeyDown(e, d)">
                            <td>@d.StartedAt.ToString("yyyy-MM-dd HH:mm") <span class="archive__tz">UTC</span></td>
                            <td>@d.PromptSummary</td>
                            <td>
                                <span class="archive__model @(IsUnresolvedModelName(d.LeftModelName, d.LeftModelId) ? "archive__model--unresolved" : "")"
                                      title="@d.LeftModelId">
                                    @FormatModelName(d.LeftModelName, d.LeftModelId)
                                </span>
                            </td>
                            <td>
                                <span class="archive__model @(IsUnresolvedModelName(d.RightModelName, d.RightModelId) ? "archive__model--unresolved" : "")"
                                      title="@d.RightModelId">
                                    @FormatModelName(d.RightModelName, d.RightModelId)
                                </span>
                            </td>
                            <td>
                                @* Names the winner. "⬅ Left" made you map the chip back to a
                                   column to learn anything, which is the one thing the verdict
                                   column exists to tell you. *@
                                @if (d.Verdict is DuelVerdict.Left or DuelVerdict.Right)
                                {
                                    <span class="archive__verdict archive__verdict--win" title="Winner of this duel">
                                        🏆 @GetWinnerName(d)
                                    </span>
                                }
                                else if (d.Verdict == DuelVerdict.Tie)
                                {
                                    <span class="archive__verdict archive__verdict--tie"
                                          title="The judge compared both outputs and found them equivalent. No rating moved.">
                                        🤝 Tie
                                    </span>
                                }
                                else
                                {
                                    <span class="archive__verdict archive__verdict--pending"
                                          title="Nobody has judged this duel yet.">Unjudged</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="archive__pagination">
            @* The old copy read "Showing 20 of 20 duels — more available", because the first
               number counted the filter and the second counted what had been loaded, while
               "more available" spoke about the server. Three different populations, one
               sentence. Now it counts one thing, and Load More says the rest. *@
            <span class="archive__count">@CountSummary</span>
            @if (_hasMore)
            {
                <button type="button" class="po-btn" @onclick="LoadMoreAsync">Load More</button>
            }
        </div>
    }
</div>

@code {
    private List<DuelSummaryDto> _duels = [];
    private DuelSummaryDto? _selectedDuel;
    private bool _loading = true;
    private string? _error;
    private bool _hasMore;
    private const int PageSize = 20;

    private string _verdictFilter = "All";

    // Materialised once per change instead of per read: the markup wants this list three times
    // (empty check, grid data, footer count), and re-sorting on every incidental re-render —
    // a row selection, say — was pure waste.
    private List<DuelSummaryDto> _filteredDuels = [];

    private void ApplyFilter()
    {
        IEnumerable<DuelSummaryDto> query = _verdictFilter switch
        {
            "Won" => _duels.Where(d => d.Verdict is DuelVerdict.Left or DuelVerdict.Right),
            "Tie" => _duels.Where(d => d.Verdict == DuelVerdict.Tie),
            "Unjudged" => _duels.Where(d => d.Verdict == DuelVerdict.Pending),
            _ => _duels
        };
        _filteredDuels = query
            .OrderByDescending(d => d.StartedAt)
            .ToList();
    }

    /// <summary>
    /// One population per sentence: how many rows are on screen, and — only when a filter is
    /// actually hiding something — how many were loaded in total.
    /// </summary>
    private string CountSummary
    {
        get
        {
            var shown = _filteredDuels.Count;
            var noun = shown == 1 ? "duel" : "duels";
            return _filteredDuels.Count == _duels.Count
                ? $"{shown} {noun}"
                : $"{shown} of {_duels.Count} loaded {noun}";
        }
    }

    private void SetVerdictFilter(string label)
    {
        _verdictFilter = label;
        ApplyFilter();
    }

    private void ResetFilters() => SetVerdictFilter("All");

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var results = await ApiClient.ListDuelsAsync(PageSize + 1);
            if (results is not null)
            {
                _hasMore = results.Count > PageSize;
                _duels = results.Take(PageSize).ToList();
                ApplyFilter();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load archive: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_duels.Count == 0) return;
        var oldest = _duels.Last();
        var before = oldest.StartedAt.ToString("yyyyMM");
        try
        {
            var more = await ApiClient.ListDuelsAsync(PageSize + 1, before);
            if (more is not null)
            {
                _hasMore = more.Count > PageSize;
                _duels.AddRange(more.Take(PageSize));
                ApplyFilter();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load more: {ex.Message}";
        }
    }

    // No scroll-into-view any more: the panel renders directly above the table, so it is
    // already on screen when it opens. Selecting the same row again closes it.
    private void OnRowSelect(DuelSummaryDto duel) =>
        _selectedDuel = _selectedDuel?.DuelId == duel.DuelId ? null : duel;

    /// <summary>Keyboard equivalent of clicking a row (SC 2.1.1).</summary>
    private void OnRowKeyDown(KeyboardEventArgs e, DuelSummaryDto duel)
    {
        if (e.Key is "Enter" or " ")
            OnRowSelect(duel);
    }

    /// <summary>
    /// One line naming what actually happened. A tie and an unjudged duel both have no winner
    /// but are not the same event, and the old "Winner: —" said nothing about which one it was.
    /// </summary>
    private static string OutcomeText(DuelSummaryDto d) => d.Verdict switch
    {
        DuelVerdict.Tie => "Tie — the judge found both outputs equivalent, so no rating moved.",
        DuelVerdict.Pending => "Not judged yet.",
        DuelVerdict.Expired => "Expired before anyone judged it.",
        _ => GetWinnerName(d),
    };

    private static string GetWinnerName(DuelSummaryDto d)
    {
        if (d.WinnerModelId is null) return "—";
        if (d.WinnerModelId == d.LeftModelId) return FormatModelName(d.LeftModelName, d.LeftModelId);
        if (d.WinnerModelId == d.RightModelId) return FormatModelName(d.RightModelName, d.RightModelId);
        return ShortModelId(d.WinnerModelId);
    }

    // Both delegate to the one shared resolver rather than restating its rules here; see
    // ModelDisplayName for why an unresolved id shows as "Retired model".
    private static bool IsUnresolvedModelName(string? modelName, ModelId modelId) =>
        ModelDisplayName.IsUnresolved(modelName, modelId);

    private static string FormatModelName(string? modelName, ModelId modelId) =>
        ModelDisplayName.ResolveForDisplay(modelName, null, modelId);

    private static string ShortModelId(string? modelId)
    {
        if (string.IsNullOrWhiteSpace(modelId)) return "id: n/a";
        return modelId.Length <= 10 ? $"id: {modelId}" : $"id: {modelId[..4]}…{modelId[^4..]}";
    }

    private string GetRowClass(DuelSummaryDto d) =>
        d.DuelId == _selectedDuel?.DuelId ? "archive__row--selected" : string.Empty;

    private void GoToArena() => Nav.NavigateTo($"/arena/{_selectedDuel!.DuelId}");

    private void GoToReChallenge()
    {
        if (_selectedDuel is null) return;
        var prompt = Uri.EscapeDataString(_selectedDuel.PromptSummary);
        var leftId = Uri.EscapeDataString(_selectedDuel.LeftModelId);
        var rightId = Uri.EscapeDataString(_selectedDuel.RightModelId);
        Nav.NavigateTo($"/?prompt={prompt}&leftModelId={leftId}&rightModelId={rightId}");
    }
}
