@page "/archive"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Microsoft.AspNetCore.Components.Web
@inject DuelApiClient ApiClient
@inject NavigationManager Nav

<PageTitle>Archive — PoLocalCompare</PageTitle>

<div class="archive">
    <h1 class="archive__title po-title">Lab Archive</h1>

    @if (_loading)
    {
        <p class="po-status">Loading archive...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="po-error">@_error</p>
    }
    else if (_duels.Count == 0)
    {
        <div class="po-empty">
            <h2>No duels recorded yet</h2>
            <p>Archive snapshots, verdicts, and lab reports will appear here once a duel completes.</p>
            <div class="archive__empty-actions">
                <a class="po-btn po-btn--ghost" href="/">⚔ Start a New Duel</a>
            </div>
        </div>
    }
    else
    {
        <div class="archive__filters">
            @foreach (var label in Filters)
            {
                <button class="archive__filter-chip @(_verdictFilter == label ? "archive__filter-chip--active" : "")"
                        @onclick="() => SetVerdictFilter(label)">
                    @label
                </button>
            }
        </div>
        @if (_filteredDuels.Count == 0)
        {
            <div class="archive__filtered-empty">
                <p>No duels match the <strong>@_verdictFilter</strong> filter.</p>
                <button class="archive__filter-reset" @onclick="ResetFilters">Show all duels</button>
            </div>
        }
        @* Clicking a row navigates straight to /arena/{id} so both model outputs are
           visible side-by-side (no intermediate "Duel Details" panel). Re-Challenge and
           Lab report sit inline as per-row icon buttons so the two side features the
           panel used to host don't quietly disappear. *@
        @* Semantic table with the shared card treatment below 640px. This replaced a
           RadzenDataGrid on 2026-08-23: the grid bought sorting and virtualisation, but
           Radzen.Blazor cost 1.43 MB gzipped — 11.9% of the app's entire download — and was
           one of two things keeping PublishTrimmed off, which costs another 2.47 MB. Paying
           roughly a third of cold-start payload for sorting on one table was the wrong trade
           for an app whose measured time-to-first-heading was 4-12 seconds.

           Rows are keyboard-operable links: role="link" + tabindex + aria-label keeps them
           operable (WCAG 2.2 SC 2.1.1) without pretending to be selectable rows. *@
        <div class="po-table-wrap">
            <table class="po-table po-table--selectable po-table--cards archive__rows">
                <caption class="visually-hidden">Recorded duels — open a row to compare both outputs side by side</caption>
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Prompt</th>
                        <th scope="col">Left model</th>
                        <th scope="col">Right model</th>
                        <th scope="col">Verdict</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _filteredDuels)
                    {
                        var href = $"/arena/{d.DuelId}";
                        <tr @key="d.DuelId"
                            role="link" tabindex="0"
                            aria-label="@($"Open {d.LeftModelName} vs {d.RightModelName} side-by-side")"
                            @onclick="@(() => Nav.NavigateTo(href))"
                            @onkeydown="e => OnRowKeyDown(e, href)">
                            <td data-label="Date">@d.StartedAt.ToString("yyyy-MM-dd HH:mm") <span class="archive__tz">UTC</span></td>
                            <td data-label="Prompt">@d.PromptSummary</td>
                            <td data-label="Left">
                                <span class="archive__model @(IsUnresolvedModelName(d.LeftModelName, d.LeftModelId) ? "archive__model--unresolved" : "")"
                                      title="@d.LeftModelId">
                                    @FormatModelName(d.LeftModelName, d.LeftModelId)
                                </span>
                            </td>
                            <td data-label="Right">
                                <span class="archive__model @(IsUnresolvedModelName(d.RightModelName, d.RightModelId) ? "archive__model--unresolved" : "")"
                                      title="@d.RightModelId">
                                    @FormatModelName(d.RightModelName, d.RightModelId)
                                </span>
                            </td>
                            <td data-label="Verdict">
                                @* Names the winner. "Left" made you map a chip back to a column
                                   to learn anything, which is the one thing this column is for. *@
                                @if (d.Verdict is DuelVerdict.Left or DuelVerdict.Right)
                                {
                                    <span class="archive__verdict archive__verdict--win" title="Winner of this duel">
                                        🏆 @GetWinnerName(d)
                                    </span>
                                }
                                else if (d.Verdict == DuelVerdict.Tie)
                                {
                                    <span class="archive__verdict archive__verdict--tie"
                                          title="The judge compared both outputs and found them equivalent. No rating moved.">
                                        🤝 Tie
                                    </span>
                                }
                                else
                                {
                                    <a class="po-btn po-btn--sm po-btn--primary archive__judge-btn"
                                       href="@href"
                                       title="Open both outputs and pick a winner"
                                       @onclick:stopPropagation="true">
                                        ⚖ Judge
                                    </a>
                                }
                            </td>
                            <td class="po-cell--bare">
                                <div class="archive__row-actions">
                                    @* Re-Challenge: same prompt, same two models, fresh duel. *@
                                    <button type="button"
                                            class="archive__row-btn"
                                            aria-label="@($"Re-Challenge {d.LeftModelName} vs {d.RightModelName} with the same prompt")"
                                            title="Re-Challenge with the same prompt"
                                            @onclick="@(() => GoToReChallenge(d))"
                                            @onclick:stopPropagation="true">⚧</button>
                                    @* Same-origin GET carries the BFF cookie, so the browser
                                       does the whole download with no interop. *@
                                    <a class="archive__row-btn archive__row-btn--link"
                                       href="@($"/api/duels/{d.DuelId}/report")"
                                       aria-label="Download lab report (HTML)"
                                       title="Download lab report (HTML)"
                                       download="@($"lab-report-{d.DuelId}.html")"
                                       @onclick:stopPropagation="true">⬇</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="archive__pagination">
            @* The old copy read "Showing 20 of 20 duels — more available", because the first
               number counted the filter and the second counted what had been loaded, while
               "more available" spoke about the server. Three different populations, one
               sentence. Now it counts one thing, and Load More says the rest. *@
            <span class="archive__count">@CountSummary</span>
            @if (_hasMore)
            {
                <button type="button" class="po-btn" @onclick="LoadMoreAsync">Load More</button>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// The one list of filter labels: the chips render from it and <see cref="VerdictQuery"/> is
    /// validated against it, so a deep link can never select a filter the chips don't offer.
    /// </summary>
    private static readonly string[] Filters = ["All", "Won", "Tie", "Unjudged"];

    /// <summary>
    /// Deep-links a filter chip. The header's "N awaiting judgment" pill uses it to land on the
    /// unjudged duels directly — it previously dropped you on "All", where the duels it was
    /// counting were scattered through twenty rows of decided ones.
    /// </summary>
    [SupplyParameterFromQuery(Name = "verdict")] public string? VerdictQuery { get; set; }

    private List<DuelSummaryDto> _duels = [];
    private bool _loading = true;
    private string? _error;
    private bool _hasMore;
    private const int PageSize = 20;

    private string _verdictFilter = "All";

    // Materialised once per change instead of per read: the markup wants this list three times
    // (empty check, grid data, footer count), and re-sorting on every incidental re-render —
    // a row selection, say — was pure waste.
    private List<DuelSummaryDto> _filteredDuels = [];

    private void ApplyFilter()
    {
        IEnumerable<DuelSummaryDto> query = _verdictFilter switch
        {
            "Won" => _duels.Where(d => d.Verdict is DuelVerdict.Left or DuelVerdict.Right),
            "Tie" => _duels.Where(d => d.Verdict == DuelVerdict.Tie),
            "Unjudged" => _duels.Where(d => d.Verdict == DuelVerdict.Pending),
            _ => _duels
        };
        _filteredDuels = query
            .OrderByDescending(d => d.StartedAt)
            .ToList();
    }

    /// <summary>
    /// One population per sentence: how many rows are on screen, and — only when a filter is
    /// actually hiding something — how many were loaded in total.
    /// </summary>
    private string CountSummary
    {
        get
        {
            var shown = _filteredDuels.Count;
            var noun = shown == 1 ? "duel" : "duels";
            return _filteredDuels.Count == _duels.Count
                ? $"{shown} {noun}"
                : $"{shown} of {_duels.Count} loaded {noun}";
        }
    }

    private void SetVerdictFilter(string label)
    {
        _verdictFilter = label;
        ApplyFilter();
    }

    private void ResetFilters() => SetVerdictFilter("All");

    protected override async Task OnInitializedAsync()
    {
        // Before LoadAsync, which applies the filter as part of loading.
        if (Filters.FirstOrDefault(f => string.Equals(f, VerdictQuery, StringComparison.OrdinalIgnoreCase)) is { } match)
            _verdictFilter = match;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var results = await ApiClient.ListDuelsAsync(PageSize + 1);
            if (results is not null)
            {
                _hasMore = results.Count > PageSize;
                _duels = results.Take(PageSize).ToList();
                ApplyFilter();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load archive: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_duels.Count == 0) return;
        var oldest = _duels.Last();
        var before = oldest.StartedAt.ToString("yyyyMM");
        try
        {
            var more = await ApiClient.ListDuelsAsync(PageSize + 1, before);
            if (more is not null)
            {
                _hasMore = more.Count > PageSize;
                _duels.AddRange(more.Take(PageSize));
                ApplyFilter();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load more: {ex.Message}";
        }
    }

    /// <summary>Keyboard equivalent of clicking a row (SC 2.1.1). Triggers the same
    /// navigation as a pointer click, so Enter or Space opens /arena/{id}.</summary>
    private void OnRowKeyDown(KeyboardEventArgs e, string href)
    {
        if (e.Key is "Enter" or " ")
            Nav.NavigateTo(href);
    }

    private static string GetWinnerName(DuelSummaryDto d)
    {
        if (d.WinnerModelId is null) return "—";
        if (d.WinnerModelId == d.LeftModelId) return FormatModelName(d.LeftModelName, d.LeftModelId);
        if (d.WinnerModelId == d.RightModelId) return FormatModelName(d.RightModelName, d.RightModelId);
        return ShortModelId(d.WinnerModelId);
    }

    // Both delegate to the one shared resolver rather than restating its rules here; see
    // ModelDisplayName for why an unresolved id shows as "Retired model".
    private static bool IsUnresolvedModelName(string? modelName, ModelId modelId) =>
        ModelDisplayName.IsUnresolved(modelName, modelId);

    private static string FormatModelName(string? modelName, ModelId modelId) =>
        ModelDisplayName.ResolveForDisplay(modelName, null, modelId);

    private static string ShortModelId(string? modelId)
    {
        if (string.IsNullOrWhiteSpace(modelId)) return "id: n/a";
        return modelId.Length <= 10 ? $"id: {modelId}" : $"id: {modelId[..4]}…{modelId[^4..]}";
    }

    private void GoToReChallenge(DuelSummaryDto d)
    {
        // Re-Challenge re-runs the same pairing with the same prompt. The Compare page expects
        // the prompt on the query string, so this stays text-only - the user can still swap
        // models on the landing page before launching.
        var prompt = Uri.EscapeDataString(d.PromptSummary);
        var leftId = Uri.EscapeDataString(d.LeftModelId);
        var rightId = Uri.EscapeDataString(d.RightModelId);
        Nav.NavigateTo($"/?prompt={prompt}&leftModelId={leftId}&rightModelId={rightId}");
    }
}
