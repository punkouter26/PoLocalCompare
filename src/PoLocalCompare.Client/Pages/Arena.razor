@page "/arena/{DuelIdText}"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Radzen
@using Radzen.Blazor
@inject DuelApiClient ApiClient
@inject AudioService AudioService
@inject NavigationManager Nav
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="arena">
    <h1 class="arena__title">Arena - Judge the Duel</h1>

    @if (_loading)
    {
        <p class="arena__loading">Loading duel results…</p>
    }
    else if (_duel is null)
    {
        <p class="arena__error">Duel not found.</p>
    }
    else
    {
        <p class="arena__prompt-label">Prompt: <em>@_duel.PromptText</em></p>

        @* ── View switcher ────────────────────────────────────────────────
           Rendered is what the models built; Code and Diff are for deciding *why* one is
           better. Only offered once both outputs exist — there is nothing to diff mid-stream. *@
        @if (BothOutputsPresent())
        {
            <div class="arena__view-toggle" role="group" aria-label="Output view">
                @foreach (var mode in new[] { SourceViewMode.Rendered, SourceViewMode.Code, SourceViewMode.Diff })
                {
                    <button type="button"
                            class="arena__view-btn @(_viewMode == mode ? "arena__view-btn--active" : "")"
                            aria-pressed="@(_viewMode == mode ? "true" : "false")"
                            @onclick="() => _viewMode = mode">
                        @ViewLabel(mode)
                    </button>
                }
            </div>
        }

        @if (_viewMode == SourceViewMode.Rendered || !BothOutputsPresent())
        {
            <div class="arena__viewports">
                <div class="arena__viewport-panel">
                    <SandboxedViewport
                        HtmlContent="@(_leftStreamingHtml ?? _leftResult?.HtmlOutputRaw ?? string.Empty)"
                        ModelName="@(_leftResult?.ModelName ?? _duel.LeftModelId)"
                        IsLoser="@(_loserModelId == _duel.LeftModelId)"
                        ShowWinner="@(_verdictRecorded && _winnerModelId == _duel.LeftModelId)"
                        ProbeRuntime="@(!_duelStillRunning)"
                        OnProbeUpdated="OnLeftProbe"
                    />
                    <div class="arena__hud">
                        <TelemetryHud Result="_leftResult" />
                    </div>
                    @if (_leftResult?.IsFailure == true)
                    {
                        <div class="arena__failure-card">
                            <div class="arena__failure-title">❌ @(_leftResult.ModelName ?? _duel.LeftModelId) failed</div>
                            <div class="arena__failure-body">@(FirstLine(_leftResult.FailureReason) ?? "No reason provided by the model runtime.")</div>
                            <details class="arena__failure-details">
                                <summary>Show technical details</summary>
                                <pre class="arena__failure-raw">@_leftResult.FailureReason</pre>
                            </details>
                            <div class="arena__failure-hint">Start a new duel with a different model pairing.</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_leftResult?.HtmlOutputRaw))
                    {
                        <div class="arena__source-link">
                            <button class="arena__source-btn" @onclick="() => OpenSourceAsync(_leftResult.HtmlOutputRaw, _leftResult.ModelName ?? _duel.LeftModelId)">
                                &lt;/&gt; View Source
                            </button>
                        </div>
                    }
                    @if (_eloShiftLeft.HasValue)
                    {
                        <div class="arena__elo-badge @(_eloShiftLeft >= 0 ? "arena__elo-badge--positive" : "arena__elo-badge--negative")">
                            ELO @(_eloDisplayLeft >= 0 ? "+" : "")@_eloDisplayLeft.ToString("F1")
                        </div>
                    }
                </div>

                <div class="arena__viewport-panel">
                    <SandboxedViewport
                        HtmlContent="@(_rightStreamingHtml ?? _rightResult?.HtmlOutputRaw ?? string.Empty)"
                        ModelName="@(_rightResult?.ModelName ?? _duel.RightModelId)"
                        IsLoser="@(_loserModelId == _duel.RightModelId)"
                        ShowWinner="@(_verdictRecorded && _winnerModelId == _duel.RightModelId)"
                        ProbeRuntime="@(!_duelStillRunning)"
                        OnProbeUpdated="OnRightProbe"
                    />
                    <div class="arena__hud">
                        <TelemetryHud Result="_rightResult" />
                    </div>
                    @if (_rightResult?.IsFailure == true)
                    {
                        <div class="arena__failure-card">
                            <div class="arena__failure-title">❌ @(_rightResult.ModelName ?? _duel.RightModelId) failed</div>
                            <div class="arena__failure-body">@(FirstLine(_rightResult.FailureReason) ?? "No reason provided by the model runtime.")</div>
                            <details class="arena__failure-details">
                                <summary>Show technical details</summary>
                                <pre class="arena__failure-raw">@_rightResult.FailureReason</pre>
                            </details>
                            <div class="arena__failure-hint">Start a new duel with a different model pairing.</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_rightResult?.HtmlOutputRaw))
                    {
                        <div class="arena__source-link">
                            <button class="arena__source-btn" @onclick="() => OpenSourceAsync(_rightResult.HtmlOutputRaw, _rightResult.ModelName ?? _duel.RightModelId)">
                                &lt;/&gt; View Source
                            </button>
                        </div>
                    }
                    @if (_eloShiftRight.HasValue)
                    {
                        <div class="arena__elo-badge @(_eloShiftRight >= 0 ? "arena__elo-badge--positive" : "arena__elo-badge--negative")">
                            ELO @(_eloDisplayRight >= 0 ? "+" : "")@_eloDisplayRight.ToString("F1")
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <SourceCompare
                LeftHtml="@_leftResult?.HtmlOutputRaw"
                RightHtml="@_rightResult?.HtmlOutputRaw"
                LeftName="@LeftDisplayName"
                RightName="@RightDisplayName"
                Mode="_viewMode" />
        }

        @* ── Objective scorecard ──────────────────────────────────────────
           Placed above the verdict buttons: it is evidence for the vote, not a summary of it. *@
        @if (BothOutputsPresent())
        {
            <OutputScorecard
                LeftHtml="@_leftResult?.HtmlOutputRaw"
                RightHtml="@_rightResult?.HtmlOutputRaw"
                LeftName="@LeftDisplayName"
                RightName="@RightDisplayName"
                LeftProbe="_leftProbe"
                RightProbe="_rightProbe" />
        }

        @if (_verdictRecorded)
        {
            @* SC 4.1.3 Status Messages — announced without moving focus. *@
            <div class="arena__verdict-recorded @(_optimistic ? "arena__verdict-recorded--pending" : "")" role="status">
                @if (_optimistic)
                {
                    <span>Winner: <strong>@ResolveDisplayName(_winnerModelId)</strong> — recording…</span>
                }
                else if (_verdictSource == VerdictSource.Ai)
                {
                    <span>
                        Decided by the AI judge — Winner: <strong>@ResolveDisplayName(_winnerModelId)</strong>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(_judgeRationale))
                    {
                        <span class="arena__judge-rationale">“@_judgeRationale”</span>
                    }
                }
                else
                {
                    <span>Verdict recorded ✓ — Winner: <strong>@ResolveDisplayName(_winnerModelId)</strong></span>
                }
            </div>
        }

        @* A pick that lost the race to the auto-judge has to be corrected visibly, not
           silently swapped underneath the person who made it. *@
        @if (_overriddenNotice is not null)
        {
            <div class="arena__override-notice" role="status">@_overriddenNotice</div>
        }

        @if (_duelStillRunning)
        {
            <div class="arena__generating-notice" role="status"><span aria-hidden="true">⚡</span> Duel in progress — previewing output as it streams…</div>
        }

        @if (!_verdictRecorded && !_duelStillRunning && _duel.Verdict == DuelVerdict.Pending)
        {
            @if (BothSidesFailed())
            {
                <div class="arena__judge-note arena__judge-note--error">
                    Both models failed — start a new duel with a different pairing.
                </div>
            }
            else if (_autoJudgeDeciding)
            {
                <div class="arena__judge-note arena__judge-note--auto" role="status">
                    <span aria-hidden="true">⚖</span> Nobody picked in time — the AI judge is deciding…
                </div>
            }
            else if (_autoJudgeRemaining is int remaining)
            {
                @* SC 4.1.3 — the countdown is the live region; it must not steal focus from the
                   verdict buttons, which are what a user racing the clock needs to reach. *@
                <div class="arena__judge-note arena__judge-note--auto" role="status">
                    <span aria-hidden="true">⚖</span>
                    Pick the winner below — otherwise the AI judge decides in
                    <strong>@remaining</strong> @(remaining == 1 ? "second" : "seconds").
                </div>
            }
            else if (_leftResult is not null || _rightResult is not null)
            {
                <div class="arena__judge-note">⚖ Pick the winner below.</div>
            }
        }

        <div class="arena__actions">
            <RadzenButton
                Text="👈 Winner: Left"
                ButtonStyle="ButtonStyle.Success"
                Size="ButtonSize.Large"
                Disabled="@(_verdictRecorded || _submitting || _retrying || BothSidesFailed())"
                Click="@(() => RecordVerdictAsync(DuelVerdict.Left))"
                class="arena__action-btn"
            />
            <RadzenButton
                Text="Winner: Right 👉"
                ButtonStyle="ButtonStyle.Success"
                Size="ButtonSize.Large"
                Disabled="@(_verdictRecorded || _submitting || _retrying || BothSidesFailed())"
                Click="@(() => RecordVerdictAsync(DuelVerdict.Right))"
                class="arena__action-btn"
            />
            @* Re-runs the same pairing and prompt as a brand-new duel — useful when a
               model failed for a transient reason (model load, cache, rate limit). *@
            <RadzenButton
                Text="@(_retrying ? "Starting…" : "🔄 Retry duel")"
                ButtonStyle="ButtonStyle.Secondary"
                Size="ButtonSize.Large"
                Disabled="@(_retrying || _submitting || _duelStillRunning)"
                Click="RetryDuelAsync"
                class="arena__action-btn"
            />
            @if (_verdictRecorded && !_optimistic)
            {
                <RadzenButton
                    Text="🖼 Share result"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Large"
                    Click="ShareResultAsync"
                    class="arena__action-btn"
                />
            }
            @* Available once both models are known — even if one is mid-stream or failed, a
               head-to-head link is still meaningful because the screen shows W/L counts per
               opponent regardless of who failed this round. *@
            @if (_duel is not null)
            {
                <RadzenButton
                    Text="⚔ Head-to-head"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Large"
                    Disabled="@(_duelStillRunning)"
                    Title="@(_duelStillRunning ? "Available once the duel finishes" : "Open the head-to-head record for these two models")"
                    Click="@(() => Nav.NavigateTo($"/h2h/{_duel!.LeftModelId}/{_duel.RightModelId}"))"
                    class="arena__action-btn"
                />
            }
        </div>

        @if (_retryError is not null)
        {
            <p class="arena__error" role="status">@_retryError</p>
        }
    }
</div>

@code {
    // Blazor route parameters must be one of its supported primitive types, so the route binds
    // text and it is narrowed to DuelId once, here, instead of at every call site.
    [Parameter] public string DuelIdText { get; set; } = string.Empty;

    private DuelId _duelId;

    protected override void OnParametersSet() => _duelId = DuelId.From(DuelIdText);

    private DuelDto? _duel;
    private DuelResultDto? _leftResult;
    private DuelResultDto? _rightResult;
    private bool _loading = true;
    private bool _submitting;
    private bool _verdictRecorded;
    private bool _retrying;
    private string? _retryError;

    private string? _winnerModelId;
    private string? _loserModelId;
    private double? _eloShiftLeft;
    private double? _eloShiftRight;

    // ── Comparison views ──────────────────────────────────────────────────────
    private SourceViewMode _viewMode = SourceViewMode.Rendered;
    private RuntimeProbeReport? _leftProbe;
    private RuntimeProbeReport? _rightProbe;

    // ── Optimistic verdict ────────────────────────────────────────────────────
    // The click flips the UI immediately and the server confirms afterwards. _optimistic marks
    // the window where what is on screen is a prediction, so a losing race can be corrected
    // rather than left standing as if it were the recorded outcome.
    private bool _optimistic;
    private string? _overriddenNotice;

    // Animated ELO readouts. The badge counts up to the real shift instead of snapping, which
    // is the only part of a verdict with any weight behind it.
    private double _eloDisplayLeft;
    private double _eloDisplayRight;
    private CancellationTokenSource? _eloAnimationCts;

    // ── Auto-judge ────────────────────────────────────────────────────────────
    // The server owns the real clock (it starts when the duel completes); this countdown
    // only mirrors it so the user can see how long they have. Whoever writes the verdict
    // first wins — a human click inside the window makes the server-side judge stand down.
    private VerdictSource _verdictSource = VerdictSource.Human;
    private string? _judgeRationale;
    private int? _autoJudgeRemaining;
    private bool _autoJudgeDeciding;
    private CancellationTokenSource? _autoJudgeCts;

    // Both models failed → there's nothing to judge; the UI prompts a fresh duel instead.
    private bool BothSidesFailed() =>
        _leftResult?.IsFailure == true && _rightResult?.IsFailure == true;

    private bool BothOutputsPresent() =>
        !string.IsNullOrWhiteSpace(_leftResult?.HtmlOutputRaw)
        && !string.IsNullOrWhiteSpace(_rightResult?.HtmlOutputRaw);

    private string LeftDisplayName => _leftResult?.ModelName ?? _duel?.LeftModelId ?? "Left";
    private string RightDisplayName => _rightResult?.ModelName ?? _duel?.RightModelId ?? "Right";

    private static string ViewLabel(SourceViewMode mode) => mode switch
    {
        SourceViewMode.Rendered => "🖼 Rendered",
        SourceViewMode.Code => "</> Code",
        _ => "⇄ Diff",
    };

    private static string? FirstLine(string? reason) => FailureReasonText.FirstLine(reason);

    private void OnLeftProbe(RuntimeProbeReport report)
    {
        _leftProbe = report;
        StateHasChanged();
    }

    private void OnRightProbe(RuntimeProbeReport report)
    {
        _rightProbe = report;
        StateHasChanged();
    }

    // Live streaming preview while duel is in progress
    private string? _leftStreamingHtml;
    private string? _rightStreamingHtml;
    private bool _duelStillRunning;
    private SignalRDuelClient? _signalR;

    private IDisposable? _locationChangingReg;

    protected override async Task OnInitializedAsync()
    {
        // UX#7: Block navigation away when verdict is still pending
        _locationChangingReg = Nav.RegisterLocationChangingHandler(async ctx =>
        {
            // A retry navigates deliberately to the new duel — don't nag about the old one,
            // and don't nag at all when the auto-judge will decide it anyway.
            if (_duel?.Verdict == DuelVerdict.Pending && !_verdictRecorded && !_retrying
                && _duel.AutoJudgeDelaySeconds <= 0)
            {
                var confirmed = await JS.InvokeAsync<bool>("confirm", "You haven't picked a winner yet. Leave without voting?");
                if (!confirmed) ctx.PreventNavigation();
            }
        });

        try
        {
            _duel = await ApiClient.GetDuelAsync(_duelId);
            if (_duel is not null)
            {
                _leftResult = _duel.Results.FirstOrDefault(r => r.ModelId == _duel.LeftModelId);
                _rightResult = _duel.Results.FirstOrDefault(r => r.ModelId == _duel.RightModelId);

                // If duel is still running, connect SignalR for live streaming preview
                if (_leftResult is null && _rightResult is null && _duel.CompletedAt is null)
                {
                    _duelStillRunning = true;
                    _signalR = new SignalRDuelClient();
                    _signalR.OnModelStatusUpdate += OnStatusUpdate;
                    _signalR.OnDuelComplete += OnDuelComplete;
                    _signalR.OnVerdictRecorded += OnVerdictRecorded;
                    await _signalR.ConnectAsync(Nav.BaseUri.TrimEnd('/'), _duelId);
                }
                // If verdict already recorded, restore state
                if (_duel.Verdict != DuelVerdict.Pending && _duel.WinnerModelId is not null)
                {
                    _verdictRecorded = true;
                    _winnerModelId = _duel.WinnerModelId;
                    _loserModelId = _duel.LoserModelId;
                    _verdictSource = _duel.VerdictSource;
                    _judgeRationale = _duel.JudgeRationale;
                    ApplyEloShifts(_duel);
                    SettleEloDisplay();
                }
                else if (!_duelStillRunning)
                {
                    // Arrived at an already-finished duel: the server's clock has been running
                    // since CompletedAt, so resume from where it actually is, not from zero.
                    StartAutoJudgeCountdown();
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Starts a fresh duel with the same pairing and prompt. Model failures here are usually
    /// transient (model load, browser cache, rate limit), so re-running beats rebuilding the
    /// selection by hand. The original duel is left untouched and still judgeable.
    /// </summary>
    private async Task RetryDuelAsync()
    {
        if (_duel is null || _retrying || _submitting) return;

        _retrying = true;
        _retryError = null;

        try
        {
            var prompt = string.IsNullOrWhiteSpace(_duel.PromptFull) ? _duel.PromptText : _duel.PromptFull;
            var rerun = await ApiClient.CommenceDuelAsync(_duel.LeftModelId, _duel.RightModelId, prompt);

            if (rerun is not null)
            {
                Nav.NavigateTo($"/processing/{rerun.DuelId}");
                return;
            }

            _retryError = "Could not start the re-run. Please try again.";
        }
        catch (Exception ex)
        {
            _retryError = $"Failed to start the re-run: {ex.Message}";
        }

        _retrying = false;
    }

    /// <summary>
    /// Commits the pick on screen before the network confirms it. The server remains the
    /// authority — every branch below either adopts what it recorded or rolls the guess back.
    /// </summary>
    private async Task RecordVerdictAsync(DuelVerdict verdict)
    {
        if (_verdictRecorded || _submitting || _duel is null) return;
        _submitting = true;
        _overriddenNotice = null;

        // Stop the visible countdown the moment they commit. The server-side judge is stopped
        // by the verdict itself — it re-reads the duel and stands down on anything but Pending.
        StopAutoJudgeCountdown();

        // Optimistic paint: winner/loser badges land on the frame of the click rather than
        // after a round-trip. ELO stays blank until the server says what it actually was —
        // inventing a number here would be a guess presented as a result.
        _verdictRecorded = true;
        _optimistic = true;
        _verdictSource = VerdictSource.Human;
        _judgeRationale = null;
        _winnerModelId = verdict == DuelVerdict.Left ? _duel.LeftModelId : _duel.RightModelId;
        _loserModelId = verdict == DuelVerdict.Left ? _duel.RightModelId : _duel.LeftModelId;
        StateHasChanged();

        // Confirmation feedback fires now, not after the response, for the same reason.
        await PulseAsync(30);
        _ = AudioService.PlaySuccessAsync();

        try
        {
            var response = await ApiClient.RecordVerdictAsync(_duelId, new VerdictRequestDto { Verdict = verdict });
            if (response is not null)
            {
                AdoptVerdict(response.WinnerModelId, response.LoserModelId, response.Source, response.JudgeRationale);
                ApplyEloShifts(response.WinnerModelId, response.EloShiftWinner, response.EloShiftLoser);
                await AnimateEloAsync();
            }
            else
            {
                // Most likely a 409: the auto-judge landed its verdict first. Show what was
                // actually recorded rather than leaving the optimistic guess standing.
                await ReconcileWithServerAsync(verdict);
            }
        }
        catch (Exception ex)
        {
            // The write may still have landed — ask before deciding the click did nothing.
            if (!await ReconcileWithServerAsync(verdict))
            {
                RollBackOptimisticVerdict();
                _retryError = $"Could not record the verdict: {ex.Message}";
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>
    /// Re-reads the duel after an uncertain write and reconciles the optimistic paint with it.
    /// Returns true when a verdict exists server-side.
    /// </summary>
    private async Task<bool> ReconcileWithServerAsync(DuelVerdict attempted)
    {
        var predictedWinner = _winnerModelId;

        if (!await RefreshVerdictFromServerAsync()) return false;

        if (!string.Equals(predictedWinner, _winnerModelId, StringComparison.Ordinal))
        {
            _overriddenNotice = _verdictSource == VerdictSource.Ai
                ? $"The AI judge recorded its verdict first — {ResolveDisplayName(_winnerModelId)} won. Your pick was not counted."
                : $"This duel was already decided — {ResolveDisplayName(_winnerModelId)} won.";
        }

        await AnimateEloAsync();
        return true;
    }

    private void RollBackOptimisticVerdict()
    {
        _verdictRecorded = false;
        _optimistic = false;
        _winnerModelId = null;
        _loserModelId = null;
        _eloShiftLeft = null;
        _eloShiftRight = null;
        StartAutoJudgeCountdown();
    }

    private void AdoptVerdict(string? winner, string? loser, VerdictSource source, string? rationale)
    {
        _verdictRecorded = true;
        _optimistic = false;
        _winnerModelId = winner;
        _loserModelId = loser;
        _verdictSource = source;
        _judgeRationale = rationale;
    }

    // ── ELO count-up ──────────────────────────────────────────────────────────

    /// <summary>
    /// Counts both badges from zero to their real shift over ~400ms. Respecting reduced-motion
    /// is handled by settling instantly rather than by animating faster.
    /// </summary>
    private async Task AnimateEloAsync()
    {
        _eloAnimationCts?.Cancel();
        _eloAnimationCts?.Dispose();
        _eloAnimationCts = new CancellationTokenSource();
        var token = _eloAnimationCts.Token;

        bool reduceMotion;
        try
        {
            reduceMotion = await JS.InvokeAsync<bool>(
                "eval", "window.matchMedia('(prefers-reduced-motion: reduce)').matches");
        }
        catch (JSException)
        {
            reduceMotion = false;
        }

        if (reduceMotion)
        {
            SettleEloDisplay();
            StateHasChanged();
            return;
        }

        const int steps = 24;
        var targetLeft = _eloShiftLeft ?? 0;
        var targetRight = _eloShiftRight ?? 0;

        try
        {
            for (var step = 1; step <= steps; step++)
            {
                // Cubic ease-out: fast enough to feel immediate, settling rather than stopping.
                var progress = step / (double)steps;
                var eased = 1 - Math.Pow(1 - progress, 3);

                _eloDisplayLeft = targetLeft * eased;
                _eloDisplayRight = targetRight * eased;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(16, token);
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded or navigating away — land on the true values below regardless.
        }

        SettleEloDisplay();
        await InvokeAsync(StateHasChanged);
    }

    private void SettleEloDisplay()
    {
        _eloDisplayLeft = _eloShiftLeft ?? 0;
        _eloDisplayRight = _eloShiftRight ?? 0;
    }

    private async Task PulseAsync(int milliseconds)
    {
        try
        {
            await JS.InvokeVoidAsync("hapticPulse", milliseconds);
        }
        catch (JSException)
        {
            // No Vibration API here — the sound and the visual flip already carry the feedback.
        }
    }

    // ── Share card ────────────────────────────────────────────────────────────

    private async Task ShareResultAsync()
    {
        if (_duel is null || _winnerModelId is null) return;

        var winnerSide = _winnerModelId == _duel.LeftModelId ? "left" : "right";

        try
        {
            await JS.InvokeVoidAsync("renderShareCard", new
            {
                kind = "Duel result",
                prompt = _duel.PromptText,
                leftName = LeftDisplayName,
                rightName = RightDisplayName,
                leftStat = FormatShareStat(_leftResult, _eloShiftLeft),
                rightStat = FormatShareStat(_rightResult, _eloShiftRight),
                winner = winnerSide,
                badge = _verdictSource == VerdictSource.Ai ? "⚖ AI-judged" : "👤 Human-judged",
                footer = $"{_duel.StartedAt:yyyy-MM-dd} · PoLocalCompare",
                fileName = $"duel-{_duel.DuelId}",
            });
        }
        catch (JSException)
        {
            _retryError = "Could not render the share card in this browser.";
        }
    }

    private static string FormatShareStat(DuelResultDto? result, double? eloShift)
    {
        if (result is null) return "no result";

        var parts = new List<string>
        {
            $"{result.TokenVelocity:F0} tok/s",
            $"{result.TotalDurationMs / 1000.0:F1}s",
        };

        if (eloShift.HasValue)
            parts.Add($"ELO {(eloShift >= 0 ? "+" : "")}{eloShift.Value:F1}");

        return string.Join("  ·  ", parts);
    }

    // ── Auto-judge countdown ──────────────────────────────────────────────────

    /// <summary>
    /// Mirrors the server's grace window. Started once the duel has finished and is still
    /// unjudged; a delay of 0 (auto-judge disabled) leaves the Arena exactly as it was.
    /// </summary>
    private void StartAutoJudgeCountdown()
    {
        if (_duel is null || _verdictRecorded || _autoJudgeCts is not null) return;
        if (_duel.Verdict != DuelVerdict.Pending) return;
        if (_duel.AutoJudgeDelaySeconds <= 0) return;

        // The server started counting at CompletedAt, so a page opened late must not restart
        // the clock — resume from whatever is genuinely left of the window.
        var elapsed = _duel.CompletedAt is { } completedAt
            ? (DateTimeOffset.UtcNow - completedAt).TotalSeconds
            : 0;
        var remaining = (int)Math.Ceiling(_duel.AutoJudgeDelaySeconds - elapsed);

        _autoJudgeCts = new CancellationTokenSource();
        _ = RunAutoJudgeCountdownAsync(Math.Max(0, remaining), _autoJudgeCts.Token);
    }

    private void StopAutoJudgeCountdown()
    {
        _autoJudgeCts?.Cancel();
        _autoJudgeCts?.Dispose();
        _autoJudgeCts = null;
        _autoJudgeRemaining = null;
        _autoJudgeDeciding = false;
    }

    private async Task RunAutoJudgeCountdownAsync(int seconds, CancellationToken cancellationToken)
    {
        try
        {
            for (var remaining = seconds; remaining > 0; remaining--)
            {
                _autoJudgeRemaining = remaining;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1000, cancellationToken);
            }

            _autoJudgeRemaining = null;
            _autoJudgeDeciding = true;
            await InvokeAsync(StateHasChanged);

            // SignalR delivers the verdict when this page is connected, but the Arena only
            // connects for duels that were still running when it loaded. Poll as well so a
            // page opened after completion still reflects the decision. The judge call itself
            // is bounded by AiJudge:TimeoutSeconds, so this window is generous, not open-ended.
            for (var attempt = 0; attempt < 45 && !_verdictRecorded; attempt++)
            {
                await Task.Delay(1000, cancellationToken);
                if (await RefreshVerdictFromServerAsync())
                {
                    await AnimateEloAsync();
                    return;
                }
            }

            // The judge declined to decide (no output to compare, or an unreachable judge).
            // Fall back to the plain "pick a winner" prompt — the duel is still judgeable.
            _autoJudgeDeciding = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Human picked, or the page went away.
        }
    }

    /// <summary>Re-reads the duel and adopts its verdict if one has landed. True when it had.</summary>
    private async Task<bool> RefreshVerdictFromServerAsync()
    {
        var fresh = await ApiClient.GetDuelAsync(_duelId);
        if (fresh is null || fresh.Verdict == DuelVerdict.Pending || fresh.WinnerModelId is null)
            return false;

        _duel = fresh;
        AdoptVerdict(fresh.WinnerModelId, fresh.LoserModelId, fresh.VerdictSource, fresh.JudgeRationale);
        _autoJudgeRemaining = null;
        _autoJudgeDeciding = false;
        ApplyEloShifts(fresh);
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private void OnVerdictRecorded(VerdictResponseDto response)
    {
        // A verdict the user just submitted comes back through the normal response path with
        // its ELO animation; adopting the broadcast too would restart that mid-flight.
        if (_verdictRecorded && !_optimistic) return;

        AdoptVerdict(response.WinnerModelId, response.LoserModelId, response.Source, response.JudgeRationale);
        ApplyEloShifts(response.WinnerModelId, response.EloShiftWinner, response.EloShiftLoser);

        StopAutoJudgeCountdown();
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await AnimateEloAsync();
        });
    }

    private void ApplyEloShifts(DuelDto duel)
    {
        if (duel.WinnerModelId is null || duel.EloShiftWinner is null || duel.EloShiftLoser is null)
            return;

        ApplyEloShifts(duel.WinnerModelId, duel.EloShiftWinner, duel.EloShiftLoser);
    }

    /// <summary>
    /// The server reports shifts by outcome (winner/loser); the two panels need them by side.
    /// Every path that learns a verdict — human click, SignalR push, or a re-read of the duel —
    /// funnels through here so the badges can't disagree about which side gained.
    /// </summary>
    private void ApplyEloShifts(string? winnerModelId, double? shiftWinner, double? shiftLoser)
    {
        _eloShiftLeft = _duel?.LeftModelId == winnerModelId ? shiftWinner : shiftLoser;
        _eloShiftRight = _duel?.RightModelId == winnerModelId ? shiftWinner : shiftLoser;
    }

    private string ResolveDisplayName(string? modelId)
    {
        if (modelId is null || _duel is null) return modelId ?? string.Empty;
        if (modelId == _duel.LeftModelId)
            return _leftResult?.ModelName ?? _duel.LeftModelId;
        if (modelId == _duel.RightModelId)
            return _rightResult?.ModelName ?? _duel.RightModelId;
        return modelId;
    }

    private async Task OpenSourceAsync(string htmlContent, string modelName)
    {
        // Open the raw HTML source in a new browser tab so the user can inspect it
        await JS.InvokeVoidAsync("openHtmlSource", htmlContent, modelName);
    }

    // ── SignalR handlers ──────────────────────────────────────────────────────
    private void OnStatusUpdate(ModelStatusUpdateDto update)
    {
        if (string.IsNullOrEmpty(update.HtmlPreview)) return;
        if (update.Side == "Left") _leftStreamingHtml = update.HtmlPreview;
        else if (update.Side == "Right") _rightStreamingHtml = update.HtmlPreview;
        InvokeAsync(StateHasChanged);
    }

    private void OnDuelComplete(DuelDto completedDuel)
    {
        _duelStillRunning = false;
        var duelId = _duelId;
        InvokeAsync((Func<Task>)(async () =>
        {
            _duel = await ApiClient.GetDuelAsync(duelId);
            if (_duel is not null)
            {
                _leftResult  = _duel.Results.FirstOrDefault(r => r.ModelId == _duel.LeftModelId);
                _rightResult = _duel.Results.FirstOrDefault(r => r.ModelId == _duel.RightModelId);
                _leftStreamingHtml  = null;
                _rightStreamingHtml = null;
                StartAutoJudgeCountdown();
            }
            StateHasChanged();
        }));
    }

    // UX#7: Dispose location-changing handler and SignalR connection.
    public async ValueTask DisposeAsync()
    {
        _locationChangingReg?.Dispose();
        StopAutoJudgeCountdown();
        _eloAnimationCts?.Cancel();
        _eloAnimationCts?.Dispose();
        if (_signalR is not null)
            await _signalR.DisposeAsync();
    }
}
