@page "/arena/{DuelIdText}"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Challenges
@using PoLocalCompare.Shared.Enums
@inject DuelApiClient ApiClient
@inject AudioService AudioService
@inject NavigationManager Nav
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WebLlmService WebLlm
@inject BlindModeService Blind
@inject FxService Fx

<PageTitle>Arena — PoLocalCompare</PageTitle>

<div class="arena">
    <h1 class="arena__title po-title">Arena — Judge the Duel</h1>

    @if (_loading)
    {
        <p class="po-status">Loading duel results…</p>
    }
    else if (_duel is null)
    {
        <div class="arena__not-found">
            <p class="arena__error">That duel no longer exists — it may have been wiped with the local storage, or the link may be mistyped.</p>
            <div class="arena__actions arena__actions--secondary">
                <a class="po-btn po-btn--primary arena__action-btn" href="/">⚔ Start a new duel</a>
                <a class="po-btn arena__action-btn" href="/archive">📁 Browse the archive</a>
            </div>
        </div>
    }
    else
    {
        <p class="arena__prompt-label">Prompt: <em>@_duel.PromptText</em></p>
        @if (!string.IsNullOrWhiteSpace(_duel.OwnerId))
        {
            <p class="arena__owner-line">Started by <strong>@_duel.OwnerId</strong></p>
        }

        @* ── Challenge budget ─────────────────────────────────────────────
           Stated before the outputs, because it changes what winning means: a model that goes
           over the ceiling loses regardless of what it produced. Each side's measurement lands
           here once its result exists, so the forfeit is visible rather than only asserted in
           the verdict line. *@
        @if (_duel.IsChallenge)
        {
            <div class="arena__budget">
                <span class="arena__budget-label">
                    <span aria-hidden="true">⏱</span>
                    @ChallengeRules.KindLabel(_duel.ChallengeKind) challenge —
                    @ChallengeRules.Describe(_duel.ChallengeKind, _duel.ChallengeThreshold)
                </span>
                @if (_leftResult is not null || _rightResult is not null)
                {
                    <span class="arena__budget-side @(MetBudget(_leftResult) ? "po-fg--ok" : "po-fg--err")">
                        @LeftDisplayName @MeasuredText(_leftResult) @(MetBudget(_leftResult) ? "✓" : "✗")
                    </span>
                    <span class="arena__budget-side @(MetBudget(_rightResult) ? "po-fg--ok" : "po-fg--err")">
                        @RightDisplayName @MeasuredText(_rightResult) @(MetBudget(_rightResult) ? "✓" : "✗")
                    </span>
                }
            </div>
        }

        @* ── Live race ────────────────────────────────────────────────────
           Only while generating. Previously this, the streaming previews and the whole
           telemetry read-out lived on a separate /processing page that navigated here the
           instant the duel finished; folding it in removes the page swap mid-duel. *@
        @if (_duelStillRunning)
        {
            <TokenRace
                LeftName="@LeftDisplayName"
                RightName="@RightDisplayName"
                LeftStatus="@_sides[(int)Side.Left].Status"
                RightStatus="@_sides[(int)Side.Right].Status"
                LeftTokenCount="@_sides[(int)Side.Left].TokenCount"
                RightTokenCount="@_sides[(int)Side.Right].TokenCount"
                LeftVelocity="@_sides[(int)Side.Left].TokenVelocity"
                RightVelocity="@_sides[(int)Side.Right].TokenVelocity"
                LeftPeakVelocity="@_sides[(int)Side.Left].PeakVelocity"
                RightPeakVelocity="@_sides[(int)Side.Right].PeakVelocity"
                LeftHistory="_sides[(int)Side.Left].VelocityHistory"
                RightHistory="_sides[(int)Side.Right].VelocityHistory" />

            @* The one diagnostic worth keeping from the old panels: without it, a browser model
               compiling shaders for 30 s is indistinguishable from a hung page. *@
            @if (_sides[(int)Side.Left].StallDetail is not null || _sides[(int)Side.Right].StallDetail is not null)
            {
                <div class="arena__stall-note" role="status">
                    @(_sides[(int)Side.Left].StallDetail ?? _sides[(int)Side.Right].StallDetail)
                </div>
            }
        }

        @* ── View switcher ────────────────────────────────────────────────
           Rendered is what the models built; Code and Diff are for deciding *why* one is
           better. Only offered once both outputs exist — there is nothing to diff mid-stream. *@
        @if (BothOutputsPresent())
        {
            <div class="arena__view-toggle" role="group" aria-label="Output view">
                @foreach (var mode in new[] { SourceViewMode.Rendered, SourceViewMode.Code, SourceViewMode.Diff })
                {
                    <button type="button"
                            class="arena__view-btn @(_viewMode == mode ? "arena__view-btn--active" : "")"
                            aria-pressed="@(_viewMode == mode ? "true" : "false")"
                            @onclick="() => _viewMode = mode">
                        @ViewLabel(mode)
                    </button>
                }
            </div>
        }

        @if (_viewMode == SourceViewMode.Rendered || !BothOutputsPresent())
        {
            @* A failed side renders its failure card INSTEAD of the viewport and telemetry, not
               on top of them. The same failure used to be stated three times per side — the
               viewport's "produced no renderable output" placeholder, the HUD's red FAILED
               banner, and this card repeating the identical message — over a metric grid
               reading 0.0 tok/s / 0ms / 0 tokens / 0 B. *@
            <div class="arena__viewports">
                <ArenaViewportPanel
                    Result="@_leftResult"
                    DisplayName="@LeftDisplayName"
                    StreamingHtml="@_leftStreamingHtml"
                    PanelModelId="@_duel.LeftModelId"
                    LoserModelId="@_loserModelId"
                    WinnerModelId="@_winnerModelId"
                    IsVerdictRecorded="@_verdictRecorded"
                    IsDuelStillRunning="@_duelStillRunning"
                    IsMasked="@IsMasked"
                    EloShiftDisplay="@(_eloShiftLeft.HasValue ? _eloDisplayLeft : null)"
                    OnProbeUpdated="OnLeftProbe"
                    OnViewSource="(html) => OpenSourceAsync(html, LeftDisplayName)" />

                <ArenaViewportPanel
                    Result="@_rightResult"
                    DisplayName="@RightDisplayName"
                    StreamingHtml="@_rightStreamingHtml"
                    PanelModelId="@_duel.RightModelId"
                    LoserModelId="@_loserModelId"
                    WinnerModelId="@_winnerModelId"
                    IsVerdictRecorded="@_verdictRecorded"
                    IsDuelStillRunning="@_duelStillRunning"
                    IsMasked="@IsMasked"
                    EloShiftDisplay="@(_eloShiftRight.HasValue ? _eloDisplayRight : null)"
                    OnProbeUpdated="OnRightProbe"
                    OnViewSource="(html) => OpenSourceAsync(html, RightDisplayName)" />
            </div>
        }
        else
        {
            <SourceCompare
                LeftHtml="@_leftResult?.HtmlOutputRaw"
                RightHtml="@_rightResult?.HtmlOutputRaw"
                LeftName="@LeftDisplayName"
                RightName="@RightDisplayName"
                Mode="_viewMode" />
        }

        @* ── Duel cost summary ─────────────────────────────────────────
           Sums the two sides' API costs once both have a value. Shown above the scorecard so
           the dollar figure is in the same visual band as the per-side API cost lines in the
           telemetry HUDs. Suppressed when neither side has a rate (e.g. both local), because
           there is no signal to sum. *@
        @if (BothOutputsPresent() && (_leftResult?.ApiCostUsd.HasValue == true || _rightResult?.ApiCostUsd.HasValue == true))
        {
            <div class="arena__cost-total" role="status" aria-label="Estimated total cost for this duel">
                <span class="arena__cost-total-label">💰 Estimated duel cost</span>
                <span class="arena__cost-total-value">$@DuelTotalCost().ToString("F4")</span>
                <span class="arena__cost-total-breakdown">(@LeftDisplayName $@FormatCost(_leftResult?.ApiCostUsd) + @RightDisplayName $@FormatCost(_rightResult?.ApiCostUsd))</span>
            </div>
        }

        @* ── Objective scorecard ──────────────────────────────────────────
           Placed above the verdict buttons: it is evidence for the vote, not a summary of it. *@
        @if (BothOutputsPresent())
        {
            <OutputScorecard
                LeftHtml="@_leftResult?.HtmlOutputRaw"
                RightHtml="@_rightResult?.HtmlOutputRaw"
                LeftName="@LeftDisplayName"
                RightName="@RightDisplayName"
                LeftProbe="_leftProbe"
                RightProbe="_rightProbe" />
        }

        @* ── Blind reveal ─────────────────────────────────────────────────
           Fires on whichever verdict lands first, human or AI. Stated explicitly rather than
           just swapping the labels: a name that silently changes mid-page is a thing the reader
           has to notice, and the point of the exercise is knowing what you just picked. *@
        @if (_blind && _verdictRecorded)
        {
            <div class="arena__reveal" role="status">
                <span aria-hidden="true">🙈</span>
                Revealed — <strong>@BlindLabels.Left</strong> was @LeftRealName,
                <strong>@BlindLabels.Right</strong> was @RightRealName.
            </div>
        }

        @if (_verdictRecorded)
        {
            @* SC 4.1.3 Status Messages — announced without moving focus. *@
            <div class="arena__verdict-recorded @(_optimistic ? "arena__verdict-recorded--pending" : "")" role="status">
                @if (_optimistic)
                {
                    <span>Winner: <strong>@ResolveDisplayName(_winnerModelId)</strong> — recording…</span>
                }
                else if (_verdictValue == DuelVerdict.Tie)
                {
                    @* A tie has no winner to name, so it says what happened instead — and says
                       explicitly that ratings did not move, because "no winner" otherwise reads
                       as "the judge never ran". *@
                    <span>
                        <span aria-hidden="true">🤝</span>
                        Judged a tie — both outputs were found equivalent, so no rating moved.
                    </span>
                    @if (!string.IsNullOrWhiteSpace(_judgeRationale))
                    {
                        <span class="arena__judge-rationale">“@_judgeRationale”</span>
                    }
                }
                else if (_verdictSource == VerdictSource.Constraint)
                {
                    @* Nothing read the outputs here — the budget decided it. Said plainly, so a
                       forfeit is never mistaken for a judgement about quality. *@
                    <span>
                        Won on the challenge budget — Winner: <strong>@ResolveDisplayName(_winnerModelId)</strong>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(_judgeRationale))
                    {
                        <span class="arena__judge-rationale">@_judgeRationale</span>
                    }
                }
                else if (_verdictSource == VerdictSource.Ai)
                {
                    <span>
                        Decided by the AI judge — Winner: <strong>@ResolveDisplayName(_winnerModelId)</strong>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(_judgeRationale))
                    {
                        <span class="arena__judge-rationale">“@_judgeRationale”</span>
                    }
                }
                else
                {
                    <span>Verdict recorded ✓ — Winner: <strong>@ResolveDisplayName(_winnerModelId)</strong></span>
                }
                @* Forensic attribution — visible to the user, but never used for authorization.
                   For Human verdicts this is the clicker; for AI verdicts this is null and we
                   fall back to the deployment name on the rationale line above. *@
                @if (_verdictSource == VerdictSource.Human && !string.IsNullOrWhiteSpace(_duel.VerdictBy))
                {
                    <span class="arena__judge-by">Judged by <strong>@_duel.VerdictBy</strong></span>
                }
                else if (_verdictSource is VerdictSource.Ai or VerdictSource.Constraint
                         && !string.IsNullOrWhiteSpace(_duel.JudgeModel))
                {
                    <span class="arena__judge-by">Judge: <strong>@_duel.JudgeModel</strong></span>
                }
            </div>
        }

        @* A pick that lost the race to the auto-judge has to be corrected visibly, not
           silently swapped underneath the person who made it. *@
        @if (_overriddenNotice is not null)
        {
            <div class="arena__override-notice" role="status">@_overriddenNotice</div>
        }

        @if (_duelStillRunning)
        {
            <div class="arena__generating-notice" role="status"><span aria-hidden="true">⚡</span> Duel in progress — previewing output as it streams…</div>
        }

        @if (!_verdictRecorded && !_duelStillRunning && _duel.Verdict == DuelVerdict.Pending)
        {
            @if (BothSidesFailed())
            {
                <div class="arena__judge-note arena__judge-note--error">
                    Both models failed — start a new duel with a different pairing.
                </div>
            }
            else if (_autoJudgeDeciding)
            {
                <div class="arena__judge-note arena__judge-note--auto" role="status">
                    <span aria-hidden="true">⚖</span> Nobody picked in time — the AI judge is deciding…
                </div>
            }
            else if (_autoJudgeRemaining is int remaining)
            {
                @* SC 4.1.3 — the countdown is the live region; it must not steal focus from the
                   verdict buttons, which are what a user racing the clock needs to reach. *@
                <div class="arena__judge-note arena__judge-note--auto" role="status">
                    <span aria-hidden="true">⚖</span>
                    Pick the winner below — otherwise the AI judge decides in
                    <strong>@remaining</strong> @(remaining == 1 ? "second" : "seconds").
                </div>
            }
            else if (_leftResult is not null || _rightResult is not null)
            {
                <div class="arena__judge-note">⚖ Pick the winner below.</div>
            }
        }

        @* Two tiers. Voting is the page's primary action and gets the large buttons — but only
           while a vote is still possible: once a verdict exists they were rendered disabled
           forever, leaving the page's headline control permanently dead. Everything else is a
           follow-up and sits in a secondary row. *@
        @* Sticky to the foot of the viewport, not just placed here. The evidence — two iframes,
           the telemetry HUDs and the scorecard — is taller than any screen, so the decision
           control was always a scroll away from wherever you were reading. Sticky keeps the
           order (evidence first, then the vote) while making the vote reachable without
           travelling: land on an unjudged duel from the Archive and the winner buttons are
           already under your cursor. *@
        @if (CanStillVote)
        {
            <ArenaVoteButtons
                LeftDisplayName="@LeftDisplayName"
                RightDisplayName="@RightDisplayName"
                Disabled="@(_submitting || _retrying)"
                OnVote="RecordVerdictAsync" />
        }

        @* ── Follow-ups ────────────────────────────────────────────────────
           Nothing here while the duel is still streaming: the page is a live view at that
           point and every one of these was either disabled or hidden anyway, so the row was
           an empty band under the race.

           Once it has finished, the exits are New duel and Archive — two, both leading
           somewhere. The old row carried five same-weight buttons (Retry / Share / Head-to-head
           / Lab report / New duel) plus the two vote buttons above it: eleven controls on a
           decided duel. Head-to-head is gone with the page it opened; Retry now appears only
           when a side actually failed, which is what it is for; and the two export actions —
           which are not exits — sit behind a disclosure instead of competing with them. *@
        @if (!_duelStillRunning)
        {
            <div class="arena__actions arena__actions--secondary">
                <a class="po-btn po-btn--primary arena__action-btn" href="/">⚔ New duel</a>
                <a class="po-btn arena__action-btn" href="/archive">📁 Archive</a>

                @* Re-runs the same pairing and prompt as a brand-new duel. Shown only when a
                   model failed, because a transient failure (model load, cache, rate limit) is
                   the situation it exists for — on a clean duel it competed with New duel while
                   meaning almost the same thing. *@
                @if (EitherSideFailed())
                {
                    <button type="button" class="po-btn po-btn--warn arena__action-btn"
                            disabled="@(_retrying || _submitting)"
                            @onclick="RetryDuelAsync">
                        @(_retrying ? "Starting…" : "🔄 Retry duel")
                    </button>
                }
            </div>

            @if (_duel is not null)
            {
                <details class="arena__export">
                    <summary class="arena__export-summary">Export this duel</summary>
                    <div class="arena__actions arena__actions--secondary">
                        @if (_verdictRecorded && !_optimistic)
                        {
                            <button type="button" class="po-btn po-btn--sm arena__action-btn"
                                    @onclick="ShareResultAsync">
                                🖼 Share result
                            </button>
                        }
                        @* Plain anchor rather than a fetch + blob: the endpoint already sets
                           Content-Disposition, and a same-origin GET carries the BFF session
                           cookie, so the browser does the whole download without any interop. *@
                        <a class="po-btn po-btn--sm arena__action-btn"
                           href="@($"/api/duels/{_duelId}/report")"
                           download="@($"lab-report-{_duelId}.html")"
                           title="Download a self-contained HTML lab report for this duel">
                            ⬇ Lab report
                        </a>
                    </div>
                </details>
            }
        }

        @if (_retryError is not null)
        {
            <p class="arena__error" role="status">@_retryError</p>
        }
    }
</div>

@code {
    // Blazor route parameters must be one of its supported primitive types, so the route binds
    // text and it is narrowed to DuelId here instead of at every call site.
    [Parameter] public string DuelIdText { get; set; } = string.Empty;

    // Derived, not assigned in OnParametersSet: Blazor runs OnInitializedAsync *before*
    // OnParametersSet, so a field set there is still default() during the initial load. That
    // sent GET /api/duels/ with an empty id, which matched the list route, returned a JSON
    // array, and blew up deserializing it into a single DuelDto.
    private DuelId _duelId => DuelId.From(DuelIdText);

    private DuelDto? _duel;
    private DuelResultDto? _leftResult;
    private DuelResultDto? _rightResult;
    private bool _loading = true;
    private bool _submitting;
    private bool _verdictRecorded;
    private bool _retrying;
    private string? _retryError;

    private ModelId? _winnerModelId;
    private ModelId? _loserModelId;
    private double? _eloShiftLeft;
    private double? _eloShiftRight;

    // ── Comparison views ──────────────────────────────────────────────────────
    private SourceViewMode _viewMode = SourceViewMode.Rendered;
    private RuntimeProbeReport? _leftProbe;
    private RuntimeProbeReport? _rightProbe;

    // ── Optimistic verdict ────────────────────────────────────────────────────
    // The click flips the UI immediately and the server confirms afterwards. _optimistic marks
    // the window where what is on screen is a prediction, so a losing race can be corrected
    // rather than left standing as if it were the recorded outcome.
    private bool _optimistic;
    private string? _overriddenNotice;

    /// <summary>
    /// True when this duel was started with blind mode on. Read from localStorage rather than
    /// from the duel record: blindness is presentational and per-browser, so a shared Arena link
    /// correctly shows the names to whoever opens it — the duel was never blind for them.
    /// </summary>
    private bool _blind;

    // Animated ELO readouts. The badge counts up to the real shift instead of snapping, which
    // is the only part of a verdict with any weight behind it.
    private double _eloDisplayLeft;
    private double _eloDisplayRight;
    private CancellationTokenSource? _eloAnimationCts;

    // ── Auto-judge ────────────────────────────────────────────────────────────
    // The server owns the real clock (it starts when the duel completes); this countdown
    // only mirrors it so the user can see how long they have. Whoever writes the verdict
    // first wins — a human click inside the window makes the server-side judge stand down.
    private VerdictSource _verdictSource = VerdictSource.Human;

    /// <summary>
    /// The recorded verdict itself. Needed alongside <see cref="_winnerModelId"/> because a tie
    /// is a real verdict with no winner — keying "was this decided?" off the winner id alone
    /// treats a tie as still-pending and restarts the judge countdown on a finished duel.
    /// </summary>
    private DuelVerdict _verdictValue = DuelVerdict.Pending;
    private string? _judgeRationale;
    private int? _autoJudgeRemaining;
    private bool _autoJudgeDeciding;
    private CancellationTokenSource? _autoJudgeCts;

    // Both models failed → there's nothing to judge; the UI prompts a fresh duel instead.
    private bool BothSidesFailed() =>
        _leftResult?.IsFailure == true && _rightResult?.IsFailure == true;

    /// <summary>Gates "Retry duel" — a failure on either side is the case it exists for.</summary>
    private bool EitherSideFailed() =>
        _leftResult?.IsFailure == true || _rightResult?.IsFailure == true;

    private bool BothOutputsPresent() =>
        !string.IsNullOrWhiteSpace(_leftResult?.HtmlOutputRaw)
        && !string.IsNullOrWhiteSpace(_rightResult?.HtmlOutputRaw);

    /// <summary>
    /// Whether a human vote can still land. Gates the vote buttons out of the DOM rather than
    /// disabling them: once the verdict is in they can never become live again, and a dead
    /// control in the primary position reads as a broken page.
    /// </summary>
    private bool CanStillVote => !_verdictRecorded && !BothSidesFailed() && !_duelStillRunning;

    /// <summary>The model's actual name, whether or not the duel is currently masked.</summary>
    /// <remarks>
    /// Resolution order: result row's <c>ModelName</c> (only present once inference has
    /// landed), then the snapshotted <c>LeftModelName</c> on the duel DTO (always present for
    /// duels created after the snapshot was added; the server resolves through the catalog
    /// too), then the id as a last-ditch fallback so the page never renders a ULID on its own
    /// for a side whose name the user has no way to look up.
    /// </remarks>
    private string LeftRealName =>
        _leftResult?.ModelName
        ?? (string.IsNullOrEmpty(_duel?.LeftModelName) ? null : _duel!.LeftModelName)
        ?? _duel?.LeftModelId.ToString()
        ?? "Left";

    /// <inheritdoc cref="LeftRealName"/>
    private string RightRealName =>
        _rightResult?.ModelName
        ?? (string.IsNullOrEmpty(_duel?.RightModelName) ? null : _duel!.RightModelName)
        ?? _duel?.RightModelId.ToString()
        ?? "Right";

    /// <summary>
    /// Whether identity is currently hidden. Every surface that names a side — viewport
    /// caption, race lanes, scorecard columns, cost breakdown, failure card, View Source tab
    /// title, vote buttons — resolves its name through <see cref="LeftDisplayName"/> or
    /// <see cref="RightDisplayName"/>, so this one flag is the whole mask.
    /// </summary>
    private bool IsMasked => _blind && !_verdictRecorded;

    private string LeftDisplayName => IsMasked ? BlindLabels.Left : LeftRealName;
    private string RightDisplayName => IsMasked ? BlindLabels.Right : RightRealName;

    /// <summary>
    /// Sums the two sides' API costs. Models without a Foundry rate return null and contribute
    /// 0, so a "free" local model paired with a paid remote just shows the remote's share.
    /// </summary>
    private double DuelTotalCost() =>
        (_leftResult?.ApiCostUsd ?? 0) + (_rightResult?.ApiCostUsd ?? 0);

    // Formatting helpers live in ArenaFormatting so the share card can render the same
    // numbers without forking the rules.
    private static string FormatCost(double? value) => ArenaFormatting.FormatCost(value);
    private static string FormatElo(double value) => ArenaFormatting.FormatElo(value);
    private static string ViewLabel(SourceViewMode mode) => ArenaFormatting.ViewLabel(mode);
    private static string? FirstLine(string? reason) => FailureReasonText.FirstLine(reason);

    // ── Challenge budget ─────────────────────────────────────────────────────
    // Measured client-side from the same result row the server adjudicated on, through the same
    // shared rules — so what the page shows and what decided the duel cannot disagree.

    private ChallengeMeasurement? Measure(DuelResultDto? result)
    {
        if (_duel is null || !_duel.IsChallenge || result is null) return null;

        // isMetered has to match what ChallengeAdjudicator passed, or the page shows a tick
        // beside a side the server forfeited. A remote model with no recorded cost is unknown,
        // not free — see ChallengeRules.CostOf.
        var isMetered = result.ModelId == _duel.LeftModelId
            ? _duel.LeftModelType == ModelType.Remote
            : _duel.RightModelType == ModelType.Remote;

        return ChallengeRules.Measure(
            _duel.ChallengeKind,
            _duel.ChallengeThreshold,
            result.IsFailure,
            result.TotalDurationMs,
            result.ApiCostUsd,
            result.TokenCount,
            isMetered);
    }

    private bool MetBudget(DuelResultDto? result) => Measure(result)?.Met ?? false;

    private string MeasuredText(DuelResultDto? result) =>
        _duel is null ? string.Empty : ChallengeRules.Format(_duel.ChallengeKind, Measure(result)?.Measured);

    private void OnLeftProbe(RuntimeProbeReport report)
    {
        _leftProbe = report;
        StateHasChanged();
    }

    private void OnRightProbe(RuntimeProbeReport report)
    {
        _rightProbe = report;
        StateHasChanged();
    }

    // ── Live duel state ───────────────────────────────────────────────────────
    // The streaming half of this page used to be the /processing page. It lives here because a
    // duel is one thing: it streams, then it is judged, and swapping pages between those two
    // moments cost a full remount of both preview iframes. Running a browser model is no longer
    // part of it — that moved to LocalInferenceDriver, leaving only the view state behind.
    private string? _leftStreamingHtml;
    private string? _rightStreamingHtml;
    private bool _duelStillRunning;
    private SignalRDuelClient? _signalR;

    /// <summary>
    /// Streaming telemetry per side, indexed by <see cref="Side"/>. Replaces the row of
    /// parallel <c>_leftXxx</c> / <c>_rightXxx</c> fields that read identically but had to
    /// be updated through a <c>Side == "Left"</c> branch. Marked non-readonly because the
    /// side elements are mutated in place; only the array reference itself is fixed.
    /// </summary>
    private readonly SideMetrics[] _sides =
    [
        new SideMetrics(),
        new SideMetrics(),
    ];

    private ModelId _leftLocalModelId;
    private ModelId _rightLocalModelId;
    private bool _leftIsBrowserModel;
    private bool _rightIsBrowserModel;
    private DuelStatus _leftPrevStatus = DuelStatus.Initializing;
    private DuelStatus _rightPrevStatus = DuelStatus.Initializing;
    /// <summary>Browser-side warm-up timing captured at the Initializing → Generating edge;
    /// stays outside SideMetrics because it is set once per run and read in the velocity
    /// calculation, not surfaced in the markup.</summary>
    private long? _leftWarmUpMs;
    private long? _rightWarmUpMs;
    private DateTimeOffset _leftLastTokenAt = DateTimeOffset.UtcNow;
    private DateTimeOffset _rightLastTokenAt = DateTimeOffset.UtcNow;
    private DateTimeOffset _leftLastUpdateAt = DateTimeOffset.UtcNow;
    private DateTimeOffset _rightLastUpdateAt = DateTimeOffset.UtcNow;

    // Rolling tok/s samples behind the race sparklines. Bounded because status updates arrive
    // per token batch for the whole run — an unbounded list would grow for 15 minutes and the
    // sparkline only has ~100 horizontal units to draw into anyway.
    private const int VelocityHistoryLength = 60;

    private static void PushVelocity(List<double> history, double? velocity)
    {
        if (velocity is not > 0) return;
        history.Add(velocity.Value);
        if (history.Count > VelocityHistoryLength) history.RemoveAt(0);
    }

    // Owns running a WebGPU model in this tab and posting its result back. Per-Arena, because
    // its replay guard is per-duel bookkeeping.
    private LocalInferenceDriver _localInference = null!;
    private PeriodicTimer? _stallTimer;

    // Token-batch updates arrive far faster than a frame, and each one used to re-render the
    // whole page — both sandboxed iframes and the scorecard included — to move a counter. The
    // two streaming handlers ask this for a render instead; terminal events still paint at once.
    private RenderCoalescer? _streamRender;

    private IDisposable? _locationChangingReg;

    protected override async Task OnInitializedAsync()
    {
        // UX#7: Block navigation away when verdict is still pending. The prompt only fires
        // when the user has time to vote — AutoJudgeDelaySeconds > 0 means the auto-judge
        // will decide the duel on its own, so there is no reason to nag on the way out.
        // (The previous condition inverted this and prompted exactly when it shouldn't.)
        _locationChangingReg = Nav.RegisterLocationChangingHandler(async ctx =>
        {
            if (_duel?.Verdict == DuelVerdict.Pending && !_verdictRecorded && !_retrying
                && _duel.AutoJudgeDelaySeconds <= 0)
            {
                var confirmed = await JS.InvokeAsync<bool>("confirm", "You haven't picked a winner yet. Leave without voting?");
                if (!confirmed) ctx.PreventNavigation();
            }
        });

        // Before the duel loads, so the very first render of the panels is already masked.
        _blind = await Blind.IsBlindAsync(_duelId);

        try
        {
            _duel = await ApiClient.GetDuelAsync(_duelId);
            if (_duel is not null)
            {
                _leftResult = _duel.Results.FirstOrDefault(r => r.ModelId == _duel.LeftModelId);
                _rightResult = _duel.Results.FirstOrDefault(r => r.ModelId == _duel.RightModelId);

                // If duel is still running, connect SignalR for the live race and preview
                if (_leftResult is null && _rightResult is null && _duel.CompletedAt is null)
                {
                    _duelStillRunning = true;
                    NoteBrowserModels(_duel);

                    _streamRender = new RenderCoalescer(() => InvokeAsync(StateHasChanged));
                    _localInference = new LocalInferenceDriver(WebLlm, ApiClient);

                    _signalR = new SignalRDuelClient();
                    _signalR.OnModelStatusUpdate += OnStatusUpdate;
                    _signalR.OnDuelComplete += OnDuelComplete;
                    _signalR.OnVerdictRecorded += OnVerdictRecorded;
                    // Browser models run in this tab, not on the server — without this the duel
                    // would sit at Initializing forever for any WebGPU pairing.
                    _signalR.OnStartLocalInference += OnStartLocalInference;
                    WebLlm.OnStatusUpdate += OnLocalStatusUpdate;
                    await _signalR.ConnectAsync(Nav.BaseUri.TrimEnd('/'), _duelId);

                    // Independent ticker: worker silence is exactly when the UI must keep talking.
                    _stallTimer = new PeriodicTimer(TimeSpan.FromSeconds(2));
                    _ = RunStallTimerAsync(_stallTimer);
                }
                // If a verdict already exists, restore it. A tie counts: it is terminal and has
                // no winner id, so testing the winner id alone would drop it back into the
                // countdown branch below and re-arm a judge that has already spoken.
                if (_duel.Verdict is DuelVerdict.Tie
                    || (_duel.Verdict != DuelVerdict.Pending && _duel.WinnerModelId is not null))
                {
                    _verdictRecorded = true;
                    _verdictValue = _duel.Verdict;
                    _winnerModelId = _duel.WinnerModelId;
                    _loserModelId = _duel.LoserModelId;
                    _verdictSource = _duel.VerdictSource;
                    _judgeRationale = _duel.JudgeRationale;
                    ApplyEloShifts(_duel);
                    SettleEloDisplay();
                }
                else if (!_duelStillRunning)
                {
                    // Arrived at an already-finished duel: the server's clock has been running
                    // since CompletedAt, so resume from where it actually is, not from zero.
                    StartAutoJudgeCountdown();
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Starts a fresh duel with the same pairing and prompt. Model failures here are usually
    /// transient (model load, browser cache, rate limit), so re-running beats rebuilding the
    /// selection by hand. The original duel is left untouched and still judgeable.
    /// </summary>
    private async Task RetryDuelAsync()
    {
        if (_duel is null || _retrying || _submitting) return;

        _retrying = true;
        _retryError = null;

        try
        {
            var prompt = string.IsNullOrWhiteSpace(_duel.PromptFull) ? _duel.PromptText : _duel.PromptFull;
            var rerun = await ApiClient.CommenceDuelAsync(_duel.LeftModelId, _duel.RightModelId, prompt);

            if (rerun is not null)
            {
                Nav.NavigateTo($"/arena/{rerun.DuelId}");
                return;
            }

            _retryError = "Could not start the re-run. Please try again.";
        }
        catch (Exception ex)
        {
            _retryError = $"Failed to start the re-run: {ex.Message}";
        }

        _retrying = false;
    }

    /// <summary>
    /// Commits the pick on screen before the network confirms it. The server remains the
    /// authority — every branch below either adopts what it recorded or rolls the guess back.
    /// </summary>
    private async Task RecordVerdictAsync(DuelVerdict verdict)
    {
        if (_verdictRecorded || _submitting || _duel is null) return;
        _submitting = true;
        _overriddenNotice = null;

        // Stop the visible countdown the moment they commit. The server-side judge is stopped
        // by the verdict itself — it re-reads the duel and stands down on anything but Pending.
        StopAutoJudgeCountdown();

        // Optimistic paint: winner/loser badges land on the frame of the click rather than
        // after a round-trip. ELO stays blank until the server says what it actually was —
        // inventing a number here would be a guess presented as a result.
        _verdictRecorded = true;
        _optimistic = true;
        _verdictSource = VerdictSource.Human;
        _judgeRationale = null;
        _winnerModelId = verdict == DuelVerdict.Left ? _duel.LeftModelId : _duel.RightModelId;
        _loserModelId = verdict == DuelVerdict.Left ? _duel.RightModelId : _duel.LeftModelId;
        StateHasChanged();

        // Confirmation feedback fires now, not after the response, for the same reason.
        await PulseAsync(30);
        _ = AudioService.PlaySuccessAsync();

        // Banked on the click rather than on the server's answer. This ledger records what the
        // user preferred, not what was ultimately recorded — a pick that loses the race to the
        // AI judge was still a pick, and it is exactly as informative about their taste. Voting
        // again after a rollback replaces the entry, since the ledger is keyed on duel id.
        await RecordBlindVoteAsync(verdict);

        try
        {
            var response = await ApiClient.RecordVerdictAsync(_duelId, new VerdictRequestDto { Verdict = verdict });
            if (response is not null)
            {
                AdoptVerdict(response.Verdict, response.WinnerModelId, response.LoserModelId, response.Source, response.JudgeRationale);
                ApplyEloShifts(response.WinnerModelId, response.EloShiftWinner, response.EloShiftLoser);
                await AnimateEloAsync();
            }
            else
            {
                // Most likely a 409: the auto-judge landed its verdict first. Show what was
                // actually recorded rather than leaving the optimistic guess standing.
                await ReconcileWithServerAsync(verdict);
            }
        }
        catch (Exception ex)
        {
            // The write may still have landed — ask before deciding the click did nothing.
            if (!await ReconcileWithServerAsync(verdict))
            {
                RollBackOptimisticVerdict();
                _retryError = $"Could not record the verdict: {ex.Message}";
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>
    /// Re-reads the duel after an uncertain write and reconciles the optimistic paint with it.
    /// Returns true when a verdict exists server-side.
    /// </summary>
    private async Task<bool> ReconcileWithServerAsync(DuelVerdict attempted)
    {
        var predictedWinner = _winnerModelId;

        if (!await RefreshVerdictFromServerAsync()) return false;

        if (!string.Equals(predictedWinner, _winnerModelId, StringComparison.Ordinal))
        {
            _overriddenNotice = _verdictValue == DuelVerdict.Tie
                ? "The AI judge recorded a tie first — it found both outputs equivalent. Your pick was not counted."
                : _verdictSource == VerdictSource.Ai
                    ? $"The AI judge recorded its verdict first — {ResolveDisplayName(_winnerModelId)} won. Your pick was not counted."
                    : $"This duel was already decided — {ResolveDisplayName(_winnerModelId)} won.";
        }

        await AnimateEloAsync();
        return true;
    }

    /// <summary>
    /// Adds this pick to the local blind ledger. No-ops for a sighted duel, and for anything
    /// that is not a straight Left/Right choice — a tie expresses no preference.
    /// </summary>
    private async Task RecordBlindVoteAsync(DuelVerdict verdict)
    {
        if (!_blind || _duel is null) return;
        if (verdict is not (DuelVerdict.Left or DuelVerdict.Right)) return;

        var leftWon = verdict == DuelVerdict.Left;

        await Blind.RecordVoteAsync(new BlindVote(
            DuelId: _duelId,
            WinnerModelId: leftWon ? _duel.LeftModelId : _duel.RightModelId,
            WinnerName: leftWon ? LeftRealName : RightRealName,
            LoserModelId: leftWon ? _duel.RightModelId : _duel.LeftModelId,
            LoserName: leftWon ? RightRealName : LeftRealName,
            VotedAt: DateTimeOffset.UtcNow));
    }

    private void RollBackOptimisticVerdict()
    {
        _verdictRecorded = false;
        _optimistic = false;
        _verdictValue = DuelVerdict.Pending;
        _winnerModelId = null;
        _loserModelId = null;
        _eloShiftLeft = null;
        _eloShiftRight = null;
        StartAutoJudgeCountdown();
    }

    private void AdoptVerdict(DuelVerdict verdict, ModelId? winner, ModelId? loser, VerdictSource source, string? rationale)
    {
        var wasAlreadyFinal = _verdictRecorded && !_optimistic;

        _verdictRecorded = true;
        _optimistic = false;
        _verdictValue = verdict;
        _winnerModelId = winner;
        _loserModelId = loser;
        _verdictSource = source;
        _judgeRationale = rationale;

        // Only on the transition into a settled verdict. Re-adopting the same verdict happens
        // on every reconcile and poll, and replaying the celebration each time would turn the
        // payoff moment into a stutter.
        if (!wasAlreadyFinal) _ = CelebrateVerdictAsync(verdict);
    }

    /// <summary>
    /// The duel's payoff: a burst over the verdict banner and a cue that matches the outcome.
    /// </summary>
    /// <remarks>
    /// Safe here specifically because generation has finished — the burst is Canvas2D and
    /// one-shot, and the GPU it would otherwise contend with is no longer running inference.
    /// Nothing is awaited by the caller; a browser with no AudioContext or no canvas simply
    /// does not celebrate.
    /// </remarks>
    private async Task CelebrateVerdictAsync(DuelVerdict verdict)
    {
        try
        {
            if (verdict == DuelVerdict.Tie)
            {
                await AudioService.PlayTieAsync();
                return;
            }

            await Fx.BurstFromAsync(".arena__verdict-recorded");
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException or ObjectDisposedException)
        {
            // Decoration only — never let it reach the ErrorBoundary over a finished duel.
        }
    }

    // ── ELO count-up ──────────────────────────────────────────────────────────

    /// <summary>
    /// Counts both badges from zero to their real shift over ~400ms. Respecting reduced-motion
    /// is handled by settling instantly rather than by animating faster.
    /// </summary>
    private async Task AnimateEloAsync()
    {
        _eloAnimationCts?.Cancel();
        _eloAnimationCts?.Dispose();
        _eloAnimationCts = new CancellationTokenSource();
        var token = _eloAnimationCts.Token;

        bool reduceMotion;
        try
        {
            reduceMotion = await JS.InvokeAsync<bool>(
                "eval", "window.matchMedia('(prefers-reduced-motion: reduce)').matches");
        }
        catch (JSException)
        {
            reduceMotion = false;
        }

        if (reduceMotion)
        {
            SettleEloDisplay();
            StateHasChanged();
            return;
        }

        const int steps = 24;
        var targetLeft = _eloShiftLeft ?? 0;
        var targetRight = _eloShiftRight ?? 0;

        try
        {
            for (var step = 1; step <= steps; step++)
            {
                // Cubic ease-out: fast enough to feel immediate, settling rather than stopping.
                var progress = step / (double)steps;
                var eased = 1 - Math.Pow(1 - progress, 3);

                _eloDisplayLeft = targetLeft * eased;
                _eloDisplayRight = targetRight * eased;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(16, token);
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded or navigating away — land on the true values below regardless.
        }

        SettleEloDisplay();
        await InvokeAsync(StateHasChanged);
    }

    private void SettleEloDisplay()
    {
        _eloDisplayLeft = _eloShiftLeft ?? 0;
        _eloDisplayRight = _eloShiftRight ?? 0;
    }

    private async Task PulseAsync(int milliseconds)
    {
        try
        {
            await JS.InvokeVoidAsync("hapticPulse", milliseconds);
        }
        catch (JSException)
        {
            // No Vibration API here — the sound and the visual flip already carry the feedback.
        }
    }

    // ── Share card ────────────────────────────────────────────────────────────

    private async Task ShareResultAsync()
    {
        if (_duel is null || _winnerModelId is null) return;

        var winnerSide = _winnerModelId == _duel.LeftModelId ? "left" : "right";

        try
        {
            await JS.InvokeVoidAsync("renderShareCard", new
            {
                kind = "Duel result",
                prompt = _duel.PromptText,
                leftName = LeftDisplayName,
                rightName = RightDisplayName,
                leftStat = ArenaFormatting.FormatShareStat(_leftResult, _eloShiftLeft),
                rightStat = ArenaFormatting.FormatShareStat(_rightResult, _eloShiftRight),
                winner = winnerSide,
                badge = _verdictSource == VerdictSource.Ai ? "⚖ AI-judged" : "👤 Human-judged",
                footer = $"{_duel.StartedAt:yyyy-MM-dd} · PoLocalCompare",
                fileName = $"duel-{_duel.DuelId}",
            });
        }
        catch (JSException)
        {
            _retryError = "Could not render the share card in this browser.";
        }
    }

    // ── Auto-judge countdown ──────────────────────────────────────────────────

    /// <summary>
    /// Mirrors the server's grace window. Started once the duel has finished and is still
    /// unjudged; a delay of 0 (auto-judge disabled) leaves the Arena exactly as it was.
    /// </summary>
    private void StartAutoJudgeCountdown()
    {
        if (_duel is null || _verdictRecorded || _autoJudgeCts is not null) return;
        if (_duel.Verdict != DuelVerdict.Pending) return;
        if (_duel.AutoJudgeDelaySeconds <= 0) return;

        // The server started counting at CompletedAt, so a page opened late must not restart
        // the clock — resume from whatever is genuinely left of the window.
        var elapsed = _duel.CompletedAt is { } completedAt
            ? (DateTimeOffset.UtcNow - completedAt).TotalSeconds
            : 0;
        var remaining = (int)Math.Ceiling(_duel.AutoJudgeDelaySeconds - elapsed);

        _autoJudgeCts = new CancellationTokenSource();
        _ = RunAutoJudgeCountdownAsync(Math.Max(0, remaining), _autoJudgeCts.Token);
    }

    private void StopAutoJudgeCountdown()
    {
        _autoJudgeCts?.Cancel();
        _autoJudgeCts?.Dispose();
        _autoJudgeCts = null;
        _autoJudgeRemaining = null;
        _autoJudgeDeciding = false;
    }

    private async Task RunAutoJudgeCountdownAsync(int seconds, CancellationToken cancellationToken)
    {
        try
        {
            for (var remaining = seconds; remaining > 0; remaining--)
            {
                _autoJudgeRemaining = remaining;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1000, cancellationToken);
            }

            _autoJudgeRemaining = null;
            _autoJudgeDeciding = true;
            await InvokeAsync(StateHasChanged);

            // SignalR delivers the verdict when this page is connected, but the Arena only
            // connects for duels that were still running when it loaded. Poll as well so a
            // page opened after completion still reflects the decision. The judge call itself
            // is bounded by AiJudge:TimeoutSeconds, so this window is generous, not open-ended.
            for (var attempt = 0; attempt < 45 && !_verdictRecorded; attempt++)
            {
                await Task.Delay(1000, cancellationToken);
                if (await RefreshVerdictFromServerAsync())
                {
                    await AnimateEloAsync();
                    return;
                }
            }

            // The judge declined to decide (no output to compare, or an unreachable judge).
            // Fall back to the plain "pick a winner" prompt — the duel is still judgeable.
            _autoJudgeDeciding = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Human picked, or the page went away.
        }
    }

    /// <summary>Re-reads the duel and adopts its verdict if one has landed. True when it had.</summary>
    private async Task<bool> RefreshVerdictFromServerAsync()
    {
        var fresh = await ApiClient.GetDuelAsync(_duelId);
        // A tie is terminal but carries no winner id, so it has to pass this gate on the verdict
        // alone — otherwise the poll below never stops and the page waits out all 45 attempts on
        // a duel that was decided on the first one.
        if (fresh is null
            || fresh.Verdict == DuelVerdict.Pending
            || (fresh.Verdict != DuelVerdict.Tie && fresh.WinnerModelId is null))
            return false;

        _duel = fresh;
        AdoptVerdict(fresh.Verdict, fresh.WinnerModelId, fresh.LoserModelId, fresh.VerdictSource, fresh.JudgeRationale);
        _autoJudgeRemaining = null;
        _autoJudgeDeciding = false;
        ApplyEloShifts(fresh);
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private void OnVerdictRecorded(VerdictResponseDto response)
    {
        // A verdict the user just submitted comes back through the normal response path with
        // its ELO animation; adopting the broadcast too would restart that mid-flight.
        if (_verdictRecorded && !_optimistic) return;

        AdoptVerdict(response.Verdict, response.WinnerModelId, response.LoserModelId, response.Source, response.JudgeRationale);
        ApplyEloShifts(response.WinnerModelId, response.EloShiftWinner, response.EloShiftLoser);

        StopAutoJudgeCountdown();
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await AnimateEloAsync();
        });
    }

    private void ApplyEloShifts(DuelDto duel)
    {
        if (duel.WinnerModelId is null || duel.EloShiftWinner is null || duel.EloShiftLoser is null)
            return;

        ApplyEloShifts(duel.WinnerModelId, duel.EloShiftWinner, duel.EloShiftLoser);
    }

    /// <summary>
    /// The server reports shifts by outcome (winner/loser); the two panels need them by side.
    /// Every path that learns a verdict — human click, SignalR push, or a re-read of the duel —
    /// funnels through here so the badges can't disagree about which side gained.
    /// </summary>
    private void ApplyEloShifts(ModelId? winnerModelId, double? shiftWinner, double? shiftLoser)
    {
        _eloShiftLeft = _duel?.LeftModelId == winnerModelId ? shiftWinner : shiftLoser;
        _eloShiftRight = _duel?.RightModelId == winnerModelId ? shiftWinner : shiftLoser;
    }

    private string ResolveDisplayName(ModelId? modelId)
    {
        if (modelId is null || _duel is null) return modelId?.Value ?? string.Empty;
        if (modelId == _duel.LeftModelId)
            return _leftResult?.ModelName ?? _duel.LeftModelName;
        if (modelId == _duel.RightModelId)
            return _rightResult?.ModelName ?? _duel.RightModelName;
        return modelId.Value;
    }

    private async Task OpenSourceAsync(string htmlContent, string modelName)
    {
        // Open the raw HTML source in a new browser tab so the user can inspect it
        await JS.InvokeVoidAsync("openHtmlSource", htmlContent, modelName);
    }

    // ── SignalR handlers ──────────────────────────────────────────────────────
    private void OnStatusUpdate(ModelStatusUpdateDto update)
    {
        if (update.DuelId != _duelId) return;

        var side = ParseSide(update.Side);
        if (side is null) return;

        var metrics = _sides[(int)side.Value];
        metrics.Status = update.Status;
        metrics.TokenCount = update.TokenCount;
        if (update.TokenVelocity.HasValue) metrics.TokenVelocity = update.TokenVelocity;
        PushVelocity(metrics.VelocityHistory, update.TokenVelocity);
        if (update.PeakTokenVelocity.HasValue) metrics.PeakVelocity = update.PeakTokenVelocity;
        if (update.WarmUpMs.HasValue) metrics.WarmUpMs = update.WarmUpMs;
        if (side == Side.Left && !string.IsNullOrEmpty(update.HtmlPreview))
            _leftStreamingHtml = update.HtmlPreview;
        else if (!string.IsNullOrEmpty(update.HtmlPreview))
            _rightStreamingHtml = update.HtmlPreview;

        if (side == Side.Left) _leftLastTokenAt = DateTimeOffset.UtcNow;
        else _rightLastTokenAt = DateTimeOffset.UtcNow;

        // Coalesced, not immediate: this fires once per token batch on both sides at once.
        _streamRender?.Request();

        // Audio runs on the browser's audio thread and never touches the WebGPU device WebLLM
        // is generating on, so — unlike a particle effect — this is safe to fire mid-duel. The
        // module throttles to one blip per 130 ms per side; batches arrive far faster.
        if (update.TokenVelocity is { } velocity && velocity > 0)
            _ = AudioService.PlayTokenBlipAsync(velocity, update.Side);
    }

    /// <summary>Maps a SignalR side name to the <see cref="Side"/> enum, or null if unknown.</summary>
    private static Side? ParseSide(string side) =>
        side == "Left" ? Side.Left : side == "Right" ? Side.Right : null;

    /// <summary>Records which sides run in the browser so the stall hint can explain the silence.</summary>
    private void NoteBrowserModels(DuelDto duel)
    {
        _leftLocalModelId = ModelId.From(duel.LeftModelId);
        _rightLocalModelId = ModelId.From(duel.RightModelId);
    }

    /// <summary>
    /// Browser-model status arrives straight from the JS worker, bypassing the server hub, so
    /// velocity has to be derived here rather than read off the update.
    /// </summary>
    private void OnLocalStatusUpdate(ModelId modelId, WebLlmStatusUpdate update)
    {
        // The first browser update names the side: before it lands, neither id is known.
        var isLeft = modelId == _leftLocalModelId;
        if (isLeft) _leftIsBrowserModel = true; else _rightIsBrowserModel = true;

        var status = update.Status switch
        {
            "Generating" => DuelStatus.Generating,
            "Done" => DuelStatus.Done,
            "Failed" => DuelStatus.Failed,
            _ => DuelStatus.Initializing,
        };

        if (isLeft)
        {
            _leftLastUpdateAt = DateTimeOffset.UtcNow;
            // Warm-up is the elapsed time at the Initializing → Generating edge.
            if (_leftPrevStatus == DuelStatus.Initializing && status == DuelStatus.Generating)
                _leftWarmUpMs = update.ElapsedMs;
            _leftPrevStatus = status;

            var metrics = _sides[(int)Side.Left];
            metrics.Status = status;
            metrics.TokenCount = update.TokenCount;

            var velocity = GenerationVelocity(update, _leftWarmUpMs);
            metrics.TokenVelocity = velocity;
            PushVelocity(metrics.VelocityHistory, velocity);
            if (velocity > (metrics.PeakVelocity ?? 0)) metrics.PeakVelocity = velocity;
            if (update.TokenCount > 0) _leftLastTokenAt = DateTimeOffset.UtcNow;
            if (update.HtmlPreview is not null) _leftStreamingHtml = update.HtmlPreview;
        }
        else
        {
            _rightLastUpdateAt = DateTimeOffset.UtcNow;
            if (_rightPrevStatus == DuelStatus.Initializing && status == DuelStatus.Generating)
                _rightWarmUpMs = update.ElapsedMs;
            _rightPrevStatus = status;

            var metrics = _sides[(int)Side.Right];
            metrics.Status = status;
            metrics.TokenCount = update.TokenCount;

            var velocity = GenerationVelocity(update, _rightWarmUpMs);
            metrics.TokenVelocity = velocity;
            PushVelocity(metrics.VelocityHistory, velocity);
            if (velocity > (metrics.PeakVelocity ?? 0)) metrics.PeakVelocity = velocity;
            if (update.TokenCount > 0) _rightLastTokenAt = DateTimeOffset.UtcNow;
            if (update.HtmlPreview is not null) _rightStreamingHtml = update.HtmlPreview;
        }

        // Same reasoning as the hub handler: the WebLLM worker reports per token batch.
        _streamRender?.Request();

        var blipVelocity = isLeft
            ? _sides[(int)Side.Left].TokenVelocity
            : _sides[(int)Side.Right].TokenVelocity;
        if (blipVelocity is { } sampled && sampled > 0)
            _ = AudioService.PlayTokenBlipAsync(sampled, isLeft ? "Left" : "Right");
    }

    /// <summary>Tokens per second excluding warm-up, so a slow model load does not read as slow generation.</summary>
    private static double? GenerationVelocity(WebLlmStatusUpdate update, long? warmUpMs)
    {
        var generatingMs = warmUpMs.HasValue ? update.ElapsedMs - warmUpMs.Value : update.ElapsedMs;
        return generatingMs > 0 && update.TokenCount > 0
            ? Math.Round(update.TokenCount / (generatingMs / 1000.0), 1)
            : null;
    }

    private async Task RunStallTimerAsync(PeriodicTimer timer)
    {
        while (await timer.WaitForNextTickAsync())
        {
            var now = DateTimeOffset.UtcNow;
            _sides[(int)Side.Left].StallDetail = StallDetail(_leftIsBrowserModel, _sides[(int)Side.Left].Status, _sides[(int)Side.Left].TokenCount, _leftLastUpdateAt, now, LeftDisplayName);
            _sides[(int)Side.Right].StallDetail = StallDetail(_rightIsBrowserModel, _sides[(int)Side.Right].Status, _sides[(int)Side.Right].TokenCount, _rightLastUpdateAt, now, RightDisplayName);
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Explains pre-first-token silence for browser models. Server-side models stream steadily,
    /// so an empty return here is the normal case and the note simply does not render.
    /// </summary>
    private static string? StallDetail(
        bool isBrowserModel, DuelStatus status, int tokenCount, DateTimeOffset lastUpdate, DateTimeOffset now, string name)
    {
        if (!isBrowserModel || status != DuelStatus.Generating || tokenCount > 0) return null;

        var secondsSince = (int)(now - lastUpdate).TotalSeconds;
        if (secondsSince < 3) return null;   // suppress for the first few seconds

        return $"⏳ {name}: GPU compiling shaders / pre-filling — last worker signal {secondsSince}s ago. Waiting for first token…";
    }

    // ── Browser-model inference ───────────────────────────────────────────────

    private void OnStartLocalInference(StartLocalInferencePayload payload)
    {
        if (payload.DuelId != _duelId) return;
        // A hub reconnect replays this signal; the driver owns the de-duplication.
        if (!_localInference.TryClaim(payload.ModelId)) return;

        if (payload.ModelId == _leftLocalModelId) _leftIsBrowserModel = true;
        else _rightIsBrowserModel = true;

        // Fire-and-forget; every failure path is handled inside the driver and reported to
        // the server, so there is no outcome here worth awaiting.
        _ = Task.Run(() => _localInference.RunAsync(payload));
    }

    private void OnDuelComplete(DuelDto completedDuel)
    {
        _duelStillRunning = false;
        var duelId = _duelId;
        InvokeAsync((Func<Task>)(async () =>
        {
            _duel = await ApiClient.GetDuelAsync(duelId);
            if (_duel is not null)
            {
                _leftResult  = _duel.Results.FirstOrDefault(r => r.ModelId == _duel.LeftModelId);
                _rightResult = _duel.Results.FirstOrDefault(r => r.ModelId == _duel.RightModelId);
                _leftStreamingHtml  = null;
                _rightStreamingHtml = null;
                StartAutoJudgeCountdown();
            }
            // Terminal: paint now rather than waiting out a coalescing interval, and drop any
            // pending streaming render so it cannot repaint stale mid-stream state afterwards.
            _streamRender?.Dispose();
            _streamRender = null;
            StateHasChanged();
        }));
    }

    // UX#7: Dispose location-changing handler and SignalR connection.
    public async ValueTask DisposeAsync()
    {
        _locationChangingReg?.Dispose();
        StopAutoJudgeCountdown();
        _eloAnimationCts?.Cancel();
        _eloAnimationCts?.Dispose();
        _stallTimer?.Dispose();
        _streamRender?.Dispose();
        WebLlm.OnStatusUpdate -= OnLocalStatusUpdate;
        if (_signalR is not null)
        {
            _signalR.OnModelStatusUpdate -= OnStatusUpdate;
            _signalR.OnDuelComplete -= OnDuelComplete;
            _signalR.OnVerdictRecorded -= OnVerdictRecorded;
            _signalR.OnStartLocalInference -= OnStartLocalInference;
            await _signalR.DisposeAsync();
        }
    }
}
