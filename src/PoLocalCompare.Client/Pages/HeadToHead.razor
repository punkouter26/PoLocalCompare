@page "/h2h/{ModelIdAText}/{ModelIdBText}"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@inject DuelApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Head to head — PoLocalCompare</PageTitle>

<div class="h2h">
    @if (_loading)
    {
        <p class="h2h__status">Loading the record…</p>
    }
    else if (_error is not null)
    {
        <p class="h2h__error">@_error</p>
        <a class="h2h__back" href="/leaderboard">← Back to leaderboard</a>
    }
    else if (_detail is null)
    {
        <p class="h2h__error">No record found for these two models.</p>
        <a class="h2h__back" href="/leaderboard">← Back to leaderboard</a>
    }
    else
    {
        <header class="h2h__header">
            <h1 class="h2h__title">@_detail.A.DisplayName <span class="h2h__vs">vs</span> @_detail.B.DisplayName</h1>
            @if (_detail.HasMet)
            {
                <p class="h2h__subtitle">
                    @_detail.TotalDuels judged meeting@(_detail.TotalDuels == 1 ? "" : "s")
                    @if (_detail.LastDuelAt is { } last)
                    {
                        <text> · last @last.ToString("yyyy-MM-dd")</text>
                    }
                </p>
            }
            else
            {
                <p class="h2h__subtitle">These two have never duelled. The profiles below are their overall records.</p>
            }
        </header>

        @* ── Scoreline ──────────────────────────────────────────────────── *@
        <div class="h2h__scoreline">
            <div class="h2h__score h2h__score--a @(_detail.A.Wins > _detail.B.Wins ? "h2h__score--lead" : "")">
                <span class="h2h__score-value">@_detail.A.Wins</span>
                <span class="h2h__score-name">@_detail.A.DisplayName</span>
            </div>
            <span class="h2h__score-sep" aria-hidden="true">–</span>
            <div class="h2h__score h2h__score--b @(_detail.B.Wins > _detail.A.Wins ? "h2h__score--lead" : "")">
                <span class="h2h__score-value">@_detail.B.Wins</span>
                <span class="h2h__score-name">@_detail.B.DisplayName</span>
            </div>
        </div>

        @* ── Side-by-side profile ───────────────────────────────────────── *@
        <table class="h2h__table">
            <caption class="h2h__caption">Comparison of the two models</caption>
            <thead>
                <tr>
                    <th scope="col">@_detail.A.DisplayName</th>
                    <th scope="col">Metric</th>
                    <th scope="col">@_detail.B.DisplayName</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td class="h2h__cell @(row.AWins ? "h2h__cell--better" : "")">@row.A</td>
                        <th scope="row" class="h2h__metric">
                            <span>@row.Label</span>
                            @if (row.Hint is not null)
                            {
                                <span class="h2h__metric-hint">@row.Hint</span>
                            }
                        </th>
                        <td class="h2h__cell @(row.BWins ? "h2h__cell--better" : "")">@row.B</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (_detail.A.EloSparkline is { Length: > 1 } || _detail.B.EloSparkline is { Length: > 1 })
        {
            <div class="h2h__sparklines">
                <div class="h2h__sparkline-col">
                    <span class="h2h__sparkline-label">@_detail.A.DisplayName — ELO trend</span>
                    <EloSparkline Values="_detail.A.EloSparkline" />
                </div>
                <div class="h2h__sparkline-col">
                    <span class="h2h__sparkline-label">@_detail.B.DisplayName — ELO trend</span>
                    <EloSparkline Values="_detail.B.EloSparkline" />
                </div>
            </div>
        }

        @* ── Recent meetings ────────────────────────────────────────────── *@
        @if (_detail.RecentDuels.Count > 0)
        {
            <section class="h2h__section">
                <h2 class="h2h__section-title">
                    Last @_detail.RecentDuels.Count meeting@(_detail.RecentDuels.Count == 1 ? "" : "s")
                </h2>
                <ul class="h2h__duels">
                    @foreach (var duel in _detail.RecentDuels)
                    {
                        <li class="h2h__duel">
                            <a class="h2h__duel-link" href="@($"/arena/{duel.DuelId}")">
                                <span class="h2h__duel-date">@duel.OccurredAt.ToString("MMM d")</span>
                                <span class="h2h__duel-prompt">@duel.PromptSummary</span>
                                <span class="h2h__duel-winner @WinnerClass(duel)">@WinnerLabel(duel)</span>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }

        <div class="h2h__actions">
            <a class="h2h__btn h2h__btn--primary" href="@RematchHref">⚔ Run a fresh duel</a>
            <button type="button" class="h2h__btn" @onclick="ShareAsync">🖼 Share this record</button>
            <a class="h2h__btn" href="/leaderboard">← Leaderboard</a>
        </div>
    }
</div>

@code {
    [Parameter] public string ModelIdAText { get; set; } = string.Empty;
    [Parameter] public string ModelIdBText { get; set; } = string.Empty;

    private HeadToHeadDetailDto? _detail;
    private bool _loading = true;
    private string? _error;
    private List<Row> _rows = [];

    private sealed record Row(string Label, string? Hint, string A, string B, bool AWins, bool BWins);

    private string RematchHref =>
        _detail is null
            ? "/"
            : $"/?leftModelId={Uri.EscapeDataString(_detail.A.ModelId.Value)}&rightModelId={Uri.EscapeDataString(_detail.B.ModelId.Value)}";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _detail = null;

        try
        {
            _detail = await ApiClient.GetHeadToHeadAsync(
                ModelId.From(ModelIdAText), ModelId.From(ModelIdBText));

            if (_detail is not null) _rows = BuildRows(_detail);
        }
        catch (ArgumentException)
        {
            _error = "That model id is not valid.";
        }
        catch (Exception ex)
        {
            _error = $"Could not load the head-to-head record: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static List<Row> BuildRows(HeadToHeadDetailDto detail)
    {
        var sampleNote = detail.SampledDuels > 0
            ? $"last {detail.SampledDuels} meeting{(detail.SampledDuels == 1 ? "" : "s")}"
            : null;

        var rows = new List<Row>
        {
            Compare("Current ELO", "overall, not just this matchup",
                detail.A.CurrentElo, detail.B.CurrentElo, higherIsBetter: true, v => v.ToString("F0")),

            new("Type", null,
                Label(detail.A.ModelType), Label(detail.B.ModelType), false, false),
        };

        if (detail.HasMet)
        {
            rows.Add(Compare("Avg ELO swing", "per meeting with this opponent",
                detail.A.AvgEloShift, detail.B.AvgEloShift, higherIsBetter: true,
                v => $"{(v >= 0 ? "+" : "")}{v:F1}"));
        }

        if (detail.A.AvgTokenVelocity is not null || detail.B.AvgTokenVelocity is not null)
        {
            rows.Add(CompareNullable("Avg speed", sampleNote,
                detail.A.AvgTokenVelocity, detail.B.AvgTokenVelocity, higherIsBetter: true,
                v => $"{v:F1} tok/s"));
        }

        if (detail.A.AvgQuality is not null || detail.B.AvgQuality is not null)
        {
            rows.Add(CompareNullable("Avg quality", sampleNote,
                detail.A.AvgQuality, detail.B.AvgQuality, higherIsBetter: true,
                v => $"{v:F0}/100"));
        }

        if (detail.A.AvgGreenScore is not null || detail.B.AvgGreenScore is not null)
        {
            rows.Add(CompareNullable("Green score", "tokens per Wh",
                detail.A.AvgGreenScore, detail.B.AvgGreenScore, higherIsBetter: true,
                v => $"{v:F1}"));
        }

        return rows;
    }

    private static string Label(ModelType type) => type switch
    {
        ModelType.Local => "Browser",
        ModelType.LocalService => "Ollama",
        _ => "Remote",
    };

    private static Row Compare(
        string label, string? hint, double a, double b, bool higherIsBetter, Func<double, string> format)
    {
        var aWins = higherIsBetter ? a > b : a < b;
        var bWins = higherIsBetter ? b > a : b < a;
        return new Row(label, hint, format(a), format(b), aWins, bWins);
    }

    /// <summary>
    /// A side with no sample does not "lose" the row — it simply has no reading, and marking
    /// the other side as better would turn missing data into a result.
    /// </summary>
    private static Row CompareNullable(
        string label, string? hint, double? a, double? b, bool higherIsBetter, Func<double, string> format)
    {
        var aText = a is null ? "—" : format(a.Value);
        var bText = b is null ? "—" : format(b.Value);

        if (a is null || b is null)
            return new Row(label, hint, aText, bText, false, false);

        var aWins = higherIsBetter ? a > b : a < b;
        var bWins = higherIsBetter ? b > a : b < a;
        return new Row(label, hint, aText, bText, aWins, bWins);
    }

    private string WinnerLabel(HeadToHeadDuelDto duel)
    {
        if (_detail is null || duel.WinnerModelId is null) return "no verdict";

        var name = duel.WinnerModelId == _detail.A.ModelId ? _detail.A.DisplayName : _detail.B.DisplayName;
        var judged = duel.Source == VerdictSource.Ai ? " ⚖" : "";
        return $"🏆 {name}{judged}";
    }

    private string WinnerClass(HeadToHeadDuelDto duel) =>
        _detail is null || duel.WinnerModelId is null ? "h2h__duel-winner--none"
        : duel.WinnerModelId == _detail.A.ModelId ? "h2h__duel-winner--a"
        : "h2h__duel-winner--b";

    private async Task ShareAsync()
    {
        if (_detail is null) return;

        var winner = _detail.A.Wins == _detail.B.Wins ? "none"
            : _detail.A.Wins > _detail.B.Wins ? "left" : "right";

        try
        {
            await JS.InvokeVoidAsync("renderShareCard", new
            {
                kind = "Head to head",
                prompt = _detail.HasMet
                    ? $"{_detail.TotalDuels} meetings — {_detail.A.Wins}–{_detail.B.Wins}"
                    : "No meetings yet",
                leftName = _detail.A.DisplayName,
                rightName = _detail.B.DisplayName,
                leftStat = $"ELO {_detail.A.CurrentElo:F0}  ·  {_detail.A.Wins} wins",
                rightStat = $"ELO {_detail.B.CurrentElo:F0}  ·  {_detail.B.Wins} wins",
                winner,
                badge = (string?)null,
                footer = $"{DateTimeOffset.UtcNow:yyyy-MM-dd} · PoLocalCompare",
                fileName = $"h2h-{_detail.A.ModelId}-{_detail.B.ModelId}",
            });
        }
        catch (JSException)
        {
            _error = "Could not render the share card in this browser.";
        }
    }
}
