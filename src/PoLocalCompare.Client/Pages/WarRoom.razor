@page "/war-room"
@inject NavigationManager Nav

@code {
    [SupplyParameterFromQuery] public string? Prompt { get; set; }
    [SupplyParameterFromQuery(Name = "leftModelId")] public string? LeftModelId { get; set; }
    [SupplyParameterFromQuery(Name = "rightModelId")] public string? RightModelId { get; set; }

    protected override void OnInitialized()
    {
        // /war-room was consolidated into the wizard at /. Forward any query params.
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(Prompt))
            qs.Add($"prompt={Uri.EscapeDataString(Prompt)}");
        if (!string.IsNullOrWhiteSpace(LeftModelId))
            qs.Add($"leftModelId={Uri.EscapeDataString(LeftModelId)}");
        if (!string.IsNullOrWhiteSpace(RightModelId))
            qs.Add($"rightModelId={Uri.EscapeDataString(RightModelId)}");

        var url = "/" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
        Nav.NavigateTo(url, forceLoad: false, replace: true);
    }
}