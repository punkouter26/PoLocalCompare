@page "/challenge"
@using PoLocalCompare.Shared.Challenges
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@inject DuelApiClient ApiClient

<PageTitle>Challenges — PoLocalCompare</PageTitle>

@* ── Challenge board ──────────────────────────────────────────────────────
   Deliberately not a view of the ELO leaderboard. A challenge asks "can this model do the job
   inside the budget", which is a different question from "which output is better" — so it is
   ranked on pass rate rather than rating, and rating is not shown at all. Challenge duels do
   still move ELO (they are ordinary duels with a rule attached); that movement belongs on the
   leaderboard, and mixing the two here is exactly what would make both uninterpretable. *@
<div class="challenge po-page">
    <header class="po-header">
        <h1 class="po-title">Challenge board</h1>
        <p class="po-subtitle">
            A budget is a hard ceiling: a model that goes over forfeits the duel however good its
            output was. Ranked by how often each model comes in under, not by rating.
        </p>
    </header>

    <div class="challenge__kinds" role="group" aria-label="Budget kind">
        @foreach (var kind in _kinds)
        {
            <button type="button"
                    class="po-btn @(_kind == kind ? "po-btn--success" : "po-btn--secondary")"
                    aria-pressed="@(_kind == kind ? "true" : "false")"
                    @onclick="() => SetKindAsync(kind)">
                @ChallengeRules.KindLabel(kind)
            </button>
        }
    </div>

    @if (_loading)
    {
        <p class="po-status">Loading challenge board…</p>
    }
    else if (_error is not null)
    {
        <p class="po-error" role="status">@_error</p>
    }
    else if (_entries.Count == 0)
    {
        @* An empty board is a prompt to run one, not an error: challenge duels are started from
           the Compare page, so this points there rather than leaving a dead table. *@
        <div class="po-empty">
            <p class="po-empty__title">
                No @ChallengeRules.KindLabel(_kind).ToLowerInvariant() challenges have been run yet.
            </p>
            <p class="po-empty__hint">
                Pick a budget on the Compare page before you start a duel and the result lands here.
            </p>
            <a class="po-btn po-btn--primary" href="/">⚔ Run a challenge</a>
        </div>
    }
    else
    {
        <div class="po-table-wrap">
            <table class="po-table po-table--cards">
                <caption class="visually-hidden">
                    Models ranked by how often they come in under a @ChallengeRules.KindLabel(_kind).ToLowerInvariant() budget
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Rank</th>
                        <th scope="col">Model</th>
                        <th scope="col" title="Attempts that came in at or under the budget">Passed</th>
                        <th scope="col">Pass rate</th>
                        <th scope="col" title="Challenge duels won, however the verdict was reached">Wins</th>
                        <th scope="col" title="Best measurement recorded for this kind of budget">Best</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _entries)
                    {
                        <tr @key="entry.ModelId">
                            <td class="po-cell--bare">
                                @if (entry.Rank == 1)
                                {
                                    <span class="challenge__rank challenge__rank--gold po-glow" title="#1 ranked">&#x1F947;</span>
                                }
                                else
                                {
                                    <span class="challenge__rank">@entry.Rank</span>
                                }
                            </td>
                            <td data-label="Model">
                                <a class="challenge__model" href="@($"/model/{entry.ModelId}")">@entry.DisplayName</a>
                                <span class="po-chip">@ModelTypeGroup.ShortLabel(entry.ModelType)</span>
                            </td>
                            <td data-label="Passed">@entry.Met<span class="challenge__of">/@entry.Attempts</span></td>
                            <td data-label="Pass rate">
                                @* The bar is the ranking key made visible; the width is the only
                                   dynamic value, so it goes through a custom property and the
                                   styling itself stays in the stylesheet. *@
                                <span class="challenge__rate">
                                    <span class="challenge__rate-bar" style="--fill: @((entry.PassRate * 100).ToString("F0"))%"></span>
                                    <span class="challenge__rate-text">@((entry.PassRate * 100).ToString("F0"))%</span>
                                </span>
                            </td>
                            <td data-label="Wins">@entry.Wins</td>
                            <td data-label="Best">@ChallengeRules.Format(entry.Kind, entry.Best)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="challenge__footnote">
            Challenge duels are ordinary duels with a rule attached — they persist and they move
            ELO. This board deliberately shows none of that: see the
            <a href="/leaderboard">leaderboard</a> for ratings.
        </p>
    }
</div>

@code {
    private static readonly ChallengeKind[] _kinds =
    [
        ChallengeKind.MaxSeconds,
        ChallengeKind.MaxCostUsd,
        ChallengeKind.MaxTokens,
    ];

    private ChallengeKind _kind = ChallengeKind.MaxSeconds;
    private List<ChallengeLeaderboardEntryDto> _entries = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetKindAsync(ChallengeKind kind)
    {
        if (_kind == kind) return;
        _kind = kind;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var rows = await ApiClient.GetChallengeLeaderboardAsync(_kind);
            _entries = rows?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _error = $"Could not load the challenge board: {ex.Message}";
            _entries = [];
        }
        finally
        {
            _loading = false;
        }
    }
}
