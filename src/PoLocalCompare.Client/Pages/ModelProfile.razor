@page "/model/{ModelIdText}"
@using PoLocalCompare.Shared.Analysis
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@inject DuelApiClient ApiClient
@inject IJSRuntime JS

<PageTitle>@(_profile?.DisplayName ?? "Model") — PoLocalCompare</PageTitle>

@* ── Model profile ────────────────────────────────────────────────────────
   The destination the leaderboard never had. Every column in that table was terminal: you
   could sort models but not open one. This is where a model's own record lives — standing,
   rating curve, who it has beaten, what it costs, and the gallery, which is the only place
   in the app that shows what a model actually produces without a duel wrapped around it.

   The kill list moved here wholesale from the leaderboard's expanding panel. It answers a
   question about one model, so it belongs on that model's page rather than in a drawer under
   a table of all of them. *@
<div class="po-page">
    @if (_loading)
    {
        <p class="po-status">Loading model…</p>
    }
    else if (_error is not null)
    {
        <p class="po-error" role="status">@_error</p>
        <a class="po-btn po-btn--secondary" href="/leaderboard">← Back to leaderboard</a>
    }
    else if (_profile is null)
    {
        <EmptyState Icon="❓"
                    Title="Model not found"
                    Hint="No model with that id — it may have been retired from the catalog since the link was made."
                    Actions="@(new[] {
                        new EmptyStateAction("← Back to leaderboard", "/leaderboard", EmptyStateActionVariant.Secondary)
                    })" />
    }
    else
    {
        @* The header is the model's trading card: it tilts under the pointer, its foil shifts
           with the angle, and the foil's strength is the tier (rank 1 prismatic, 2–3 gold,
           4–8 silver, the rest bronze). The tier is also stated as text, so nothing is carried
           by the sheen alone. It is the landing spot of the leaderboard → profile morph. *@
        <header class="profile__header profile__card profile__card--@Tier po-header po-glass">
            <div class="profile__card-top">
                <a class="profile__back" href="/leaderboard">← Leaderboard</a>
                <span class="profile__tier">@Tier tier</span>
                <button type="button" class="po-btn po-btn--sm po-btn--ghost profile__card-save"
                        @onclick="SaveCardAsync"
                        title="Download this model's card as a PNG">
                    <span aria-hidden="true">🃏</span> Save card
                </button>
            </div>

            <div class="profile__identity">
                <h1 class="po-title">@_profile.DisplayName</h1>
                <ModelTypeBadge Type="_profile.ModelType" Variant="ModelTypeBadgeVariant.Long" />
            </div>

            <div class="profile__standing">
                @if (_profile.Rank > 0)
                {
                    <span class="profile__rank">#@_profile.Rank</span>
                }
                else
                {
                    <span class="profile__rank profile__rank--unranked" title="No judged duels yet">Unranked</span>
                }
                <span class="profile__elo">@((int)Math.Round(_profile.CurrentElo)) ELO</span>
                <span class="profile__ci"
                      title="@($"95% interval on strength: {_profile.Strength - _profile.RatingInterval:F0}–{_profile.Strength + _profile.RatingInterval:F0}, from a Bradley–Terry fit over every judged duel.")">
                    ±@((int)Math.Round(_profile.RatingInterval))
                </span>
                @if (_profile.IsProvisional)
                {
                    <span class="profile__provisional" title="Fewer than 10 judged duels — this rating will still move a lot.">provisional</span>
                }
            </div>
        </header>

        @* ── Stat strip ────────────────────────────────────────────────────
           Costs and speed sit beside the record deliberately: "is it good" and "what does it
           cost to be that good" are the same decision, and splitting them across two surfaces
           is what made the leaderboard's Value column need a paragraph of tooltip. *@
        <dl class="profile__stats">
            <div class="profile__stat">
                <dt>Record</dt>
                <dd>@_profile.WinCount<span class="profile__stat-sep">–</span>@_profile.LossCount@(_profile.DrawCount > 0 ? $"–{_profile.DrawCount}" : "")</dd>
            </div>
            <div class="profile__stat">
                <dt>Win rate</dt>
                <dd>@(_profile.DuelCount > 0 ? $"{_profile.WinRate * 100:F0}%" : "—")</dd>
            </div>
            <div class="profile__stat">
                <dt>Duels</dt>
                <dd>@_profile.DuelCount</dd>
            </div>
            <div class="profile__stat">
                <dt>Avg speed</dt>
                <dd>@(_profile.AvgTokenVelocity.HasValue ? $"{_profile.AvgTokenVelocity:F0} tok/s" : "—")</dd>
            </div>
            <div class="profile__stat">
                <dt>Avg cost<span class="visually-hidden"> per duel</span></dt>
                <dd>
                    @if (_profile.AvgApiCostPerDuel.HasValue)
                    {
                        <span>$@_profile.AvgApiCostPerDuel.Value.ToString("F4")</span>
                    }
                    else
                    {
                        <span class="profile__no-data" title="Runs locally, or has no priced duels yet">free</span>
                    }
                </dd>
            </div>
            <div class="profile__stat">
                <dt>Output quality</dt>
                <dd>@(_profile.OutputQualityAvg.HasValue ? $"{_profile.OutputQualityAvg:F0}/100" : "—")</dd>
            </div>
        </dl>

        @* ── Rating curve ──────────────────────────────────────────────────
           Inline SVG rather than a charting library, for the same reason the prompts ask models
           for one: there is no component library here and this is a polyline. *@
        @if (_profile.EloHistory.Count > 1)
        {
            <section class="po-section" aria-labelledby="profile-elo-heading">
                <h2 id="profile-elo-heading" class="po-section-title">Rating history</h2>
                @* RadzenChart — restored 2026-09-02 when the payload decision was re-taken.
                   What it brings back over the hand-rolled inline SVG that stood in for it:
                   hover tooltips naming the opponent and the shift, automatic resize, and a
                   real value axis instead of two hand-placed range labels.

                   The baseline at the starting rating is kept as a RadzenSeriesAnnotation-free
                   second series (a flat 1200 line), because that comparison — "did this model
                   end above where it started" — is the one thing the curve exists to answer and
                   a bare line chart does not show it.

                   Colours come from the app tokens (ChartLineColor / ChartBaselineColor), not from a Radzen
                   theme: index.html deliberately loads only Radzen's structural base CSS, so
                   nothing here inherits a competing palette.

                   The height is NOT set here as Style="height: 16rem". It lives in app.css
                   under the Radzen token bridge, for the same reason the Archive grid's height
                   does: it needs a media query so a phone gets a shorter chart, and an inline
                   style cannot express that — it also keeps this file on the right side of the
                   "no inline style= attributes" rule the rest of the app follows. *@
                <div class="profile__chart-wrap">
                    <RadzenChart @key="_profile.ModelId"
                                 class="profile__chart">
                        <RadzenLineSeries TItem="EloPointView"
                                          Data="@_chartPoints"
                                          CategoryProperty="Label"
                                          ValueProperty="Elo"
                                          Title="Rating"
                                          Smooth="false"
                                          Stroke="@ChartLineColor"
                                          StrokeWidth="2">
                            <RadzenMarkers MarkerType="MarkerType.Circle" Size="6" />
                            <RadzenSeriesDataLabels Visible="false" />
                            @* The highlights below, pinned to the curve. Same point instances as
                               the series data, so each label lands on its own duel. *@
                            @foreach (var (point, text) in _chartAnnotations)
                            {
                                <RadzenSeriesAnnotation TItem="EloPointView" Data="@point" Text="@text" OffsetY="-14" Fill="@ChartAnnotationColor" />
                            }
                        </RadzenLineSeries>

                        <RadzenLineSeries TItem="EloPointView"
                                          Data="@_chartPoints"
                                          CategoryProperty="Label"
                                          ValueProperty="Baseline"
                                          Title="Starting rating"
                                          Stroke="@ChartBaselineColor"
                                          StrokeWidth="1"
                                          LineType="LineType.Dashed" />

                        <RadzenValueAxis Formatter="@(o => ((double)(o ?? 0d)).ToString("F0", Inv))">
                            <RadzenGridLines Visible="true" />
                            <RadzenAxisTitle Text="Elo" />
                        </RadzenValueAxis>

                        @* The category axis is one tick per duel; on a long history that is
                           unreadable, so the step keeps roughly eight labels regardless. *@
                        <RadzenCategoryAxis Step="@ChartCategoryStep" />

                        <RadzenLegend Visible="false" />
                    </RadzenChart>
                </div>
            </section>
        }

        @* ── Highlights ────────────────────────────────────────────────────
           The curve's story in three facts. Upsets are judged on the ratings at the time of
           the duel, not today's: beating a model that was 1400 then is an upset even if it has
           since fallen to 1100. *@
        @if (_profile.Highlights.PeakElo is { } peak)
        {
            var highlights = _profile.Highlights;
            <section class="po-section" aria-labelledby="profile-highlights-heading">
                <h2 id="profile-highlights-heading" class="po-section-title">Highlights</h2>
                <dl class="profile__stats profile__stats--flush">
                    <div class="profile__stat">
                        <dt>Peak rating</dt>
                        <dd>
                            @((int)Math.Round(peak))
                            @if (highlights.PeakAt is { } peakAt)
                            {
                                <span class="profile__stat-note">@peakAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                            }
                        </dd>
                    </div>
                    <div class="profile__stat">
                        <dt>Longest win streak</dt>
                        <dd>@highlights.LongestWinStreak</dd>
                    </div>
                    <div class="profile__stat">
                        <dt>Biggest upset</dt>
                        <dd>@(highlights.Upsets.Count > 0 ? $"+{highlights.Upsets[0].RatingGap:F0}" : "—")</dd>
                    </div>
                </dl>

                @if (highlights.Upsets.Count > 0)
                {
                    <ol class="profile__upsets">
                        @foreach (var upset in highlights.Upsets)
                        {
                            <li @key="upset.DuelId">
                                <a class="profile__opponent" href="@($"/arena/{upset.DuelId}")">
                                    Beat @upset.OpponentName
                                </a>
                                <span class="profile__upset-meta">
                                    rated @upset.RatingGap.ToString("F0") higher at the time · +@upset.Shift.ToString("F1") ELO ·
                                    @upset.At.ToLocalTime().ToString("yyyy-MM-dd")
                                </span>
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <p class="po-hint">No upsets yet — no win so far against a model rated 25+ points higher.</p>
                }
            </section>
        }

        @* ── Kill list ─────────────────────────────────────────────────────
           Moved from the leaderboard's drawer. Rematch is kept: it was the one thing the
           deleted /h2h page offered that the table did not. *@
        <section class="po-section" aria-labelledby="profile-killlist-heading">
            <h2 id="profile-killlist-heading" class="po-section-title">Kill list</h2>

            @if (_profile.KillList.Count == 0)
            {
                <p class="po-status">No head-to-head history yet.</p>
            }
            else
            {
                <div class="po-table-wrap">
                    <table class="po-table po-table--cards">
                        <caption class="visually-hidden">Head-to-head record against each opponent</caption>
                        <thead>
                            <tr>
                                <th scope="col">Opponent</th>
                                <th scope="col" title="Wins/losses, then ties when there are any">W/L/T</th>
                                <th scope="col">Win %</th>
                                <th scope="col">Last duel</th>
                                <th scope="col"><span class="visually-hidden">Rematch</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _profile.KillList)
                            {
                                var total = row.Wins + row.Losses + row.Draws;
                                var pct = total > 0 ? (row.Wins * 100.0 / total) : 0;
                                <tr @key="row.OpponentModelId">
                                    <td data-label="Opponent">
                                        <a class="profile__opponent" href="@($"/model/{row.OpponentModelId}")">@row.OpponentName</a>
                                    </td>
                                    <td data-label="W/L/T">@row.Wins/@row.Losses@(row.Draws > 0 ? $"/{row.Draws}" : "")</td>
                                    <td data-label="Win %">@(total > 0 ? $"{pct:F0}%" : "-")</td>
                                    <td class="po-cell--secondary" data-label="Last duel">@(row.LastDuelAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                    <td class="po-cell--bare">
                                        <a class="po-btn po-btn--sm po-btn--secondary"
                                           href="@RematchHref(row)"
                                           title="@($"Set up {_profile.DisplayName} vs {row.OpponentName} on the compare page")">
                                            ⚔ Rematch
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @* ── Gallery ───────────────────────────────────────────────────────
           Live sandboxed iframes, not screenshots. Same sandbox as the Arena's viewport —
           allow-scripts with no allow-same-origin — so a generated document still cannot reach
           the parent frame, cookies or localStorage. Scaled down with a transform rather than
           by resizing the frame, so each page lays out at its intended width and then shrinks;
           rendering a 1200px design into a 300px frame would show its mobile breakpoint. *@
        @if (_profile.WinningOutputs.Count > 0)
        {
            <section class="po-section" aria-labelledby="profile-gallery-heading">
                <h2 id="profile-gallery-heading" class="po-section-title">Winning outputs</h2>
                <p class="po-hint">
                    The most recent @_profile.WinningOutputs.Count duel@(_profile.WinningOutputs.Count == 1 ? "" : "s") this model won.
                </p>

                <div class="profile__gallery">
                    @foreach (var item in _profile.WinningOutputs)
                    {
                        <a class="profile__gallery-item po-lift" href="@($"/arena/{item.DuelId}")" @key="item.DuelId">
                            <div class="profile__gallery-frame">
                                <iframe srcdoc="@HtmlPreview.Normalize(item.HtmlOutputRaw)"
                                        sandbox="allow-scripts"
                                        title="@($"Output for: {item.PromptSummary}")"
                                        class="profile__gallery-iframe"
                                        loading="lazy"
                                        tabindex="-1"
                                        aria-hidden="true"></iframe>
                                @* Transparent cover: without it every click lands inside the
                                   generated document instead of on the link wrapping it. *@
                                <span class="profile__gallery-cover" aria-hidden="true"></span>
                            </div>
                            <span class="profile__gallery-prompt">@Truncate(item.PromptSummary, 80)</span>
                            <span class="profile__gallery-meta">
                                beat @item.OpponentName · @item.WonAt.ToLocalTime().ToString("yyyy-MM-dd")
                            </span>
                        </a>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    [Parameter] public string ModelIdText { get; set; } = string.Empty;

    private ModelProfileDto? _profile;
    private bool _loading = true;
    private string? _error;

    /// <summary>
    /// Foil tier by rank. Rank rather than raw ELO, because a rating only means something
    /// against the field it was earned in — 1320 is the top of one board and the middle of
    /// another. Unranked models (no judged duels) are bronze.
    /// </summary>
    private string Tier => _profile?.Rank switch
    {
        1 => "prismatic",
        2 or 3 => "gold",
        >= 4 and <= 8 => "silver",
        _ => "bronze",
    };

    private string? _holoBoundTo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Once per loaded profile: the header element is recreated whenever the page goes
        // through its loading state, so binding by model id rebinds exactly when it must.
        var id = _profile?.ModelId.ToString();
        if (id is null || _loading || id == _holoBoundTo) return;
        _holoBoundTo = id;

        try
        {
            await JS.InvokeVoidAsync("poWow.holo", ".profile__card");
        }
        catch (JSException)
        {
            // The card simply does not tilt.
        }
    }

    private async Task SaveCardAsync()
    {
        if (_profile is null) return;
        try
        {
            await JS.InvokeVoidAsync("poWow.exportCard", new
            {
                name = _profile.DisplayName,
                rank = _profile.Rank,
                elo = _profile.CurrentElo,
                interval = _profile.RatingInterval,
                record = $"{_profile.WinCount}–{_profile.LossCount}" + (_profile.DrawCount > 0 ? $"–{_profile.DrawCount}" : ""),
                winRate = _profile.DuelCount > 0 ? $"{_profile.WinRate * 100:F0}%" : "—",
                duels = _profile.DuelCount,
                type = ModelTypeGroup.Label(_profile.ModelType),
                tier = Tier,
            });
        }
        catch (JSException)
        {
            // No canvas or no download support: nothing to save.
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // OnParametersSetAsync, not OnInitializedAsync: the kill list links model to model, so
        // navigating from one profile to another reuses this component instance and an
        // initialiser would never run for the second one.
        _loading = true;
        _error = null;
        _profile = null;

        if (string.IsNullOrWhiteSpace(ModelIdText))
        {
            _loading = false;
            return;
        }

        try
        {
            _profile = await ApiClient.GetModelProfileAsync(ModelId.From(ModelIdText));
            BuildChart();
        }
        catch (Exception ex)
        {
            _error = $"Could not load this model: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Compare page prefilled with this pairing — the same querystring the Archive's
    /// Re-run uses, so there is one way to reopen a matchup rather than two.
    /// </summary>
    private string RematchHref(HeadToHeadDto row) =>
        $"/?leftModelId={Uri.EscapeDataString(_profile?.ModelId.Value ?? string.Empty)}" +
        $"&rightModelId={Uri.EscapeDataString(row.OpponentModelId.Value)}";

    private static string Truncate(string text, int max) =>
        string.IsNullOrEmpty(text) || text.Length <= max ? text : text[..max].TrimEnd() + "…";

    // ── Chart geometry ───────────────────────────────────────────────────────
    // Hand-rolled again after RadzenChart was removed for payload. The maths is small; the
    // library was 1.43 MB gzipped.

    private const double ChartWidth = 600;
    private const double ChartHeight = 140;
    private const double ChartPadding = 8;

    /// <summary>Where a rating starts before any duel moves it. Matches <c>Elo:StartingRating</c>.</summary>
    private const double StartingElo = 1200;

    /// <summary>SVG coordinates must use "." regardless of the viewer's locale.</summary>
    private static readonly System.Globalization.CultureInfo Inv =
        System.Globalization.CultureInfo.InvariantCulture;

    /// <summary>
    /// One point per recorded duel, shaped for RadzenLineSeries. <c>Baseline</c> repeats the
    /// starting rating on every point so the flat reference line can be a second series over
    /// the same categories — Radzen has no horizontal-rule primitive, and a series is the
    /// cheapest way to keep "did this model end above where it started" legible.
    /// </summary>
    private sealed record EloPointView(string Label, double Elo, double Baseline, DuelId DuelId);

    /// <summary>
    /// Built once per load rather than as a computed property: the annotations must reference
    /// the very instances the series holds, and a property would mint new ones every render.
    /// </summary>
    private List<EloPointView> _chartPoints = [];
    private List<(EloPointView Point, string Text)> _chartAnnotations = [];

    /// <summary>
    /// A DISTINCT category label per duel, which is what a category axis needs to give each
    /// point its own tick.
    /// </summary>
    /// <remarks>
    /// This was a bare "MMM d", and a category axis treats two identical categories as ONE —
    /// so a model whose duels all ran on the same day (which is every model here, because a
    /// session is where duels happen) had its whole rating history stacked on a single x
    /// position. The chart rendered as a vertical line with two thirds of its width empty,
    /// and the one question it exists to answer — did this model end above where it started —
    /// was unreadable in exactly the common case.
    ///
    /// The date alone is kept where it is already unique, because that is the label worth
    /// reading; a day carrying more than one duel falls back to date + time for every point on
    /// that day, and a collision inside the same minute takes a trailing ordinal. Ordinals are
    /// the last resort rather than the first because "#3" says nothing a reader wants.
    /// </remarks>
    private static Dictionary<DuelId, string> CategoryLabels(IReadOnlyList<EloPointDto> history)
    {
        var byDate = history
            .GroupBy(p => p.At.ToLocalTime().ToString("MMM d", Inv))
            .ToDictionary(g => g.Key, g => g.Count());

        var labels = new Dictionary<DuelId, string>();
        var used = new Dictionary<string, int>(StringComparer.Ordinal);

        foreach (var point in history)
        {
            var local = point.At.ToLocalTime();
            var date = local.ToString("MMM d", Inv);
            var label = byDate[date] == 1 ? date : local.ToString("MMM d, HH:mm", Inv);

            if (used.TryGetValue(label, out var seen))
            {
                used[label] = seen + 1;
                label = $"{label} ({seen + 1})";
            }
            else
            {
                used[label] = 1;
            }

            labels[point.DuelId] = label;
        }

        return labels;
    }

    private void BuildChart()
    {
        _chartPoints = [];
        _chartAnnotations = [];
        if (_profile is null) return;

        _chartPoints = _profile.EloHistory
            .Select(p => new EloPointView(
                CategoryLabels(_profile.EloHistory)[p.DuelId],
                Math.Round(p.Elo, 1),
                StartingElo,
                p.DuelId))
            .ToList();

        var byDuel = _chartPoints
            .GroupBy(p => p.DuelId)
            .ToDictionary(g => g.Key, g => g.Last());

        foreach (var upset in _profile.Highlights.Upsets)
        {
            if (byDuel.TryGetValue(upset.DuelId, out var point))
                _chartAnnotations.Add((point, $"▲ upset +{upset.RatingGap:F0}"));
        }

        // Peak last so it wins when the peak IS an upset: one label per point, the bigger fact.
        if (_profile.Highlights.PeakDuelId is { } peakDuel && byDuel.TryGetValue(peakDuel, out var peakPoint))
        {
            _chartAnnotations.RemoveAll(a => ReferenceEquals(a.Point, peakPoint));
            _chartAnnotations.Add((peakPoint, $"★ peak {peakPoint.Elo:F0}"));
        }
    }

    /// <summary>
    /// Keeps roughly eight category labels whatever the history length — one tick per duel is
    /// unreadable past a dozen, and Radzen does not thin them automatically.
    /// </summary>
    private int ChartCategoryStep =>
        Math.Max(1, (int)Math.Ceiling(_profile!.EloHistory.Count / 8.0));

    /// <summary>
    /// Series colours come from the app's own tokens rather than a Radzen theme — index.html
    /// loads only Radzen's structural base CSS precisely so the component palette does not
    /// compete with the design system. These are the literal token values because Radzen's
    /// Stroke takes a colour string, not a CSS custom property it can resolve at paint time.
    /// </summary>
    private const string ChartLineColor = "#1560c4";      /* --accent-blue (light) */
    private const string ChartBaselineColor = "#8a8f9c";  /* neutral, legible in both themes */
    /// <summary>The line colour, so a label reads as belonging to the curve it sits on. The same
    /// facts are listed as text under Highlights, which is the accessible form of them.</summary>
    private const string ChartAnnotationColor = ChartLineColor;

    /// <summary>Text alternative for the curve — the shape means nothing to a screen reader.</summary>
    private string ChartDescription
    {
        get
        {
            var h = _profile!.EloHistory;
            var first = h[0].Elo;
            var last = h[^1].Elo;
            var direction = last > first ? "up" : last < first ? "down" : "level";
            return $"Rating history across {h.Count} duels: {first:F0} to {last:F0}, trending {direction}.";
        }
    }
}
