@page "/leaderboard"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Radzen
@using Radzen.Blazor

<PageTitle>Leaderboard — PoLocalCompare</PageTitle>

@inject DuelApiClient ApiClient

<div class="leaderboard">
    <h1 class="leaderboard__title">Leaderboard</h1>

    <div class="leaderboard__controls">
        <span class="leaderboard__sort-label">Sort by:</span>
        <RadzenButton Text="ELO" Click="@(() => SetSortAsync("Elo"))"
            ButtonStyle="@(IsGreenSort ? ButtonStyle.Light : ButtonStyle.Primary)"
            Size="ButtonSize.Small" class="leaderboard__sort-btn" />
        <RadzenButton Text="🌱 Green Score" Click="@(() => SetSortAsync("GreenScore"))"
            ButtonStyle="@(IsGreenSort ? ButtonStyle.Primary : ButtonStyle.Light)"
            Size="ButtonSize.Small" class="leaderboard__sort-btn"
            Disabled="@(!_entries.Any(e => e.GreenScoreAvg is > 0))"
            title="@(!_entries.Any(e => e.GreenScoreAvg is > 0) ? "Run local (WebGPU) model duels to unlock Green Score" : "Sort by energy efficiency")" />
        <RadzenButton Text="🧪 Output Quality" Click="@(() => SetSortAsync("Quality"))"
            ButtonStyle="@(IsQualitySort ? ButtonStyle.Primary : ButtonStyle.Light)"
            Size="ButtonSize.Small" class="leaderboard__sort-btn"
            Disabled="@(!_entries.Any(e => e.OutputQualityAvg.HasValue))"
            title="Sort by persisted HTML output quality score" />
        <span class="leaderboard__divider">|</span>
        <RadzenButton Text="@(_activeOnly ? "Active ✓" : "Show All")"
            Click="ToggleActiveOnly"
            ButtonStyle="@(_activeOnly ? ButtonStyle.Primary : ButtonStyle.Light)"
            Size="ButtonSize.Small" class="leaderboard__sort-btn"
            title="@(_activeOnly ? "Showing models with duels — click to show all" : "Showing all models — click to hide unplayed")" />
    </div>
    @if (!_entries.Any(e => e.GreenScoreAvg is > 0) && !_loading)
    {
        <p class="leaderboard__green-info">🌱 Green Score unlocks after running local (WebGPU) model duels — start one from the <a href="/">Compare page</a>.</p>
    }

    @if (_loading)
    {
        <p class="leaderboard__status">Loading leaderboard...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="leaderboard__error">@_error</p>
    }
    else
    {
        @if (_entries.Count > 0 && _entries.All(e => e.DuelCount == 0))
        {
            <div class="leaderboard__empty-state">
                <h2>🏁 No competitive history yet</h2>
                <p>Run your first duel to generate ELO trends, win rates, and green-score comparisons.</p>
                <div class="leaderboard__empty-actions">
                    <a href="/" class="leaderboard__cta">⚔ Compare two models</a>
                </div>
            </div>
        }
        <RadzenDataGrid Data="@_displayedEntries"
            TItem="LeaderboardEntryDto" RowSelect="OnRowSelect"
            Class="leaderboard__grid leaderboard__grid--scrollable">
            <Columns>
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="Rank" Title="Rank" Width="80px">
                    <Template Context="entry">
                        @{ var dr = _displayedEntries.IndexOf(entry) + 1; }
                        @if (dr == 1)
                        {
                            <span class="lb__rank lb__rank--gold" title="#1 Ranked">🥇</span>
                        }
                        else if (dr == 2)
                        {
                            <span class="lb__rank lb__rank--silver" title="#2 Ranked">🥈</span>
                        }
                        else if (dr == 3)
                        {
                            <span class="lb__rank lb__rank--bronze" title="#3 Ranked">🥉</span>
                        }
                        else
                        {
                            <span class="lb__rank">@dr</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="DisplayName" Title="Model Name" Width="200px">
                    <Template Context="entry">
                        @entry.DisplayName
                        @if (_modelTypes.TryGetValue(entry.ModelId, out var mtype))
                        {
                            <span class="lb__type-badge lb__type-badge--@ModelTypeGroup.CssModifier(mtype)">
                                @ModelTypeGroup.ShortLabel(mtype)
                            </span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="CurrentElo" Title="ELO" Width="120px">
                    <Template Context="entry">@((int)Math.Round(entry.CurrentElo))</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="DuelCount" Title="Duels" Width="90px" />
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Title="W/L (Win %)" Width="140px">
                    <Template Context="entry">
                        @{
                            var losses = Math.Max(entry.DuelCount - entry.WinCount, 0);
                            var winPct = entry.DuelCount > 0 ? (entry.WinCount * 100.0 / entry.DuelCount) : 0;
                            var pctStr = entry.DuelCount > 0 ? $" ({winPct:F0}%)" : "";
                        }
                        @($"{entry.WinCount}/{losses}{pctStr}")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="OutputQualityAvg" Title="🧪 Output Quality" Width="160px"
                    HeaderTooltip="0–100 score from automated renderability + structure checks on each model's HTML output. Higher = more polished, self-contained HTML.">
                    <Template Context="entry">
                        @if (entry.OutputQualityAvg.HasValue)
                        {
                            <span title="@($"Last quality score: {entry.OutputQualityAvg.Value:F1} / 100")">@entry.OutputQualityAvg.Value.ToString("F1")</span>
                        }
                        else
                        {
                            <span class="leaderboard__no-data" title="No scored outputs yet — run a duel to generate one">—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Property="GreenScoreAvg" Title="🌱 Green Score" Width="150px"
                    HeaderTooltip="Tokens generated per watt-hour. Higher = more energy efficient.">
                    <Template Context="entry">
                        @if (entry.GreenScoreAvg.HasValue)
                        {
                            <span title="@entry.GreenScoreAvg.Value.ToString("F1") tok/Wh">@entry.GreenScoreAvg.Value.ToString("F1")</span>
                        }
                        else
                        {
                            <span class="leaderboard__no-data" title="Run a local model duel to generate this score">—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LeaderboardEntryDto" Title="ELO Trend" Width="170px"
                    HeaderTooltip="ELO rating trend over the last 20 duels">
                    <Template Context="entry">
                        @if (entry.EloSparkline is not null && entry.EloSparkline.Length > 1)
                        {
                            <EloSparkline Values="entry.EloSparkline" />
                        }
                        else if (entry.EloSparkline is not null && entry.EloSparkline.Length == 1)
                        {
                            <span class="leaderboard__no-data leaderboard__no-data--note" title="Only 1 duel recorded so far">1 duel</span>
                        }
                        else
                        {
                            <span class="leaderboard__no-data leaderboard__no-data--note" title="No duel history yet">No duels yet</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @if (_entries.Count > 0)
        {
            var totalDuels = _entries.Sum(e => e.DuelCount) / 2;
            var topModel = _entries.FirstOrDefault()?.DisplayName ?? "—";
            <div class="leaderboard__summary">
                <span>&#x1F4CA; <strong>@_entries.Count</strong> model@(_entries.Count == 1 ? "" : "s") ranked</span>
                <span>&#x2694;&#xFE0F; <strong>@totalDuels</strong> duel@(totalDuels == 1 ? "" : "s") fought</span>
                <span>&#x1F3C6; Top: <strong>@topModel</strong></span>
            </div>
        }

        @if (_selected is not null)
        {
            <div class="leaderboard__killlist-panel">
                <div class="leaderboard__killlist-header">
                    <span class="leaderboard__killlist-title">@KillListPanelText</span>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                        Click="CloseKillList" class="leaderboard__killlist-close" />
                </div>
                @if (_killListLoading)
                {
                    <p class="leaderboard__status">Loading kill list...</p>
                }
                else if (_killListError is not null)
                {
                    <p class="leaderboard__error">@_killListError</p>
                }
                else if (_killList.Count == 0)
                {
                    <p class="leaderboard__status">No head-to-head history yet.</p>
                }
                else
                {
                    <RadzenDataGrid Data="@_killList" TItem="HeadToHeadDto">
                        <Columns>
                            <RadzenDataGridColumn TItem="HeadToHeadDto" Property="OpponentName" Title="Opponent" />
                            <RadzenDataGridColumn TItem="HeadToHeadDto" Title="W/L" Width="100px">
                                <Template Context="row">@row.Wins/@row.Losses</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="HeadToHeadDto" Title="Win %" Width="90px">
                                <Template Context="row">
                                    @{
                                        var total = row.Wins + row.Losses;
                                        var pct = total > 0 ? (row.Wins * 100.0 / total) : 0;
                                    }
                                    @(total > 0 ? $"{pct:F0}%" : "-")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="HeadToHeadDto" Title="Last Duel" Width="170px">
                                <Template Context="row">
                                    @(row.LastDuelAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>
        }
    }
</div>

@code {
    private List<LeaderboardEntryDto> _entries = [];
    private List<LeaderboardEntryDto> _displayedEntries = [];
    private Dictionary<ModelId, ModelType> _modelTypes = [];
    private bool _activeOnly = true; // default: hide unplayed models
    private bool _loading = true;
    private string? _error;

    private LeaderboardEntryDto? _selected;
    private readonly List<HeadToHeadDto> _killList = [];
    private bool _killListLoading;
    private string? _killListError;

    private string _sortBy = "Elo";
    private bool IsGreenSort => string.Equals(_sortBy, "GreenScore", StringComparison.OrdinalIgnoreCase);
    private bool IsQualitySort => string.Equals(_sortBy, "Quality", StringComparison.OrdinalIgnoreCase);
    private string KillListPanelText => _selected is null ? "Kill List" : $"Kill List: {_selected.DisplayName}";

    protected override async Task OnInitializedAsync()
    {
        var modelsTask = ApiClient.GetModelsAsync();
        await LoadLeaderboardAsync();
        var models = await modelsTask;
        if (models is not null)
            _modelTypes = models.ToDictionary(m => m.ModelId, m => m.ModelType);
    }

    private async Task SetSortAsync(string sortBy)
    {
        if (string.Equals(_sortBy, sortBy, StringComparison.OrdinalIgnoreCase))
            return;
        if (sortBy == "GreenScore" && !_entries.Any(e => e.GreenScoreAvg is > 0))
            return; // button is disabled; guard in case of race condition
        if (sortBy == "Quality" && !_entries.Any(e => e.OutputQualityAvg.HasValue))
            return; // button is disabled; guard in case of race condition
        _sortBy = sortBy;
        await LoadLeaderboardAsync();
    }

    private void ToggleActiveOnly()
    {
        _activeOnly = !_activeOnly;
        _displayedEntries = _activeOnly
            ? _entries.Where(e => e.DuelCount > 0).ToList()
            : _entries;
    }

    private void CloseKillList()
    {
        _selected = null;
        _killList.Clear();
        _killListError = null;
    }

    private async Task LoadLeaderboardAsync()
    {
        _loading = true;
        _error = null;
        _selected = null;
        _killList.Clear();
        _killListError = null;

        try
        {
            var rows = await ApiClient.GetLeaderboardAsync(_sortBy);
            _entries = rows?.ToList() ?? [];
            _displayedEntries = _activeOnly
                ? _entries.Where(e => e.DuelCount > 0).ToList()
                : _entries;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load leaderboard: {ex.Message}";
            _entries = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRowSelect(LeaderboardEntryDto row)
    {
        _selected = row;
        _killListLoading = true;
        _killListError = null;
        _killList.Clear();

        try
        {
            var rows = await ApiClient.GetKillListAsync(row.ModelId);
            if (rows is not null)
            {
                _killList.AddRange(rows);
            }
        }
        catch (Exception ex)
        {
            _killListError = $"Failed to load kill list: {ex.Message}";
        }
        finally
        {
            _killListLoading = false;
        }
    }
}

