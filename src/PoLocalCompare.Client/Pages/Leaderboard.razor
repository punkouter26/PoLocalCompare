@page "/leaderboard"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Leaderboard — PoLocalCompare</PageTitle>

@inject DuelApiClient ApiClient

<div class="leaderboard">
    <h1 class="leaderboard__title">Leaderboard</h1>

    <div class="leaderboard__controls">
        <span class="leaderboard__sort-label">Sort by:</span>
        @* aria-pressed carries the active sort to assistive tech; the colour alone would not. *@
        <button type="button" class="po-btn leaderboard__sort-btn @(IsEloSort ? "po-btn--primary" : "")"
                aria-pressed="@Pressed(IsEloSort)" @onclick="@(() => SetSortAsync("Elo"))">ELO</button>
        @* Green Score appears only once something has scored. Previously an unpopulated metric
           cost a permanently disabled sort button, a table column of em-dashes, and a
           full-width explainer — three pieces of chrome advertising an empty cell. *@
        @if (HasGreenScores)
        {
            <button type="button" class="po-btn leaderboard__sort-btn @(IsGreenSort ? "po-btn--primary" : "")"
                    aria-pressed="@Pressed(IsGreenSort)"
                    title="Sort by energy efficiency"
                    @onclick="@(() => SetSortAsync("GreenScore"))">🌱 Green Score</button>
        }
        <button type="button" class="po-btn leaderboard__sort-btn @(IsQualitySort ? "po-btn--primary" : "")"
                aria-pressed="@Pressed(IsQualitySort)"
                disabled="@(!_entries.Any(e => e.OutputQualityAvg.HasValue))"
                title="Sort by persisted HTML output quality score"
                @onclick="@(() => SetSortAsync("Quality"))">🧪 Output Quality</button>
        <button type="button" class="po-btn leaderboard__sort-btn @(IsCostSort ? "po-btn--primary" : "")"
                aria-pressed="@Pressed(IsCostSort)"
                disabled="@(!_entries.Any(e => e.AvgApiCostPerDuel.HasValue))"
                title="Sort by average API cost per duel (cheapest first)"
                @onclick="@(() => SetSortAsync("Cost"))">💰 Avg $/duel</button>
        <span class="leaderboard__divider" aria-hidden="true">|</span>
        @* A checkbox, not a button. The button labelled the current state in one position
           ("Active ✓") and the pending action in the other ("Show All"), so its label never
           told you what pressing it would do. *@
        <label class="leaderboard__filter">
            <input type="checkbox" checked="@_activeOnly" @onchange="ToggleActiveOnly" />
            Hide models with no duels
        </label>
    </div>

    @if (_loading)
    {
        <p class="leaderboard__status">Loading leaderboard...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="leaderboard__error">@_error</p>
    }
    else
    {
        @if (_entries.Count > 0 && _entries.All(e => e.DuelCount == 0))
        {
            <div class="leaderboard__empty-state">
                <h2>🏁 No competitive history yet</h2>
                <p>Run your first duel to generate ELO trends, win rates, and green-score comparisons.</p>
                <div class="leaderboard__empty-actions">
                    <a href="/" class="po-btn po-btn--ghost">⚔ Compare two models</a>
                </div>
            </div>
        }
        @* Rows open the kill-list panel, so they are keyboard-operable (SC 2.1.1). *@
        <div class="po-table-wrap leaderboard__grid--scrollable">
            <table class="po-table po-table--selectable leaderboard__grid">
                <caption class="visually-hidden">Model rankings - select a row for head-to-head history</caption>
                <thead>
                    <tr>
                        <th scope="col">Rank</th>
                        <th scope="col">Model Name</th>
                        <th scope="col">ELO</th>
                        @* No Duels column: it was the sum of the W/L cell beside it (14/2 → 16),
                           so the table stated the same number twice. *@
                        <th scope="col" title="Wins/losses and win rate. The two added together are the model's duel count.">W/L (Win %)</th>
                        <th scope="col" title="0-100 score from automated renderability + structure checks on each model's HTML output. Higher = more polished, self-contained HTML.">&#x1F9EA; Output Quality</th>
                        @if (HasGreenScores)
                        {
                            <th scope="col" title="Tokens generated per watt-hour. Higher = more energy efficient.">&#x1F331; Green Score</th>
                        }
                        <th scope="col" title="Average API cost (USD) per duel across every priced result. Free local/Ollama models show &mdash;.">💰 Avg $/duel</th>
                        <th scope="col" title="ELO rating trend over the last 20 duels">ELO Trend</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _displayedEntries.Count; i++)
                    {
                        var entry = _displayedEntries[i];
                        var dr = i + 1;
                        <tr tabindex="0"
                            aria-controls="@KillListPanelId"
                            aria-expanded="@(_selected?.ModelId == entry.ModelId ? "true" : "false")"
                            @onclick="() => OnRowSelect(entry)"
                            @onkeydown="e => OnRowKeyDown(e, entry)">
                            <td>
                                @if (dr == 1)
                                {
                                    <span class="leaderboard__rank leaderboard__rank--gold" title="#1 Ranked">&#x1F947;</span>
                                }
                                else if (dr == 2)
                                {
                                    <span class="leaderboard__rank leaderboard__rank--silver" title="#2 Ranked">&#x1F948;</span>
                                }
                                else if (dr == 3)
                                {
                                    <span class="leaderboard__rank leaderboard__rank--bronze" title="#3 Ranked">&#x1F949;</span>
                                }
                                else
                                {
                                    <span class="leaderboard__rank">@dr</span>
                                }
                            </td>
                            <td>
                                @entry.DisplayName
                                @if (_modelTypes.TryGetValue(entry.ModelId, out var mtype))
                                {
                                    <span class="leaderboard__type-badge leaderboard__type-badge--@ModelTypeGroup.CssModifier(mtype)">
                                        @ModelTypeGroup.ShortLabel(mtype)
                                    </span>
                                }
                            </td>
                            <td>@((int)Math.Round(entry.CurrentElo))</td>
                            <td>
                                @{
                                    var losses = Math.Max(entry.DuelCount - entry.WinCount, 0);
                                    var winPct = entry.DuelCount > 0 ? (entry.WinCount * 100.0 / entry.DuelCount) : 0;
                                    var pctStr = entry.DuelCount > 0 ? $" ({winPct:F0}%)" : "";
                                }
                                @($"{entry.WinCount}/{losses}{pctStr}")
                            </td>
                            <td>
                                @if (entry.OutputQualityAvg.HasValue)
                                {
                                    <span title="@($"Last quality score: {entry.OutputQualityAvg.Value:F1} / 100")">@entry.OutputQualityAvg.Value.ToString("F1")</span>
                                }
                                else
                                {
                                    <span class="leaderboard__no-data" title="No scored outputs yet - run a duel to generate one">&#8212;</span>
                                }
                            </td>
                            @if (HasGreenScores)
                            {
                                <td>
                                    @if (entry.GreenScoreAvg.HasValue)
                                    {
                                        <span title="@entry.GreenScoreAvg.Value.ToString("F1") tok/Wh">@entry.GreenScoreAvg.Value.ToString("F1")</span>
                                    }
                                    else
                                    {
                                        <span class="leaderboard__no-data" title="Run a local model duel to generate this score">&#8212;</span>
                                    }
                                </td>
                            }
                            <td>
                                @if (entry.AvgApiCostPerDuel.HasValue)
                                {
                                    <span class="leaderboard__cost" title="Average across @entry.DuelCount priced duel(s)">$@entry.AvgApiCostPerDuel.Value.ToString("F4")</span>
                                }
                                else if (IsLocalLike(entry.ModelType))
                                {
                                    <span class="leaderboard__no-data" title="Local/Ollama models aren't billed per token. Energy cost is reported per-duel in the Arena.">free</span>
                                }
                                else
                                {
                                    <span class="leaderboard__no-data" title="No priced duels yet — once this model runs a duel that has a Foundry rate, the average will appear here.">&#8212;</span>
                                }
                            </td>
                            <td>
                                @if (entry.EloSparkline is not null && entry.EloSparkline.Length > 1)
                                {
                                    <EloSparkline Values="entry.EloSparkline" />
                                }
                                else if (entry.EloSparkline is not null && entry.EloSparkline.Length == 1)
                                {
                                    <span class="leaderboard__no-data leaderboard__no-data--note" title="Only 1 duel recorded so far">1 duel</span>
                                }
                                else
                                {
                                    <span class="leaderboard__no-data leaderboard__no-data--note" title="No duel history yet">No duels yet</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_entries.Count > 0)
        {
            var totalDuels = _entries.Sum(e => e.DuelCount) / 2;
            var topModel = _entries.FirstOrDefault()?.DisplayName ?? "—";
            <div class="leaderboard__summary">
                <span>&#x1F4CA; <strong>@_entries.Count</strong> model@(_entries.Count == 1 ? "" : "s") ranked</span>
                <span>&#x2694;&#xFE0F; <strong>@totalDuels</strong> duel@(totalDuels == 1 ? "" : "s") fought</span>
                <span>&#x1F3C6; @TopLabel: <strong>@topModel</strong></span>
            </div>
        }

        @if (_selected is not null)
        {
            <div id="@KillListPanelId" class="leaderboard__killlist-panel">
                <div class="leaderboard__killlist-header">
                    <span class="leaderboard__killlist-title">@KillListPanelText</span>
                    <button type="button" class="po-btn leaderboard__killlist-close"
                            aria-label="Close kill list" @onclick="CloseKillList">✕</button>
                </div>
                @if (_killListLoading)
                {
                    <p class="leaderboard__status">Loading kill list...</p>
                }
                else if (_killListError is not null)
                {
                    <p class="leaderboard__error">@_killListError</p>
                }
                else if (_killList.Count == 0)
                {
                    <p class="leaderboard__status">No head-to-head history yet.</p>
                }
                else
                {
                    <div class="po-table-wrap">
                        <table class="po-table">
                            <caption class="visually-hidden">Head-to-head record against each opponent</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Opponent</th>
                                    <th scope="col">W/L</th>
                                    <th scope="col">Win %</th>
                                    <th scope="col">Last Duel</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _killList)
                                {
                                    var total = row.Wins + row.Losses;
                                    var pct = total > 0 ? (row.Wins * 100.0 / total) : 0;
                                    <tr>
                                        <td>@row.OpponentName</td>
                                        <td>@row.Wins/@row.Losses</td>
                                        <td>@(total > 0 ? $"{pct:F0}%" : "-")</td>
                                        <td>@(row.LastDuelAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<LeaderboardEntryDto> _entries = [];
    private List<LeaderboardEntryDto> _displayedEntries = [];
    private Dictionary<ModelId, ModelType> _modelTypes = [];
    private bool _activeOnly = true; // default: hide unplayed models
    private bool _loading = true;
    private string? _error;

    private LeaderboardEntryDto? _selected;
    private readonly List<HeadToHeadDto> _killList = [];
    private bool _killListLoading;
    private string? _killListError;

    private string _sortBy = "Elo";
    private bool IsGreenSort => string.Equals(_sortBy, "GreenScore", StringComparison.OrdinalIgnoreCase);
    private bool IsQualitySort => string.Equals(_sortBy, "Quality", StringComparison.OrdinalIgnoreCase);
    private bool IsCostSort => string.Equals(_sortBy, "Cost", StringComparison.OrdinalIgnoreCase);
    private bool IsEloSort => !IsGreenSort && !IsQualitySort && !IsCostSort;

    /// <summary>Gates the Green Score sort button and column — both are hidden until a duel scores one.</summary>
    private bool HasGreenScores => _entries.Any(e => e.GreenScoreAvg is > 0);

    private static bool IsLocalLike(ModelType t) => t is ModelType.Local or ModelType.LocalService;

    /// <summary>aria-pressed needs the lowercase JS-style literal, not .NET's "True"/"False".</summary>
    private static string Pressed(bool on) => on ? "true" : "false";
    private string KillListPanelText => _selected is null ? "Kill List" : $"Kill List: {_selected.DisplayName}";

    /// <summary>Headline label mirrors the active sort — "Top ELO" / "Cheapest" / "Greenest"
    /// / "Highest quality" — so a sorted-by-cost view doesn't claim the leader is the top.</summary>
    private string TopLabel => _sortBy switch
    {
        "GreenScore" => "Greenest",
        "Quality"    => "Highest quality",
        "Cost"       => "Cheapest",
        _            => "Top ELO",
    };

    /// <summary>Stable id referenced by each row's aria-controls, so a screen reader
    /// knows which kill-list panel the row expanded.</summary>
    private const string KillListPanelId = "leaderboard-killlist-panel";

    protected override async Task OnInitializedAsync()
    {
        var modelsTask = ApiClient.GetModelsAsync();
        await LoadLeaderboardAsync();
        var models = await modelsTask;
        if (models is not null)
            _modelTypes = models.ToDictionary(m => m.ModelId, m => m.ModelType);
    }

    private async Task SetSortAsync(string sortBy)
    {
        if (string.Equals(_sortBy, sortBy, StringComparison.OrdinalIgnoreCase))
            return;
        if (sortBy == "GreenScore" && !HasGreenScores)
            return; // button is not rendered; guard in case of race condition
        if (sortBy == "Quality" && !_entries.Any(e => e.OutputQualityAvg.HasValue))
            return; // button is disabled; guard in case of race condition
        if (sortBy == "Cost" && !_entries.Any(e => e.AvgApiCostPerDuel.HasValue))
            return; // button is disabled; guard in case of race condition
        _sortBy = sortBy;
        await LoadLeaderboardAsync();
    }

    private void ToggleActiveOnly()
    {
        _activeOnly = !_activeOnly;
        _displayedEntries = _activeOnly
            ? _entries.Where(e => e.DuelCount > 0).ToList()
            : _entries;
    }

    private void CloseKillList()
    {
        _selected = null;
        _killList.Clear();
        _killListError = null;
    }

    private async Task LoadLeaderboardAsync()
    {
        _loading = true;
        _error = null;
        _selected = null;
        _killList.Clear();
        _killListError = null;

        try
        {
            var rows = await ApiClient.GetLeaderboardAsync(_sortBy);
            _entries = rows?.ToList() ?? [];
            _displayedEntries = _activeOnly
                ? _entries.Where(e => e.DuelCount > 0).ToList()
                : _entries;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load leaderboard: {ex.Message}";
            _entries = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRowSelect(LeaderboardEntryDto row)
    {
        _selected = row;
        _killListLoading = true;
        _killListError = null;
        _killList.Clear();

        try
        {
            var rows = await ApiClient.GetKillListAsync(row.ModelId);
            if (rows is not null)
            {
                _killList.AddRange(rows);
            }
        }
        catch (Exception ex)
        {
            _killListError = $"Failed to load kill list: {ex.Message}";
        }
        finally
        {
            _killListLoading = false;
        }
    }

    /// <summary>Keyboard equivalent of clicking a row (SC 2.1.1).</summary>
    private async Task OnRowKeyDown(KeyboardEventArgs e, LeaderboardEntryDto row)
    {
        if (e.Key is "Enter" or " ")
            await OnRowSelect(row);
    }
}

