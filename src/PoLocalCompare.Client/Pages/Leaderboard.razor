@page "/leaderboard"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Leaderboard — PoLocalCompare</PageTitle>

@inject DuelApiClient ApiClient

<div class="leaderboard">
    <h1 class="leaderboard__title po-title">Leaderboard</h1>

    <div class="leaderboard__controls">
        <span class="leaderboard__sort-label">Sort by:</span>
        @* aria-pressed carries the active sort to assistive tech; the colour alone would not. *@
        <button type="button" class="po-btn leaderboard__sort-btn @(IsEloSort ? "po-btn--primary" : "")"
                aria-pressed="@Pressed(IsEloSort)" @onclick="@(() => SetSortAsync("Elo"))">ELO</button>
        <button type="button" class="po-btn leaderboard__sort-btn @(IsValueSort ? "po-btn--primary" : "")"
                aria-pressed="@Pressed(IsValueSort)"
                disabled="@(!_entries.Any(e => e.Value.HasValue))"
                title="Sort by ELO earned per dollar of API spend (higher = more bang per buck)"
                @onclick="@(() => SetSortAsync("Value"))">💎 Value</button>
        <button type="button" class="po-btn leaderboard__sort-btn @(IsSpeedSort ? "po-btn--primary" : "")"
                title="Mean time to first token — the wait before anything appears, which is what actually makes a model feel fast. Lower is better."
                aria-pressed="@Pressed(IsSpeedSort)" @onclick="@(() => SetSortAsync("Speed"))">⚡ Speed</button>
        <button type="button" class="po-btn leaderboard__sort-btn @(IsQualitySort ? "po-btn--primary" : "")"
                aria-pressed="@Pressed(IsQualitySort)"
                disabled="@(!_entries.Any(e => e.OutputQualityAvg.HasValue))"
                title="Sort by persisted HTML output quality score"
                @onclick="@(() => SetSortAsync("Quality"))">🧪 Output Quality</button>
        <button type="button" class="po-btn leaderboard__sort-btn @(IsCostSort ? "po-btn--primary" : "")"
                aria-pressed="@Pressed(IsCostSort)"
                disabled="@(!_entries.Any(e => e.AvgApiCostPerDuel.HasValue))"
                title="Sort by average API cost per duel (cheapest first)"
                @onclick="@(() => SetSortAsync("Cost"))">💰 Avg $/duel</button>
        <span class="leaderboard__divider" aria-hidden="true">|</span>
        @* A checkbox, not a button. The button labelled the current state in one position
           ("Active ✓") and the pending action in the other ("Show All"), so its label never
           told you what pressing it would do. *@
        <label class="leaderboard__filter">
            <input type="checkbox" checked="@_activeOnly" @onchange="ToggleActiveOnly" />
            Hide models with no duels
        </label>
    </div>

    @if (_loading)
    {
        <p class="po-status">Loading leaderboard...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="po-error">@_error</p>
    }
    else
    {
        @if (_entries.Count > 0 && _entries.All(e => e.DuelCount == 0))
        {
            <div class="po-empty">
                <h2>🏁 No competitive history yet</h2>
                <p>Run your first duel to generate ELO trends, win rates and quality comparisons.</p>
                <div class="leaderboard__empty-actions">
                    <a href="/" class="po-btn po-btn--ghost">⚔ Compare two models</a>
                </div>
            </div>
        }
        @* Rows open the kill-list panel, so they are keyboard-operable (SC 2.1.1). *@
        <div class="po-table-wrap leaderboard__grid--scrollable">
            <table class="po-table po-table--selectable po-table--cards leaderboard__grid">
                <caption class="visually-hidden">Model rankings - select a model name to open its profile</caption>
                <thead>
                    <tr>
                        <th scope="col">Rank</th>
                        <th scope="col">Model Name</th>
                        <th scope="col">ELO</th>
                        <th scope="col" title="Mean time to first token across this model's duels. Lower is better; local models with no measured run show &mdash;.">⚡ First token</th>
                        <th scope="col" title="ELO earned per dollar of API spend (CurrentElo / AvgApiCostPerDuel, divisor floored at $0.0001). Higher = more bang per buck. Local/Ollama and unpriced remotes show &mdash;.">💎 Value</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _displayedEntries.Count; i++)
                    {
                        var entry = _displayedEntries[i];
                        var dr = i + 1;
                        @* No handler on the row itself: a <tr> is not an operable control, and
                           the link in the name cell is now the whole affordance rather than a
                           keyboard fallback for a pointer-only row click. *@
                        <tr>
                            <td class="po-cell--bare">
                                @if (dr == 1)
                                {
                                    <span class="leaderboard__rank leaderboard__rank--gold po-glow" title="#1 Ranked">&#x1F947;</span>
                                }
                                else if (dr == 2)
                                {
                                    <span class="leaderboard__rank leaderboard__rank--silver" title="#2 Ranked">&#x1F948;</span>
                                }
                                else if (dr == 3)
                                {
                                    <span class="leaderboard__rank leaderboard__rank--bronze" title="#3 Ranked">&#x1F949;</span>
                                }
                                else
                                {
                                    <span class="leaderboard__rank">@dr</span>
                                }
                            </td>
                            <td data-label="Model">
                                @* Opens the model's own page. This used to expand a kill-list
                                   drawer under the table; the kill list answers a question about
                                   one model, so it moved to that model's page along with the
                                   rating history and output gallery it belongs beside. *@
                                <a class="po-btn po-btn--ghost po-btn--sm leaderboard__row-btn"
                                   href="@($"/model/{entry.ModelId}")"
                                   title="@($"Open {entry.DisplayName}")">
                                    @entry.DisplayName
                                    @if (_modelTypes.TryGetValue(entry.ModelId, out var mtype))
                                    {
                                        <span class="leaderboard__type-badge leaderboard__type-badge--@ModelTypeGroup.CssModifier(mtype)">
                                            @ModelTypeGroup.ShortLabel(mtype)
                                        </span>
                                    }
                                </a>
                            </td>
                            <td data-label="ELO">@((int)Math.Round(entry.CurrentElo))</td>
                            <td data-label="First token">
                                @if (entry.AvgFirstTokenMs is { } ttft)
                                {
                                    <span class="leaderboard__ttft">@FormatFirstToken(ttft)</span>
                                }
                                else
                                {
                                    <span class="leaderboard__no-data" title="No completed run has recorded a first-token time yet.">&#8212;</span>
                                }
                            </td>
                            <td data-label="Value">
                                @* Value = ELO earned per dollar of API spend, with the divisor
                                   floored at $0.0001 server-side. Reads as a big number, hence the
                                   tabular-nums treatment; suppress for rows that have no cost. *@
                                @if (entry.Value.HasValue)
                                {
                                    <span class="leaderboard__value" title="@($"ELO {entry.CurrentElo} / {entry.AvgApiCostPerDuel:F4} USD per duel")">@entry.Value.Value.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="leaderboard__no-data" title="No priced duels yet — Value needs at least one priced result.">&#8212;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_entries.Count > 0)
        {
            var totalDuels = _entries.Sum(e => e.DuelCount) / 2;
            var topModel = _entries.FirstOrDefault()?.DisplayName ?? "—";
            <div class="leaderboard__summary">
                <span>&#x1F4CA; <strong>@_entries.Count</strong> model@(_entries.Count == 1 ? "" : "s") ranked</span>
                <span>&#x2694;&#xFE0F; <strong>@totalDuels</strong> duel@(totalDuels == 1 ? "" : "s") fought</span>
                <span>&#x1F3C6; @TopLabel: <strong>@topModel</strong></span>
            </div>
        }

    }
</div>

@code {
    private List<LeaderboardEntryDto> _entries = [];
    private List<LeaderboardEntryDto> _displayedEntries = [];
    private Dictionary<ModelId, ModelType> _modelTypes = [];
    private bool _activeOnly = true; // default: hide unplayed models
    private bool _loading = true;
    private string? _error;

    private string _sortBy = "Elo";
    private bool IsQualitySort => string.Equals(_sortBy, "Quality", StringComparison.OrdinalIgnoreCase);
    private bool IsSpeedSort => string.Equals(_sortBy, "Speed", StringComparison.OrdinalIgnoreCase);
    private bool IsCostSort => string.Equals(_sortBy, "Cost", StringComparison.OrdinalIgnoreCase);
    private bool IsValueSort => string.Equals(_sortBy, "Value", StringComparison.OrdinalIgnoreCase);
    private bool IsEloSort => !IsQualitySort && !IsCostSort && !IsValueSort && !IsSpeedSort;

    /// <summary>aria-pressed needs the lowercase JS-style literal, not .NET's "True"/"False".</summary>
    private static string Pressed(bool on) => on ? "true" : "false";

    /// <summary>Headline label mirrors the active sort — "Top ELO" / "Cheapest" /
    /// "Highest quality" / "Best Value" — so a sorted-by-cost view doesn't claim the leader is the top.</summary>
    /// <summary>Sub-second waits read better in ms; past that, seconds.</summary>
    private static string FormatFirstToken(double ms) =>
        ms < 1000 ? $"{ms:F0} ms" : $"{ms / 1000.0:F1} s";

    private string TopLabel => _sortBy switch
    {
        "Quality"    => "Highest quality",
        "Cost"       => "Cheapest",
        "Value"      => "Best Value",
        _            => "Top ELO",
    };

    protected override async Task OnInitializedAsync()
    {
        var modelsTask = ApiClient.GetModelsAsync();
        await LoadLeaderboardAsync();
        var models = await modelsTask;
        if (models is not null)
            _modelTypes = models.ToDictionary(m => m.ModelId, m => m.ModelType);
    }

    private async Task SetSortAsync(string sortBy)
    {
        if (string.Equals(_sortBy, sortBy, StringComparison.OrdinalIgnoreCase))
            return;
        if (sortBy == "Quality" && !_entries.Any(e => e.OutputQualityAvg.HasValue))
            return; // button is disabled; guard in case of race condition
        if (sortBy == "Cost" && !_entries.Any(e => e.AvgApiCostPerDuel.HasValue))
            return; // button is disabled; guard in case of race condition
        if (sortBy == "Value" && !_entries.Any(e => e.Value.HasValue))
            return; // button is disabled; guard in case of race condition
        _sortBy = sortBy;
        await LoadLeaderboardAsync();
    }

    private void ToggleActiveOnly()
    {
        _activeOnly = !_activeOnly;
        _displayedEntries = _activeOnly
            ? _entries.Where(e => e.DuelCount > 0).ToList()
            : _entries;
    }

    private async Task LoadLeaderboardAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var rows = await ApiClient.GetLeaderboardAsync(_sortBy);
            _entries = rows?.ToList() ?? [];
            _displayedEntries = _activeOnly
                ? _entries.Where(e => e.DuelCount > 0).ToList()
                : _entries;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load leaderboard: {ex.Message}";
            _entries = [];
        }
        finally
        {
            _loading = false;
        }
    }

    // No row keydown handler and no row tabindex: the model-name cell holds a real anchor, so
    // focus, Enter and the browser's own open-in-new-tab affordances all come for free.
}

