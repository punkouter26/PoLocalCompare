@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>Sign in — PoLocalCompare</PageTitle>

<div class="login">
    <div class="login__card">
        <div class="login__brand">
            <span class="login__brand-mark" aria-hidden="true">PL</span>
            <span class="login__brand-name">PoLocalCompare</span>
        </div>
        <p class="login__subtitle">LLM Duel Arena</p>

        <button class="po-btn po-btn--lg po-btn--block login__ms-btn" @onclick="LoginWithMicrosoft">
            <svg class="login__ms-logo" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 21 21" width="20" height="20">
                <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
            </svg>
            Sign in with Microsoft
        </button>

        @if (_allowGuest)
        {
            <div class="login__divider"><span>or</span></div>
            <button class="po-btn po-btn--secondary po-btn--block" @onclick="LoginAsGuest">
                Continue as Guest
            </button>
            <p class="login__guest-note">Guest sessions persist across refreshes on this device.</p>
        }
    </div>
</div>

@code {
    private bool _allowGuest;

    protected override void OnInitialized()
    {
        var allowGuestByConfig = string.Equals(Config["Auth:AllowGuest"], "true", StringComparison.OrdinalIgnoreCase);
        var isProduction = string.Equals(HostEnvironment.Environment, "Production", StringComparison.OrdinalIgnoreCase);
        _allowGuest = allowGuestByConfig && !isProduction;
    }

    // forceLoad: these are server BFF endpoints, not Blazor routes — the cookie is set server-side.
    private void LoginWithMicrosoft()
        => Nav.NavigateTo($"auth/login/microsoft?returnUrl={Uri.EscapeDataString(ReturnPath())}", forceLoad: true);

    private void LoginAsGuest()
        => Nav.NavigateTo($"auth/login/fake?returnUrl={Uri.EscapeDataString(ReturnPath())}", forceLoad: true);

    private string ReturnPath()
    {
        var path = new Uri(Nav.Uri).PathAndQuery;
        return string.IsNullOrEmpty(path) ? "/" : path;
    }
}
