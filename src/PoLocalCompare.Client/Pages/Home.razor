@page "/"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Microsoft.JSInterop
@inject DuelApiClient ApiClient
@inject AudioService AudioService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PromptHistoryService PromptHistory
@inject WebGpuCapability WebGpu

<PageTitle>Compare - PoLocalCompare</PageTitle>

<div class="home">
    @* ── Header ──────────────────────────────────────────────────────── *@
    <header class="home__header">
        <div class="home__header-row">
            <h1 class="home__title">Compare two models</h1>
            @if (_health is not null)
            {
                <span class="home__health @HealthClass()" title="@HealthTooltip()">@HealthLabel()</span>
            }
        </div>
        <p class="home__subtitle">Pick your contenders, write a prompt, and watch them battle.</p>
        <a href="/demo" class="home__demo-link">
            <span aria-hidden="true">▶</span> Run the auto demo — 10 duels, judged automatically
        </a>
        @if (_health is not null && !_healthHasRemotes)
        {
            <p class="home__health-warning">
                ⚠ Remote (Azure OpenAI) deployments are unavailable. Use a Browser or Ollama model to run duels.
            </p>
        }
    </header>

    @* ── Model health (collapsible; replaces the standalone Local Model Lab) ── *@
    @if (!_loading && _models.Count > 0)
    {
        <div class="home__health-panel">
            <ModelHealthPanel Models="_models" />
        </div>
    }

    @* ── Step 1: Pick two models ─────────────────────────────────────────
       The panel headers ARE the stepper. A separate <ol> of step buttons used to sit above
       them naming the same three steps a second time, and pressing one only scrolled — so
       the page labelled every step twice and stepped through nothing. Each header is now a
       disclosure button (APG accordion: heading wraps the button), and completing a step
       opens the next one. *@
    <section id="home-step-1" class="home__panel @(IsOpen(1) ? "home__panel--open" : "")" aria-labelledby="step-1-heading">
        <h2 class="home__panel-headline">
            <button type="button" id="step-1-heading" class="home__panel-head"
                    aria-expanded="@Expanded(1)" @onclick="@(() => ToggleStep(1))">
                <span class="home__panel-num @(HasModels ? "home__panel-num--done" : "")" aria-hidden="true">@(HasModels ? "✓" : "1")</span>
                <span class="home__panel-heads">
                    <span class="home__panel-title">Choose two models</span>
                    <span class="home__panel-hint">@Step1Summary</span>
                </span>
                <span class="home__panel-chevron" aria-hidden="true">@(IsOpen(1) ? "▾" : "▸")</span>
            </button>
        </h2>

        @if (IsOpen(1))
        {
        <div class="home__panel-body">
        <div class="home__slots">
            <div class="home__slot @(_leftModel is not null ? "home__slot--set" : "")">
                <span class="home__slot-tag home__slot-tag--left">Left</span>
                <span class="home__slot-name">@(_leftModel?.DisplayName ?? "Not selected")</span>
            </div>
            <span class="home__slot-vs" aria-hidden="true">vs</span>
            <div class="home__slot @(_rightModel is not null ? "home__slot--set" : "")">
                <span class="home__slot-tag home__slot-tag--right">Right</span>
                <span class="home__slot-name">@(_rightModel?.DisplayName ?? "Not selected")</span>
            </div>
        </div>

        @* Replace-popover (Finding #5): when both slots full and user clicks a 3rd model *@
        @if (_replacePopoverModel is not null && _leftModel is not null && _rightModel is not null)
        {
            <div class="home__popover" role="dialog" aria-label="Choose which slot to replace">
                <p class="home__popover-text">Replace which slot with <strong>@_replacePopoverModel.DisplayName</strong>?</p>
                <div class="home__popover-actions">
                    <button class="po-btn po-btn--sm po-btn--secondary" @onclick="CancelReplace">Cancel</button>
                    <button class="po-btn po-btn--sm po-btn--secondary" @onclick="@(() => ConfirmReplace("left"))">
                        ← Replace Left (@_leftModel.DisplayName)
                    </button>
                    <button class="po-btn po-btn--sm po-btn--secondary" @onclick="@(() => ConfirmReplace("right"))">
                        Replace Right (@_rightModel.DisplayName) →
                    </button>
                </div>
            </div>
        }

        @if (_loading)
        {
            <div class="home__grid">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="skeleton home__skeleton" style="--stagger: @(i * 70)ms"></div>
                }
            </div>
        }
        else if (_loadError is not null)
        {
            <p class="home__error">@_loadError</p>
            <button class="po-btn po-btn--secondary" @onclick="LoadAsync">Retry</button>
        }
        else if (_models.Count == 0)
        {
            <p class="home__hint">No models are available right now.</p>
        }
        else
        {
            <div class="home__filters" role="group" aria-label="Filter models by type">
                @foreach (var f in _filters)
                {
                    <button class="po-btn po-btn--sm @(_modelFilter == f.Key ? "po-btn--success" : "po-btn--secondary")"
                            @onclick="@(() => _modelFilter = f.Key)">
                        @f.Label (@ModelCountFor(f.Key))
                    </button>
                }
            </div>
            @* Grouped by type (Remote / Browser / Ollama) to mirror the Model Health panel.
               Models that cannot run on this device are held back behind the toggle below
               rather than rendered greyed-out inline: they were roughly half the list on a
               machine without WebGPU, and an unpickable card is scrolling, not choice. *@
            @foreach (var _group in SelectableModels.GroupBy(m => m.ModelType).OrderBy(g => ModelTypeGroup.Order(g.Key)))
            {
                <div class="home__group-header">
                    <span class="home__group-name">@ModelTypeGroup.Label(_group.Key)</span>
                    <span class="home__group-count">@_group.Count() model@(_group.Count() == 1 ? "" : "s")</span>
                </div>
                <div class="home__grid">
                    @foreach (var model in _group)
                    {
                        var isLeft = model.ModelId == _leftModel?.ModelId;
                        var isRight = model.ModelId == _rightModel?.ModelId;
                        <ModelCard Model="model"
                                   IsSelected="@(isLeft || isRight)"
                                   Slot="@(isLeft ? "Left" : isRight ? "Right" : null)"
                                   OnSelected="AssignModel" />
                    }
                </div>
            }
            @if (!SelectableModels.Any())
            {
                <p class="home__hint">No models of this type can run here right now.</p>
            }

            @if (UnavailableModels.Any())
            {
                <button type="button" class="po-btn po-btn--sm po-btn--ghost home__unavailable-toggle"
                        aria-expanded="@(_showUnavailable ? "true" : "false")"
                        @onclick="@(() => _showUnavailable = !_showUnavailable)">
                    @(_showUnavailable ? "▾" : "▸") @UnavailableModels.Count() model@(UnavailableModels.Count() == 1 ? "" : "s") can't run here
                </button>
                @if (_showUnavailable)
                {
                    <p class="home__hint home__unavailable-why">@UnavailableReason</p>
                    <div class="home__grid">
                        @foreach (var model in UnavailableModels)
                        {
                            <div class="home__card-disabled">
                                @* IsDisabled drives tabindex/aria-disabled — the wrapper's
                                   pointer-events:none blocks the mouse but not the keyboard. *@
                                <ModelCard Model="model" IsDisabled="true" />
                                <span class="home__card-badge">@(IsBrowserWithoutGpu(model) ? "Needs WebGPU" : "Unavailable")</span>
                            </div>
                        }
                    </div>
                }
            }
        }
        </div>
        }
    </section>

    @* ── Step 2: Write prompt ────────────────────────────────────────── *@
    <section id="home-step-2" class="home__panel @(IsOpen(2) ? "home__panel--open" : "")" aria-labelledby="step-2-heading">
        <h2 class="home__panel-headline">
            <button type="button" id="step-2-heading" class="home__panel-head"
                    aria-expanded="@Expanded(2)" @onclick="@(() => ToggleStep(2))">
                <span class="home__panel-num @(HasPrompt ? "home__panel-num--done" : "")" aria-hidden="true">@(HasPrompt ? "✓" : "2")</span>
                <span class="home__panel-heads">
                    <span class="home__panel-title">Write your prompt</span>
                    <span class="home__panel-hint">@Step2Summary</span>
                </span>
                <span class="home__panel-chevron" aria-hidden="true">@(IsOpen(2) ? "▾" : "▸")</span>
            </button>
        </h2>

        @if (IsOpen(2))
        {
            <div class="home__panel-body">
            <textarea class="home__textarea @(_promptLongWarning ? "home__textarea--warn" : "")"
                      placeholder="e.g. Build a single-page HTML app that shows today's weather for any city the user types."
                      rows="5"
                      maxlength="4000"
                      @bind="_prompt"
                      @bind:event="oninput"></textarea>
            <div class="home__textarea-meta">
                <span class="@(_promptLongWarning ? "home__textarea-counter home__textarea-counter--warn" : "home__textarea-counter")">
                    @_prompt.Length / 4000
                </span>
                @if (_promptLongWarning)
                {
                    <span class="home__textarea-hint">Long prompts may be truncated or cost more.</span>
                }
            </div>

            <PromptPicker CurrentPrompt="@_prompt"
                          Recent="_recentPrompts"
                          OnPromptSelected="ApplyPromptAsync"
                          OnForgetRecent="ForgetRecentAsync"
                          OnClearRecent="ClearRecentAsync" />
            </div>
        }
    </section>

    @* ── Compare ─────────────────────────────────────────────────────────
       Not a collapsible step: it is one button and one line of state, and the action a
       page exists for should never be behind a disclosure. *@
    <section id="home-step-3" class="home__panel home__panel--cta" aria-labelledby="step-3-heading">
        <div class="home__compare-row">
            <span class="home__panel-num @(CanCompare ? "home__panel-num--done" : "")" aria-hidden="true">3</span>
            <div class="home__compare-copy">
                <h2 id="step-3-heading" class="home__panel-title">Compare</h2>
                <p class="home__panel-hint">@CompareHint</p>
            </div>
            <button class="po-btn po-btn--success po-btn--lg"
                    disabled="@(!CanCompare)"
                    @onclick="StartDuelAsync">
                Compare →
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <span class="home__error">@_error</span>
        }
    </section>

    @* ── Recent duels (or onboarding example when empty) ──────────────── *@
    @if (VisibleRecentDuels.Any())
    {
        <section class="home__recent">
            <div class="home__recent-head">
                <h2 class="home__recent-title">Recent duels</h2>
                <a href="/archive" class="home__recent-link">View all →</a>
            </div>
            <ul class="home__recent-list">
                @foreach (var d in VisibleRecentDuels)
                {
                    var href = d.Verdict == DuelVerdict.Pending ? $"/arena/{d.DuelId}" : "/archive";
                    <li>
                        <a class="home__recent-item @(d.Verdict == DuelVerdict.Pending ? "home__recent-item--pending" : "")" href="@href">
                            <span class="home__recent-prompt">@d.PromptSummary</span>
                            <span class="home__recent-meta">
                                @CleanName(d.LeftModelName) <em>vs</em> @CleanName(d.RightModelName) ·
                                @if (d.Verdict == DuelVerdict.Left) { <span class="home__recent-winner">🏆 @CleanName(d.LeftModelName)</span> }
                                else if (d.Verdict == DuelVerdict.Right) { <span class="home__recent-winner">🏆 @CleanName(d.RightModelName)</span> }
                                else { <span class="home__recent-pending">⚖ Judge</span> }
                            </span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
    else
    {
        @* Finding #4: onboarding example when there are no duels yet *@
        <section class="home__onboard">
            <h2 class="home__onboard-title">Try a starter duel</h2>
            <p class="home__onboard-hint">New here? Click below to load a working prompt and two lightweight models.</p>
            <button class="po-btn po-btn--secondary" @onclick="LoadStarterDuel">
                ⚡ Load starter duel
            </button>
        </section>
    }

    @* ── Sticky ready bar (Finding #7) ─────────────────────────────────────
       The Compare button itself lives in step 3; duplicating it here created two same-priority
       primary controls on the same page. A short status pill ("Ready: …") tells a scrolled
       user that the comparison is available without competing with the in-flow button. *@
    @if (CanCompare)
    {
        <div class="home__sticky-cta" role="status">
            <span class="home__sticky-text">Ready: @_leftModel!.DisplayName vs @_rightModel!.DisplayName — scroll to step 3 to compare</span>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? Prompt { get; set; }
    [SupplyParameterFromQuery(Name = "leftModelId")] public string? LeftModelId { get; set; }
    [SupplyParameterFromQuery(Name = "rightModelId")] public string? RightModelId { get; set; }

    private List<ModelDto> _models = [];
    private IReadOnlyList<DuelSummaryDto> _recentDuels = [];
    private ModelDto? _leftModel;
    private ModelDto? _rightModel;
    private string _prompt = string.Empty;
    private bool _loading = true;
    private string? _loadError;
    private string? _error;

    private DuelApiClient.SmokeSnapshotDto? _health;
    private bool _healthHasRemotes;
    private ModelDto? _replacePopoverModel;
    private bool? _webGpuSupported;   // null = not yet probed

    private IReadOnlyList<RecentPrompt> _recentPrompts = [];

    private sealed class WebGpuProbeCompat { public bool Supported { get; set; } }

    private bool HasModels => _leftModel is not null && _rightModel is not null && _leftModel.ModelId != _rightModel.ModelId;
    private bool HasPrompt => !string.IsNullOrWhiteSpace(_prompt);
    private bool CanCompare => HasModels && HasPrompt;
    private bool _promptLongWarning => _prompt.Length > 4000 * 0.8;

    // ── Step disclosure ──────────────────────────────────────────────────────
    // Exactly one of steps 1 and 2 is open. Finishing a step advances the accordion, which
    // is what makes it a stepper rather than three permanently-open panels stacked into a
    // 6,600px scroll on mobile. Advancing happens on the *event* (a slot filled, a library
    // prompt applied), never on derived state — deriving it would slam the panel shut under
    // someone who cleared a slot to change their mind.
    private int _openStep = 1;

    private bool IsOpen(int step) => _openStep == step;
    private string Expanded(int step) => IsOpen(step) ? "true" : "false";
    private void ToggleStep(int step) => _openStep = _openStep == step ? 0 : step;

    private string Step1Summary => (_leftModel, _rightModel) switch
    {
        (null, null) => "Click a card to assign it. Click a selected card to remove it.",
        ({ } l, null) => $"{l.DisplayName} — pick one more",
        (null, { } r) => $"{r.DisplayName} — pick one more",
        var (l, r) => $"{l!.DisplayName} vs {r!.DisplayName}",
    };

    private string Step2Summary => HasPrompt
        ? (_prompt.Length <= 70 ? _prompt : _prompt[..70].TrimEnd() + "…")
        : "Both models will receive the same prompt.";

    private string CompareHint => (HasModels, HasPrompt) switch
    {
        (false, _) => "Pick two models above to enable Compare.",
        (true, false) => "Write a prompt above to enable Compare.",
        _ => $"Ready: {_leftModel!.DisplayName} vs {_rightModel!.DisplayName}."
    };

    // ── Model-type filter for the Step 1 list (keeps the mobile list scannable) ──
    private string _modelFilter = "all";
    private static readonly (string Key, string Label)[] _filters =
    [
        ("all", "All"),
        ("remote", "Remote"),
        ("browser", "Browser"),
        ("ollama", "Ollama"),
    ];

    private bool _showUnavailable;

    private IEnumerable<ModelDto> FilteredModels => _models.Where(MatchesFilter);

    // ── Availability split ───────────────────────────────────────────────────
    // A model the device cannot run is not a choice, so it does not belong in the choosing
    // list. Both halves come from the same filter so the type chips still add up.
    private bool IsBrowserWithoutGpu(ModelDto m) => m.ModelType == ModelType.Local && _webGpuSupported == false;

    private bool IsRemoteOffline(ModelDto m) =>
        _health is not null && !_healthHasRemotes && m.ModelType == ModelType.Remote;

    private bool IsUnavailable(ModelDto m) => IsBrowserWithoutGpu(m) || IsRemoteOffline(m);

    private IEnumerable<ModelDto> SelectableModels => FilteredModels.Where(m => !IsUnavailable(m));

    private IEnumerable<ModelDto> UnavailableModels => FilteredModels.Where(IsUnavailable);

    private string UnavailableReason => UnavailableModels.Any(IsBrowserWithoutGpu)
        ? "Browser models need WebGPU (desktop Chrome or Edge). Remote and Ollama models run elsewhere and are unaffected."
        : "Remote (Azure AI Foundry) deployments are unreachable right now.";

    private bool MatchesFilter(ModelDto m) => _modelFilter switch
    {
        "remote"  => m.ModelType == ModelType.Remote,
        "browser" => m.ModelType == ModelType.Local,
        "ollama"  => m.ModelType == ModelType.LocalService,
        _         => true,
    };

    private int ModelCountFor(string key) => key switch
    {
        "remote"  => _models.Count(m => m.ModelType == ModelType.Remote),
        "browser" => _models.Count(m => m.ModelType == ModelType.Local),
        "ollama"  => _models.Count(m => m.ModelType == ModelType.LocalService),
        _         => _models.Count,
    };

    // Older/seed duel records stored a raw model ID in the name field (26-char ULIDs
    // and 25-char "01SEED…" seeds). Show a neutral label instead of leaking the ID.
    // Matches an unbroken run of 16+ uppercase letters/digits (no spaces, dashes or
    // dots — real display names like "GPT-5.4 Nano" always have one) or a GUID.
    private static readonly System.Text.RegularExpressions.Regex _idLike =
        new(@"^([0-9A-Z]{16,}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$");

    private static string CleanName(string? name)
        => string.IsNullOrWhiteSpace(name) || _idLike.IsMatch(name.Trim()) ? "Unknown model" : name;

    private static bool IsIdLike(string? name)
        => !string.IsNullOrWhiteSpace(name) && _idLike.IsMatch(name.Trim());

    // Hide legacy/seed duels whose model names are both unresolved IDs — they're noise.
    private IEnumerable<DuelSummaryDto> VisibleRecentDuels =>
        _recentDuels.Where(d => !(IsIdLike(d.LeftModelName) && IsIdLike(d.RightModelName)));

    protected override async Task OnInitializedAsync()
    {
        _prompt = Prompt ?? string.Empty;
        _recentPrompts = await PromptHistory.GetAsync();
        await LoadAsync();
    }

    // ── Prompt sourcing ──────────────────────────────────────────────────────

    private async Task ApplyPromptAsync(string text)
    {
        _prompt = text;
        // Picking from the library finishes step 2, so close it and jump to whatever is still
        // outstanding — Compare if the models are chosen, step 1 if they are not.
        _openStep = HasModels ? 0 : 1;
        await Task.Yield();
        ScrollToAsync(HasModels ? "home-step-3" : "home-step-1");
    }

    private async Task ForgetRecentAsync(string text) =>
        _recentPrompts = await PromptHistory.RemoveAsync(text);

    private async Task ClearRecentAsync()
    {
        await PromptHistory.ClearAsync();
        _recentPrompts = [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Probe real WebGPU capability so Browser models can be gated when they can't run.
        // Shared with ModelHealthPanel via WebGpuCapability — single adapter/device request.
        var probe = await WebGpu.GetAsync();
        _webGpuSupported = probe?.Supported;
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            var modelsTask = ApiClient.GetModelsAsync();
            var duelsTask = ApiClient.ListDuelsAsync(5);
            var healthTask = ApiClient.GetSmokeSnapshotAsync();

            var completed = await Task.WhenAny(modelsTask, Task.Delay(TimeSpan.FromSeconds(12)));
            if (completed != modelsTask)
            {
                _loadError = "Model loading is taking longer than expected.";
                return;
            }

            _models = (await modelsTask)?.ToList() ?? [];
            _recentDuels = (await duelsTask) ?? [];
            _health = await healthTask;
            _healthHasRemotes = _models.Any(m => m.ModelType == ModelType.Remote)
                && _health?.Models.CloudMode != true; // CloudMode hides remotes if Azure is up

            if (!string.IsNullOrWhiteSpace(LeftModelId))
                _leftModel = _models.FirstOrDefault(m => m.ModelId == LeftModelId);
            if (!string.IsNullOrWhiteSpace(RightModelId))
                _rightModel = _models.FirstOrDefault(m => m.ModelId == RightModelId);

            // Arriving from a "rerun this pairing" link lands on the first step that still
            // needs an answer, not back at a choice the link already made.
            if (HasModels) _openStep = HasPrompt ? 0 : 2;
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load models: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void AssignModel(ModelDto model)
    {
        // Both slots full + clicking a 3rd → show replace popover instead of silently overwriting.
        if (_leftModel is not null && _rightModel is not null
            && model.ModelId != _leftModel.ModelId
            && model.ModelId != _rightModel.ModelId)
        {
            _replacePopoverModel = model;
            return;
        }

        // Click selected → unselect.
        if (_leftModel?.ModelId == model.ModelId) { _leftModel = null; return; }
        if (_rightModel?.ModelId == model.ModelId) { _rightModel = null; return; }

        // Fill empty slot first.
        if (_leftModel is null) { _leftModel = model; AdvanceIfModelsChosen(); return; }
        if (_rightModel is null) { _rightModel = model; AdvanceIfModelsChosen(); return; }
        _rightModel = model;
        AdvanceIfModelsChosen();
    }

    /// <summary>Opens the next unfinished step once both slots are full.</summary>
    private void AdvanceIfModelsChosen()
    {
        if (!HasModels || _openStep != 1) return;
        _openStep = HasPrompt ? 0 : 2;
    }

    private void ConfirmReplace(string slot)
    {
        if (_replacePopoverModel is null) return;
        if (slot == "left") _leftModel = _replacePopoverModel;
        else _rightModel = _replacePopoverModel;
        _replacePopoverModel = null;
    }

    private void CancelReplace() => _replacePopoverModel = null;

    private void LoadStarterDuel()
    {
        // Prefer Remote models — they run server-side and need no WebGPU, so a first-run
        // duel works on any device. Fall back to Ollama, then whatever is available.
        var ordered = _models
            .OrderBy(m => m.ModelType switch { ModelType.Remote => 0, ModelType.LocalService => 1, _ => 2 })
            .ToList();
        _leftModel ??= ordered.ElementAtOrDefault(0);
        _rightModel ??= ordered.FirstOrDefault(m => m.ModelId != _leftModel?.ModelId);
        _prompt = "Build a self-contained single HTML file with a click-counter app: a centered card showing a large number and a button. Clicking increments the count. Use a clean modern design with rounded corners and a gradient background.";
        // Both steps are answered, so collapse them and leave Compare as the only thing to do.
        _openStep = 0;
        ScrollToAsync("home-step-3");
    }

    private void ScrollToAsync(string elementId)
    {
        // Anchor navigation via the URL hash; browser handles smooth scrolling.
        Nav.NavigateTo($"#{elementId}", forceLoad: false);
    }

    private async Task StartDuelAsync()
    {
        if (!CanCompare) return;
        _error = null;

        try
        {
            // Remembered before the request, not after: navigation to the Arena follows
            // immediately on success, and a prompt worth re-running is worth keeping even if
            // the duel itself fails to start.
            _recentPrompts = await PromptHistory.RememberAsync(_prompt);

            await AudioService.PlaySnareRollAsync();
            var dto = await ApiClient.CommenceDuelAsync(_leftModel!.ModelId, _rightModel!.ModelId, _prompt);
            if (dto is not null)
                Nav.NavigateTo($"/arena/{dto.DuelId}");
            else
                _error = "Could not start the duel. Please try again.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to start duel: {ex.Message}";
        }
    }

    private string HealthLabel() => _healthHasRemotes ? "🟢 Models ready" : "🟡 Remote offline";
    private string HealthClass() => _healthHasRemotes ? "home__health--ok" : "home__health--warn";
    private string HealthTooltip()
    {
        if (_health is null) return "Health status unavailable";
        if (_healthHasRemotes)
            return $"{_health.Models.Total} models available, {_health.Models.LocalService} local services ready";
        return $"Cloud mode: {_health.Models.CloudMode}. Only local models will work right now.";
    }
}