@page "/tournament"
@page "/tournament/{TournamentIdText}"
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using PoLocalCompare.Shared.Prompts
@using PoLocalCompare.Shared.Tournaments
@implements IDisposable
@inject DuelApiClient ApiClient
@inject NavigationManager Nav
@inject AudioService AudioService
@inject FxService Fx
@inject WebLlmService WebLlm

<PageTitle>Tournament — PoLocalCompare</PageTitle>

@* ── Tournament ───────────────────────────────────────────────────────────
   Two views behind one route: the draw (no id) and the bracket (with one). They are one
   component because creating a bracket navigates straight into watching it, and splitting
   them would remount the page at exactly the moment the first match starts.

   The bracket runs server-side, and this page is mostly a viewer — it polls and paints. The
   exception is a browser (WebGPU) match: those cannot run on the server, so the page joins the
   running match's hub group and drives that inference in this tab, exactly as the Arena does.
   A bracket of remote/Ollama models still finishes with nothing open; one containing a browser
   model needs this tab left open for its matches. *@
<div class="tourney po-page po-page--wide">
    @if (_tournament is not null)
    {
        @* ── Bracket view ───────────────────────────────────────────────── *@
        <header class="po-header">
            <div class="po-header__row">
                <h1 class="po-title">@SizeLabel(_tournament.Size)</h1>
                <span class="tourney__status tourney__status--@_tournament.Status.ToString().ToLowerInvariant()">
                    @StatusLabel(_tournament)
                </span>
            </div>
            <p class="tourney__prompt">@_tournament.PromptText</p>
        </header>

        @if (_tournament.Status == TournamentStatus.Complete && _tournament.ChampionName is not null)
        {
            <div class="tourney__champion po-glass" role="status">
                <span class="tourney__champion-crown" aria-hidden="true">🏆</span>
                <span class="tourney__champion-text">
                    <strong>@_tournament.ChampionName</strong> wins the @SizeLabel(_tournament.Size).
                </span>
                <a class="po-btn po-btn--sm po-btn--secondary"
                   href="@($"/model/{_tournament.ChampionModelId}")">View model</a>
            </div>
        }
        else if (_tournament.Status == TournamentStatus.Abandoned)
        {
            @* Never shown as a result. A bracket that could not finish has no champion, and
               presenting the last model standing as one would be inventing an outcome. *@
            <div class="tourney__abandoned" role="status">
                <span aria-hidden="true">⚠</span>
                Run stopped — @(_tournament.AbandonedReason ?? "a match could not be decided.")
                No champion was crowned and the bracket is left as it stood.
            </div>
        }
        else
        {
            <div class="tourney__progress" role="status">
                <span aria-hidden="true">⚔</span>
                @_tournament.DecidedCount of @_tournament.TotalMatches matches decided.
                @if (RunningMatch is not null)
                {
                    <span>
                        Now: <strong>@RunningMatch.SlotAName</strong> vs <strong>@RunningMatch.SlotBName</strong>
                        @if (RunningMatch.DuelId is { } liveDuelId)
                        {
                            <a class="tourney__watch" href="@($"/arena/{liveDuelId}")">Watch →</a>
                        }
                    </span>
                }
                else
                {
                    <span>Starting the next match…</span>
                }
            </div>

            @* A browser match runs on this tab's GPU, so say so — the page is otherwise a
               viewer and "you can close this" is the reasonable assumption to make about it. *@
            @if (_drivingLocalMatch)
            {
                <div class="tourney__local-notice" role="status">
                    <span aria-hidden="true">🖥</span>
                    Running a browser model in this tab — keep it open until the match finishes.
                </div>
            }
        }

        @* Columns are rounds. Each column is centred against the one before it, so the pairs
           that feed a match sit either side of it — that alignment is what makes it read as a
           bracket rather than as three lists. *@
        <div class="tourney__bracket-wrap">
            <div class="tourney__bracket" style="--rounds: @RoundCount">
                @foreach (var round in _tournament.Matches.GroupBy(m => m.Round).OrderBy(g => g.Key))
                {
                    <div class="tourney__round" @key="round.Key">
                        <h2 class="tourney__round-title">@round.First().RoundName</h2>
                        <div class="tourney__round-matches">
                            @foreach (var match in round.OrderBy(m => m.Index))
                            {
                                <div class="tourney__match po-lift @MatchClass(match)" @key="@($"{match.Round}-{match.Index}")">
                                    @RenderSlot(match, isSlotA: true)
                                    @RenderSlot(match, isSlotA: false)

                                    @if (match.DuelId is { } duelId)
                                    {
                                        <a class="tourney__match-link" href="@($"/arena/{duelId}")">
                                            @(match.IsDecided ? "View duel →" : "Watch live →")
                                        </a>
                                    }
                                    @if (match.WonOnSeedTieBreak)
                                    {
                                        <span class="tourney__tiebreak" title="The judge called it a draw; the better seed advances.">
                                            drawn — advanced on seed
                                        </span>
                                    }
                                    @if (match.FailureReason is not null)
                                    {
                                        <span class="tourney__match-error">@match.FailureReason</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="tourney__actions">
            <a class="po-btn po-btn--primary" href="/tournament">⚔ New tournament</a>
            <a class="po-btn" href="/leaderboard">📊 Leaderboard</a>
        </div>
    }
    else if (_loadingTournament)
    {
        <p class="po-status">Loading bracket…</p>
    }
    else if (!string.IsNullOrEmpty(TournamentIdText))
    {
        <div class="po-empty">
            <p class="po-empty__hint">
                No tournament with that id — it may have been wiped with the local storage.
            </p>
            <a class="po-btn po-btn--primary" href="/tournament">Draw a new bracket</a>
        </div>
    }
    else
    {
        @* ── Draw view ──────────────────────────────────────────────────── *@
        <header class="po-header">
            <h1 class="po-title">Run a tournament</h1>
            <p class="po-subtitle">
                Write a prompt and start. Eight models are drawn for you and every match is
                judged automatically — re-draw if the field is not what you wanted.
            </p>
        </header>

        <section class="po-section" aria-labelledby="tourney-field-heading">
            <div class="tourney__section-head">
                <h2 id="tourney-field-heading" class="po-section-title">The field — 8 models</h2>
                <p class="po-hint">
                    Drawn at random from the remote models, then seeded by rating so the top two
                    seeds can only meet in the final. Quarter-finals, semis and a final — seven duels.
                </p>
            </div>

            @* The slot reserves the field's height while it loads. Without it this block was one
               line of status text that became a list of eight rows, and a runtime trace measured
               the jump at CLS 0.289 on a phone — past the 0.1 "needs improvement" mark, and the
               only route in the app that shifted at all. *@
            <div class="tourney__entrants-slot">
                @if (_loadingEntrants)
                {
                    <p class="po-status">Drawing the field…</p>
                }
                else if (_entrants.Count == 0)
                {
                    @* Distinguished from "not enough models" on purpose: a failed request used to
                       render as "0 models are registered", which is a different problem with a
                       different fix and sent you looking in the wrong place. *@
                    <p class="po-error">
                        Could not reach the model catalog. Check that the app is running and that
                        you are signed in, then reload.
                    </p>
                }
                else if (_selected.Count < FieldSize)
                {
                    <p class="po-error">
                        Only @_entrants.Count model@(_entrants.Count == 1 ? " is" : "s are") registered —
                        a bracket needs @FieldSize.
                    </p>
                }
                else
                {
                    @* Mirrored, four a side, converging on the final — the shape a bracket is
                       normally read in. The flat numbered list it replaced showed the same eight
                       models but hid the only thing the seeding is *for*: who actually meets whom,
                       and how far apart the top two seeds are. Pairings come from the same
                       BracketPlanner the server draws with, so this is the real first round
                       rather than a picture of one. *@
                    <div class="tourney__draw" role="group" aria-label="First-round pairings">
                        <div class="tourney__draw-half">
                            @foreach (var pair in FirstRoundPairs.Take(2))
                            {
                                @RenderPair(pair)
                            }
                        </div>

                        <div class="tourney__draw-centre" aria-hidden="true">
                            <span class="tourney__draw-final">Final</span>
                        </div>

                        <div class="tourney__draw-half tourney__draw-half--right">
                            @foreach (var pair in FirstRoundPairs.Skip(2))
                            {
                                @RenderPair(pair)
                            }
                        </div>
                    </div>

                    <button type="button" class="po-btn po-btn--sm po-btn--ghost" @onclick="DrawField">
                        <span aria-hidden="true">↺</span> Re-draw the field
                    </button>

                    @if (DrawnField.Any(e => e.ModelType != ModelType.Remote))
                    {
                        <p class="po-hint po-fg--err">
                            ⚠ Fewer than @FieldSize remote models are available, so the field was
                            topped up with local ones. A browser (WebGPU) model runs in this tab —
                            leave it open while the bracket runs, or that match stalls until the
                            duel's watchdog fails it.
                        </p>
                    }
                }
            </div>
        </section>

        <section class="po-section" aria-labelledby="tourney-prompt-heading">
            <h2 id="tourney-prompt-heading" class="po-section-title">The prompt</h2>
            <p class="po-hint">
                Every match in the bracket gets this same prompt — that is what makes the winner mean something.
            </p>
            <textarea class="tourney__textarea"
                      aria-labelledby="tourney-prompt-heading"
                      rows="4"
                      maxlength="4000"
                      placeholder="e.g. Build a self-contained single HTML file with a working scientific calculator."
                      @bind="_prompt"
                      @bind:event="oninput"></textarea>

            <div class="tourney__prompt-picks">
                @foreach (var template in PromptLibrary.SelfRunning.Take(6))
                {
                    <button type="button" class="po-btn po-btn--sm po-btn--secondary"
                            @key="template.Id"
                            @onclick="() => _prompt = template.Text">
                        <span aria-hidden="true">@template.Emoji</span> @template.Title
                    </button>
                }
            </div>
        </section>

        <div class="tourney__actions">
            <button type="button" class="po-btn po-btn--success po-btn--lg"
                    disabled="@(!CanStart)"
                    @onclick="StartAsync">
                @(_starting ? "Drawing…" : "Start tournament →")
            </button>
            <span class="tourney__start-hint">@StartHint</span>
        </div>

        @if (_error is not null)
        {
            <p class="po-error" role="status">@_error</p>
        }

        @if (_recent.Count > 0)
        {
            <section class="po-section" aria-labelledby="tourney-recent-heading">
                <h2 id="tourney-recent-heading" class="po-section-title">Recent tournaments</h2>
                <ul class="tourney__recent">
                    @foreach (var run in _recent)
                    {
                        <li @key="run.TournamentId">
                            <a class="tourney__recent-item" href="@($"/tournament/{run.TournamentId}")">
                                <span class="tourney__recent-prompt">@Truncate(run.PromptText, 60)</span>
                                <span class="tourney__recent-meta">
                                    @SizeLabel(run.Size) ·
                                    @if (run.ChampionName is not null)
                                    {
                                        <span class="tourney__recent-champ">🏆 @run.ChampionName</span>
                                    }
                                    else
                                    {
                                        <span>@StatusLabel(run)</span>
                                    }
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    [Parameter] public string? TournamentIdText { get; set; }

    // ── Draw state ───────────────────────────────────────────────────────────
    /// <summary>
    /// The only bracket the page offers. The API still accepts 2 (a plain 1v1) — see
    /// <see cref="BracketPlanner.SupportedSizes"/> — but picking a size was a decision nobody
    /// wanted to make before writing a prompt, so the page draws a full bracket and gets on
    /// with it.
    /// </summary>
    private const int FieldSize = 8;
    private List<TournamentEntrantDto> _entrants = [];
    private readonly List<ModelId> _selected = [];
    private string _prompt = string.Empty;
    private bool _loadingEntrants = true;
    private bool _starting;
    private string? _error;
    private List<TournamentDto> _recent = [];

    // ── Bracket state ────────────────────────────────────────────────────────
    private TournamentDto? _tournament;
    private bool _loadingTournament;
    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;

    // ── Browser-model matches ────────────────────────────────────────────────
    // A WebGPU model cannot run on the server, so for those matches this page plays the role
    // the Arena plays for a single duel: join the running duel's hub group, answer
    // StartLocalInference, and POST the result back. The hub follows the running match rather
    // than the tournament, because StartLocalInference is addressed to `duel:{duelId}`.
    private SignalRDuelClient? _hub;
    private DuelId? _hubDuelId;
    private LocalInferenceDriver? _localInference;
    private bool _drivingLocalMatch;

    /// <summary>
    /// How often the bracket is re-read while it runs. The server owns the run, so this is a
    /// viewer refresh rather than a control loop — slow enough not to hammer storage, fast
    /// enough that a match finishing is visible while you are still looking at it.
    /// </summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);

    private bool CanStart => _selected.Count == FieldSize
        && _prompt.Trim().Length >= 10
        && !_starting;

    private string StartHint => (_selected.Count == FieldSize, _prompt.Trim().Length >= 10) switch
    {
        (false, _) => "Not enough models registered to fill a bracket.",
        (true, false) => "Write a prompt for the bracket.",
        _ => $"{FieldSize} models · {FieldSize - 1} duels · judged automatically.",
    };

    /// <summary>The drawn field, in draw order, resolved back to entrant rows.</summary>
    private IEnumerable<TournamentEntrantDto> DrawnField =>
        _selected.Select(id => _entrants.First(e => e.ModelId == id));

    /// <summary>One first-round pairing: the two entrants and their seed numbers.</summary>
    private sealed record Pairing(
        int SeedA, TournamentEntrantDto A,
        int SeedB, TournamentEntrantDto B);

    /// <summary>
    /// The four first-round matches, in bracket order.
    /// </summary>
    /// <remarks>
    /// Mirrors what <c>CreateTournamentHandler</c> will do on the server: seed the field by
    /// rating, strongest first, then lay it out through <see cref="BracketPlanner.SeedOrder"/>.
    /// Reusing the planner rather than hard-coding 1v8/4v5/2v7/3v6 is the point — if the seeding
    /// convention ever changes, this preview cannot drift away from the bracket it previews.
    /// </remarks>
    private IReadOnlyList<Pairing> FirstRoundPairs
    {
        get
        {
            if (_selected.Count < FieldSize) return [];

            var seeded = DrawnField
                .OrderByDescending(e => e.CurrentElo)
                .ThenBy(e => e.DisplayName, StringComparer.Ordinal)
                .ToList();

            var order = BracketPlanner.SeedOrder(FieldSize);
            var pairs = new List<Pairing>(FieldSize / 2);

            for (var i = 0; i < order.Count; i += 2)
            {
                // SeedOrder is 1-based; the seeded list is 0-based.
                var seedA = order[i];
                var seedB = order[i + 1];
                pairs.Add(new Pairing(seedA, seeded[seedA - 1], seedB, seeded[seedB - 1]));
            }

            return pairs;
        }
    }

    private int RoundCount => _tournament is null ? 0 : BracketPlanner.RoundCount(_tournament.Size);

    private TournamentMatchDto? RunningMatch => _tournament?.Matches.FirstOrDefault(m => m.IsRunning);

    private static string SizeLabel(int size) => size switch
    {
        2 => "1v1",
        _ => $"{size}-model bracket",
    };

    private static string StatusLabel(TournamentDto tournament) => tournament.Status switch
    {
        TournamentStatus.Pending => "Drawn",
        TournamentStatus.Running => "Running",
        TournamentStatus.Complete => "Complete",
        _ => "Stopped",
    };

    private static string MatchClass(TournamentMatchDto match) =>
        match switch
        {
            { FailureReason: not null } => "tourney__match--failed",
            { IsDecided: true } => "tourney__match--decided",
            { IsRunning: true } => "tourney__match--running",
            // A ready match looks like the base card, so it gets no modifier at all — a class
            // whose rule restates the default is the kind of dead weight this codebase keeps
            // accumulating. Pending is the one that differs: it is dimmed, because it is
            // waiting on a winner that does not exist yet.
            { IsReady: true } => "",
            _ => "tourney__match--pending",
        };

    private static string Truncate(string text, int max) =>
        string.IsNullOrEmpty(text) || text.Length <= max ? text : text[..max].TrimEnd() + "…";

    /// <summary>
    /// Renders one side of a match. A slot with no model yet is a placeholder rather than a
    /// blank, so an unplayed round reads as "waiting for a winner" instead of as a broken card.
    /// </summary>
    private RenderFragment RenderSlot(TournamentMatchDto match, bool isSlotA) => builder =>
    {
        var modelId = isSlotA ? match.SlotAModelId : match.SlotBModelId;
        var name = isSlotA ? match.SlotAName : match.SlotBName;
        var seed = isSlotA ? match.SlotASeed : match.SlotBSeed;
        var won = match.WinnerModelId is { } winner && winner == modelId;
        var lost = match.IsDecided && !won && !modelId.IsEmpty;

        var css = "tourney__slot"
            + (won ? " tourney__slot--won" : "")
            + (lost ? " tourney__slot--lost" : "")
            + (modelId.IsEmpty ? " tourney__slot--empty" : "");

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", css);

        if (modelId.IsEmpty)
        {
            builder.OpenElement(2, "span");
            builder.AddAttribute(3, "class", "tourney__slot-name");
            builder.AddContent(4, "—");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "class", "tourney__slot-seed");
            builder.AddAttribute(7, "title", $"Seed {seed}");
            builder.AddContent(8, seed);
            builder.CloseElement();

            builder.OpenElement(9, "span");
            builder.AddAttribute(10, "class", "tourney__slot-name");
            builder.AddContent(11, name);
            builder.CloseElement();

            if (won)
            {
                builder.OpenElement(12, "span");
                builder.AddAttribute(13, "class", "tourney__slot-badge");
                builder.AddAttribute(14, "aria-label", "Winner");
                builder.AddContent(15, "🏆");
                builder.CloseElement();
            }
        }

        builder.CloseElement();
    };

    protected override async Task OnParametersSetAsync()
    {
        // OnParametersSetAsync rather than OnInitializedAsync: navigating from the draw to a
        // bracket keeps this component instance, so an initialiser would never run for it.
        StopPolling();

        if (string.IsNullOrWhiteSpace(TournamentIdText))
        {
            _tournament = null;
            await LoadDrawAsync();
            return;
        }

        _loadingTournament = true;
        _tournament = null;

        try
        {
            _tournament = await ApiClient.GetTournamentAsync(TournamentId.From(TournamentIdText));
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = $"Could not load the bracket: {ex.Message}";
        }
        finally
        {
            _loadingTournament = false;
        }

        if (_tournament is { Status: TournamentStatus.Pending or TournamentStatus.Running })
            StartPolling();
    }

    private async Task LoadDrawAsync()
    {
        _loadingEntrants = true;

        try
        {
            var entrantsTask = ApiClient.GetTournamentEntrantsAsync();
            var recentTask = ApiClient.ListTournamentsAsync(5);

            _entrants = (await entrantsTask)?.ToList() ?? [];
            _recent = (await recentTask)?.ToList() ?? [];
            DrawField();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = $"Could not load the model list: {ex.Message}";
        }
        finally
        {
            _loadingEntrants = false;
        }
    }

    /// <summary>Draws eight models at random, preferring remote ones.</summary>
    /// <remarks>
    /// Remote first because they are the only type that needs nothing from this machine — no
    /// GPU, no daemon, no tab left open — so a random draw over them is a bracket that will
    /// actually finish. Ollama and browser models only top the field up when there are not
    /// eight remotes to draw from, and the page says so when that happens. Random rather than
    /// top-eight-by-rating: the seeding already decides who meets whom, so taking the top eight
    /// every time would just mean the same bracket over and over.
    /// </remarks>
    private void DrawField()
    {
        _selected.Clear();
        if (_entrants.Count == 0) return;

        var remote = _entrants.Where(e => e.ModelType == ModelType.Remote).ToList();
        var rest = _entrants.Where(e => e.ModelType != ModelType.Remote).ToList();

        Shuffle(remote);
        Shuffle(rest);

        _selected.AddRange(remote.Concat(rest).Take(FieldSize).Select(e => e.ModelId));
    }

    private static void Shuffle<T>(IList<T> items)
    {
        for (var i = items.Count - 1; i > 0; i--)
        {
            var j = Random.Shared.Next(i + 1);
            (items[i], items[j]) = (items[j], items[i]);
        }
    }

    private async Task StartAsync()
    {
        if (!CanStart) return;

        _starting = true;
        _error = null;

        try
        {
            await AudioService.PlaySnareRollAsync();
            var drawn = await ApiClient.CreateTournamentAsync(_selected, _prompt.Trim());

            if (drawn is not null)
                Nav.NavigateTo($"/tournament/{drawn.TournamentId}");
            else
                _error = "Could not draw the bracket. Please try again.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    // ── Polling ──────────────────────────────────────────────────────────────

    private void StartPolling()
    {
        _pollCts = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(PollInterval);
        _ = PollAsync(_pollTimer, _pollCts.Token);
    }

    /// <summary>
    /// Keeps the hub connection pointed at whichever match is currently running, so a browser
    /// model in that match gets driven from this tab. A no-op for a bracket of remote/Ollama
    /// models: the server never sends StartLocalInference for those, so the connection sits idle.
    /// </summary>
    /// <remarks>
    /// Reconnecting per match rather than holding one connection is deliberate — the server
    /// addresses StartLocalInference to the duel group, and a bracket is seven different duels.
    /// The server re-sends that signal every 5 s, so joining a match already in flight still
    /// picks it up rather than deadlocking on a missed first send.
    /// </remarks>
    private async Task EnsureHubForRunningMatchAsync()
    {
        var runningDuelId = RunningMatch?.DuelId;

        if (runningDuelId == _hubDuelId) return;

        await DisconnectHubAsync();
        if (runningDuelId is null) return;

        try
        {
            _localInference ??= new LocalInferenceDriver(WebLlm, ApiClient);
            _hub = new SignalRDuelClient();
            _hub.OnStartLocalInference += OnStartLocalInference;
            await _hub.ConnectAsync(Nav.BaseUri.TrimEnd('/'), runningDuelId.Value);
            _hubDuelId = runningDuelId;
        }
        catch (Exception)
        {
            // A hub that will not connect costs browser matches, not the bracket. The next poll
            // retries; remote and Ollama matches finish regardless.
            await DisconnectHubAsync();
        }
    }

    private void OnStartLocalInference(StartLocalInferencePayload payload)
    {
        // A reconnect replays this signal, and so does the server's 5-second resend; the driver
        // owns the de-duplication.
        if (_localInference is null || !_localInference.TryClaim(payload.ModelId)) return;

        _drivingLocalMatch = true;
        _ = InvokeAsync(StateHasChanged);

        _ = Task.Run(async () =>
        {
            // Every failure path is handled inside the driver and reported to the server, so
            // there is no outcome here worth awaiting beyond clearing the banner.
            await _localInference.RunAsync(payload);
            _drivingLocalMatch = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task DisconnectHubAsync()
    {
        if (_hub is not null)
        {
            _hub.OnStartLocalInference -= OnStartLocalInference;
            await _hub.DisposeAsync();
            _hub = null;
        }
        _hubDuelId = null;
    }

    private async Task PollAsync(PeriodicTimer timer, CancellationToken cancellationToken)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var fresh = await ApiClient.GetTournamentAsync(TournamentId.From(TournamentIdText!));
                if (fresh is null) continue;

                var wasComplete = _tournament?.Status == TournamentStatus.Complete;
                _tournament = fresh;
                await EnsureHubForRunningMatchAsync();
                await InvokeAsync(StateHasChanged);

                if (fresh.Status is TournamentStatus.Complete or TournamentStatus.Abandoned)
                {
                    // One flourish on the transition only — a poll that re-reads a finished
                    // bracket must not replay it. Safe at this point by construction: the run
                    // is over, so nothing is competing for the GPU.
                    if (!wasComplete)
                    {
                        if (fresh.Status == TournamentStatus.Complete)
                        {
                            _ = AudioService.PlayFanfareAsync();
                            // Bigger than a duel verdict, because a final is.
                            _ = Fx.ChampionBurstAsync(".tourney__champion");
                        }
                        else
                        {
                            // An abandoned run is not a result and must not sound like one.
                            _ = AudioService.PlayDefeatAsync();
                        }
                    }

                    StopPolling();
                    await DisconnectHubAsync();
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Navigated away.
        }
        catch (Exception)
        {
            // A failed poll is not a failed run — the bracket is server-side. Stop refreshing
            // rather than replacing what is on screen with an error about fetching it.
            StopPolling();
        }
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    /// <summary>
    /// One match box: two seeded competitors and the tie that joins them. A local template
    /// rather than a component because it is markup with no state and is used twice on one page.
    /// </summary>
    private RenderFragment RenderPair(Pairing pair) =>
        @<div class="tourney__draw-match">
            <div class="tourney__draw-slot">
                <span class="tourney__draw-seed">@pair.SeedA</span>
                <span class="tourney__draw-name">@pair.A.DisplayName</span>
                <span class="tourney__draw-elo">@((int)Math.Round(pair.A.CurrentElo))</span>
            </div>
            <div class="tourney__draw-slot">
                <span class="tourney__draw-seed">@pair.SeedB</span>
                <span class="tourney__draw-name">@pair.B.DisplayName</span>
                <span class="tourney__draw-elo">@((int)Math.Round(pair.B.CurrentElo))</span>
            </div>
        </div>;

    public void Dispose()
    {
        StopPolling();
        // Fire-and-forget: IDisposable cannot await, and the hub's own dispose is best-effort.
        // A browser match already in flight keeps running until its worker finishes, which is
        // what we want — navigating away mid-match should not strand the duel.
        _ = DisconnectHubAsync();
    }
}
