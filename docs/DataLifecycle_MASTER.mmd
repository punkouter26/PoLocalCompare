flowchart TD
    subgraph Ingestion["📥 Ingestion Phase"]
        USER_INPUT["👤 User Input<br/>Prompt + Model Selection"]
        API_RECEIVE["🌐 API Receives<br/>POST /api/duels"]
        VALIDATE["✅ Validate Request<br/>Prompt not empty, models differ"]
        CREATE["📝 Create Duel Entity<br/>DuelId = ULID, VerdictDeadline"]
        QUEUE["⏳ Queue Execution<br/>BackgroundTaskQueue"]
    end

    subgraph Processing["⚙️ Processing Phase"]
        DEQUEUE["⚡ Dequeue Task<br/>DuelExecutionService"]
        LOAD_MODELS["📦 Load Models<br/>IModelRepository.GetById()"]
        START_LEFT["🏃 Start Left Inference"]
        START_RIGHT["🏃 Start Right Inference"]
        CONCURRENT["⚡ Concurrent Execution<br/>Parallel tasks"]
        
        subgraph Inference["🤖 Inference Paths"]
            LOCAL["🖥️ Local (WebLLM)<br/>SignalR → Browser → WebGPU"]
            REMOTE["☁️ Remote (Foundry)<br/>HTTP POST → Stream tokens"]
            SERVICE["🔧 Service (Ollama)<br/>HTTP POST → Stream tokens"]
        end
        
        LEFT_SIDE{{"Left Type?"}}
        RIGHT_SIDE{{"Right Type?"}}
        LEFT_SIDE -->|Local| LOCAL
        LEFT_SIDE -->|Remote| REMOTE
        LEFT_SIDE -->|Service| SERVICE
        RIGHT_SIDE -->|Local| LOCAL
        RIGHT_SIDE -->|Remote| REMOTE
        RIGHT_SIDE -->|Service| SERVICE
    end

    subgraph Transform["🔄 Transformation Phase"]
        STREAM["📡 Token Stream<br/>500ms updates via SignalR"]
        PREVIEW["👁️ HTML Preview<br/>Partial rendering"]
        STATS["📊 Compute Stats<br/>TokenCount, Velocity, Quality"]
        ENRICH["✨ Enrich Data<br/>GreenScore, EnergyWh, CharDensity"]
        STORE_RESULT["💾 Store DuelResult<br/>IDuelResultRepository.SaveAsync()"]
    end

    subgraph Egress["📤 Egress / UI Update"]
        COMPLETE["🎯 Both Complete<br/>DuelComplete SignalR event"]
        ARENA_LOAD["🏟️ Arena Loads<br/>GET /api/duels/{id}"]
        VIEW_HTML["👁️ View HTML<br/>Sandboxed iframes"]
        VERDICT["⚖️ User Verdict<br/>POST /api/duels/{id}/verdict"]
        ELO_UPDATE["📈 ELO Update<br/>EloCalculator.Calculate()"]
        RANK_UPDATE["🏆 Rank Update<br/>Leaderboard refreshes"]
        ARCHIVE["📜 Archive<br/>Duels stored by YYYYMM partition"]
    end

    USER_INPUT --> API_RECEIVE
    API_RECEIVE --> VALIDATE
    VALIDATE --> CREATE
    CREATE --> QUEUE
    QUEUE --> DEQUEUE
    DEQUEUE --> LOAD_MODELS
    LOAD_MODELS --> START_LEFT
    LOAD_MODELS --> START_RIGHT
    START_LEFT --> CONCURRENT
    START_RIGHT --> CONCURRENT
    CONCURRENT --> LEFT_SIDE
    CONCURRENT --> RIGHT_SIDE

    LOCAL --> STREAM
    REMOTE --> STREAM
    SERVICE --> STREAM
    STREAM --> PREVIEW
    PREVIEW --> STATS
    STATS --> ENRICH
    ENRICH --> STORE_RESULT

    STORE_RESULT --> COMPLETE
    COMPLETE --> ARENA_LOAD
    ARENA_LOAD --> VIEW_HTML
    VIEW_HTML --> VERDICT
    VERDICT --> ELO_UPDATE
    ELO_UPDATE --> RANK_UPDATE
    RANK_UPDATE --> ARCHIVE

    style Ingestion fill:#1a1a2e,stroke:#22c55e,color:#fff
    style Processing fill:#16213e,stroke:#06b6d4,color:#fff
    style Transform fill:#0f3460,stroke:#eab308,color:#fff
    style Egress fill:#1a1a2e,stroke:#22c55e,color:#fff
    style Inference fill:#16213e,stroke:#06b6d4,color:#fff