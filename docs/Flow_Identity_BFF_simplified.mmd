%% Simplified BFF identity loop.
graph TD
    SPA["Blazor WASM<br/>(no tokens ever)"] -->|"GET /auth/me"| API["PoLocalCompare.Api (BFF)"]
    API -->|"unauthenticated"| LOGIN["Login view"]
    LOGIN -->|"/auth/login/microsoft"| ENTRA["Microsoft Entra ID<br/>OIDC code + PKCE, /common"]
    ENTRA -->|"/signin-oidc + issuer check"| COOKIE["HttpOnly SameSite=Strict cookie<br/>PoLocalCompare.Session (8h sliding)"]
    COOKIE --> SPA
    SPA -->|"cookie rides every same-origin call"| GUARD["Deny-by-default authorization"]
    GUARD -->|"401 JSON (never 302)"| LOGIN
    GUARD -->|"OK"| APP["API + SignalR hubs"]
    LOGIN -.->|"Guest (Dev/Test only)"| COOKIE
