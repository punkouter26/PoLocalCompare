flowchart LR
    subgraph Branch["🌿 Branch Strategy"]
        FEAT[feature/*]
        DEV[dev]
        STAGING[staging]
        MAIN[main]
    end

    subgraph Pipeline["🔨 CI Pipeline"]
        CHECK[Check]
        TEST[Test]
        BUILD[Build]
        DEPLOY[Deploy]
    end

    subgraph Env["🌍 Environments"]
        DEV_E[Dev]
        STAGING_E[Staging]
        PROD_E[Prod]
    end

    FEAT -->|PR| DEV
    DEV --> CHECK --> TEST --> BUILD --> DEPLOY
    DEPLOY --> DEV_E --> STAGING_E --> PROD_E

    style Branch fill:#1a1a2e,stroke:#22c55e,color:#fff
    style Pipeline fill:#16213e,stroke:#06b6d4,color:#fff
    style Env fill:#0f3460,stroke:#eab308,color:#fff