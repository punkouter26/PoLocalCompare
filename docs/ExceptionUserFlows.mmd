flowchart TD
    START(["⚠️ Exception Flows"])

    subgraph Auth["🔐 Authentication & Authorization"]
        UNAUTH["🔒 Access Restricted Page<br/>Without proper auth"]
        UNAUTH -->|401| LOGIN["👤 Redirect to Login<br/>or Show Auth Required"]
        NO_ACCESS["🚫 Insufficient Permissions<br/>Role-based access denied"]
        NO_ACCESS -->|403| APOLOGY["⚠️ Access Denied Page<br/>Contact admin"]
    end

    subgraph Validation["✅ Input Validation Errors"]
        EMPTY_PROMPT["📝 Empty Prompt<br/>Validation: not empty"]
        EMPTY_PROMPT --> HINT1["💡 'Enter a prompt to continue'"]
        SAME_MODEL["⚔️ Same Model Selected<br/>LeftModel = RightModel"]
        SAME_MODEL --> HINT2["💡 'Left and Right must differ'"]
        UNAVAIL_MODEL["🚫 Model Unavailable<br/>Not confirmed working"]
        UNAVAIL_MODEL --> HINT3["💡 'Pick confirmed working models'"]
        LONG_PROMPT["📜 Prompt Too Long<br/>> max length"]
        LONG_PROMPT --> ERROR1["❌ 'Prompt exceeds maximum length'"]
    end

    subgraph Network["🌐 Network & Connectivity"]
        OFFLINE["📡 Client Offline<br/>No network connection"]
        OFFLINE --> RETRY["🔄 Auto-Retry<br/>Exponential backoff"]
        RETRY -->|Success| RESUME["▶️ Resume Duel"]
        RETRY -->|Fail| FAIL["❌ Duel Failed<br/>User notified"]
        TIMEOUT["⏱️ Request Timeout<br/>> 30s"]
        TIMEOUT --> RETRY
        SIGNALR_DISCONNECT["🔌 SignalR Disconnect<br/>WebSocket dropped"]
        SIGNALR_DISCONNECT --> RECONNECT["🔄 Reconnect<br/>Rejoin duel:{duelId}"]
        RECONNECT --> RESUME
    end

    subgraph Inference["🤖 Inference Failures"]
        LOCAL_FAIL["🖥️ WebLLM Failure<br/>Worker crash / GPU error"]
        LOCAL_FAIL --> RETRY_LOCAL["🔄 Retry Local Inference<br/>Restart worker"]
        RETRY_LOCAL -->|Fail 3x| FAIL_LOCAL["❌ Mark as Failed<br/>Partial duel continues"]
        REMOTE_FAIL["☁️ Azure Foundry Error<br/>API error / rate limit"]
        REMOTE_FAIL --> RETRY_REMOTE["🔄 Retry Remote Inference<br/>Backoff + retry"]
        RETRY_REMOTE -->|Fail| FAIL_REMOTE["❌ Mark as Failed<br/>Partial duel continues"]
        OLLAMA_FAIL["🔧 Ollama Unavailable<br/>Service down / timeout"]
        OLLAMA_FAIL --> RETRY_OLLAMA["🔄 Retry Ollama<br/>Reconnect"]
        RETRY_OLLAMA -->|Fail| FAIL_OLLAMA["❌ Mark as Failed<br/>Partial duel continues"]
    end

    subgraph Payment["💳 Payment & Quota"]
        QUOTA_EXCEED["📊 Quota Exceeded<br/>API rate limit hit"]
        QUOTA_EXCEED --> QUEUE["📋 Queue Request<br/>Wait for quota"]
        QUEUE -->|Quota Available| RESUME
        COST_HIGH["💰 High Cost Alert<br/>Token price warning"]
        COST_HIGH --> CONFIRM["✅ Confirm to proceed<br/>or cancel duel"]
    end

    subgraph Verdict["⚖️ Verdict Edge Cases"]
        VERDICT_TIMEOUT["⏰ 24h Verdict Deadline<br/>No human judgment"]
        VERDICT_TIMEOUT --> AUTO["🤖 Auto-Judge<br/>GPT-4.1 Nano decides"]
        AUTO --> RECORD["📝 Record Auto-Verdict<br/>EloCalculator runs"]
        CONFLICT["⚡ Verdict Conflict<br/>Both sides claim win"]
        CONFLICT --> RESOLVE["🎯 Admin Review<br/>Manual resolution needed"]
        EXPIRED_VERDICT["❌ Expired Verdict<br/>Deadline passed + no auto"]
        EXPIRED_VERDICT --> MARK["🏷️ Mark as Expired<br/>DuelVerdict.Expired"]
    end

    subgraph Storage["💾 Storage & Data"]
        TABLE_NOT_READY["📦 Azure Table Storage<br/>Not initialized"]
        TABLE_NOT_READY --> WAIT["⏳ Wait + Retry<br/>Azurite warm-up"]
        WAIT -->|Ready| CONTINUE["✅ Continue"]
        BLOB_FAIL["📄 Blob Upload Failed<br/>HTML output storage error"]
        BLOB_FAIL --> RETRY_BLOB["🔄 Retry Blob Upload"]
        RETRY_BLOB -->|Fail| LOG["📝 Log Error<br/>Continue without blob"]
        ENTITY_NOT_FOUND["🔍 Entity Not Found<br/>Model/Duel/Result missing"]
        ENTITY_NOT_FOUND --> NOTIFY["❌ 404 Response<br/>User notified"]
    end

    style Auth fill:#1a1a2e,stroke:#ef4444,color:#fff
    style Validation fill:#16213e,stroke:#eab308,color:#fff
    style Network fill:#0f3460,stroke:#06b6d4,color:#fff
    style Inference fill:#1a1a2e,stroke:#ef4444,color:#fff
    style Payment fill:#16213e,stroke:#22c55e,color:#fff
    style Verdict fill:#0f3460,stroke:#eab308,color:#fff
    style Storage fill:#1a1a2e,stroke:#06b6d4,color:#fff