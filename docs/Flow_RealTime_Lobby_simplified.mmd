%% Simplified lobby lifecycle.
graph LR
    P["Player (Lobby.razor)"] -->|"JoinLobby / ToggleReady"| H["LobbyHub<br/>(authoritative state)"]
    H -->|"LobbyStateChanged broadcast"| P
    HOST["Host player"] -->|"StartDuel"| H
    H -->|"validates: host + all ready + >=2"| GO["DuelStarting broadcast"]
    GO --> ALL["All players → /processing/{DuelId}"]
    ALL --> D["Duel pipeline (background queue + DuelHub streaming)"]
    P -.->|"disconnect"| H
    H -.->|"host promotion (earliest joiner)"| P
