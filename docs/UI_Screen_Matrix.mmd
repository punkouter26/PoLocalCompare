%% Client routes and screen states. Every routed page carries [Authorize] via _Imports.razor;
%% App.razor wraps the Router in CascadingAuthenticationState + AuthorizeRouteView backed by
%% BffAuthenticationStateProvider (GET /auth/me). Layout-flash mitigations noted inline.
stateDiagram-v2
    [*] --> Bootstrapping : WASM loads (no-cache _framework revalidation)

    state Bootstrapping {
        [*] --> ProbingAuthMe : BffAuthenticationStateProvider calls GET /auth/me
        ProbingAuthMe --> [*]
    }

    Bootstrapping --> Authorizing : AuthorizeRouteView pending
    note right of Authorizing
        Authorizing template renders a neutral
        spinner INSIDE MainLayout — prevents
        login/nav layout flash while /auth/me
        is in flight.
    end note

    Authorizing --> LoginView : unauthenticated
    Authorizing --> Home : authenticated

    state "Login (non-routed NotAuthorized view)" as LoginView
    note right of LoginView
        Rendered by AuthorizeRouteView.NotAuthorized —
        already inside DefaultLayout; a second
        LayoutView here would double-nest the nav
        (documented mitigation in App.razor).
        Dev shows Microsoft + Guest; Prod Microsoft only.
    end note

    LoginView --> EntraChallenge : GET /auth/login/microsoft
    state "Microsoft Entra (external)" as EntraChallenge
    EntraChallenge --> Home : /signin-oidc → cookie issued → redirect /

    state "Home  route /" as Home
    state "Arena  route /arena/{DuelId}" as Arena
    state "Leaderboard  route /leaderboard" as Leaderboard
    state "Archive  route /archive" as Archive
    state "Model health (collapsible section on Home)" as Lab
    state "NotFound  route /not-found" as NotFound

    Home --> Arena : POST /api/duels → 202
    Arena --> Arena : streams via /hubs/duel, then judged in place
    Arena --> Leaderboard : verdict recorded
    Arena --> Archive : browse history
    Archive --> Arena : re-open duel
    Home --> Leaderboard
    Home --> Archive
    Home --> Lab : expand model-health panel
    Home --> NotFound : unknown route (Router NotFoundPage)

    Home --> LoginView : POST /auth/logout (any screen)
    note left of Home
        Cookie expiry mid-session — any API call
        returns 401 JSON (never 302); provider
        re-probes /auth/me and AuthorizeRouteView
        swaps to Login without a full reload.
    end note
