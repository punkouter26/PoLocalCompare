flowchart TD
    subgraph Client["🖥️ Client Services"]
        WEB_LLM["WebLlmService<br/>WebGPU inference"]
        DUAL_API["DuelApiClient<br/>HTTP REST calls"]
        SIG_CLIENT["SignalRDuelClient<br/>WebSocket"]
        AUDIO["AudioService<br/>Sound effects"]
    end

    subgraph Api["🌐 PoLocalCompare.Api"]
        ENDPOINTS["Minimal API Endpoints<br/>/api/duels, /api/models, etc."]
        HUB["DuelHub (SignalR)<br/>Real-time broadcast"]
        MIDDLEWARE["Middleware<br/>CORS, Serilog, CSP, Exception"]
        HEALTH["Health Endpoints<br/>/health, /diag"]
        
        subgraph Services["Internal Services"]
            DUAL_EXEC["DuelExecutionService<br/>Background task runner"]
            BG_QUEUE["BackgroundTaskQueue<br/>Reliable queuing"]
            AUTO_JUDGE["AutoJudgeService<br/>GPT-4.1 Nano judge"]
        end
    end

    subgraph Application["📋 Application Layer"]
        COMMENCE["CommenceDuelHandler"]
        RECORD["RecordVerdictHandler"]
        GET_LB["GetLeaderboardHandler"]
        EXPORT["ExportLabReportHandler"]
        LIST_DUELS["ListDuelsHandler"]
        GET_DUEL["GetDuelHandler"]
        
        subgraph Interfaces["Repository Interfaces"]
            IDUEL["IDuelRepository"]
            IMODEL["IModelRepository"]
            IDUEL_RES["IDuelResultRepository"]
            IELO["IEloHistoryRepository"]
        end
    end

    subgraph Infrastructure["🏗️ Infrastructure Layer"]
        REPOS["Table Storage Repositories"]
        FOUNDRY["FoundryInferenceProxy<br/>Azure AI Foundry"]
        OLLAMA_P["OllamaProxy<br/>Ollama service"]
        HTML_RENDER["HtmlLabReportRenderer<br/>Report generation"]
        
        subgraph Repos["Repository Impls"]
            D_REPO["DuelRepository"]
            M_REPO["ModelRepository"]
            DR_REPO["DuelResultRepository"]
            E_REPO["EloHistoryRepository"]
        end
    end

    subgraph Domain["🏛️ Domain Layer"]
        ENTITIES["Entities: Model, Duel, DuelResult, EloRecord"]
        SERVICES["Domain Services: EloCalculator, GreenStatsCalculator"]
        ENUMS["Enums: ModelType, DuelStatus, DuelVerdict"]
    end

    subgraph External["🔌 External Services"]
        ATS["Azure Table Storage<br/>Data persistence"]
        BLOB["Azure Blob Storage<br/>HTML output storage"]
        FOUNDRY_API["Azure AI Foundry<br/>Remote model inference"]
        OLLAMA_SVC["Ollama Service<br/>Local service inference"]
        KEY_VAULT["Azure Key Vault<br/>Secrets management"]
        APP_INSIGHTS["App Insights<br/>Telemetry"]
    end

