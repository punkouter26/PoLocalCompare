flowchart TD
    INPUT[User Input] --> API[API Receives]
    API --> CREATE[Create Duel]
    CREATE --> QUEUE[Queue]
    QUEUE --> EXEC[Execute]
    EXEC --> STORE[Store Results]
    STORE --> COMPLETE[Complete]
    COMPLETE --> VERDICT[User Verdict]
    VERDICT --> ELO[ELO Update]
    ELO --> ARCHIVE[Archive]

    style INPUT fill:#22c55e,stroke:#000,color:#000
    style ARCHIVE fill:#16213e,stroke:#06b6d4,color:#fff