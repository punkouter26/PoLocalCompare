flowchart TB
    subgraph TRIG["Triggers — every call site that reaches an AI service"]
        direction LR
        T1["POST /api/duels<br/>duel inference"]
        T2["GET /api/models/availability<br/>reachability probe, 'Say OK.' 16 tokens"]
        T3["AutoJudge after the grace window<br/>verdict decision"]
        T4["GET /api/ollama/* <br/>tags · ps · benchmark"]
        T5["/demo — 10 remote-vs-remote duels<br/>autoJudgeDelaySeconds: 0"]
    end

    subgraph RESOLVE["Resolution — Strategy keyed by ModelType"]
        direction LR
        K1["AddKeyedTransient IRemoteInferenceProxy 'Remote'<br/>→ FoundryInferenceProxy"]
        K2["AddKeyedTransient IRemoteInferenceProxy 'LocalService'<br/>→ OllamaInferenceProxy"]
        K3["ModelType.Local — no server proxy at all"]
        K4["AddHttpClient IDuelJudge → FoundryDuelJudge<br/>separate typed client, 60 s timeout"]
    end

    subgraph FOUNDRYCALL["Azure AI Foundry — po-aiservices-shared"]
        direction TB
        U1["Primary route<br/>{Endpoint}/openai/deployments/{ApiEndpointRef}/chat/completions<br/>?api-version=2024-12-01-preview"]
        U2["Fallback route (only on HTTP 404)<br/>{Endpoint}/models/chat/completions<br/>?api-version=2024-12-01-preview · model in body"]
        PARAM["Parameter shaping — FoundryChatRequest.Build<br/>reasoning (gpt-5* / o1 / o3 / o4): max_completion_tokens, temperature OMITTED<br/>classic: max_tokens + temperature 0.7<br/>duel budget 16 384 (reasoning) / 4 096 (classic)<br/>judge budget 2 000 + response_format json_schema<br/>stream_options.include_usage ONLY for native Azure OpenAI prefixes<br/>(gpt- o1 o3 o4 phi- llama- grok-) — Codestral 2501 422s on it"]
        AUTHH["Auth header: api-key: {AzureAiFoundry:ApiKey}<br/>from Key Vault (prefix PoLocalCompare) or user-secrets"]
    end

    subgraph RESIL["Fallback + resilience policy"]
        direction TB
        R1["Polly pipeline 'foundry-inference' — retry only, 2 attempts,<br/>250 ms exponential, on HttpRequestException / 5xx / 408.<br/>NO per-attempt timeout: it would abort the SSE stream."]
        R2["In-proxy retry — 3 attempts on 429 / 502 / 503.<br/>429 honours Retry-After, clamped 1–90 s."]
        R3["HttpClient.Timeout = AzureAiFoundry:RemoteTimeoutSeconds<br/>default 120 s, clamped 30–900. Phi-4 Mini cold start needs it."]
        R4["Judge 429 → JudgeRateLimitedException(Retry-After ≤ 60 s)<br/>→ AutoJudge requeues, ≤ AiJudge:RateLimitRetryMax (2)"]
        R5["Duel watchdog: CancellationTokenSource(900 s) over both sides"]
    end

    subgraph BROWSER["Browser path — no server involvement"]
        direction TB
        B1["SignalR StartLocalInference {duelId, modelId, side, webLlmModelId}<br/>re-sent every 5 s for late joiners"]
        B2["webllm-worker.js?v=N — MLC WebLLM on WebGPU"]
        B3["Weights: wwwroot/models/{webLlmModelId}/ …<br/>else huggingface.co/mlc-ai/{modelId}/resolve/main/"]
        B4["model_lib .wasm: wwwroot/models/_libs/ …<br/>else raw.githubusercontent.com (a SECOND host — both can be blocked)"]
        B5["POST /api/duels/{id}/local-result — AllowAnonymous<br/>server never sees the inference"]
    end

    subgraph OLLAMACALL["Ollama — Development only"]
        direction TB
        O1["POST {Ollama:BaseUrl}/v1/chat/completions — OpenAI-compatible SSE, no auth"]
        O2["GET /api/tags — availability, shared across all Ollama models"]
        O3["Named client 'OllamaStatus': retry 2 + 5 s timeout (safe — not streaming)"]
    end

    subgraph COSTING["Cost + telemetry attribution"]
        direction TB
        C1["Remote: ApiCostUsd = PromptTokenCount/1e6 × InputPrice<br/>+ TokenCount/1e6 × OutputPrice — only when a price exists"]
        C2["Local / LocalService: EnergyWh = TdpWatts × ms/3.6e6<br/>EnergyCostUsd = Wh/1000 × GreenStats:ElectricityRateUsd (0.12)"]
        C3["OTel meter 'PoLocalCompare.Inference'<br/>gen_ai.client.operation.duration · gen_ai.usage.input_tokens<br/>· gen_ai.usage.output_tokens"]
        C4["NOT emitted as metrics: WarmUpDurationMs (TTFT)<br/>and TokenVelocity — persisted per row only"]
    end

    T1 --> RESOLVE
    T2 --> K1
    T2 --> K2
    T3 --> K4
    T4 --> OLLAMACALL
    T5 --> T1

    K1 --> U1
    K4 --> U1
    U1 -->|"404"| U2
    U1 --> PARAM
    U2 --> PARAM
    U1 --> AUTHH
    K1 --> RESIL
    K4 --> R4
    K2 --> O1
    K3 --> B1
    B1 --> B2 --> B3
    B2 --> B4
    B2 --> B5

    U1 --> C1
    U2 --> C1
    O1 --> C2
    B5 --> C2
    U1 --> C3
    O1 --> C3
    C3 -.-> C4

    NOAN["No Anthropic / OpenAI-direct / Google / AWS Bedrock provider exists in this codebase.<br/>Azure AI Foundry is the only paid provider; everything else runs on hardware you own."]

