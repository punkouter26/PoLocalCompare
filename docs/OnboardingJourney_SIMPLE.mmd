flowchart TD
    START([User]) --> LAND[War Room]
    LAND --> SELECT[Select Models]
    SELECT --> PROMPT[Enter Prompt]
    PROMPT --> DUEL[Commence Duel]
    DUEL --> PROCESS[Processing]
    PROCESS --> COMPLETE[Both Complete]
    COMPLETE --> ARENA[Arena]
    ARENA --> VERDICT[Pick Winner]
    VERDICT --> ELO[ELO Updated]
    ELO --> DONE([Next Duel])

    style START fill:#22c55e,stroke:#000,color:#000
    style DONE fill:#22c55e,stroke:#000,color:#000