%% BFF identity flow — server owns OIDC; WASM never touches tokens.
%% Multi-tenant Entra challenge, HttpOnly cookie session loop, /auth/me redirection gates.
graph TD
    subgraph Browser["Browser (Blazor WASM — token-free)"]
        SPA["App.razor<br/>CascadingAuthenticationState"]
        ASP["BffAuthenticationStateProvider"]
        LoginUI["Login view (NotAuthorized)"]
    end

    subgraph API["PoLocalCompare.Api (BFF, single origin)"]
        ME["GET /auth/me<br/>AllowAnonymous — never 401s"]
        MSLOGIN["GET /auth/login/microsoft<br/>returnUrl sanitized: local, starts with /, not //"]
        FAKELOGIN["GET /auth/login/fake<br/>NON-PRODUCTION guest bypass"]
        LOGOUT["POST /auth/logout"]
        COOKIE["Cookie auth scheme<br/>PoLocalCompare.Session<br/>HttpOnly · SameSite=Strict · Secure<br/>8h sliding expiry"]
        E401["OnRedirectToLogin → 401 JSON<br/>OnAccessDenied → 403<br/>(never a 302 to HTML)"]
        POLICY["FallbackPolicy = RequireAuthenticatedUser<br/>deny-by-default; AllowAnonymous is explicit"]
        FAKEH["FakeAuthHandler (X-Fake-User headers)<br/>throws if constructed in Production"]
    end

    subgraph Entra["Microsoft Entra ID (multi-tenant)"]
        AUTHZ["Authority /common/v2.0<br/>authorization_code + PKCE<br/>scopes: openid profile email"]
        ISSUER{"Issuer validation"}
        LIST["AzureAd:AllowedTenants<br/>explicit allow-list"]
        SHAPE["Shape regex: login.microsoftonline.com/{tenantGuid}/v2.0<br/>accepts work/school AND personal MSA tenant"]
    end

    SPA -->|"boot / route change"| ASP
    ASP -->|"fetch auth state"| ME
    ME -->|"AuthStateDto {IsAuthenticated, Name, Roles}"| ASP
    ASP -->|"unauthenticated → AuthorizeRouteView renders"| LoginUI

    LoginUI -->|"Sign in with Microsoft"| MSLOGIN
    LoginUI -.->|"Continue as Guest (Dev/Test only)"| FAKELOGIN
    MSLOGIN -->|"Challenge('Microsoft')"| AUTHZ
    AUTHZ -->|"code → /signin-oidc"| ISSUER
    ISSUER -->|"AllowedTenants configured"| LIST
    ISSUER -->|"no allow-list"| SHAPE
    LIST -->|"valid"| COOKIE
    SHAPE -->|"valid"| COOKIE
    LIST -.->|"invalid → SecurityTokenInvalidIssuerException"| E401
    SHAPE -.->|"invalid issuer rejected"| E401
    FAKELOGIN -->|"SignInAsync guest claims"| COOKIE

    COOKIE -->|"Set-Cookie + redirect to sanitized returnUrl"| SPA
    SPA -->|"same-origin API calls carry cookie automatically"| POLICY
    POLICY -->|"authenticated"| APIOK["Feature endpoints + SignalR hubs"]
    POLICY -->|"missing/expired cookie"| E401
    E401 -->|"401 → provider re-probes /auth/me → Login view"| ASP
    FAKEH -.->|"test scheme accepted outside Production"| POLICY

    LOGOUT -->|"SignOutAsync clears cookie"| ME
