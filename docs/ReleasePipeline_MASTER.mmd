flowchart LR
    subgraph Branches["🌿 Branch Strategy"]
        direction TB
        FEAT["feature/*<br/>New work"]
        DEV["dev<br/>Integration"]
        STAGING["staging<br/>Pre-production"]
        MAIN["main<br/>Production"]
    end

    subgraph CI["🔨 CI Pipeline (GitHub Actions)"]
        direction TB
        CHECK["✅ Check<br/>lint, test, build"]
        TEST["🧪 Test<br/>unit, integration, e2e"]
        BUILD["📦 Build<br/>dotnet publish"]
        PUBLISH["🚀 Publish<br/>artifact"]
    end

    subgraph Stages["🎯 Stage Gates"]
        direction TB
        PR["PR Review<br/>Manual Approval"]
        DEV_DEPLOY["Dev Deploy<br/>Automated"]
        STAGING_DEPLOY["Staging Deploy<br/>Automated + Manual QA"]
        PROD_DEPLOY["Prod Deploy<br/>Manual Approval"]
    end

    subgraph Environments["🌍 Environments"]
        direction LR
        DEV_ENV["Dev<br/>localhost / Azure Dev"]
        STAGING_ENV["Staging<br/>Azure Staging"]
        PROD_ENV["Prod<br/>Azure Production"]
    end

    subgraph Artifacts["📦 Artifact Flow"]
        direction TB
        NUGET["NuGet Packages<br/>src/*.nupkg"]
        WASM["WASM Bundle<br/>Client/*.zip"]
        API["API Dll<br/>Api/publish/*"]
    end

    FEAT -->|Pull Request| PR
    PR -->|Merge| DEV
    DEV --> CHECK
    CHECK --> TEST
    TEST --> BUILD
    BUILD --> PUBLISH
    PUBLISH -->|Auto| DEV_DEPLOY
    DEV_DEPLOY -->|Automated| DEV_ENV
    DEV_ENV -->|Pass QA| STAGING_DEPLOY
    STAGING_DEPLOY -->|Automated| STAGING_ENV
    STAGING_ENV -->|Manual| PROD_DEPLOY
    PROD_DEPLOY -->|Approval| PROD_ENV

    PUBLISH --> WASM
    PUBLISH --> API
    WASM -->|Deployment| DEV_ENV
    API -->|Deployment| PROD_ENV

    style Branches fill:#1a1a2e,stroke:#22c55e,color:#fff
    style CI fill:#16213e,stroke:#06b6d4,color:#fff
    style Stages fill:#0f3460,stroke:#eab308,color:#fff
    style Environments fill:#1a1a2e,stroke:#22c55e,color:#fff
    style Artifacts fill:#16213e,stroke:#06b6d4,color:#fff