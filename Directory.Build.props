<Project>
  <PropertyGroup>
    <PoSolutionName>PoLocalCompare</PoSolutionName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Standards mandate C# 15; the installed .NET 10 SDK tops out at 14, so `latest`
         tracks the newest version the toolchain supports and rolls forward automatically. -->
    <LangVersion>latest</LangVersion>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- GHSA-q939-rpr3-3284: SSH.NET 2024.2.0, pulled transitively by Testcontainers 4.4.0
         (test projects only — nothing in src/ references it). With TreatWarningsAsErrors on,
         the NU1903 advisory fails the whole solution build, which blocks the deploy-gating
         test run. Suppressed until a Testcontainers release moves off the vulnerable version;
         remove this line when bumping Testcontainers. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q939-rpr3-3284" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
